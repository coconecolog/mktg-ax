---
// カテゴリページのヘッダー直下に出す、全カテゴリのタブ列（2026-10-12追加）。
// 横幅が足りない画面では横スクロールにする。
import { getAllCategories, getCategoryPath } from "@/lib/posts";

interface Props {
  /** 表示中のカテゴリ名（太字＋下線） */
  current: string;
}

const { current } = Astro.props;
const categories = getAllCategories();
---

<nav aria-label="カテゴリ" class="border-b border-neutral-200 bg-white">
  <div class="mx-auto max-w-6xl overflow-x-auto px-5">
    <ul class="flex min-w-max items-center gap-7">
      {
        categories.map((c) => (
          <li>
            <a href={getCategoryPath(c.name)} aria-current={c.name === current ? "page" : undefined} class={`block border-b-2 py-3.5 text-sm transition-colors ${c.name === current ? "border-ink-950 font-bold text-ink-950" : "border-transparent text-neutral-500 hover:text-ink-950"}`}>
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
