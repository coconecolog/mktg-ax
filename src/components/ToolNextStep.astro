---
// ツールの直下に置く「このツールとあわせて使う」（その他のツール用、2026-11-02／2026-11-03 形を変更）。
// 上の枠：左＝この結果を、次の一手に（見出し・説明・黒いボタン）、右＝資料（表紙つき）。下：Kit・資料・記事のカード2枚。
// 判定ごとの中身をすべて書き出し、ページのスクリプトが setNextStep()（src/lib/toolNextStep.ts）で1つだけ表示する。
// 中身は src/data/tool-next-steps.ts。クリックはGA4のイベント tool_next_click で送る
// （GTMを使っているときは、GTM側にカスタムイベント「tool_next_click」のトリガーとGA4イベントのタグが必要）。
import { TOOL_NEXT_STEPS, type NextLink, type NextLinkType } from "@/data/tool-next-steps";
import { getResourceBySlug } from "@/lib/resources";

interface Props {
  path: string;
  /** 最初は隠しておく（ベンチマークのように「診断する」を押してから出すとき） */
  hidden?: boolean;
  class?: string;
}

const { path, hidden = false, class: extraClass = "" } = Astro.props;
const data = TOOL_NEXT_STEPS[path];

const BADGE: Record<NextLinkType, string> = { kit: "Kit", resource: "資料", post: "記事", tag: "記事" };
const MORE: Record<NextLinkType, string> = { kit: "Kitを使う", resource: "無料でダウンロード", post: "記事を読む", tag: "記事一覧を見る" };

/** 資料の表紙（資料DBから引けたときだけ） */
function coverOf(link: NextLink): string | null {
  const slug = link.href.match(/^\/lab\/whitepapers\/([^/?#]+)/)?.[1];
  const r = slug ? getResourceBySlug(slug) : undefined;
  return r?.thumbnail || r?.coverImage || null;
}

/** "上限 {allowable} を…" → [{text:"上限 "},{slot:"allowable"},{text:" を…"}] */
function parts(body: string): { text?: string; slot?: string }[] {
  return body.split(/(\{\w+\})/).filter(Boolean).map((p) => {
    const m = p.match(/^\{(\w+)\}$/);
    return m ? { slot: m[1] } : { text: p };
  });
}
---

{
  data && (
    <section
      class:list={["tool-next print:hidden", extraClass]}
      aria-labelledby="tool-next-heading"
      data-tool-next
      hidden={hidden}
    >
      <h2 id="tool-next-heading" class="text-2xl font-extrabold tracking-tight text-ink-950">このツールとあわせて使う</h2>
      {Object.entries(data.variants).map(([key, v]) => {
        const cover = coverOf(v.feature);
        return (
          <div data-next-variant={key} hidden={key !== data.defaultVariant}>
            <div class="mt-6 grid grid-cols-1 gap-6 border border-neutral-300 bg-white p-6 md:p-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-10">
              <div class="flex flex-col">
                <p class="text-xs font-bold tracking-wide text-neutral-500">この結果を、次の一手に</p>
                <h3 class="mt-2 text-xl font-extrabold leading-snug text-ink-950 md:text-2xl">{v.title}</h3>
                <p class="mt-3 text-sm leading-[1.9] text-neutral-600">
                  {parts(v.body).map((p) => (p.slot ? <span class="font-bold text-ink-950" data-slot={p.slot}>—</span> : p.text))}
                </p>
                <span class="min-h-6 flex-1" aria-hidden="true" />
                <a
                  href={v.cta.href}
                  data-next-link={key}
                  data-next-type={v.cta.type}
                  class="inline-flex w-fit items-center gap-5 bg-ink-950 px-7 py-4 text-sm font-bold text-white no-underline transition-colors hover:bg-neutral-800"
                >
                  {v.cta.label}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
              <a
                href={v.feature.href}
                data-next-link={key}
                data-next-type={v.feature.type}
                class="group flex flex-col text-ink-950 no-underline"
              >
                <span class="block bg-neutral-100 p-4">
                  {cover ? (
                    <img src={cover} alt={`${v.feature.title}の表紙`} class="aspect-[16/9] w-full border border-neutral-200 bg-white object-cover object-top" loading="lazy" />
                  ) : (
                    <span class="flex aspect-[16/9] w-full items-center border-l-4 border-ink-950 bg-white px-5 text-sm font-bold leading-snug">{v.feature.title}</span>
                  )}
                </span>
                <span class="mt-3 self-start border border-ink-950 px-1.5 py-0.5 text-[11px] font-bold leading-none">
                  {v.feature.type === "resource" ? "無料資料" : BADGE[v.feature.type]}
                </span>
                <span class="mt-2 flex items-start justify-between gap-4">
                  <span class="text-base font-bold leading-snug underline underline-offset-4">{v.feature.title}</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>
            </div>
            {v.links.length > 0 && (
              <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                {v.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      data-next-link={key}
                      data-next-type={l.type}
                      class="group flex h-full flex-col border border-neutral-300 bg-white p-6 text-ink-950 no-underline transition-colors hover:border-ink-950"
                    >
                      <span
                        class:list={[
                          "self-start px-2 py-px text-[0.7rem] font-bold",
                          l.type === "resource" ? "bg-ink-950 text-white" : "border border-ink-950 text-ink-950",
                        ]}
                      >
                        {BADGE[l.type]}
                      </span>
                      <span class="mt-3 text-lg font-bold leading-snug">{l.title}</span>
                      <span class="mt-2 text-sm leading-relaxed text-neutral-600">{l.desc}</span>
                      <span class="min-h-4 flex-1" aria-hidden="true" />
                      <span class="mt-3 flex items-center justify-end gap-2 text-sm font-bold">
                        {MORE[l.type]}
                        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </section>
  )
}

<script is:inline>
  (function () {
    if (window.__toolNextTracked) return;
    window.__toolNextTracked = true;
    var match = location.pathname.match(/^\/tools\/([^/]+)/);
    var toolName = match ? match[1] : "";
    document.addEventListener(
      "click",
      function (e) {
        var a = e.target && e.target.closest && e.target.closest("a[data-next-link]");
        if (!a) return;
        var params = {
          tool_name: toolName,
          next_variant: a.getAttribute("data-next-link") || "",
          link_type: a.getAttribute("data-next-type") || "",
          link_url: a.getAttribute("href") || "",
        };
        if (typeof window.gtag === "function") {
          window.gtag("event", "tool_next_click", params);
        } else {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: "tool_next_click" }, params));
        }
      },
      true,
    );
  })();
</script>
