---
// トップページと共通の「お問い合わせ」CTAブロック。他ページでも再利用する。
// heading/descriptionは呼び出し側で文言を変えられるように任意指定可（未指定ならトップページと同じ文言）。
interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "自社のマーケティング体制について相談したい方へ",
  description = "現状の課題整理から施策の優先順位づけまで、まずはお気軽にご相談ください。",
} = Astro.props;
---

<section class="py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="rounded-3xl bg-ink-950 px-6 py-16 text-center md:px-16">
      <h2 class="text-2xl font-bold tracking-tight text-white md:text-3xl">
        {heading}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        {description}
      </p>
      <a href="/contact" class="mt-8 inline-block rounded-full bg-white px-8 py-3 text-sm font-bold text-ink-950 hover:bg-neutral-200">
        お問い合わせはこちら
      </a>
    </div>
  </div>
</section>
