---
// 記事ページ・タグページ共通の右カラム（2026-10-15統一）。
// 上から「目次」（ページ内の見出し2・01からの連番。PCのみ表示）→ 薄い区切り線 →「関連する資料」（1件）
// →「関連するKit」（記事ページのみ。選び方は src/lib/tools.ts の getSideKits、2026-11-02）。
// 表紙は資料の表紙画像（PDF1ページ目のキャプチャ）。画像が無い資料は資料名から白黒で生成する。
import type { Resource } from "@/lib/types";
import type { Kit } from "@/data/tools";

interface Props {
  toc: { anchor: string; text: string }[];
  resource?: Resource;
  kits?: Kit[];
}

const { toc, resource, kits = [] } = Astro.props;
const cover = resource ? resource.thumbnail || resource.coverImage : null;
---

<div>
  {
    toc.length > 0 && (
      <nav aria-label="目次" class="hidden border-t-2 border-ink-950 pt-5 lg:block">
        <p class="text-sm font-bold text-ink-950">目次</p>
        <ol class="mt-4 space-y-3 text-sm">
          {toc.map((h, i) => (
            <li>
              <a href={`#${h.anchor}`} class="flex gap-3 text-neutral-500 no-underline hover:text-ink-950">
                <span class="shrink-0 tabular-nums text-neutral-400">{String(i + 1).padStart(2, "0")}</span>
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  {
    resource && (
      <div class={toc.length > 0 ? "lg:mt-8 lg:border-t lg:border-neutral-300 lg:pt-6" : ""}>
        <p class="text-sm font-bold text-ink-950">関連する資料</p>
        <div class="mt-3 bg-neutral-100 p-5">
          <a href={`/lab/whitepapers/${resource.slug}`} class="block" aria-hidden="true" tabindex="-1">
            {cover ? (
              <img src={cover} alt="" class="w-full border border-neutral-200 bg-white" loading="lazy" />
            ) : (
              <span class="flex aspect-[4/3] flex-col bg-ink-950 p-5 text-white">
                <span class="flex items-start justify-between gap-3 text-[10px] font-bold">
                  <span class="text-neutral-300">{resource.category || "無料資料"}</span>
                  <span class="tracking-wide">MeerKitLab</span>
                </span>
                <span class="mt-4 line-clamp-3 text-lg font-bold leading-snug">{resource.title}</span>
                {resource.homeCatch && <span class="mt-auto block text-[10px] text-neutral-300">{resource.homeCatch}</span>}
              </span>
            )}
          </a>
          <p class="mt-4 text-xs font-bold text-neutral-500">無料資料</p>
          <p class="mt-2 text-base font-extrabold leading-snug text-ink-950">
            <a href={`/lab/whitepapers/${resource.slug}`} class="text-ink-950 no-underline hover:underline">{resource.title}</a>
          </p>
          {resource.contents && <p class="mt-3 text-xs font-bold leading-relaxed text-ink-950">{resource.contents}</p>}
          {resource.description && <p class="mt-3 line-clamp-4 whitespace-pre-line text-xs leading-relaxed text-neutral-600">{resource.description}</p>}
          <a href={`/lab/whitepapers/${resource.slug}`} class="mt-5 flex items-center justify-between bg-ink-950 px-4 py-3 text-sm font-bold text-white no-underline transition-colors hover:bg-neutral-800">
            資料を見る
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    )
  }
  {
    kits.length > 0 && (
      <div class={toc.length > 0 || resource ? "mt-8 border-t border-neutral-300 pt-6" : ""}>
        <div class="flex items-end justify-between gap-2">
          <p class="text-sm font-bold text-ink-950">関連するKit</p>
          <a href="/tools" class="text-xs font-bold text-ink-950 hover:underline">Kit一覧 →</a>
        </div>
        <ul class="mt-3 space-y-2 bg-neutral-100 p-3">
          {kits.map((k) => (
            <li>
              <a href={k.href} class="group block border border-neutral-300 bg-white px-4 py-3 no-underline hover:border-ink-950">
                <span class="block text-xs text-neutral-500">{k.situation}</span>
                <span class="mt-0.5 flex items-center justify-between gap-3 text-sm font-bold text-ink-950">
                  {k.name}
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
                <span class="mt-1 block text-xs leading-relaxed text-neutral-500">{k.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
