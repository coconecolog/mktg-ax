---
// フッターのリンクは3カラムに手動で分類して表示している（NAV_LINKSのフラット表示はしていない）。
// 4カラム目は「数字の基準」（/standards 配下）への案内。
// 色はすべて src/styles/global.css の brand-* トークン経由（デザインレギュレーション準拠。hexのハードコード禁止）。
import { SITE_NAME, SITE_NAME_KANA, SITE_NAME_WITH_KANA, SITE_TAGLINE } from "@/consts";
const year = new Date().getFullYear();
---

<footer class="bg-brand-900">
  <div class="mx-auto max-w-6xl px-5 pb-7 pt-14">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 sm:gap-x-8">
      <div class="col-span-2 sm:col-span-1">
        <img src="/images/logo/meerkitlab-white.svg" alt={SITE_NAME_WITH_KANA} width="143" height="32" class="h-8 w-auto" />
        <p class="mt-1 pl-px text-[11px] leading-none tracking-[0.18em] text-brand-400" aria-hidden="true">{SITE_NAME_KANA}</p>
        <p class="mt-3 max-w-[26ch] text-sm leading-relaxed text-brand-300">{SITE_TAGLINE}</p>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">サイト</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/" class="text-sm text-brand-100 hover:text-white">トップ</a></li>
          <li><a href="/tools" class="text-sm text-brand-100 hover:text-white">Kit一覧</a></li>
          <li><a href="/lab" class="text-sm text-brand-100 hover:text-white">Lab（記事・資料）</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">MeerKitLabについて</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/service" class="text-sm text-brand-100 hover:text-white">サービスについて</a></li>
          <li><a href="/contact" class="text-sm text-brand-100 hover:text-white">お問い合わせ</a></li>
          <li><a href="/privacy" class="text-sm text-brand-100 hover:text-white">個人情報保護方針</a></li>
          <li><a href="/terms" class="text-sm text-brand-100 hover:text-white">利用規約</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">数字の基準</h3>
        <p class="mt-4 text-sm leading-relaxed text-brand-300">すべての記事・資料・ツール（Kit）は、同じ定義で計算しています。</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/standards" class="text-sm text-brand-100 hover:text-white">モデル企業を見る</a></li>
          <li><a href="/standards/model" class="text-sm text-brand-100 hover:text-white">施策と数字を見る</a></li>
          <li><a href="/standards/metrics" class="text-sm text-brand-100 hover:text-white">数字の定義を見る</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-10 border-t border-brand-800 pt-5 text-xs text-brand-400">© {year} {SITE_NAME_WITH_KANA}. All rights reserved.</p>
  </div>
</footer>
