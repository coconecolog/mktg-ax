---
// フッターのリンクは3カラムに手動で分類して表示している（NAV_LINKSのフラット表示はしていない）。
// 「ツール」カラムは TOOLS_NAV_ITEMS をそのまま使うため、ツールの追加・変更は consts.ts の編集だけで自動反映される。
// 色はすべて src/styles/global.css の brand-* トークン経由（デザインレギュレーション準拠。hexのハードコード禁止）。
import { SITE_NAME, SITE_TAGLINE, TOOLS_NAV_ITEMS } from "@/consts";
const year = new Date().getFullYear();
---

<footer class="bg-brand-900">
  <div class="mx-auto max-w-6xl px-5 pb-7 pt-14">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 sm:gap-x-8">
      <div class="col-span-2 sm:col-span-1">
        <p class="text-lg font-extrabold tracking-tight text-white">{SITE_NAME}</p>
        <p class="mt-2 max-w-[26ch] text-sm leading-relaxed text-brand-300">{SITE_TAGLINE}</p>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">サイト</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/" class="text-sm text-brand-100 hover:text-white">トップ</a></li>
          <li><a href="/tools" class="text-sm text-brand-100 hover:text-white">便利ツール</a></li>
          <li><a href="/library" class="text-sm text-brand-100 hover:text-white">ライブラリ（記事・資料）</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">MKTG.AXについて</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/service" class="text-sm text-brand-100 hover:text-white">サービスについて</a></li>
          <li><a href="/contact" class="text-sm text-brand-100 hover:text-white">お問い合わせ</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-400">ツール</h3>
        <ul class="mt-4 space-y-2.5">
          {
            TOOLS_NAV_ITEMS.map((tool) => (
              <li>
                <a href={tool.href} class="text-sm text-brand-100 hover:text-white">
                  {tool.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="mt-10 border-t border-brand-800 pt-5 text-xs text-brand-400">© {year} {SITE_NAME}. All rights reserved.</p>
  </div>
</footer>
