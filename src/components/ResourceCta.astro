---
// ブログ記事の末尾に表示する「資料ダウンロード」CTA。資料DBの内容から自動で組み立てる。
// 記事DBの「CTA資料」リレーションに値がある記事でのみ、PostLayout.astro から呼ばれる。
// 2026-11-08 デザイン変更（Claude Design「MKTG.AX 資料ダウンロードCTA」）:
//   PC  … 左に「ラベル＋表紙」、右に「資料名・CTA説明文・特徴3項目」を上端そろえで並べる。ボタンは右下。
//   スマホ … ラベル → 表紙 → 資料名 → CTA説明文 → 特徴（白い枠の中）→ 幅いっぱいのボタン。
// 説明文 … 資料DB「CTA説明文」。空ならディスクリプション（無ければ資料説明）を出す。
// 特徴   … 資料DB「ターゲット・目次」の2行目以降（1行目は見出しなので出さない）。DLページと同じ列を使う。
// ボタンは直下のツールCTA（ToolCta）のボタンと同じ幅・同じ右端にそろえている（幅 sm:w-60、左右余白 sm:p-8）。
import type { Resource } from "@/lib/types";

interface Props {
  resource: Resource;
  kits?: unknown;
}

const { resource } = Astro.props;
const cover = resource.thumbnail || resource.coverImage;
const href = `/lab/whitepapers/${resource.slug}`;
const description = resource.ctaDescription || resource.metaDescription || resource.description;
const features = (resource.targetToc || []).slice(1);
---

<aside class="mt-12 border border-brand-200 bg-brand-50 p-6 sm:p-8" aria-label="資料ダウンロード">
  <div class={cover ? "grid grid-cols-1 items-start gap-5 sm:grid-cols-[240px_1fr] sm:gap-8" : "grid grid-cols-1 gap-4"}>
    <div>
      <p class="text-xs font-bold tracking-wide text-ink-950">無料ダウンロード資料</p>
      {
        cover && (
          <a href={href} class="mt-3 block no-underline">
            <img
              src={cover}
              alt={`${resource.title}の表紙`}
              class="w-full border border-neutral-100 bg-white shadow-lg"
              loading="lazy"
            />
          </a>
        )
      }
    </div>
    <div class="min-w-0">
      <h2 class="text-xl font-extrabold leading-snug tracking-tight text-ink-950">
        <a href={href} class="text-ink-950 no-underline hover:text-brand-700">{resource.title}</a>
      </h2>
      {
        description && (
          <p class="mt-3 line-clamp-3 whitespace-pre-line text-sm leading-relaxed text-neutral-600 sm:text-[15px]">
            {description}
          </p>
        )
      }
      {
        features.length > 0 && (
          <ul class="mt-4 space-y-2 border border-neutral-200 bg-white p-4 sm:border-0 sm:bg-transparent sm:p-0">
            {features.map((line) => (
              <li class="flex items-center gap-2.5 text-sm font-medium text-ink-950">
                <svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 18 18" aria-hidden="true">
                  <circle cx="9" cy="9" r="9" fill="currentColor" />
                  <path d="M5 9.2l2.6 2.5L13 6.5" stroke="#ffffff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {line}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  <div class="mt-6 flex sm:justify-end">
    <a href={href} class="inline-flex w-full items-center justify-center gap-2 bg-brand-600 px-6 py-3 text-center text-sm font-bold text-white no-underline hover:bg-brand-700 sm:w-60">
      資料を無料でダウンロード
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 2v9M4 7.5L8 11.5 12 7.5M3 14h10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</aside>
