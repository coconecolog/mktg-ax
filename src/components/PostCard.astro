---
// ブログ一覧の記事カード（2026-10-29：/lab と同じトンマナに変更。角丸・影をやめ、細線と墨色に）
import type { Post } from "@/lib/types";
import { DEFAULT_OG_IMAGE } from "@/consts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const dateLabel = new Date(post.publishedAt)
  .toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Tokyo" })
  .replaceAll("/", ".");
---

<a href={`/lab/blog/${post.slug}`} class="group flex w-full flex-col border border-neutral-200 bg-white transition-colors hover:border-ink-950">
  <div class="aspect-video w-full overflow-hidden border-b border-neutral-200 bg-neutral-100">
    <img src={post.thumbnail || DEFAULT_OG_IMAGE} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <span class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">記事</span>
      {post.category && <span class="text-xs text-neutral-500">{post.category}</span>}
    </span>
    <h3 class="mt-2 line-clamp-2 font-bold leading-relaxed text-ink-950 group-hover:underline">{post.title}</h3>
    <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-neutral-500">{post.description}</p>
    <span class="mt-auto flex items-center justify-between gap-2 pt-4 text-xs">
      <time datetime={post.publishedAt} class="tabular-nums text-neutral-500">{dateLabel}</time>
      <span class="flex items-center gap-2 font-bold text-ink-950">
        記事を読む<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </span>
    </span>
  </div>
</a>
