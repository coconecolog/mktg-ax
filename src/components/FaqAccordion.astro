---
// 汎用FAQアコーディオン（お問い合わせページで使用）。ネイティブ<details>で実装（JS不要）。
// 2026-10-29: サイト共通の型（角丸なし・白黒・黒の2px線＋見出し＋英字ラベル、線区切りの番号付き一覧）にそろえた。
import { buildFaqSchemaFromItems } from "@/lib/schema";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  label?: string;
}

const { items, heading = "よくあるご質問", label = "FAQ" } = Astro.props;
// 画面に表示している質問と回答を、そのままFAQPageの構造化データとしても出力する（表示内容と必ず一致させるため）。
const faqSchema = buildFaqSchemaFromItems(items);
---

{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

{
  items.length > 0 && (
    <div>
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">{heading}</h2>
        <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">{label}</p>
      </div>
      <div class="mt-8 border-t border-[#dedee2]">
        {items.map((item, i) => (
          <details class="group border-b border-[#dedee2] bg-white">
            <summary class="flex cursor-pointer list-none items-center gap-4 px-4 py-4 sm:gap-6 sm:px-6 [&::-webkit-details-marker]:hidden">
              <span class="w-6 shrink-0 text-xs text-[#7b7c83] tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <span class="min-w-0 flex-1 text-[15px] font-bold leading-[1.7] text-ink-950">{item.question}</span>
              <span class="shrink-0 text-xl font-normal leading-none text-ink-950 transition-transform group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="pb-5 pl-14 pr-4 text-sm leading-[1.9] text-[#4f5057] sm:pl-[4.5rem] sm:pr-6">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  )
}
