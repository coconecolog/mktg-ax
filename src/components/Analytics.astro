---
// GTM / GA4 / Microsoft Clarity。環境変数が未設定のときは何も出力しません。
// 値は .env（ローカル）または GitHub Secrets（本番）の PUBLIC_GTM_ID / PUBLIC_GA4_ID / PUBLIC_CLARITY_ID に設定してください。
// GTM_ID が設定されている場合は、GA4を直接埋め込むタグ（gtag.js）は出さずGTMのみを読み込む（二重計測防止）。
// この場合、GA4の計測タグ自体はGTMの管理画面で「GA4設定タグ」として作成する（コード変更は不要）。
// Search Console はタグではなくmeta認証（SEO.astro側）で対応しています。
import { GTM_ID, GA4_ID, CLARITY_ID } from "@/consts";
---

{
  GTM_ID && (
    <script is:inline define:vars={{ GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", GTM_ID);
    </script>
  )
}

{
  !GTM_ID && GA4_ID && (
    <>
      <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", GA4_ID);
      </script>
    </>
  )
}

{
  /*
    ツール利用の計測（tool_use）。/tools/{ツール名} のページで、ボタンが押されたら送る。
    同じボタンは1回の表示につき1回だけ送る（月の切り替えなどで回数が膨らまないように）。
    送る値：tool_name（URLのツール名）、tool_action（ボタンの文言。40文字まで）。
    ボタンに data-track-action="..." があれば、文言の代わりにその値を使う。
    GTMを使っているときは、GTM側にカスタムイベント「tool_use」のトリガーとGA4イベントのタグが必要。
  */
  (GTM_ID || GA4_ID) && (
    <script is:inline>
      (function () {
        var match = location.pathname.match(/^\/tools\/([^/]+)/);
        if (!match) return;
        var toolName = match[1];
        var sent = {};
        document.addEventListener(
          "click",
          function (e) {
            var el = e.target && e.target.closest && e.target.closest("button, [role='button'], a[download], input[type='submit']");
            if (!el) return;
            var action = (el.getAttribute("data-track-action") || el.textContent || el.value || "").replace(/\s+/g, " ").trim().slice(0, 40);
            if (!action || sent[action]) return;
            sent[action] = true;
            var params = { tool_name: toolName, tool_action: action };
            if (typeof window.gtag === "function") {
              window.gtag("event", "tool_use", params);
            } else {
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push(Object.assign({ event: "tool_use" }, params));
            }
          },
          true,
        );
      })();
    </script>
  )
}

{
  CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", CLARITY_ID);
    </script>
  )
}
