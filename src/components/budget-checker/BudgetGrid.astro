---
// src/components/budget-checker/BudgetGrid.astro
// 予算案診断キットの入力（左）と判定（右）。/tools/budget-checker と見本のページ（/tools/budget-checker/sample）で共通
// 動きは src/scripts/budget-checker/app.ts。sample＝見本のページ（ダウンロードの代わりにキットへのリンク）
import { CHANNELS } from "@/lib/kpi-sheet-maker";

interface Props {
  sample?: boolean;
}
const { sample = false } = Astro.props;

const PRE = [
  { key: "goal", label: "売上目標" },
  { key: "price", label: "平均受注単価" },
  { key: "gmPct", label: "粗利率（%）" },
  { key: "paybackYears", label: "回収期間（年）" },
  { key: "leadTime", label: "リードタイム（月）" },
  { key: "common", label: "共通費" },
] as const;
const FIELDS = ["leads", "valid", "deals", "wins", "ext", "labor"] as const;
const FIELD_LABEL = { leads: "リード数", valid: "有効リード数", deals: "商談数", wins: "受注数", ext: "外部費用", labor: "人件費" } as const;
---

      <div class="bk-grid" id="bk-diagview">
        <form class="bk-left" id="bk-form" novalidate autocomplete="off">
          <div class="bk-tabs" role="tablist">
            <button type="button" role="tab" class="bk-tab" id="bk-tab-y" aria-selected="true" aria-controls="bk-pane-y">年間</button>
            <button type="button" role="tab" class="bk-tab" id="bk-tab-m" aria-selected="false" aria-controls="bk-pane-m">月別<i class="bk-dot" id="bk-mdot" hidden></i></button>
            <span class="bk-tab-n" id="bk-tab-n">月別のリード数・有効リード数は、年間÷12が入っています。直したいときだけ開きます</span>
          </div>

          <div id="bk-pane-y" role="tabpanel">
            <h3 class="bk-st">1. 前提</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead><tr><th>期首</th>{PRE.map((p) => <th>{p.label}</th>)}</tr></thead>
                <tbody>
                  <tr>
                    <td class="in">
                      <div class="bk-start">
                        <input name="startYear" type="number" inputmode="numeric" min="2000" max="2100" aria-label="期首の年" />
                        <select name="startMonth" aria-label="期首の月">{Array.from({ length: 12 }).map((_, i) => <option value={String(i + 1)}>{i + 1}月</option>)}</select>
                      </div>
                    </td>
                    {PRE.map((p) => <td class="in"><input name={p.key} type="number" inputmode="decimal" min="0" step="any" aria-label={p.label} /></td>)}
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="bk-tw bk-tw-s">
              <table class="bk-t bk-t-s">
                <thead><tr><th class="c">1社あたりの月の粗利</th><th class="c">CACの上限</th><th class="c">許容CPL</th></tr></thead>
                <tbody><tr><td class="calc" data-out="monthlyProfit">—</td><td class="calc" data-out="cacLimit">—</td><td class="calc" data-out="allowableCpl">—</td></tr></tbody>
              </table>
            </div>

            <h3 class="bk-st">2. チャネル別の計画（年間）</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead>
                  <tr><th class="bk-ch">チャネル</th><th>リード数</th><th>有効リード数</th><th>商談数</th><th>受注数</th><th>外部費用</th><th>人件費</th><th class="c">CPL</th><th class="c">CAC</th></tr>
                </thead>
                <tbody>
                  {
                    CHANNELS.map((name, i) => (
                      <tr>
                        <td class="lb">{name}</td>
                        {FIELDS.map((k) => (
                          <td class="in"><input name={`ch${i}.${k}`} type="number" inputmode="decimal" min="0" step="any" aria-label={`${name}の${FIELD_LABEL[k]}`} /></td>
                        ))}
                        <td class="calc" data-out={`cpl${i}`}>—</td>
                        <td class="calc" data-out={`cac${i}`}>—</td>
                      </tr>
                    ))
                  }
                  <tr class="sum">
                    <td class="lb">合計</td>
                    {FIELDS.map((k) => <td class="calc" data-out={`total.${k}`}>—</td>)}
                    <td class="calc" data-out="total.cpl">—</td>
                    <td class="calc" data-out="total.cac">—</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="bk-hint">水色＝入力　灰色＝自動計算　単位 万円　率は入れません（件数から出します）</p>
          </div>

          <div id="bk-pane-m" role="tabpanel" hidden>
            <p class="bk-hint" style="margin-bottom:8px">展示会のように特定の月に集中するチャネルだけ直します。直したチャネルは、年間の数字を変えても月別はそのままです。</p>
            {
              CHANNELS.map((name, i) => (
                <div class="bk-mblock" id={`bk-m${i}`}>
                  <div class="bk-mhead">
                    <h3 class="bk-st">{name}</h3>
                    <button type="button" class="bk-link" data-reset={i}>年間÷12に戻す</button>
                  </div>
                  <div class="bk-tw">
                    <table class="bk-t bk-t-m">
                      <thead>
                        <tr>
                          <th class="bk-ch" />
                          {Array.from({ length: 12 }).map((_, k) => <th data-mlabel={k}>{((3 + k) % 12) + 1}月</th>)}
                          <th class="c">年間</th>
                          <th class="c">計画との差</th>
                        </tr>
                      </thead>
                      <tbody>
                        {(["leads", "valid"] as const).map((k) => (
                          <tr>
                            <td class="lb">{k === "leads" ? "リード数" : "有効リード数"}</td>
                            {Array.from({ length: 12 }).map((_, m) => (
                              <td class="in"><input name={`m${i}.${k}.${m}`} type="number" inputmode="numeric" min="0" step="1" aria-label={`${name}の${m + 1}か月目`} /></td>
                            ))}
                            <td class="calc" data-out={`m${i}.${k}.sum`}>—</td>
                            <td class="calc" data-out={`m${i}.${k}.diff`}>—</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))
            }
            <p class="bk-hint">外部費用・人件費の月別は、ダウンロードした年間予算表に年額÷12の式で入ります。違う月はExcelで上書きしてください</p>
          </div>
        </form>

        <aside class="bk-panel" id="bk-panel" aria-label="判定">
          <div class="bk-counts">
            <div class="fix"><b id="bk-c-fix">0</b>直す</div>
            <div class="check"><b id="bk-c-check">0</b>確認</div>
            <div class="ok"><b id="bk-c-ok">0</b>問題なし</div>
          </div>
          <p class="bk-wait" id="bk-wait" hidden></p>
          <div id="bk-res">
            <p class="bk-ph">目標に届くか</p>
            <div id="bk-goal"></div>
            <p class="bk-ph">コストは上限以内か</p>
            <div id="bk-cost"></div>
            <div id="bk-list"></div>
          </div>
          <div class="bk-out">
            <p class="bk-remain" id="bk-remain" hidden></p>
            {
              sample ? (
                <a class="bk-btn bk-dl" href="/tools/budget-checker">自分の予算案で診断する<span aria-hidden="true">→</span></a>
              ) : (
                <button type="button" class="bk-btn bk-dl" id="bk-dl">年間予算表をDL（Excel）</button>
              )
            }
            <p class="bk-err" id="bk-dlerr" role="alert" hidden></p>
          </div>
        </aside>
      </div>
