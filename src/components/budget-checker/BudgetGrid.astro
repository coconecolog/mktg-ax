---
// src/components/budget-checker/BudgetGrid.astro
// 予算案診断キット・KPI妥当性診断キットの入力（左）と判定（右）。各キットの /input と見本のページ（/sample）で共通
// kit＝キット（src/lib/planKits.ts）。KPI妥当性診断キットだけ、判定に「率は目安の範囲か」を出す
// 動きは src/scripts/budget-checker/app.ts。sample＝見本のページ（ダウンロードの代わりにキットへのリンク、記入例・すべて消すはなし）
// 2026-10-30：作る系のKit（予算作成Kit kit="make"・KPI管理表作成Kit kit="kpimake"）は「2. 今期の実績と、来期に必要な数」を足し、チャネルの有効リード数・商談数・受注数を自動配分（灰色、上書きすると水色・↺で戻す）にする
// 2026-11-01：flow＝予算案診断Kitの入力の画面。判定（右の列）とダウンロードを出さず、入力だけにする（判定は次の ② 診断・修正で出す）。
//   右の列は app.ts が数字を書き込むので、消さずに隠す
// 2026-10-30：タブは「1 年間を入力 → 2 月別で調整」（どちらも黒、開いている方に黄色の線と✓）。ダウンロードは判定の枠の外に独立し、判定の上に置く
import { CHANNELS } from "@/lib/kpi-sheet-maker";
import { KITS, type KitId } from "@/lib/planKits";

interface Props {
  sample?: boolean;
  kit?: KitId;
  flow?: boolean;
}
const { sample = false, kit: kitId = "budget", flow = false } = Astro.props;
const kit = KITS[kitId];
const MAKE = kit.maker;
const AUTO = new Set(["valid", "deals", "wins"]);
const ACT = [
  { key: "leads", label: "リード数" },
  { key: "validRate", label: "有効リード率", rate: true },
  { key: "valid", label: "有効リード数" },
  { key: "dealRate", label: "商談化率", rate: true },
  { key: "deals", label: "商談数" },
  { key: "winRate", label: "受注率", rate: true },
  { key: "wins", label: "受注数" },
] as const;

const PRE = [
  { key: "goal", label: "売上目標" },
  { key: "price", label: "平均受注単価" },
  { key: "gmPct", label: "粗利率（%）" },
  { key: "paybackYears", label: "回収期間（年）" },
  { key: "leadTime", label: "リードタイム（月）" },
  { key: "common", label: "共通費" },
] as const;
const FIELDS = ["leads", "valid", "deals", "wins", "ext", "labor"] as const;
const FIELD_LABEL = { leads: "リード数", valid: "有効リード数", deals: "商談数", wins: "受注数", ext: "外部費用", labor: "人件費" } as const;
---

      <div class={flow ? "bk-grid is-flow" : "bk-grid"} id="bk-diagview">
        <form class="bk-left" id="bk-form" novalidate autocomplete="off">
          <div class="bk-tabs">
            <div class="bk-tabset" role="tablist" aria-label="入力の順番">
              <button type="button" role="tab" class="bk-tab" id="bk-tab-y" aria-selected="true" aria-controls="bk-pane-y"><span class="bk-tno">1</span>年間を入力<span class="bk-tck" aria-hidden="true">✓</span></button>
              <span class="bk-tarr" aria-hidden="true">→</span>
              <button type="button" role="tab" class="bk-tab" id="bk-tab-m" aria-selected="false" aria-controls="bk-pane-m"><span class="bk-tno">2</span>月別で調整<i class="bk-dot" id="bk-mdot" hidden></i><span class="bk-tck" aria-hidden="true">✓</span></button>
            </div>
            {
              !sample && (
                <div class="bk-acts">
                  <button type="button" class="bk-btn-o" id="bk-example">記入例を入れる</button>
                  <button type="button" class="bk-btn-o" id="bk-clear">すべて消す</button>
                </div>
              )
            }
          </div>
          <p class="bk-tab-n" id="bk-tab-n">いま表示中：年間。入力が終わったら「2 月別で調整」を押してください</p>

          <div id="bk-pane-y" role="tabpanel">
            <h3 class="bk-st">1. 前提</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead><tr><th>期首</th>{PRE.map((p) => <th>{p.label}</th>)}</tr></thead>
                <tbody>
                  <tr>
                    <td class="in">
                      <div class="bk-start">
                        <input name="startYear" type="number" inputmode="numeric" min="2000" max="2100" aria-label="期首の年" />
                        <select name="startMonth" aria-label="期首の月">{Array.from({ length: 12 }).map((_, i) => <option value={String(i + 1)}>{i + 1}月</option>)}</select>
                      </div>
                    </td>
                    {PRE.map((p) => <td class="in"><input name={p.key} type="number" inputmode="decimal" min="0" step="any" aria-label={p.label} /></td>)}
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="bk-tw bk-tw-s">
              <table class="bk-t bk-t-s">
                <thead><tr><th class="c">1社あたりの月の粗利</th><th class="c">CACの上限</th><th class="c">許容CPL</th></tr></thead>
                <tbody><tr><td class="calc" data-out="monthlyProfit">—</td><td class="calc" data-out="cacLimit">—</td><td class="calc" data-out="allowableCpl">—</td></tr></tbody>
              </table>
            </div>

            {
              MAKE && (
                <>
                  <h3 class="bk-st">2. 今期の実績と、来期に必要な数</h3>
                  <div class="bk-tw">
                    <table class="bk-t">
                      <thead>
                        <tr><th class="bk-ch" />{ACT.map((a) => <th class={"rate" in a ? "c" : undefined}>{a.label}</th>)}</tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td class="lb">今期の実績</td>
                          {ACT.map((a) =>
                            "rate" in a ? (
                              <td class="calc" data-out={`act.${a.key}`}>—</td>
                            ) : (
                              <td class="in"><input name={`act.${a.key}`} type="number" inputmode="numeric" min="0" step="any" aria-label={`今期の${a.label}`} /></td>
                            ),
                          )}
                        </tr>
                        <tr class="sum">
                          <td class="lb">来期に必要な数</td>
                          {ACT.map((a) => ("rate" in a ? <td class="calc" /> : <td class="calc" data-out={`need.${a.key}`}>—</td>))}
                        </tr>
                      </tbody>
                    </table>
                  </div>
                  <p class="bk-hint" id="bk-rate-n">受注数＝売上目標÷平均受注単価。そこから今期の率でさかのぼります。今期の実績が空欄なら、基本モデルの率（38%・40%・29%）を使います</p>
                </>
              )
            }

            <h3 class="bk-st">{MAKE ? "3" : "2"}. チャネル別の計画（年間）</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead>
                  <tr><th class="bk-ch">チャネル</th><th>リード数</th><th>有効リード数</th><th>商談数</th><th>受注数</th><th>外部費用</th><th>人件費</th><th class="c">CPL</th><th class="c">CAC</th></tr>
                </thead>
                <tbody>
                  {
                    CHANNELS.map((name, i) => (
                      <tr>
                        <td class="lb">{name}</td>
                        {FIELDS.map((k) =>
                          MAKE && AUTO.has(k) ? (
                            <td class="in auto">
                              <input name={`ch${i}.${k}`} type="number" inputmode="decimal" min="0" step="any" aria-label={`${name}の${FIELD_LABEL[k]}（自動。上書きできます）`} />
                              <button type="button" class="bk-ovr-x" data-ovr={`${i}.${k}`} title="自動に戻す" aria-label={`${name}の${FIELD_LABEL[k]}を自動に戻す`}>↺</button>
                            </td>
                          ) : (
                            <td class="in"><input name={`ch${i}.${k}`} type="number" inputmode="decimal" min="0" step="any" aria-label={`${name}の${FIELD_LABEL[k]}`} /></td>
                          ),
                        )}
                        <td class="calc" data-out={`cpl${i}`}>—</td>
                        <td class="calc" data-out={`cac${i}`}>—</td>
                      </tr>
                    ))
                  }
                  <tr class="sum">
                    <td class="lb">合計</td>
                    {FIELDS.map((k) => <td class="calc" data-out={`total.${k}`}>—</td>)}
                    <td class="calc" data-out="total.cpl">—</td>
                    <td class="calc" data-out="total.cac">—</td>
                  </tr>
                  {
                    MAKE && (
                      <tr class="sum">
                        <td class="lb">必要との差</td>
                        {(["leads", "valid", "deals", "wins"] as const).map((k) => <td class="calc" data-out={`diff.${k}`}>—</td>)}
                        <td class="calc" colspan="4" />
                      </tr>
                    )
                  }
                </tbody>
              </table>
            </div>
            {
              MAKE ? (
                <p class="bk-hint">水色＝入力　灰色＝自動計算　単位 万円　有効リード数・商談数・受注数はリード数から今期の率で自動で配ります。上書きした欄は水色になり、↺で自動に戻せます</p>
              ) : (
                <p class="bk-hint">水色＝入力　灰色＝自動計算　単位 万円　率は入れません（件数から出します）</p>
              )
            }
          </div>

          <div id="bk-pane-m" role="tabpanel" hidden>
            <p class="bk-hint" style="margin-bottom:8px">展示会のように特定の月に集中するチャネルだけ直します。直したチャネルは、年間の数字を変えても月別はそのままです。</p>
            {
              CHANNELS.map((name, i) => (
                <div class="bk-mblock" id={`bk-m${i}`}>
                  <div class="bk-mhead">
                    <h3 class="bk-st">{name}</h3>
                    <button type="button" class="bk-link" data-reset={i}>年間÷12に戻す</button>
                  </div>
                  <div class="bk-tw">
                    <table class="bk-t bk-t-m">
                      <thead>
                        <tr>
                          <th class="bk-ch" />
                          {Array.from({ length: 12 }).map((_, k) => <th data-mlabel={k}>{((3 + k) % 12) + 1}月</th>)}
                          <th class="c">年間</th>
                          <th class="c">計画との差</th>
                        </tr>
                      </thead>
                      <tbody>
                        {(["leads", "valid"] as const).map((k) => (
                          <tr>
                            <td class="lb">{k === "leads" ? "リード数" : "有効リード数"}</td>
                            {Array.from({ length: 12 }).map((_, m) => (
                              <td class="in"><input name={`m${i}.${k}.${m}`} type="number" inputmode="numeric" min="0" step="1" aria-label={`${name}の${m + 1}か月目`} /></td>
                            ))}
                            <td class="calc" data-out={`m${i}.${k}.sum`}>—</td>
                            <td class="calc" data-out={`m${i}.${k}.diff`}>—</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))
            }
            <p class="bk-hint">外部費用・人件費の月別は、ダウンロードした{kit.doc}に年額÷12の式で入ります。違う月はExcelで上書きしてください</p>
          </div>
        </form>

        <div class="bk-side" hidden={flow}>
          <div class="bk-out">
            <p class="bk-remain" id="bk-remain" hidden></p>
            {
              sample ? (
                <a class="bk-btn bk-dl" href={kit.path}>{kit.cta}<span aria-hidden="true">→</span></a>
              ) : (
                <button type="button" class="bk-btn bk-dl" id="bk-dl">{kit.doc}をダウンロード（Excel）</button>
              )
            }
            <p class="bk-err" id="bk-dlerr" role="alert" hidden></p>
          </div>
          <aside class="bk-panel" id="bk-panel" aria-label="判定">
            <div class="bk-counts">
              <div class="fix"><b id="bk-c-fix">0</b>直す</div>
              <div class="check"><b id="bk-c-check">0</b>確認</div>
              <div class="ok"><b id="bk-c-ok">0</b>問題なし</div>
            </div>
            <p class="bk-wait" id="bk-wait" hidden></p>
            <div id="bk-res">
              <p class="bk-ph">目標に届くか</p>
              <div id="bk-goal"></div>
              {
                kitId === "kpi" && (
                  <>
                    <p class="bk-ph">率は目安の範囲か</p>
                    <div id="bk-rate"></div>
                  </>
                )
              }
              <p class="bk-ph">コストは上限以内か</p>
              <div id="bk-cost"></div>
              <div id="bk-list"></div>
            </div>
          </aside>
        </div>
      </div>
