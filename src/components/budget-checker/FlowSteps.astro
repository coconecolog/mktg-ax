---
// src/components/budget-checker/FlowSteps.astro
// 予算案診断Kitの流れ（① 入力・取り込み → ② 診断・修正 → ③ 最終チェック → ④ ダウンロード → ⑤ 次へ）。2026-11-01
// 入口・入力・診断・最終チェック・完了のどの画面でも、いちばん上に同じ帯を出す（いまどこにいるかがわかるように）
// current＝いまの段階（1〜5）。それより前は「済み」（✓）
// スマホは短い名前（m）を出す
// 押して移る作りにはしない（戻るときは各画面の「← 〇〇に戻る」を使う）
interface Props {
  current: 1 | 2 | 3 | 4 | 5;
}
const { current } = Astro.props;
const STEPS = [
  { t: "入力・取り込み", m: "入力", s: "AIの案・Excel・画面入力" },
  { t: "診断・修正", m: "診断・修正", s: "判定を見ながら直す" },
  { t: "最終チェック", m: "最終確認", s: "未対応を確かめる" },
  { t: "ダウンロード", m: "ダウンロード", s: "年間予算表（Excel）" },
  { t: "次へ", m: "次へ", s: "KPI管理表作成Kitなど" },
];
---

<ol class="bk-fs" aria-label="予算案診断Kitの流れ">
  {
    STEPS.map((x, i) => {
      const n = i + 1;
      const state = n < current ? "done" : n === current ? "now" : "next";
      return (
        <li class={`bk-fs-i is-${state}`} aria-current={state === "now" ? "step" : undefined}>
          <span class="bk-fs-n">{state === "done" ? "✓" : n}</span>
          <span class="bk-fs-t">
            <b>{x.t}</b>
            <em>{x.m}</em>
            <small>{x.s}</small>
          </span>
        </li>
      );
    })
  }
</ol>
