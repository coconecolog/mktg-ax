---
// ライブラリページ用のカード。記事・資料どちらの LibraryItem も同じ見た目で表示する。
import type { LibraryItem } from "@/lib/library";
import { DEFAULT_OG_IMAGE } from "@/consts";

interface Props {
  item: LibraryItem;
}

const { item } = Astro.props;
const isResource = item.kind === "resource";
const dateLabel = new Date(item.publishedAt)
  .toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" })
  .replaceAll("/", ".");
const readTimeLabel = item.metaLabel ? item.metaLabel.replace(/^◷\s*/, "") : null;
---

<a href={item.href} class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-100 bg-white transition-shadow hover:shadow-lg">
  <div class={`aspect-video w-full overflow-hidden ${isResource ? "bg-brand-100 p-6" : "bg-neutral-50"}`}>
    <img
      src={item.thumbnail || DEFAULT_OG_IMAGE}
      alt=""
      class={`h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 ${isResource ? "rounded-md shadow-lg" : ""}`}
    />
  </div>
  <div class={`flex flex-1 flex-col px-5 pb-5 ${isResource ? "pt-5" : "pt-10"}`}>
    <div class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-400">
      {item.category && <span class="font-medium text-brand-600">{item.category}</span>}
      {item.category && <span class="text-neutral-300">/</span>}
      <span>{dateLabel}</span>
      {!isResource && readTimeLabel && <span class="text-neutral-300">/</span>}
      {!isResource && readTimeLabel && <span>{readTimeLabel}</span>}
    </div>
    <h3 class="mt-1 line-clamp-2 font-bold text-ink-950 group-hover:text-brand-700">{item.title}</h3>
    <p class="mt-2 line-clamp-2 flex-1 text-sm text-neutral-500">{item.description}</p>
    <span class={`mt-4 flex w-full items-center justify-center rounded-full px-4 py-2.5 text-sm font-bold ${isResource ? "bg-black text-white" : "bg-neutral-200 text-black"}`}>
      {item.ctaLabel}
    </span>
  </div>
</a>
