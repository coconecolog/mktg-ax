---
// カテゴリページ（2026-10-12リニューアル）の、サブカテゴリ1つ分のブロック。
// 左「記事で理解する」、右「資料で実践する」（資料が無いテーマは「関連テーマも活用する」）。
// 件数が多いテーマは、最初の数件だけを表示し、残りは「もっと見る」ボタンで開く（ページ番号のページネーションは使わない）。
// 絞り込み・検索・「もっと見る」の動きは、カテゴリページ側の <script> が data-* 属性を見て制御する。
import type { CategorySection } from "@/lib/library";
import { CATEGORY_SECTION_POST_LIMIT, CATEGORY_SECTION_RESOURCE_LIMIT, DEFAULT_OG_IMAGE } from "@/consts";

interface RelatedLink {
  number: string;
  name: string;
  anchor: string;
  /** このテーマより上にあるか（↑）、下にあるか（↓） */
  direction: "up" | "down";
}

interface Props {
  section: CategorySection;
  /** 資料が無いテーマの右側に出す、同じカテゴリ内で資料があるテーマへのリンク */
  related: RelatedLink[];
}

const { section, related } = Astro.props;
const isOthers = section.subcategory === null;
const total = section.posts.length + section.resources.length;
const searchText = (item: { title: string; description: string }) => `${item.title} ${item.description}`;

// 「まずはこの記事から」はサブカテゴリのブロックだけ（「その他」は全件を同じ形の行で並べる）
const featuredPost = !isOthers ? section.posts[0] : undefined;
const listPosts = featuredPost ? section.posts.slice(1) : section.posts;
// 記事が1件だけのときは、空いた横幅を埋めるために代表記事にサムネイルを付ける
const showFeaturedThumb = !!featuredPost && section.posts.length === 1 && !!featuredPost.thumbnail;
// 最初から見えている記事の数（代表記事を含めて CATEGORY_SECTION_POST_LIMIT 件）
const visiblePostRows = Math.max(0, CATEGORY_SECTION_POST_LIMIT - (featuredPost ? 1 : 0));
const extraPostCount = Math.max(0, listPosts.length - visiblePostRows);

const featuredResource = section.resources[0];
const listResources = section.resources.slice(1);
const visibleResourceRows = Math.max(0, CATEGORY_SECTION_RESOURCE_LIMIT - 1);
const extraResourceCount = Math.max(0, listResources.length - visibleResourceRows);

const hasRight = section.resources.length > 0 || related.length > 0;
const countLabel =
  section.resources.length > 0
    ? `記事 ${section.posts.length} / 無料資料 ${section.resources.length}`
    : `記事 ${section.posts.length}`;
---

<section id={section.anchor} data-section class="scroll-mt-24 border-t-2 border-ink-950 pt-8 pb-14">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h2 class="flex items-baseline gap-4 text-2xl font-bold tracking-tight text-ink-950">
      {section.number && <span class="text-3xl font-bold tabular-nums">{section.number}</span>}
      <span>{section.name}</span>
    </h2>
    <p class="text-xs text-neutral-500">{countLabel}　・　{total}件</p>
  </div>

  {section.description && <p class="mt-4 text-sm text-neutral-500">ここでできること｜{section.description}</p>}

  {
    total === 0 && section.tools.length === 0 ? (
      <p class="mt-8 text-sm text-neutral-400">このテーマの記事・資料は準備中です。</p>
    ) : (
      <div class={`mt-8 grid grid-cols-1 gap-10 ${hasRight ? "lg:grid-cols-[minmax(0,1fr)_336px]" : ""}`}>
        {/* 左: 記事で理解する */}
        <div data-column="post" class="min-w-0">
          {section.posts.length > 0 && <p class="text-sm font-bold text-ink-950">記事で理解する</p>}

          {featuredPost && (
            <a href={featuredPost.href} data-item data-kind="post" data-search={searchText(featuredPost)} class="group mt-4 flex items-start gap-5 border-b border-neutral-300 pb-6">
              {showFeaturedThumb && (
                <span class="hidden aspect-video w-56 shrink-0 overflow-hidden bg-neutral-100 sm:block">
                  <img src={featuredPost.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover" />
                </span>
              )}
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-2">
                  <span class="inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">記事</span>
                  <span class="text-xs text-neutral-500">まずはこの記事から</span>
                </span>
                <span class="mt-3 block text-lg font-bold leading-relaxed text-ink-950 group-hover:underline sm:text-xl">{featuredPost.title}</span>
                {featuredPost.description && <span class="mt-2 line-clamp-2 text-sm text-neutral-500">{featuredPost.description}</span>}
              </span>
              <span aria-hidden="true" class="mt-8 shrink-0 text-lg text-ink-950 transition-transform group-hover:translate-x-1">→</span>
            </a>
          )}

          {listPosts.length > 0 && (
            <ul data-list="post" class={featuredPost ? "" : "mt-4 border-t border-neutral-300"}>
              {listPosts.map((item, i) => (
                <li data-item data-kind="post" data-search={searchText(item)} data-extra={i >= visiblePostRows ? "" : undefined} hidden={i >= visiblePostRows} class="border-b border-neutral-300">
                  <a href={item.href} class="group flex items-center gap-4 py-4">
                    <span class="inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">記事</span>
                    <span class="min-w-0 flex-1 text-sm font-medium leading-relaxed text-ink-950 group-hover:underline sm:text-[15px]">{item.title}</span>
                    <span aria-hidden="true" class="shrink-0 text-ink-950 transition-transform group-hover:translate-x-1">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {extraPostCount > 0 && (
            <button type="button" data-more="post" class="mt-5 flex w-full items-center justify-center gap-2 border border-ink-950 bg-white px-4 py-3 text-sm font-bold text-ink-950 transition-colors hover:bg-ink-950 hover:text-white">
              記事をもっと見る（残り{extraPostCount}件）<span aria-hidden="true">↓</span>
            </button>
          )}

          {section.tools.length > 0 && (
            <ul data-tools class="mt-5 space-y-3">
              {section.tools.map((tool) => (
                <li>
                  <a href={tool.href} class="group flex items-start gap-3">
                    <span class="mt-0.5 inline-flex shrink-0 items-center bg-ink-950 px-1.5 py-0.5 text-[11px] font-bold leading-none text-white">ツール</span>
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-ink-950 group-hover:underline">{tool.title} ↗</span>
                      <span class="block text-xs text-neutral-400">関連リンク / {total}件には含みません</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

        {/* 右: 資料で実践する / 関連テーマも活用する */}
        {section.resources.length > 0 ? (
          <div data-column="resource" class="flex min-w-0 flex-col">
            <p class="text-sm font-bold text-ink-950">資料で実践する</p>
            <div class="mt-4 flex flex-1 flex-col bg-neutral-100 p-5">
              <a href={featuredResource.href} data-item data-kind="resource" data-search={searchText(featuredResource)} class="group flex flex-1 flex-col">
                <span class="block aspect-video overflow-hidden bg-white">
                  <img src={featuredResource.thumbnail || DEFAULT_OG_IMAGE} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
                </span>
                <span class="mt-4 inline-flex w-fit items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">無料資料</span>
                <span class="mt-3 block text-lg font-bold leading-snug text-ink-950">{featuredResource.title}</span>
                {featuredResource.description && <span class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-600">{featuredResource.description}</span>}
                <span aria-hidden="true" class="block min-h-5 flex-1"></span>
                <span class="mt-auto flex items-center justify-between bg-ink-950 px-4 py-3 text-sm font-bold text-white">
                  資料を見る<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>

              {listResources.length > 0 && (
                <ul data-list="resource" class="mt-4">
                  {listResources.map((item, i) => (
                    <li data-item data-kind="resource" data-search={searchText(item)} data-extra={i >= visibleResourceRows ? "" : undefined} hidden={i >= visibleResourceRows} class="border-t border-neutral-300">
                      <a href={item.href} class="group flex items-center gap-3 py-3.5">
                        <span class="inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">無料資料</span>
                        <span class="min-w-0 flex-1 text-sm font-medium leading-snug text-ink-950 group-hover:underline">{item.title}</span>
                        <span aria-hidden="true" class="shrink-0 text-ink-950">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {extraResourceCount > 0 && (
                <button type="button" data-more="resource" class="mt-4 flex w-full items-center justify-center gap-2 border border-ink-950 bg-white px-4 py-3 text-sm font-bold text-ink-950 transition-colors hover:bg-ink-950 hover:text-white">
                  資料をもっと見る（残り{extraResourceCount}件）<span aria-hidden="true">↓</span>
                </button>
              )}
            </div>
          </div>
        ) : (
          related.length > 0 && (
            <div data-related class="min-w-0">
              <div class="bg-neutral-100 p-5">
                <p class="text-sm font-bold text-ink-950">関連テーマも活用する</p>
                <p class="mt-2 text-xs leading-relaxed text-neutral-500">このテーマの資料は準備中です。同じカテゴリの、資料があるテーマもあわせて使えます。</p>
                <ul class="mt-4 space-y-2.5">
                  {related.map((r) => (
                    <li>
                      <a href={`#${r.anchor}`} class="text-sm font-bold text-ink-950 hover:underline">
                        {r.number} {r.name}へ {r.direction === "up" ? "↑" : "↓"}
                      </a>
                    </li>
                  ))}
                </ul>
                <p class="mt-4 text-xs text-neutral-400">関連参照 / このテーマの{total}件には含みません</p>
              </div>
            </div>
          )
        )}
      </div>
    )
  }
</section>
