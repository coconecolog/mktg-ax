---
import { SITE_NAME, GSC_VERIFICATION } from "@/consts";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  // 正規URLを明示したいとき（例: タグページの「ブログ記事」「無料資料」タブを本体ページへ寄せる）に、
  // サイト内パスで指定する。未指定なら現在のURLが正規URLになる。
  canonicalPath?: string;
}

const { title, description, ogImage, noindex = false, jsonLd, canonicalPath: canonicalPathProp } = Astro.props;

// 末尾にサイト名を付ける。title がすでにサイト名を含む場合（トップページの「MeerKitLab（ミーアキットラボ）｜…」や、
// Kitページの「…｜MeerKitLab」）は付けない（「…｜MeerKitLab | MeerKitLab」と二重になるのを防ぐ）。
const pageTitle = title.startsWith(SITE_NAME) || /[|｜]\s*MeerKitLab\s*$/.test(title) ? title : `${title} | ${SITE_NAME}`;
// canonical は常に「スラッシュなし・.htmlなし」に正規化する（トップ "/" のみ例外）
const canonicalPath =
  canonicalPathProp ||
  Astro.url.pathname.replace(/\/index(\.html)?$/, "/").replace(/\.html$/, "").replace(/(.)\/+$/, "$1") || "/";
const canonicalURL = new URL(canonicalPath, Astro.site);
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />

{jsonLdList.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
