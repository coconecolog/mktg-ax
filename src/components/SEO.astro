---
import { SITE_NAME, GSC_VERIFICATION, DEFAULT_OG_IMAGE } from "@/consts";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // og:image の縦横（px）。わかるときだけ渡す。/open-graph/ の自動生成画像は 1200×630 として自動で入れる。
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  jsonLd?: object | object[];
  // 正規URLを明示したいとき（例: タグページの「ブログ記事」「無料資料」タブを本体ページへ寄せる）に、
  // サイト内パスで指定する。未指定なら現在のURLが正規URLになる。
  canonicalPath?: string;
  // OGPの種類。未指定なら URL から自動で決める（下の resolveOgType）。
  // ブログ記事は PostLayout.astro が "article" と公開日・更新日を渡すので、記事を足すたびの対応は不要。
  ogType?: "website" | "article" | "profile";
  // ogType が "article" のときだけ出す（ISO 8601）
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  noindex = false,
  jsonLd,
  canonicalPath: canonicalPathProp,
  ogType: ogTypeProp,
  publishedTime,
  modifiedTime,
} = Astro.props;

// 末尾にサイト名を付ける。title がすでにサイト名を含む場合（トップページの「MeerKitLab（ミーアキットラボ）｜…」や、
// Kitページの「…｜MeerKitLab」）は付けない（「…｜MeerKitLab | MeerKitLab」と二重になるのを防ぐ）。
const pageTitle = title.startsWith(SITE_NAME) || /[|｜]\s*MeerKitLab\s*$/.test(title) ? title : `${title} | ${SITE_NAME}`;
// canonical は常に「スラッシュなし・.htmlなし」に正規化する（トップ "/" のみ例外）
const canonicalPath =
  canonicalPathProp ||
  Astro.url.pathname.replace(/\/index(\.html)?$/, "/").replace(/\.html$/, "").replace(/(.)\/+$/, "$1") || "/";
const canonicalURL = new URL(canonicalPath, Astro.site);
// og:image が指定されていないページも、SNSでシェアされたときに画像が出るよう既定の画像を使う（2026-11-01）。
const ogImagePath = ogImage || DEFAULT_OG_IMAGE;
const resolvedOgImage = new URL(ogImagePath, Astro.site).toString();
const isGeneratedOg = ogImagePath.startsWith("/open-graph/");
const ogWidth = ogImageWidth ?? (isGeneratedOg ? 1200 : undefined);
const ogHeight = ogImageHeight ?? (isGeneratedOg ? 630 : undefined);
const ogImageType = /\.png$/i.test(ogImagePath) ? "image/png" : /\.jpe?g$/i.test(ogImagePath) ? "image/jpeg" : /\.webp$/i.test(ogImagePath) ? "image/webp" : undefined;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// og:type を URL から決める（ページごとに書かなくても、新しいページが正しい種類になるようにする）。
// ・/lab/blog/{記事}（一覧の /lab/blog と、ページ番号の /lab/blog/2 などは除く）→ article
// ・/authors/{執筆者} → profile
// ・それ以外（トップ・一覧・資料・Kit・固定ページ）→ website
function resolveOgType(path: string): "website" | "article" | "profile" {
  if (/^\/lab\/blog\/(?!\d+$)[^/]+$/.test(path)) return "article";
  if (/^\/authors\/[^/]+$/.test(path)) return "profile";
  return "website";
}
const ogType = ogTypeProp ?? resolveOgType(canonicalPath);
const toIso = (value?: string) => {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};
const articlePublished = ogType === "article" ? toIso(publishedTime) : undefined;
const articleModified = ogType === "article" ? toIso(modifiedTime) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{/* noindex のページ（入力画面・検索・サンクスなど）も、ページ内のリンクはたどってもらう（follow） */}
{noindex && <meta name="robots" content="noindex, follow" />}
{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

<meta property="og:locale" content="ja_JP" />
<meta property="og:type" content={ogType} />
{articlePublished && <meta property="article:published_time" content={articlePublished} />}
{articleModified && <meta property="article:modified_time" content={articleModified} />}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={resolvedOgImage} />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
{ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
{ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
<meta property="og:image:alt" content={pageTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={pageTitle} />

<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />

{jsonLdList.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
