---
// フッター手前の共通ブロック「カテゴリ一覧」「タグ一覧」（2026-10-15）。
// ContactCta（ご要望・ご質問）の直前に自動で表示されるので、ContactCta を置いている全ページで共通になる。
// カテゴリはマスターカテゴリDBの全件（並び順どおり）、タグは記事に使われている全タグ（記事数の多い順）。
// 2026-11-01：showTags={false} でタグ一覧を出さない（Kitのページ。ToolFooter → ContactCta から渡す）
// 2026-11-07：全タグの一覧をやめ、渡されたタグ（tags）だけを「関連するタグ」として出す。
//   全ページから全タグへ同じリンクが張られ、どのタグとの関係も区別できなくなっていたため。
//   記事ページ＝記事のサブカテゴリと重なるタグ、タグページ＝そのタグのサブカテゴリと重なるタグ（getRelatedTagsBySubcategories）。
//   tags を渡さないページ（Labトップ・記事一覧・カテゴリ・資料一覧・執筆者・Kitなど）と、0件のときはタグのブロックを出さない。
// 2026-11-07：関連するタグはカテゴリ一覧の帯から独立させ、スマホ・タブレットだけに出す（PCは右カラム）。
import { getAllCategories, getCategoryPath, getTagPath } from "@/lib/posts";

interface Props {
  tags?: string[];
}
const { tags = [] } = Astro.props;
const categories = getAllCategories();
---

{/* 関連するタグ：独立した帯。PCは右カラム（RelatedTagsNav）に出すので、スマホ・タブレットだけ（2026-11-07） */}
{
  tags.length > 0 && (
    <section aria-labelledby="site-related-tags" class="border-t border-neutral-200 lg:hidden">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <h2 id="site-related-tags" class="text-lg font-bold text-ink-950">関連するタグ</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((name) => (
            <li>
              <a href={getTagPath(name)} class="block border border-neutral-300 bg-white px-3 py-1.5 text-xs text-neutral-700 transition-colors hover:bg-ink-950 hover:text-white">
                {name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  categories.length > 0 && (
    <section class="bg-neutral-100">
      <div class="mx-auto max-w-6xl px-5 py-12 md:py-14">
        <div>
          <h2 class="text-lg font-bold text-ink-950">カテゴリ一覧</h2>
          <ul class="mt-6 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-5">
            {categories.map((c) => (
              <li class="border-b border-neutral-300">
                <a href={getCategoryPath(c.name)} class="group block py-4 text-sm font-bold text-ink-950 hover:underline">
                  {c.name}
                  <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
