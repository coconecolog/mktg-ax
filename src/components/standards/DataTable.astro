---
// 「数字の基準」ページの表。1列目は行の見出し。
// strongCols：太字にする列（0始まり）。total：最後の行を合計行（太字）にする。size：sm で文字を14pxにする（列の多い表）
interface Props {
  head: string[];
  rows: string[][];
  widths?: string[];
  strongCols?: number[];
  total?: boolean;
  size?: "md" | "sm";
  minWidth?: string;
  caption?: string;
}
const { head, rows, widths, strongCols = [], total = false, size = "md", minWidth = "36rem", caption } = Astro.props;
const text = size === "sm" ? "text-sm" : "text-base";
---

<div class="overflow-x-auto">
  <table class={`w-full border-collapse text-left leading-[1.7] ${text}`} style={`min-width:${minWidth}`}>
    {caption && <caption class="sr-only">{caption}</caption>}
    {
      widths && (
        <colgroup>
          {widths.map((w) => (
            <col style={w ? `width:${w}` : undefined} />
          ))}
        </colgroup>
      )
    }
    <thead>
      <tr class="bg-std-bg">
        {head.map((h) => (
          <th scope="col" class="px-4 py-3.5 text-[0.8125rem] font-bold leading-[1.6] text-std-sub">
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, ri) => {
          const isTotal = total && ri === rows.length - 1;
          return (
            <tr class="border-b border-std-line">
              {row.map((cell, ci) =>
                ci === 0 ? (
                  <th scope="row" class={`px-4 py-4 align-middle text-ink-950 ${isTotal ? "font-bold" : "font-medium"}`}>
                    {cell}
                  </th>
                ) : (
                  <td
                    class={`px-4 py-4 align-middle text-ink-950 tabular-nums ${isTotal ? "font-bold" : strongCols.includes(ci) ? "font-medium" : ""}`}
                  >
                    {cell}
                  </td>
                ),
              )}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
