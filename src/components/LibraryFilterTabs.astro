---
// ライブラリページ・カテゴリページ共通の「すべて / ブログ記事 / 無料資料・eBook」絞り込みタブ。
// hrefsを渡さない場合はライブラリページ（/library配下）のリンクになる。
// カテゴリページ等、別の場所で使う場合は hrefs で行き先を上書きする。
interface Props {
  active: "all" | "post" | "resource";
  counts: { all: number; post: number; resource: number };
  hrefs?: { all: string; post: string; resource: string };
}

const { active, counts, hrefs } = Astro.props;

const defaultHrefs = { all: "/library", post: "/library/blog", resource: "/library/resources" };
const resolvedHrefs = hrefs || defaultHrefs;

const tabs = [
  { key: "all" as const, label: "すべて", href: resolvedHrefs.all },
  { key: "post" as const, label: "ブログ記事", href: resolvedHrefs.post },
  { key: "resource" as const, label: "無料資料・eBook", href: resolvedHrefs.resource },
];
---

<div class="flex flex-wrap gap-2">
  {
    tabs.map((tab) => (
      <a href={tab.href}
        class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold ${
          active === tab.key ? "bg-ink-950 text-white" : "bg-neutral-100 text-neutral-600 hover:bg-neutral-200"
        }`}
      >
        {tab.label}
        <span class={`rounded-full px-1.5 py-0.5 text-xs ${active === tab.key ? "bg-white/20" : "bg-white text-neutral-500"}`}>
          {counts[tab.key]}
        </span>
      </a>
    ))
  }
</div>
