---
// ブログ記事の末尾に表示する「無料ツール」CTA。ツールDBの内容から自動で組み立てる。
// 記事DBの「CTAツール」リレーションに値がある記事でのみ、PostLayout.astro から呼ばれる。
// 資料CTA（ResourceCta）と並べて表示するときは compact を指定する（縦積みの2カラム用レイアウト）。
import type { Tool } from "@/lib/types";
import { DEFAULT_TOOL_ICON } from "@/lib/tools";

interface Props {
  tool: Tool;
  compact?: boolean;
}

const { tool, compact = false } = Astro.props;
const icon = tool.icon || DEFAULT_TOOL_ICON;
---

<aside
  class={`${compact ? "flex h-full flex-col" : "mt-12"} rounded-2xl border border-brand-200 bg-white p-6 sm:p-8`}
  aria-label="無料ツール"
>
  <p class="text-xs font-bold tracking-wide text-brand-700">無料で使えるツール</p>
  <div class="mt-4 flex flex-1 flex-col">
    <div class="flex items-center gap-3">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-100">
        <img src={icon} alt="" class="h-6 w-6" />
      </span>
      <div class="flex flex-wrap items-center gap-2">
        {tool.tag && <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tool.tag}</span>}
        {tool.duration && <span class="text-xs text-neutral-400">🕐 {tool.duration}</span>}
      </div>
    </div>
    <h2 class="mt-4 text-xl font-extrabold leading-snug tracking-tight text-ink-950">
      <a href={tool.href} class="text-ink-950 no-underline hover:text-brand-700">{tool.title}</a>
    </h2>
    {
      tool.description && (
        <p class="mt-3 line-clamp-4 whitespace-pre-line text-sm leading-relaxed text-neutral-600">{tool.description}</p>
      )
    }
    <div class="mt-auto pt-5">
      <a href={tool.href} class="inline-block rounded-full bg-brand-600 px-8 py-3 text-sm font-bold text-white no-underline hover:bg-brand-700">
        {tool.ctaLabel}
      </a>
    </div>
  </div>
</aside>
