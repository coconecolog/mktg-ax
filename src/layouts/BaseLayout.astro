---
import SEO from "@/components/SEO.astro";
import Analytics from "@/components/Analytics.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { GTM_ID } from "@/consts";
import { buildToolSchema } from "@/lib/schema";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
   jsonLd?: object | object[];
  // 正規URLを別ページに寄せたいときのサイト内パス（SEO.astroのcanonicalPathへそのまま渡す）
  canonicalPath?: string;
  // true にすると、このページをサイト内検索（Pagefind）の索引対象から除外する。
  // タグ一覧・カテゴリ一覧のように記事本文を含まない一覧ページ向け。
  // 検索エンジン向けのnoindexとは別物（そちらはSEO.astro側でmeta robotsを制御）。
  pagefindIgnore?: boolean;
  // OGPの種類と記事の日付（SEO.astroへそのまま渡す）。未指定ならSEO.astroがURLから決める。
  ogType?: "website" | "article" | "profile";
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, ogImage, noindex, jsonLd, pagefindIgnore, canonicalPath, ogType, publishedTime, modifiedTime } =
  Astro.props;

// /tools/xxx（ツール本体ページ。一覧の /tools は除く）には、各ページを個別に編集しなくても
// 自動でWebApplication（無料の診断・シミュレーションツール）の構造化データを付ける。
const toolPath = Astro.url.pathname.replace(/\/index(\.html)?$/, "").replace(/\.html$/, "").replace(/\/+$/, "");
const toolSchema = /^\/tools\/[^/]+$/.test(toolPath)
  ? buildToolSchema({
      name: title.replace(/\s*[|｜]\s*(MeerKitLab|MKTG\.AX)\s*$/, ""),
      description,
      path: toolPath,
    })
  : null;
const mergedJsonLd = toolSchema ? [...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []), toolSchema] : jsonLd;
---

<!doctype html>
<html lang="ja">
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={mergedJsonLd}
      canonicalPath={canonicalPath}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <Header />
   <main class="flex-1" data-pagefind-body={pagefindIgnore ? undefined : true} data-pagefind-ignore={pagefindIgnore ? "all" : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
