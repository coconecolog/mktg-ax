---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import SideNav from "@/components/SideNav.astro";
import ContactCta from "@/components/ContactCta.astro";
import ResourceCta from "@/components/ResourceCta.astro";
import ToolCta from "@/components/ToolCta.astro";
import { getResourceById } from "@/lib/resources";
import { getSideKits, getToolById } from "@/lib/tools";
import { buildArticleSchema, buildFaqSchema } from "@/lib/schema";
import { buildToc, getAllPosts, getAuthorByName, getCategoryPath, getTagPath } from "@/lib/posts";
import { getLibraryItemsByCategory } from "@/lib/library";
import { autoLinkTagKeywords } from "@/lib/tagKeywordLinks";
import type { Post } from "@/lib/types";
import { toRouteSlug } from "@/lib/routeSlug";
import { DEFAULT_OG_IMAGE } from "@/consts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const toc = buildToc(post.blocks);
// OGP画像：サムネイルと同じ絵柄のPNG（fetch-notion で作成）。無ければ自動生成のOGP画像
const ogImage = post.ogImage || `/open-graph/blog/${post.slug}.png`;
const ogImageSize = post.ogImage ? { width: 1200, height: 675 } : { width: 1200, height: 630 };
const articleSchema = buildArticleSchema(post, ogImage);
const faqSchema = buildFaqSchema(post.blocks);
// 本文中のタグ名（サイト内の全タグ）を、タグごとに最初の1箇所だけタグページへのリンクにする（src/lib/tagKeywordLinks.ts）。
const bodyBlocks = autoLinkTagKeywords(post.blocks);

const author = post.author ? getAuthorByName(post.author) : undefined;

// 記事DBの「CTA資料」に値がある記事だけ、資料DLのCTAを出す。値が無い、または資料が非公開で
// 資料キャッシュに存在しない場合は undefined になり、CTAは表示されない。
const ctaResource = post.ctaResourceId ? getResourceById(post.ctaResourceId) : undefined;
// 記事DBの「CTAツール」に値がある記事だけ、ツールCTAを出す（資料CTAの下に縦に並べて表示）。
const ctaTool = post.ctaToolId ? getToolById(post.ctaToolId) : undefined;
if (post.ctaToolId && !ctaTool) {
  console.warn(
    `[PostLayout] 「${post.title}」の「CTAツール」に指定されたツールが見つかりません（ツールDBで「公開」がOFF、またはSlugに対応するページが無いためスキップされた可能性があります）。`,
  );
}

// 右カラムの「関連するKit」（CTAツールがKitならそれ、なければカテゴリで決める）
const sideKits = getSideKits(post.category, ctaTool?.href);

// 同じカテゴリの他記事（自分自身を除く、最大2件）。ブログ記事ページのみで表示するため PostLayout.astro 側に置く。
// 共通するタグが多い記事を先に出す（同じ数なら新しい順）。関係の近い記事へ内部リンクを集めるため。
const postTagSet = new Set(post.tags || []);
const tagsBySlug = new Map(getAllPosts().map((p) => [p.slug, p.tags || []]));
const relatedItems = post.category
  ? getLibraryItemsByCategory(post.category, "post")
      .filter((item) => item.slug !== post.slug)
      .map((item, index) => ({
        item,
        index,
        score: (tagsBySlug.get(item.slug) || []).filter((tag) => postTagSet.has(tag)).length,
      }))
      .sort((a, b) => b.score - a.score || a.index - b.index)
      .slice(0, 2)
      .map(({ item }) => item)
  : [];

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Lab（記事・資料）", href: "/lab" },
  // カテゴリがある記事はカテゴリを挟む（サイトの階層を検索エンジンに伝える）
  ...(post.category ? [{ name: post.category, href: getCategoryPath(post.category) }] : []),
  { name: post.title, href: `/lab/blog/${post.slug}` },
];


const dateLabel = (iso: string) =>
  new Date(iso).toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogImage={ogImage}
  ogImageWidth={ogImageSize.width}
  ogImageHeight={ogImageSize.height}
  jsonLd={faqSchema ? [articleSchema, faqSchema] : articleSchema}
  ogType="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt}
>
  <Breadcrumb items={breadcrumbItems} />

  <article class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <header>
          {
            (post.categories.length > 0 || post.tags.length > 0) && (
              <div class="mb-4 flex flex-wrap items-center gap-1.5">
                {post.categories.map((cat) => (
                  <a href={getCategoryPath(cat)}
                    class="rounded border border-brand-300 px-2.5 py-0.5 text-xs font-medium text-brand-700 no-underline hover:bg-brand-50"
                  >
                    {cat}
                  </a>
                ))}
                {post.tags.map((tag) => (
                  <a href={getTagPath(tag)}
                    class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 no-underline hover:bg-brand-100"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-ink-950 md:text-4xl">
            {post.title}
          </h1>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            {
              author && (
                <a href={`/authors/${encodeURIComponent(toRouteSlug(author.name))}`} class="flex items-center gap-2.5 no-underline">
                  {author.image && (
                    <img src={author.image} alt={author.name} class="aspect-square h-10 w-10 shrink-0 rounded-full object-cover" />
                  )}
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-bold text-ink-950">{author.name}</span>
                    {author.title && (
                      <span class="rounded-full bg-white px-2.5 py-0.5 text-xs font-bold text-brand-700 shadow-sm">
                        {author.title}
                      </span>
                    )}
                  </span>
                </a>
              )
            }
            <p class="ml-auto text-sm text-neutral-400">
              公開日: <time datetime={post.publishedAt}>{dateLabel(post.publishedAt)}</time>
              {post.updatedAt !== post.publishedAt && (
                <>
                  {" "}／ 更新日: <time datetime={post.updatedAt}>{dateLabel(post.updatedAt)}</time>
                </>
              )}
            </p>
          </div>
        </header>

        {
          post.keyPoints.length > 0 && (
            <div class="mt-6 border border-neutral-200 bg-white px-5 py-4">
              <p class="text-sm font-bold text-ink-950">👉 この記事でわかること</p>
              <ul class="mt-2 space-y-1">
                {post.keyPoints.map((point) => (
                  <li class="text-sm text-neutral-600">•{point}</li>
                ))}
              </ul>
            </div>
          )
        }

{
  post.thumbnail && (
    <div class="mt-8 aspect-video w-full overflow-hidden border border-neutral-300 bg-neutral-100">
      <img src={post.thumbnail} alt={post.title} class="h-full w-full object-cover" />
    </div>
  )
}

        {/* 目次は右カラムに表示。右カラムが記事の下に回るスマホ・タブレットだけ、ここに折りたたみで出す */}
        {
          toc.length > 0 && (
            <details class="mt-8 border border-neutral-200 bg-white open:pb-2 lg:hidden">
              <summary class="cursor-pointer px-5 py-4 text-sm font-bold text-ink-950">目次</summary>
              <div class="px-5 pb-4">
                <TableOfContents items={toc} showHeading={false} wrapped={false} />
              </div>
            </details>
          )
        }

        <div class="prose-notion mt-10 w-full">
          <NotionBlocks blocks={bodyBlocks} />
        </div>

        {ctaResource && <ResourceCta resource={ctaResource} kits={sideKits} />}

        {ctaTool && <ToolCta tool={ctaTool} attached={!!ctaResource} />}

        {/* 執筆者（2026-11-01：枠付きカードをやめ、上下の細線だけの1行に。記事上部の執筆者名・構造化データと合わせてEEATを担保） */}
        {
          author && (
            <a href={`/authors/${encodeURIComponent(toRouteSlug(author.name))}`} class="group mt-12 flex items-center gap-3 border-y border-neutral-300 py-3 no-underline">
              {author.image && (
                <img src={author.image} alt={author.name} class="aspect-square h-9 w-9 shrink-0 rounded-full object-cover" loading="lazy" />
              )}
              <span class="min-w-0 flex-1 text-sm leading-relaxed">
                <span class="text-neutral-500">執筆者</span>
                <span class="ml-3 font-bold text-ink-950">{author.name}</span>
                {author.expertise && <span class="ml-3 hidden text-neutral-500 sm:inline">{author.expertise.split("\n")[0]}</span>}
              </span>
              <span class="shrink-0 text-sm font-bold text-ink-950 group-hover:underline">
                プロフィール<span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          )
        }

        {/* 関連記事（2026-11-01：カテゴリページの「まずはこの記事から」と同じ横長の行に） */}
        {
          relatedItems.length > 0 && (
            <div class="mt-12">
              <h2 class="text-xl font-extrabold tracking-tight text-ink-950">{post.category}の記事</h2>
              <ul class="mt-4 border-t border-neutral-300">
                {relatedItems.map((item) => (
                  <li class="border-b border-neutral-300">
                    <a href={item.href} class="group flex flex-col items-start gap-4 py-6 no-underline sm:flex-row sm:gap-5">
                      <span class="block aspect-video w-full shrink-0 overflow-hidden bg-neutral-100 sm:w-60">
                        <img src={item.thumbnail || DEFAULT_OG_IMAGE} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-2">
                          <span class="inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">記事</span>
                          <span class="text-xs text-neutral-500">{post.category}</span>
                        </span>
                        <span class="mt-3 block text-lg font-bold leading-relaxed text-ink-950 group-hover:underline">{item.title}</span>
                        {item.description && <span class="mt-2 line-clamp-2 text-sm text-neutral-500">{item.description}</span>}
                      </span>
                      <span aria-hidden="true" class="mt-8 hidden shrink-0 text-lg text-ink-950 transition-transform group-hover:translate-x-1 sm:block">→</span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-6 text-center">
                <a href="/lab" class="text-sm font-bold text-ink-950 hover:underline">
                  Lab（記事・資料）一覧へ →
                </a>
              </p>
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        {/* 右カラム（タグページと共通。目次 → 関連する資料 → 関連するKit）。2026-10-15にタグ一覧を削除 */}
        <SideNav toc={toc.map((h2) => ({ anchor: h2.anchor, text: h2.text }))} resource={ctaResource} kits={sideKits} />
      </aside>
    </div>
  </article>

  <ContactCta />
</BaseLayout>
