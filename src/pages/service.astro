---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContactCta from "@/components/ContactCta.astro";
import { SITE_NAME, TOOLS_NAV_ITEMS } from "@/consts";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "サービスについて", href: "/service" },
];

// 「型ファーストで、迷いをなくす。」の3ステップ
const flowSteps = [
  { icon: "💬", label: "現場の悩み" },
  { icon: "📋", label: "型（テンプレート）" },
  { icon: "🔍", label: "AIにも届く情報（AEO）" },
];

// 「MKTG.AXが大切にしていること」
const values = [
  {
    title: "型とツールがあるから、明日からすぐ動ける",
    description: "単なる情報提供に終わらせず、実務でそのまま活用できるテンプレートやWebツールを直接提供します。",
  },
  {
    title: "上層部の説得から現場の実務までカバー",
    description: "単なる手法論だけでなく、予算獲得や役員報告に必要な説得ロジックはもちろん、日々の運用も重視します。",
  },
  {
    title: "限られた人・予算で成果を出す現場主義",
    description: "大手企業前提の理想論ではなく、少人数・限られた予算でも現実的に回せる再現性の高いノウハウにこだわります。",
  },
  {
    title: "マーケティングを組織に定着させる体制・評価支援",
    description: "営業など他部署とのスムーズな連携づくりや社内での評価獲得など、担当者が孤立せず組織を動かすための視点も大切にしています。",
  },
];

// 「運営について」。氏名は未定のため役割名の仮表記。確定次第このファイルを直接更新してください。
const members = [
  {
    role: "主な経験分野：大手企業のデータ分析から中小企業DXまで幅広く牽引",
    tag: "MKTG.AX",
    description: "マーケティングコンサルタントとして、専門分野はデジタルマーケティング領域を中心に担当。中小企業向けのマーケティングDXコンサルティングほか、大手電力会社・郵便会社などのデータ分析業務を中心に業務に携わりつつ、宣伝会議などでセミナー講師なども行う。",
  },
  {
    role: "主な経験分野：デジタルマーケティング立ち上げ・運用設計責任者",
    tag: "coconeco",
    description: "メーカーのWeb責任者や、Webプログラマーや Webプロデューサーを経て、スタートアップや大手代理店子会社にてマーケティング立ち上げの現場責任者を歴任。予算管理やチームビルディング、ツールの導入・運用設計まで、主導してきた実践者。",
  },
];
---

<BaseLayout
  title="サービスについて"
  description={`${SITE_NAME}が提供する、中小企業向けマーケティング支援サービスのご案内です。`}
  ogImage="/open-graph/service.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-5xl px-5 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">サービスについて</h1>
    <p class="mt-4 text-xl font-bold text-ink-950">中小企業に、明日から使える「型」を。</p>
    <p class="mt-4 max-w-2xl leading-relaxed text-neutral-600">
      {SITE_NAME}は、従業員50〜300名規模の中小企業の経営層・マーケティング責任者に向けて、明日から実行できるテンプレートと実践知を届けるメディア&実行支援サービスです。限られた人・予算の中でも、現実的に成果につながる一歩にこだわっています。
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/library" class="rounded-full bg-brand-600 px-6 py-3 text-sm font-bold text-white hover:bg-brand-700">
        ライブラリを見る
      </a>
      <a href="/tools" class="rounded-full border border-neutral-200 px-6 py-3 text-sm font-bold text-ink-950 hover:border-brand-300">
        便利ツールを見る
      </a>
    </div>
  </section>

  <section class="border-t border-neutral-100 bg-neutral-50 py-16">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-ink-950">型ファーストで、迷いをなくす。</h2>
      <p class="mt-3 max-w-2xl text-neutral-500">
        {SITE_NAME}の記事とホワイトペーパーは、読んで終わりにしません。現場でそのまま使えるテンプレートとセットでお届けします。
      </p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        {
          flowSteps.map((step, i) => (
            <>
              <div class="flex w-full flex-col items-center gap-2 rounded-2xl border border-neutral-100 bg-white px-6 py-5 sm:w-48">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-lg">{step.icon}</span>
                <span class="text-sm font-bold text-ink-950">{step.label}</span>
              </div>
              {i < flowSteps.length - 1 && <span class="text-xl text-neutral-300">→</span>}
            </>
          ))
        }
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-neutral-500">
        「読むだけ」で終わらないコンテンツと、AIの検索にも届く情報設計（AEO）。この2つを軸に、記事とテンプレートを作っています。
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-5xl px-5">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-ink-950">便利ツール</h2>
        <a href="/tools" class="text-sm font-medium text-brand-700 hover:underline">
          便利ツールを見る →
        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          TOOLS_NAV_ITEMS.map((tool, i) => (
            <a href={tool.href} class="block rounded-2xl border border-neutral-100 bg-white p-6 transition-shadow hover:shadow-lg">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-brand-200 bg-brand-50 text-xs font-bold text-brand-700">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-4 font-bold text-ink-950">{tool.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-500">{tool.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-100 bg-neutral-50 py-16">
    <div class="mx-auto max-w-5xl px-5">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-ink-950">ブログ</h2>
        <a href="/library/blog" class="text-sm font-medium text-brand-700 hover:underline">
          記事一覧を見る →
        </a>
      </div>
      <div class="mt-6 flex flex-col items-start justify-between gap-4 rounded-2xl border border-neutral-100 bg-white p-6 sm:flex-row sm:items-center">
        <p class="text-sm leading-relaxed text-neutral-500">
          マーケティングの実践ノウハウや最新情報を、現場で使える形に落とし込んで発信しています。
        </p>
        <a href="/library/blog" class="shrink-0 rounded-full bg-brand-600 px-6 py-2.5 text-sm font-bold text-white hover:bg-brand-700">
          記事を読む
        </a>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-5xl px-5">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-ink-950">資料（ホワイトペーパー）</h2>
        <a href="/library/resources" class="text-sm font-medium text-brand-700 hover:underline">
          資料一覧を見る →
        </a>
      </div>
      <div class="mt-6 flex flex-col items-start justify-between gap-4 rounded-2xl border border-neutral-100 bg-white p-6 sm:flex-row sm:items-center">
        <p class="text-sm leading-relaxed text-neutral-500">
          リード獲得の進め方や組織体制づくりなど、現場でそのまま使えるテンプレート付きの資料を無料でダウンロードいただけます。
        </p>
        <a href="/library/resources" class="shrink-0 rounded-full bg-brand-600 px-6 py-2.5 text-sm font-bold text-white hover:bg-brand-700">
          資料をダウンロードする
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-100 bg-neutral-50 py-16">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-ink-950">MKTG.AXが大切にしていること</h2>
      <div class="mt-8 divide-y divide-neutral-200 border-t border-neutral-200">
        {
          values.map((value, i) => (
            <div class="flex gap-5 py-6">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-brand-200 bg-white text-xs font-bold text-brand-700">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-bold text-ink-950">{value.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">{value.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-2xl font-bold tracking-tight text-ink-950">運営について</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          members.map((member) => (
            <div class="flex gap-4 rounded-2xl border border-neutral-100 p-6">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xl">👤</span>
              <div>
                <h3 class="font-bold text-ink-950">{member.role}</h3>
                <span class="mt-1 inline-block rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
                  {member.tag}
                </span>
                <p class="mt-2 text-sm leading-relaxed text-neutral-500">{member.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-2xl border border-neutral-100 bg-brand-50 p-8 sm:flex-row sm:items-center">
        <div>
          <h3 class="font-bold text-ink-950">ホワイトペーパー掲載にご興味のある企業様へ</h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600">
            {SITE_NAME}では、中小企業の課題解決に役立つ資料の掲載企業様を募集しています。掲載は成果報酬型、初期費用はかかりません。
          </p>
        </div>
        <a href="/contact" class="shrink-0 rounded-full border border-brand-300 bg-white px-6 py-3 text-sm font-bold text-brand-700 hover:border-brand-400">
          掲載についてお問い合わせ
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
