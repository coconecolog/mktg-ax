---
// src/pages/tools/budget-checker.astro
//
// 予算案チェッカー（/tools/budget-checker）
// 仕様: Googleドライブ「MKTG.AX／共有（正本）／04_ツール仕様／予算案チェッカーの仕様（budget-checker-tool-spec）」（2026-10-17）
// 数字の定義: 同「数字の定義（KPI・予算）」。計算は src/lib/budget-calc.ts（予算シミュレーターと共通）
// - 生成AIで作った来期の予算案を、人件費込みで判定する。計算はすべてブラウザ内。入力した数字はブラウザの外に送らない
// - 金額は万円（時間単価だけ円）。費用＝外部費用＋人件費。人件費は総額をチャネルの時間の比で配る（最大剰余法）
// - 入力の途中の値は localStorage に保存する（消えても動く）
// - 記入例（テスト1）は架空の会社（基本モデル）の成長期
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import { metricUrl } from "@/lib/budget-calc";
import type { MetricKey } from "@/lib/budget-calc";

const def = (key: MetricKey) => metricUrl(key);

// 入力B：フォーマット化用のプロンプト（仕様 7.1）
const AI_PROMPT = `あなたは、マーケティング予算案の数字を決まった形に書き直すアシスタントです。

このチャットで作った来期のマーケティング予算案（この上の会話、または下に貼る予算案）を、次のJSONの形に変換してください。

ルール
- 予算案に書かれている数字だけを使う。書かれていない数字は null にする。推測で埋めない
- 金額の単位は万円（時間単価だけ円）。月額で書かれている費用は12倍して年額にし、notes にその旨を書く
- 予備費・バッファ・調整枠は channels に入れず、excluded に入れる
- ツール費・保守費など、リードを生まない費用は、それを使うチャネルの external_cost に足し、notes に書く
- 人件費が書かれていなければ labor は空の配列にする
- 出力はJSONのコードブロック1つだけ。説明の文は書かない

{
  "format": "mktgax-budget-v1",
  "gross_margin_pct": 粗利率（%）,
  "payback_years": 取り返す年数（年）,
  "actual_deal_rate_pct": 今期の実績の商談化率（%）,
  "actual_win_rate_pct": 今期の実績の受注率（%）,
  "labor": [
    { "role": "役割", "hours": 年間の時間, "hourly_yen": 時間単価（円）, "amount_man": 人件費（万円） }
  ],
  "sales_support_included": 営業が施策に協力する時間を人件費に含めたか（true/false/null）,
  "channels": [
    { "name": "チャネル名", "external_cost": 外部費用（万円・年額）, "hours": マーケがかける時間（時間／年）, "leads": リード数, "deals": 商談数, "wins": 受注数, "unit_price": 受注単価（万円） }
  ],
  "excluded": [
    { "item": "除いた項目", "amount": 金額（万円）, "reason": "理由" }
  ],
  "notes": ["変換で行ったこと"]
}`;
---

<BaseLayout
  title="予算案チェッカー｜AIで作った予算案を人件費込みで判定｜MKTG.AX"
  description="生成AIで作った来期のマーケティング予算案を、人件費込みのCPL・CAC・回収期間・ROI（1年）で判定し、AIの案で抜けやすいところを指摘する無料ツールです。結果は経営向けのA4・1枚で出せます。"
  ogImage="/open-graph/default.png"
>
  <main class="bc">
    <header class="bc-head no-print">
      <p class="bc-eyebrow"><a href="/tools">便利ツール</a></p>
      <h1>予算案チェッカー</h1>
      <p class="bc-lead">生成AIで作った来期のマーケティング予算案を、人件費込みのCPL・CAC・回収期間・ROI（1年）で判定し、AIの案で抜けやすいところを指摘します。結果は回収期間を主役にした経営向けの1枚（A4）で出せます（金額は万円）。</p>
      <p class="bc-why">AIの案は人件費が抜けがちです。架空の会社（基本モデル）の例では、人件費を入れるとCACが76→107万円、回収期間が9.1→12.8か月に変わります。</p>
    </header>

    <div class="bc-grid">
      <!-- ===== STEP1 入力 ===== -->
      <div class="bc-in no-print">
        <p class="bc-step"><span>STEP1</span>予算案の数字を入れる</p>
        <div class="bc-tools">
          <button type="button" class="bc-link" id="bc-example">記入例を入れる</button>
          <button type="button" class="bc-link" id="bc-clear">入力をすべて消す</button>
        </div>
        <p class="bc-note bc-note-r">記入例は架空の会社（基本モデル）の成長期の数字です</p>

        <!-- 入力B：AIの案を読み込む -->
        <div class="bc-ai">
          <button type="button" class="bc-ai-toggle" id="bc-ai-toggle" aria-expanded="false" aria-controls="bc-ai-panel">
            <span><b>AIの案を読み込む</b>AIに決まった形へ変換させて貼りつけると、下の欄に数字が入ります</span>
            <span class="bc-ai-mark" aria-hidden="true">＋</span>
          </button>
          <div class="bc-ai-panel" id="bc-ai-panel" hidden>
            <p class="bc-ai-st">1. このプロンプトをコピーして、予算案を作ったAIのチャットに貼る</p>
            <pre class="bc-prompt" id="bc-prompt" set:text={AI_PROMPT}></pre>
            <button type="button" class="bc-obtn bc-w" id="bc-copy">プロンプトをコピー</button>
            <p class="bc-ai-st">2. AIが返した結果を貼りつけて読み込む</p>
            <textarea class="bc-paste" id="bc-paste" rows="6" placeholder="AIが返したJSON（```json から ``` まで）をそのまま貼りつけます" aria-label="AIが返した結果"></textarea>
            <button type="button" class="bc-btn bc-btn-s" id="bc-import">読み込む</button>
            <p class="bc-msg" id="bc-ai-msg" role="status" hidden></p>
            <p class="bc-note">読み込んだ内容はブラウザの外に送りません。読み込んだあとは、下の欄で目で見て直せます。予算案に書かれていなかった欄は黄色で示します</p>
          </div>
        </div>

        <div class="bc-imp" id="bc-imp" hidden>
          <p class="bc-imp-h">読み込み結果<button type="button" class="bc-del" id="bc-imp-close" aria-label="読み込み結果を閉じる">×</button></p>
          <div id="bc-imp-body"></div>
        </div>

        <section class="bc-sec">
          <h2 class="bc-st">1. 前提</h2>
          <div class="bc-f">
            <label class="bc-field"><span class="bc-lb">粗利率</span><span class="bc-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.1" data-k="margin" /><span>%</span></span></label>
            <label class="bc-field"><span class="bc-lb">取り返す年数</span><span class="bc-ip"><input type="number" inputmode="decimal" min="0" step="0.1" data-k="years" /><span>年</span></span></label>
            <label class="bc-field"><span class="bc-lb">今期の実績の商談化率<small>任意</small></span><span class="bc-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.1" data-k="actDeal" /><span>%</span></span></label>
            <label class="bc-field"><span class="bc-lb">今期の実績の受注率<small>任意</small></span><span class="bc-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.1" data-k="actWin" /><span>%</span></span></label>
          </div>
          <p class="bc-note">取り返す年数は、獲得の費用を何年で取り返すかを自社で決める値です（小数可）。受注率は、決着した商談（受注＋失注）だけで出した率を入れます。今期の実績を入れると、許容CPLと率のチェックに使います</p>
        </section>

        <section class="bc-sec">
          <h2 class="bc-st">2. チャネル<small>年額・最大10行</small></h2>
          <div id="bc-rows"></div>
          <button type="button" class="bc-add" id="bc-add">＋ チャネルを追加</button>
          <p class="bc-note">外部費用は年額。ツール費・保守費など、リードを生まない費用も、使うチャネルに入れます。時間は、マーケがこのチャネルの施策にかける時間（年間）。集計・報告、営業との連携、予算づくりなど共通の作業は入れません。受注単価は1社あたりの年間の取引額です</p>
        </section>

        <section class="bc-sec">
          <h2 class="bc-st">3. 人件費<small>1行＝1人またはグループ</small></h2>
          <div id="bc-labor"></div>
          <button type="button" class="bc-add" id="bc-labor-add">＋ 行を追加</button>
          <label class="bc-check" id="bc-sales-wrap"><input type="checkbox" id="bc-sales" />営業が施策に協力する時間（展示会の立ち会い、事例の取材、登壇など）を含めた</label>
          <p class="bc-note">人件費（万円）＝時間×時間単価÷10,000。時間がわからないときは人件費を直接入れます。時間には、施策の時間と共通の作業の時間をすべて含めます。チャネルごとの人件費は、この総額をチャネルの時間の比で配ります</p>
        </section>
      </div>

      <!-- ===== STEP2 判定／STEP3 経営向けの1枚 ===== -->
      <div class="bc-out">
        <div class="bc-bar no-print">
          <p class="bc-step"><span>STEP2</span>判定（入力を変えるたびに計算し直します）</p>
          <button type="button" class="bc-obtn" id="bc-print">STEP3 経営向けの1枚を印刷／PDF</button>
        </div>

        <div class="bc-rp" id="bc-report">
          <div class="bc-rh">
            <div>
              <h2 class="bc-rt">来期マーケティング予算案の判定</h2>
              <p class="bc-rs" id="r-sub">人件費込み・金額は万円</p>
            </div>
            <p class="bc-rs" id="r-date"></p>
          </div>

          <p class="bc-empty" id="r-empty" hidden></p>

          <div id="r-body" hidden>
            <p class="bc-concl" id="r-concl"></p>

            <div class="bc-dark">
              <div class="bc-k">
                <div class="bc-k-main"><p class="bc-kl">回収期間<a class="bc-def no-print" href={def("payback")}>定義</a></p><p class="bc-kv bc-big"><span id="r-payback"></span><small>か月</small></p><p class="bc-ks" id="r-payback-s"></p></div>
                <div><p class="bc-kl">CAC<a class="bc-def no-print" href={def("cac")}>定義</a></p><p class="bc-kv"><span id="r-cac"></span><small>万円</small></p><p class="bc-ks" id="r-cac-s"></p></div>
                <div><p class="bc-kl">ROI（1年）<a class="bc-def no-print" href={def("roi")}>定義</a></p><p class="bc-kv"><span id="r-roi"></span></p><p class="bc-ks">（受注金額×粗利率−費用）÷費用</p></div>
                <div><p class="bc-kl">受注</p><p class="bc-kv"><span id="r-wins"></span><small>件</small></p><p class="bc-ks" id="r-wins-s"></p></div>
              </div>
            </div>

            <div class="bc-row2">
              <div class="bc-box">
                <p class="bc-h"><span>費用<a class="bc-def no-print" href={def("laborCost")}>定義</a></span><small>万円</small></p>
                <table class="bc-t">
                  <tbody id="r-cost"></tbody>
                </table>
              </div>
              <div class="bc-box">
                <p class="bc-h"><span>上限</span><small id="r-rate-src"></small></p>
                <table class="bc-t">
                  <tbody>
                    <tr><td class="n">CACの上限<a class="bc-def no-print" href={def("cacLimit")}>定義</a></td><td><span id="r-limit"></span> 万円</td></tr>
                    <tr><td class="n">許容CPL<a class="bc-def no-print" href={def("allowableCpl")}>定義</a></td><td><span id="r-acpl"></span> 万円</td></tr>
                  </tbody>
                </table>
                <p class="bc-fx" id="r-limit-s"></p>
              </div>
            </div>

            <div class="bc-box bc-mt">
              <p class="bc-h"><span>チャネル別<a class="bc-def no-print" href={def("cpl")}>CPL</a><a class="bc-def no-print" href={def("judgment")}>判定</a></span><small>費用合計＝外部費用＋人件費（万円）</small></p>
              <div class="bc-tw">
                <table class="bc-t">
                  <thead><tr><th>チャネル</th><th>費用合計</th><th>リード</th><th>受注</th><th>CPL</th><th>CAC</th><th>回収期間</th><th>ROI（1年）</th><th class="c">判定</th></tr></thead>
                  <tbody id="r-ch"></tbody>
                </table>
              </div>
              <p class="bc-fx" id="r-ch-s"></p>
            </div>

            <div class="bc-box bc-mt bc-warn" id="r-warn-box" hidden>
              <p class="bc-h"><span>要確認</span><small>AIの案で抜けやすいところ</small></p>
              <ul id="r-warn"></ul>
            </div>

            <div class="bc-box bc-mt bc-say">
              <p class="bc-h"><span>経営陣に説明するときの一文<a class="bc-def no-print" href={def("explain")}>定義</a></span></p>
              <p id="r-say"></p>
            </div>

            <div class="bc-pre">
              <p><b>前提</b><span id="r-pre"></span></p>
              <p class="bc-src">指標の定義は「数字の定義（KPI・予算）」による：mktg.ax/standards/metrics（#cpl #cac #payback #roi #cac-limit #allowable-cpl #judgment）</p>
            </div>
          </div>
        </div>

        <a class="bc-next no-print" href="/blog/category/budget-roi">
          <span><b>本格的な予算づくりは、年間計画シート（KPIと予算）で</b>施策×月の計画、止める基準、3つのシナリオまで、自社の数字で作れます</span>
          <span aria-hidden="true">資料を見る →</span>
        </a>
        <a class="bc-next bc-next-s no-print" href="/tools/budget-simulator">
          <span><b>目標から逆算して予算を作るなら</b>来期の売上目標から受注・商談・リード数と予算を逆算します</span>
          <span aria-hidden="true">予算シミュレーター →</span>
        </a>
      </div>
    </div>
  </main>

  <ToolFooter path="/tools/budget-checker" />
</BaseLayout>

<style is:global>
  .bc { max-width: 1240px; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: #0b0b12; font-variant-numeric: tabular-nums; }
  .bc p { margin: 0; }
  .bc-eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; color: #737373; }
  .bc-eyebrow a { color: inherit; text-decoration: none; }
  .bc-eyebrow a:hover { text-decoration: underline; }
  .bc-head h1 { margin: 0.25rem 0 0.4rem; font-size: 1.7rem; font-weight: 800; line-height: 1.35; }
  .bc-lead { color: #525252; line-height: 1.7; }
  .bc-why { font-size: 0.82rem; color: #0b0b12; background: #f6f6f6; border-left: 3px solid #0b0b12; border-radius: 0 6px 6px 0; padding: 8px 12px; margin: 10px 0 1.25rem !important; line-height: 1.7; }

  .bc-grid { display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: 24px; align-items: start; }
  .bc-step { font-size: 0.8rem; font-weight: 800; display: flex; align-items: center; gap: 8px; }
  .bc-step span { background: #0b0b12; color: #fff; border-radius: 4px; padding: 1px 7px; font-size: 0.68rem; letter-spacing: 0.04em; }

  /* ===== 入力 ===== */
  .bc-in { border: 1px solid #e5e5e5; border-radius: 12px; padding: 14px 16px 16px; background: #fff; min-width: 0; }
  .bc-tools { display: flex; justify-content: flex-end; gap: 12px; margin-top: 8px; }
  .bc-link { background: none; border: 0; padding: 0; font-size: 0.75rem; color: #525252; text-decoration: underline; cursor: pointer; }
  .bc-link[data-armed="1"] { color: #b91c1c; font-weight: 700; }
  .bc-note-r { text-align: right; margin-top: 2px !important; }
  .bc-sec { border-bottom: 1px solid #ececec; padding: 12px 0 14px; }
  .bc-sec:last-child { border-bottom: 0; padding-bottom: 0; }
  .bc-st { font-size: 0.8rem; font-weight: 800; margin: 0 0 8px; }
  .bc-st small { font-weight: 400; color: #8a8a8a; margin-left: 6px; font-size: 0.7rem; }
  .bc-f { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .bc-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .bc-lb { font-size: 0.72rem; font-weight: 600; color: #404040; line-height: 1.4; }
  .bc-lb small { font-weight: 400; color: #8a8a8a; margin-left: 4px; }
  .bc-ip { display: flex; align-items: center; gap: 6px; min-width: 0; border: 1px solid #d4d4d4; border-radius: 8px; background: #fff; padding: 0 8px; }
  .bc-ip:focus-within { border-color: #0b0b12; outline: 1px solid #0b0b12; }
  .bc-ip input { flex: 1 1 0; width: 0; min-width: 0; border: 0; outline: 0; background: transparent; padding: 6px 0; font-size: 0.9rem; color: #0b0b12; }
  .bc-ip input[readonly] { color: #525252; }
  .bc-ip > span { font-size: 0.72rem; color: #737373; flex-shrink: 0; }
  .bc-note { font-size: 0.68rem; color: #8a8a8a; line-height: 1.55; margin-top: 6px !important; }
  .bc-card { border: 1px solid #e5e5e5; border-radius: 8px; padding: 8px; margin-bottom: 6px; }
  .bc-card-h { display: flex; gap: 6px; align-items: center; margin-bottom: 5px; }
  .bc-name { flex: 1; min-width: 0; border: 1px solid transparent; border-radius: 6px; padding: 2px 4px; font-size: 0.78rem; font-weight: 800; color: #0b0b12; background: transparent; }
  .bc-name:hover { border-color: #e5e5e5; }
  .bc-name:focus { border-color: #0b0b12; outline: 0; }
  .bc-g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .bc-card .bc-lb { font-size: 0.66rem; font-weight: 400; color: #737373; }
  .bc-card .bc-ip input { padding: 4px 0; font-size: 0.8rem; }
  .bc-card .bc-ip > span { font-size: 0.66rem; }
  .bc-del { border: 0; background: none; color: #8a8a8a; font-size: 0.95rem; line-height: 1; cursor: pointer; padding: 2px 4px; flex-shrink: 0; }
  .bc-del:hover { color: #b91c1c; }
  .bc-check { display: flex; gap: 6px; align-items: flex-start; font-size: 0.72rem; color: #404040; line-height: 1.5; margin-top: 8px; cursor: pointer; border-radius: 6px; padding: 2px 4px; }
  .bc-check input { margin-top: 3px; flex-shrink: 0; }
  .bc-add { width: 100%; border: 1px dashed #bfbfbf; border-radius: 8px; background: #fff; text-align: center; padding: 6px; color: #525252; font-size: 0.72rem; cursor: pointer; }
  .bc-add:hover:not(:disabled) { border-color: #0b0b12; color: #0b0b12; }
  .bc-add:disabled { opacity: 0.5; cursor: default; }
  .bc-ip.bc-invalid { border-color: #b91c1c; background: #fef2f2; outline: 1px solid #b91c1c; }
  .bc-ip.bc-null:not(.bc-invalid) { border-color: #d4a514; background: #fef9c3; }
  .bc-check.bc-null { background: #fef9c3; }

  /* 入力B */
  .bc-ai { border: 1px solid #0b0b12; border-radius: 10px; margin-top: 10px; overflow: hidden; }
  .bc-ai-toggle { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #fff; border: 0; padding: 10px 12px; text-align: left; font-size: 0.7rem; color: #525252; line-height: 1.5; cursor: pointer; }
  .bc-ai-toggle b { display: block; font-size: 0.82rem; color: #0b0b12; }
  .bc-ai-toggle:hover { background: #f6f6f6; }
  .bc-ai-mark { font-size: 1.1rem; font-weight: 700; color: #0b0b12; flex-shrink: 0; }
  .bc-ai-toggle[aria-expanded="true"] .bc-ai-mark { transform: rotate(45deg); }
  .bc-ai-panel { border-top: 1px solid #e5e5e5; padding: 10px 12px 12px; }
  .bc-ai-st { font-size: 0.72rem; font-weight: 800; margin: 4px 0 6px !important; }
  .bc-ai-st + .bc-ai-st, .bc-w + .bc-ai-st { margin-top: 12px !important; }
  .bc-prompt { max-height: 160px; overflow: auto; background: #f6f6f6; border-radius: 6px; padding: 8px 10px; font-size: 0.64rem; line-height: 1.55; white-space: pre-wrap; word-break: break-all; margin: 0 0 6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #404040; }
  .bc-paste { display: block; width: 100%; box-sizing: border-box; border: 1px solid #d4d4d4; border-radius: 8px; padding: 6px 8px; font-size: 0.72rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; resize: vertical; }
  .bc-paste:focus { outline: 1px solid #0b0b12; border-color: #0b0b12; }
