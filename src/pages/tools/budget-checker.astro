---
// src/pages/tools/budget-checker.astro
//
// 予算案診断キット（旧予算案チェッカー、/tools/budget-checker）2026-10-30 作り直し
// AIや自社で作った予算案を取りこみ、診断して直し、年間予算表（M-B-03、Excel）に仕上げる。
// - 3ステップ：入力する → 診断する（左＝入力、右＝判定。直すと判定がすぐ変わる）→ 年間予算表 完成（Excelをダウンロード）
// - 入口は3つ：AIで整えて貼りつける／年間予算表（.xlsx）を読み込む／画面で入力する。どれも同じ入力の画面に入る
// - 入力の項目は年間予算表（施策別）と同じ。ダウンロードするExcelは「年間予算表（施策別）」＋「診断結果」の2シート（PDFはなし）
// - NGが残っていてもダウンロードできる（その旨を出す）
// 判定と状態：src/lib/budgetCheck.ts　Excelの書き込み：src/lib/budget-sheet.ts　画面：src/scripts/budget-checker/app.ts
// ひな形：public/files/tools/budget-sheet-template.xlsx（scripts/build-budget-sheet-template.py で作る）
// 記入例：/tools/budget-checker?sample=1（基本モデルの安定期。年間予算表の記入例と同じ数字）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import { CHANNELS } from "@/lib/kpi-sheet-maker";
import { AI_PROMPT } from "@/lib/budgetCheck";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "予算案診断キット";
const TOOL_DESCRIPTION =
  "AIや自社で作ったマーケティング予算案を取りこみ、目標に届くか・コストが上限以内かを診断する無料のキットです。画面でNGを直すと、そのまま稟議に使える年間予算表（Excel）になります。";
const SHEET_URL = "/lab/whitepapers/kgi-kpi-backcast-sheet";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "便利ツール", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/budget-checker" },
];

const PRE_TAGS = ["売上目標", "平均受注単価", "粗利率", "回収期間", "リードタイム", "共通費"];
const CH_TAGS = ["リード数", "有効リード数", "商談数", "受注数", "外部費用", "人件費"];
const PRE = [
  { key: "goal", label: "売上目標" },
  { key: "price", label: "平均受注単価" },
  { key: "gmPct", label: "粗利率（%）" },
  { key: "paybackYears", label: "回収期間（年）" },
  { key: "leadTime", label: "リードタイム（月）" },
  { key: "common", label: "共通費" },
] as const;
const FIELDS = ["leads", "valid", "deals", "wins", "ext", "labor"] as const;
const FIELD_LABEL = { leads: "リード数", valid: "有効リード数", deals: "商談数", wins: "受注数", ext: "外部費用", labor: "人件費" } as const;
---

<BaseLayout title={`${TOOL_TITLE}｜予算案を診断して直し、年間予算表に仕上げる｜MeerKitLab`} description={TOOL_DESCRIPTION} ogImage="/open-graph/default.png">
  <Breadcrumb items={breadcrumbItems} />

  <!-- H1まわりは /lab・/tools と同じ形。.bk の外に置く -->
  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">作った予算案を、診断して直し、年間予算表に仕上げる。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">AIや自社で作った予算案を取りこみ、目標に届くか・コストが上限以内かを判定します。画面でNGを直すと、そのまま稟議に使える年間予算表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk">
    <!-- ===== 入口 ===== -->
    <section id="bk-intro">
      <h2 class="bk-h2">3ステップで、予算を診断し、年間予算表が完成します。</h2>
      <ol class="bk-steps">
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">1</span>入力する</p>
          <p class="bk-step-p">3つのどれかで取りこむ</p>
          <div class="bk-th" aria-hidden="true">
            <span class="bk-th-e">AIの案を貼りつける</span>
            <span class="bk-th-e">年間予算表を読み込む</span>
            <span class="bk-th-e">画面で入力する</span>
          </div>
        </li>
        <li class="bk-arrow" aria-hidden="true">→</li>
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">2</span>診断する</p>
          <p class="bk-step-p">数字を直すと判定がすぐ変わる。NGがなくなるまで直す</p>
          <div class="bk-th bk-th-2" aria-hidden="true">
            <div class="bk-th-grid bk-th-g5">
              {Array.from({ length: 5 }).map(() => <i class="k" />)}
              {Array.from({ length: 20 }).map((_, i) => <i class={i % 5 === 0 ? "" : i === 18 ? "r" : "b"} />)}
            </div>
            <div class="bk-th-alert"><span>1 直す</span><i /><i class="s" /><em>メールのCPL</em></div>
          </div>
        </li>
        <li class="bk-arrow" aria-hidden="true">→</li>
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">3</span>年間予算表 完成</p>
          <p class="bk-step-p">直した数字と診断結果が入った年間予算表（Excel）をダウンロード</p>
          <div class="bk-th" aria-hidden="true">
            <i class="bk-th-title" />
            <div class="bk-th-grid bk-th-g9">
              {Array.from({ length: 9 }).map(() => <i class="k" />)}
              {Array.from({ length: 9 }).map(() => <i class="b" />)}
            </div>
            <div class="bk-th-grid bk-th-g9" style="margin-top:4px">
              {Array.from({ length: 9 }).map(() => <i class="k" />)}
              {Array.from({ length: 18 }).map((_, i) => <i class={i % 2 ? "b" : ""} />)}
            </div>
            <span class="bk-th-ft">Excel</span>
          </div>
        </li>
      </ol>

      <div class="bk-need">
        <div class="bk-need-l">
          <p><b>必要な数字</b><span class="bk-need-k">前提</span>{PRE_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</p>
          <p><span class="bk-need-k">チャネル別（年間）</span>{CH_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</p>
          <p class="bk-need-n">率は入れません。使わないチャネルは空欄でかまいません</p>
        </div>
        <a class="bk-need-dl" href={SHEET_URL}>
          <span>
            <small>スプレッドシートで入力したい方向け</small>
            <b><span class="bk-ft">スプレッドシート</span>年間予算表</b>
          </span>
          <span class="bk-btn2">無料でDL</span>
        </a>
      </div>

      <h2 class="bk-h2">診断をはじめる</h2>
      <p class="bk-sub">手元の状態に合うものを1つ選んでください。どれを選んでも、診断の中身は同じです。</p>
      <div class="bk-ents">
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z" /><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" /></svg>AIや手元の資料で作った</small>
          <b>AIで整えて貼りつける</b>
          <p>プロンプトをAIに渡し、返ってきた結果を貼る</p>
          <button type="button" class="bk-btn" id="bk-ai-open" aria-expanded="false" aria-controls="bk-ai">はじめる<span aria-hidden="true">→</span></button>
        </div>
        <label class="bk-ent bk-drop" id="bk-drop" for="bk-file">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h8M12 11v8" /></svg>年間予算表に入力した</small>
          <b>年間予算表（.xlsx）を読み込む</b>
          <p>ファイルを置くだけで診断</p>
          <span class="bk-btn">ファイルを選ぶ</span>
        </label>
        <input type="file" id="bk-file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden />
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="20" height="12" /><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10" /></svg>数字が頭の中にある</small>
          <b>画面で入力する</b>
          <p>必要な数字を画面の表に入れる</p>
          <button type="button" class="bk-btn" id="bk-start">入力する<span aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="bk-ai" id="bk-ai" hidden>
        <p class="bk-ai-st">① このプロンプトをコピーして、予算案を作ったAIのチャットに貼る（手元の資料があれば一緒に貼る）</p>
        <pre class="bk-prompt" id="bk-prompt" set:text={AI_PROMPT}></pre>
        <button type="button" class="bk-btn2" id="bk-copy">プロンプトをコピー</button>
        <p class="bk-ai-st">② AIが返した結果を、ここに貼る</p>
        <textarea class="bk-paste" id="bk-paste" rows="6" placeholder="AIが返したJSON（```json から ``` まで）をそのまま貼りつけます" aria-label="AIが返した結果"></textarea>
        <p class="bk-ai-st">③ 読み込む</p>
        <button type="button" class="bk-btn" id="bk-import">読み込む<span aria-hidden="true">→</span></button>
      </div>

      <p class="bk-busy" id="bk-busy" role="status" hidden>読み込んでいます…</p>
      <p class="bk-err" id="bk-err" role="alert" hidden></p>
      <p class="bk-hint">無料・登録なし・入れた数字やファイルはサーバーに送りません（すべてブラウザの中）・<a href="/tools/budget-checker?sample=1">記入例で試す（基本モデルの安定期）→</a></p>

      <div class="bk-next">
        <span>予算をまだ作っていないなら</span>
        <a href="/tools/budget-simulator">予算作成キットへ →</a>
      </div>
    </section>

    <!-- ===== 入力と判定 ===== -->
    <section id="bk-work" hidden>
      <div class="bk-bar">
        <p><b>{TOOL_TITLE}</b><span id="bk-src"></span>水色の欄を直すと、右の判定がすぐ変わります</p>
        <div class="bk-acts">
          <button type="button" class="bk-link" id="bk-example">記入例</button>
          <button type="button" class="bk-link" id="bk-clear">すべて消す</button>
          <button type="button" class="bk-link" id="bk-home">入口に戻る</button>
        </div>
      </div>
      <div class="bk-notes" id="bk-notes" hidden></div>

      <div class="bk-grid">
        <form class="bk-left" id="bk-form" novalidate autocomplete="off">
          <div class="bk-tabs" role="tablist">
            <button type="button" role="tab" class="bk-tab" id="bk-tab-y" aria-selected="true" aria-controls="bk-pane-y">年間</button>
            <button type="button" role="tab" class="bk-tab" id="bk-tab-m" aria-selected="false" aria-controls="bk-pane-m">月別<i class="bk-dot" id="bk-mdot" hidden></i></button>
            <span class="bk-tab-n" id="bk-tab-n">月別のリード数・有効リード数は、年間÷12が入っています。直したいときだけ開きます</span>
          </div>

          <div id="bk-pane-y" role="tabpanel">
            <h3 class="bk-st">1. 前提</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead><tr><th>期首</th>{PRE.map((p) => <th>{p.label}</th>)}</tr></thead>
                <tbody>
                  <tr>
                    <td class="in">
                      <div class="bk-start">
                        <input name="startYear" type="number" inputmode="numeric" min="2000" max="2100" aria-label="期首の年" />
                        <select name="startMonth" aria-label="期首の月">{Array.from({ length: 12 }).map((_, i) => <option value={String(i + 1)}>{i + 1}月</option>)}</select>
                      </div>
                    </td>
                    {PRE.map((p) => <td class="in"><input name={p.key} type="number" inputmode="decimal" min="0" step="any" aria-label={p.label} /></td>)}
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="bk-tw bk-tw-s">
              <table class="bk-t bk-t-s">
                <thead><tr><th class="c">1社あたりの月の粗利</th><th class="c">CACの上限</th><th class="c">許容CPL</th></tr></thead>
                <tbody><tr><td class="calc" data-out="monthlyProfit">—</td><td class="calc" data-out="cacLimit">—</td><td class="calc" data-out="allowableCpl">—</td></tr></tbody>
              </table>
            </div>

            <h3 class="bk-st">2. チャネル別の計画（年間）</h3>
            <div class="bk-tw">
              <table class="bk-t">
                <thead>
                  <tr><th class="bk-ch">チャネル</th><th>リード数</th><th>有効リード数</th><th>商談数</th><th>受注数</th><th>外部費用</th><th>人件費</th><th class="c">CPL</th><th class="c">CAC</th></tr>
                </thead>
                <tbody>
                  {
                    CHANNELS.map((name, i) => (
                      <tr>
                        <td class="lb">{name}</td>
                        {FIELDS.map((k) => (
                          <td class="in"><input name={`ch${i}.${k}`} type="number" inputmode="decimal" min="0" step="any" aria-label={`${name}の${FIELD_LABEL[k]}`} /></td>
                        ))}
                        <td class="calc" data-out={`cpl${i}`}>—</td>
                        <td class="calc" data-out={`cac${i}`}>—</td>
                      </tr>
                    ))
                  }
                  <tr class="sum">
                    <td class="lb">合計</td>
                    {FIELDS.map((k) => <td class="calc" data-out={`total.${k}`}>—</td>)}
                    <td class="calc" data-out="total.cpl">—</td>
                    <td class="calc" data-out="total.cac">—</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="bk-hint">水色＝入力　灰色＝自動計算　単位 万円　率は入れません（件数から出します）</p>
          </div>

          <div id="bk-pane-m" role="tabpanel" hidden>
            <p class="bk-hint" style="margin-bottom:8px">展示会のように特定の月に集中するチャネルだけ直します。直したチャネルは、年間の数字を変えても月別はそのままです。</p>
            {
              CHANNELS.map((name, i) => (
                <div class="bk-mblock" id={`bk-m${i}`}>
                  <div class="bk-mhead">
                    <h3 class="bk-st">{name}</h3>
                    <button type="button" class="bk-link" data-reset={i}>年間÷12に戻す</button>
                  </div>
                  <div class="bk-tw">
                    <table class="bk-t bk-t-m">
                      <thead>
                        <tr>
                          <th class="bk-ch" />
                          {Array.from({ length: 12 }).map((_, k) => <th data-mlabel={k}>{((3 + k) % 12) + 1}月</th>)}
                          <th class="c">年間</th>
                          <th class="c">計画との差</th>
                        </tr>
                      </thead>
                      <tbody>
                        {(["leads", "valid"] as const).map((k) => (
                          <tr>
                            <td class="lb">{k === "leads" ? "リード数" : "有効リード数"}</td>
                            {Array.from({ length: 12 }).map((_, m) => (
                              <td class="in"><input name={`m${i}.${k}.${m}`} type="number" inputmode="numeric" min="0" step="1" aria-label={`${name}の${m + 1}か月目`} /></td>
                            ))}
                            <td class="calc" data-out={`m${i}.${k}.sum`}>—</td>
                            <td class="calc" data-out={`m${i}.${k}.diff`}>—</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))
            }
            <p class="bk-hint">外部費用・人件費の月別は、ダウンロードした年間予算表に年額÷12の式で入ります。違う月はExcelで上書きしてください</p>
          </div>
        </form>

        <aside class="bk-panel" id="bk-panel" aria-label="判定">
          <div class="bk-counts">
            <div class="fix"><b id="bk-c-fix">0</b>直す</div>
            <div class="check"><b id="bk-c-check">0</b>確認</div>
            <div class="ok"><b id="bk-c-ok">0</b>問題なし</div>
          </div>
          <p class="bk-wait" id="bk-wait" hidden></p>
          <div id="bk-res">
            <p class="bk-ph">目標に届くか</p>
            <div id="bk-goal"></div>
            <p class="bk-ph">コストは上限以内か</p>
            <div id="bk-cost"></div>
            <div id="bk-list"></div>
          </div>
          <div class="bk-out">
            <p class="bk-remain" id="bk-remain" hidden></p>
            <button type="button" class="bk-btn bk-dl" id="bk-dl">年間予算表をDL（Excel）</button>
            <p class="bk-err" id="bk-dlerr" role="alert" hidden></p>
          </div>
        </aside>
      </div>

      <div class="bk-mbar" id="bk-mbar">
        <span class="fix"><b id="bk-m-fix">0</b>直す</span>
        <span class="check"><b id="bk-m-check">0</b>確認</span>
        <button type="button" class="bk-btn2" id="bk-mopen">判定を見る</button>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/budget-checker" />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
