---
// src/pages/tools/budget-checker.astro
//
// 予算案診断Kit（旧予算案チェッカー、/tools/budget-checker）2026-10-30 作り直し・2026-11-01 情報設計の見直し
// AIや自社で作った予算案を取りこみ、診断して直し、年間予算表（M-B-03、Excel）に仕上げる。
// - 流れは5ステップ（FlowSteps）：① 入力・取り込み（このページ・/input）→ ② 診断・修正（/check）→ ③ 最終チェック（/final）→ ④ ダウンロード ⑤ 次へ（/done）
// - このページは「選んで始めるページ」：ファーストビューは H1 → 流れ → 入口3つ。説明（わかること・必要な数字）は入口の下
// - 入口は3つ：AIの案を貼りつける／年間予算表（.xlsx）を読み込む（→ どちらも /check へ）／画面で入力する（→ /input）
// - 入力の項目は年間予算表（施策別）と同じ。ダウンロードするExcelは「年間予算表（施策別）」＋「診断結果」の2シート（PDFはなし）
// - NGが残っていてもダウンロードできる（その旨を出す）
// 判定と状態：src/lib/budgetCheck.ts　Excelの書き込み：src/lib/budget-sheet.ts　画面：src/scripts/budget-checker/app.ts
// ひな形：public/files/tools/budget-sheet-template.xlsx（scripts/build-budget-sheet-template.py で作る）
// サンプル画面：/tools/budget-checker/sample（基本モデルの安定期。診断画面と年間予算表の完成イメージをタブで切り替え）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import { CHANNELS } from "@/lib/kpi-sheet-maker";
import { aiPrompt, diagnoseBudget, sampleState } from "@/lib/budgetCheck";
import { buildIssues } from "@/lib/budgetFlow";
import { KITS } from "@/lib/planKits";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "予算案診断Kit";
// 「このKitでわかること」と完成イメージ（画像は scripts/capture-kit-shots.py で撮る）
const TOOL_DESCRIPTION =
  "AIや自社で作ったマーケティング予算案を取りこみ、目標に届くか・コストが上限以内かを診断する無料のツール（Kit）です。画面でNGを直すと、そのまま稟議に使える年間予算表（Excel）になります。";
const SHEET_URL = "/lab/whitepapers/kgi-kpi-backcast-sheet";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/budget-checker" },
];

// ファーストビュー右の「診断結果の見本」：基本モデルの安定期の記入例から、展示会の商談数・受注数を減らした案を実際に判定した結果（2026-11-01）
const demo = sampleState();
demo.input.channels[0].deals = 15;
demo.input.channels[0].wins = 4;
const demoDiag = diagnoseBudget(demo);
const demoIssues = buildIssues(demo, undefined, demoDiag);
const ST_LABEL = { fix: "直す", check: "確認" } as const;

const PRE_TAGS = ["売上目標", "平均受注単価", "粗利率", "回収期間", "リードタイム", "共通費"];
const CH_TAGS = ["リード数", "有効リード数", "商談数", "受注数", "外部費用", "人件費"];
// アイコン（入口のカードと同じ）
const ICON = {
  ai: ["M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z", "M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"],
  file: ["M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z", "M14 2v6h6M8 13h8M8 17h8M12 11v8"],
  key: "M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10",
};
---

<BaseLayout title={`${TOOL_TITLE}｜予算案を診断して直し、年間予算表に仕上げる｜MeerKitLab`} description={TOOL_DESCRIPTION} ogImage="/open-graph/default.png">
  <Breadcrumb items={breadcrumbItems} />

  <!-- H1はKit名。その下に問いかけ（何をするKitか）と説明、右に診断結果の見本（2026-11-01） -->
  <div class="bk bk-top">
    <div class="bk-top-l">
      <h1 class="bk-top-h1">{TOOL_TITLE}</h1>
      <p class="bk-top-q">その予算案、<br />目標に届く？<br />コストは上限以内？</p>
      <p class="bk-top-d">予算案の数字を入れると、すぐに判定して<b>直すところ</b>を示します。直した数字は、そのまま稟議に使える年間予算表（Excel）で持ち帰れます。</p>
      <p class="bk-top-tags"><span>無料</span><span>登録なし</span><span>数字はサーバーに送りません</span></p>
      <div class="bk-top-cta">
        <a class="bk-btn bk-go" href="#start">診断をはじめる<span aria-hidden="true">↓</span></a>
        <a class="bk-top-link" href="/tools/budget-checker/sample">見本の診断結果を見る →</a>
      </div>
    </div>
    <figure class="bk-demo" aria-label="診断結果の見本">
      <figcaption><b>診断結果</b><span>見本</span></figcaption>
      <div class="bk-demo-sum">
        <div class="is-fix"><span>直す</span><b>{demoDiag.counts.fix}</b></div>
        <div class="is-check"><span>確認</span><b>{demoDiag.counts.check}</b></div>
        <div><span>問題なし</span><b>{demoDiag.counts.ok}</b></div>
      </div>
      <ul class="bk-demo-l">
        {
          demoIssues.map((x) => (
            <li>
              <div>
                <b>{x.title}</b>
                <p>いま：{x.now}</p>
                <p class="ok">OKになる条件：{x.target}</p>
              </div>
              <span class={`bk-demo-st is-${x.status}`}>{ST_LABEL[x.status]}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </div>

  <main class="bk" id="bk" data-kit="budget" data-mode="intro">
    <section id="bk-intro">
      <!-- 3ステップ（入力 → 診断して直す → ダウンロード）。中の画面の帯（FlowSteps）とは別に、流れを説明する -->
      <section class="bk-3s" aria-labelledby="bk-3s-h">
        <h2 class="bk-3s-h" id="bk-3s-h">3ステップで、予算案が年間予算表になります</h2>
        <ol class="bk-3s-l">
          <li>
            <span class="bk-3s-n">STEP 1</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" /><path d="M3 10h18M9 10v10M13 15h4" /></svg>
            <b>入力する</b>
            <p>AIの案・年間予算表（Excel）・画面入力のどれかで、予算案の数字を入れます</p>
          </li>
          <li aria-hidden="true" class="bk-3s-a">→</li>
          <li>
            <span class="bk-3s-n">STEP 2</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13 7l4 4" /></svg>
            <b>診断して直す</b>
            <p>目標に届くか・コストは上限以内かを判定。NGは「OKになる条件」を見ながら、その場で直せます</p>
          </li>
          <li aria-hidden="true" class="bk-3s-a">→</li>
          <li>
            <span class="bk-3s-n">STEP 3</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            <b>ダウンロード</b>
            <p>直した数字と診断結果を、稟議に使える年間予算表（Excel）で持ち帰ります</p>
          </li>
        </ol>
      </section>

      <!-- ===== 入口3つ（上下に余白をとって目立たせる） ===== -->
      <div class="bk-entry">
      <div class="bk-start-h" id="start">
        <h2 class="bk-h2">診断をはじめる</h2>
        <p class="bk-sub">手元の状態に合うものを1つ選んでください。どれを選んでも、診断の中身は同じです。</p>
      </div>
      <div class="bk-ents">
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true">{ICON.ai.map((d) => <path d={d} />)}</svg>AIで作った案がある</small>
          <b>AIの案を貼りつける</b>
          <p>プロンプトをAIに渡し、返ってきた結果を貼ります</p>
          <button type="button" class="bk-btn" id="bk-ai-open" aria-expanded="false" aria-controls="bk-ai">はじめる<span aria-hidden="true">→</span></button>
        </div>
        <label class="bk-ent bk-drop" id="bk-drop" for="bk-file">
          <small><svg viewBox="0 0 24 24" aria-hidden="true">{ICON.file.map((d) => <path d={d} />)}</svg>年間予算表に入力済み</small>
          <b>年間予算表（.xlsx）をここに置く</b>
          <span class="bk-drop-hint">Googleスプレッドシート：ファイル → ダウンロード → Microsoft Excel（.xlsx）</span>
          <span class="bk-btn">ファイルを選ぶ</span>
        </label>
        <input type="file" id="bk-file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden />
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="20" height="12" /><path d={ICON.key} /></svg>数字が手元にある</small>
          <b>画面で入力する</b>
          <p>必要な数字を画面の表に入れます</p>
          <button type="button" class="bk-btn" id="bk-start">入力する<span aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="bk-ai" id="bk-ai" hidden>
        <p class="bk-ai-st">① このプロンプトをコピーして、予算案を作ったAIのチャットに貼る（手元の資料があれば一緒に貼る）</p>
        <pre class="bk-prompt" id="bk-prompt" set:text={aiPrompt(KITS.budget)}></pre>
        <button type="button" class="bk-btn2" id="bk-copy">プロンプトをコピー</button>
        <p class="bk-ai-st">② AIが返した結果を、ここに貼る</p>
        <textarea class="bk-paste" id="bk-paste" rows="6" placeholder="AIが返したJSON（```json から ``` まで）をそのまま貼りつけます" aria-label="AIが返した結果"></textarea>
        <p class="bk-ai-st">③ 読み込むと、すぐに診断します</p>
        <button type="button" class="bk-btn" id="bk-import">読み込んで診断する<span aria-hidden="true">→</span></button>
      </div>

      <p class="bk-busy" id="bk-busy" role="status" hidden>読み込んでいます…</p>
      <p class="bk-err" id="bk-err" role="alert" hidden></p>
      <p class="bk-hint bk-trust">無料・登録なし・入れた数字やファイルはサーバーに送りません（すべてブラウザの中）<span class="bk-for-i">予算がまだない方は <a href="/tools/budget-simulator">予算作成Kit →</a></span></p>
      </div>

      <!-- ===== ここから下は説明 ===== -->
      <div class="bk-band bk-info">
        <div class="bk-know">
        <h2 class="bk-h2">診断でわかること</h2>
        <div class="bk-know-g">
          <ul class="bk-know-l">
            <li><i>A</i><div><b>目標に届くか</b><p>計画の数で、売上目標に届くかを判定します</p></div></li>
            <li><i>B</i><div><b>コストは上限以内か</b><p>CPL・CACが上限を超えていないかを判定します</p></div></li>
            <li><i>C</i><div><b>直すところと、OKになる条件</b><p>NGを1件ずつ示し、その場で数字を直せます。最後に年間予算表（Excel）を持ち帰れます</p></div></li>
          </ul>
          <a class="bk-shot" href="/tools/budget-checker/sample?tab=sheet"><img src="/images/tools/budget-checker-sheet.png" alt="" width="640" height="420" loading="lazy" /><span>年間予算表（完成イメージ）を見る →</span></a>
        </div>
        </div>

        <div class="bk-need">
        <div>
          <p class="bk-need-top"><b>必要な数字</b><span>率は入れません（件数から出します）。使わないチャネルは空欄か0でかまいません</span></p>
          <dl>
            <dt>前提</dt>
            <dd>{PRE_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
            <dt>チャネル別（年間）</dt>
            <dd>{CH_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
          </dl>
        </div>
        <div class="bk-need-dl">
          <div class="bk-doc" aria-hidden="true"><i></i><b>年間予算表</b><em></em><em></em></div>
          <div class="bk-need-dl-t">
            <span class="bk-tag-o">スプレッドシートで入力したい方へ</span>
            <b>年間予算表（無料）</b>
            <p>画面ではなくスプレッドシートで入力したい方向けの資料です。入力して.xlsxで保存し、上の枠に置くと同じ診断ができます。</p>
          </div>
          <a class="bk-btn2" href={SHEET_URL}>無料でダウンロード<span aria-hidden="true">→</span></a>
        </div>
      </div>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/budget-checker" />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
