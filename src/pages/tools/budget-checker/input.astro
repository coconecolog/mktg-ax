---
// src/pages/tools/budget-checker/input.astro
//
// 予算案診断キットの入力の画面（/tools/budget-checker/input）2026-10-30・2026-11-01 流れを5ステップに
// 2026-11-01：「① 入力・取り込み」の画面。判定は出さず入力だけにし、「診断する →」で ② 診断・修正（/check）に移る。
//   入口で「画面で入力する」を選んだ人が来る。② の「表全体で見る・直す」（?from=check）からも来る（そのときは上の戻り先が ② になる）
// 入口（/tools/budget-checker）の3つの入口（AIの案／年間予算表の.xlsx／画面で入力）は、どれもこのページに移る。
// - 入口で読み込んだ数字は localStorage（app.ts の STORE）で受け渡す。直接開いたときは、前回の入力（なければ空）から始める
// - 上に「← 予算案診断キットに戻る」と使い方。入力の上のバー（読み込み元・入口に戻る）はなし
// - 記入例・すべて消すは、入力のタブの右に置く（BudgetGrid）
// - ダウンロードは判定の枠の外に独立。Chrome・Edgeは保存先を選ぶ画面が開く（それ以外は通常のダウンロード）
// - ?sample=1 で記入例（基本モデルの安定期）を入れて開く
// 画面の動きは src/scripts/budget-checker/app.ts（#bk の data-mode="input"）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import BudgetGrid from "@/components/budget-checker/BudgetGrid.astro";
import FlowSteps from "@/components/budget-checker/FlowSteps.astro";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "予算案診断キット";
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/budget-checker" },
  { name: "入力", href: "/tools/budget-checker/input" },
];
---

<BaseLayout
  title={`${TOOL_TITLE} 入力｜MeerKitLab`}
  description="予算案診断キットの入力の画面です。予算案の数字を入れて「診断する」を押すと、目標に届くか・コストが上限以内かを判定します。"
  ogImage="/open-graph/default.png"
  noindex
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">作った予算案を、診断して直し、年間予算表に仕上げる。</p>
  </div>

  <main class="bk" id="bk" data-kit="budget" data-mode="input">
    <FlowSteps current={1} />
    <p class="bk-back" id="bk-back"><a href="/tools/budget-checker">← 予算案診断キットの入口に戻る</a></p>

    <section class="bk-howto" aria-labelledby="bk-howto-h">
      <h2 class="bk-howto-h" id="bk-howto-h">使い方</h2>
      <div class="bk-howto-b">
        <ol class="bk-howto-l">
          <li>
            <span class="bk-tno">1</span>
            <div><b>まず「年間」を入力</b><p>前提と、チャネル別の年間の計画を入れます。</p></div>
          </li>
          <li>
            <span class="bk-tno">2</span>
            <div><b>月別は必要なときだけ</b><p>年間÷12が入っています。季節で増減する月だけ直します。</p></div>
          </li>
        </ol>
        <ul class="bk-howto-n">
          <li>水色のセルに入力してください。</li>
          <li>灰色のセルは自動計算されるセルです。</li>
          <li>入力が終わったら「診断する」を押します。直すところとOKになる条件は、次の画面で出します。</li>
        </ul>
      </div>
    </section>

    <section id="bk-work">
      <div class="bk-notes" id="bk-notes" hidden></div>

      <BudgetGrid flow />

      <div class="bk-gobar">
        <p class="bk-hint">入力の途中の値は、このブラウザの中にだけ保存されます</p>
        <button type="button" class="bk-btn bk-go" data-go-check>診断する<span aria-hidden="true">→</span></button>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/budget-checker" />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
<script>
  // ② 診断・修正の「表全体で見る・直す」から来たときは、戻り先を ② にする
  if (new URLSearchParams(location.search).get("from") === "check") {
    const a = document.querySelector<HTMLAnchorElement>("#bk-back a");
    if (a) {
      a.href = "/tools/budget-checker/check";
      a.textContent = "← 診断・修正に戻る";
    }
    const go = document.querySelector<HTMLElement>("[data-go-check]");
    if (go) go.firstChild!.textContent = "診断・修正に戻る";
  }
</script>
