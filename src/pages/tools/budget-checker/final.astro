---
// src/pages/tools/budget-checker/final.astro
//
// 予算案診断Kitの「③ 最終チェック・ダウンロード」（/tools/budget-checker/final）2026-11-01
// 2026-11-01 見直し：「予算案の診断結果」（修正が必要・確認が必要・問題なしの数）→「最終チェック」（修正が必要な項目／確認事項。確認事項はチェックして承認）→ いちばん下にダウンロード。
// 確認事項（と残った修正）をチェックするとダウンロードが押せる。残りがなければ最初から押せる。保存が終わると自動で完了（/done）に移る
// カードの状態の一覧（押すと ② のそのカードへ）→「診断結果を確認しました」にチェックするとダウンロードのボタンが押せる
// NGが残っていてもダウンロードできる（以前からの決定）。保存が終わったら完了（/done）に移る
// 画面の動きは src/scripts/budget-checker/flow.ts（#bk の data-mode="final"）。数字は入力の画面と同じ localStorage を読む
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import FlowSteps from "@/components/budget-checker/FlowSteps.astro";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "予算案診断Kit";
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/budget-checker" },
  { name: "最終チェック・ダウンロード", href: "/tools/budget-checker/final" },
];
---

<BaseLayout title={`${TOOL_TITLE} 最終チェック｜MeerKitLab`} description="予算案診断Kitの最終チェックの画面です。未対応の項目を確かめて、年間予算表（Excel）をダウンロードします。" ogImage="/open-graph/default.png" noindex>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">作った予算案を、診断して直し、年間予算表に仕上げる。</p>
  </div>

  <main class="bk" id="bk" data-kit="budget" data-mode="final">
    <FlowSteps current={3} />
    <div id="bk-flow" class="bk-f2">
      <section aria-labelledby="bk-f2-h">
        <h2 class="bk-fi-h" id="bk-f2-h">予算案の診断結果</h2>
        <div class="bk-f2-n" aria-label="判定のまとめ">
          <div><b id="bk-f-fix">0</b><span>修正が必要</span></div>
          <div><b id="bk-f-check">0</b><span>確認が必要</span></div>
          <div><b id="bk-f-ok">0</b><span>問題なし</span></div>
        </div>
        <p class="bk-f2-lead" id="bk-fin-lead">確認事項をチェックして、年間予算表を完成させましょう。</p>
      </section>

      <section class="bk-f2-chk" aria-labelledby="bk-f2-c">
        <h3 id="bk-f2-c">最終チェック</h3>
        <ul class="bk-f2-l">
          <li id="bk-f2-fix"></li>
          <li id="bk-f2-check"></li>
        </ul>
        <p class="bk-back"><a href="/tools/budget-checker/check?back=1">← ② 診断・修正に戻る</a></p>
      </section>

      <!-- ダウンロードはいちばん下に全幅で（2026-11-01） -->
      <section class="bk-f2-dl" id="bk-f2-dl" aria-labelledby="bk-f2-dt">
        <span class="bk-f2-tag" id="bk-f2-tag">完成</span>
        <h3 id="bk-f2-dt">年間予算表をダウンロードできます</h3>
        <button type="button" class="bk-btn bk-fin-btn" id="bk-dl" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>年間予算表をダウンロード（Excel）</button>
        <p class="bk-hint"><span id="bk-fin-name"></span>（年間予算表（施策別）＋診断結果）。診断結果を反映したExcelファイルを出力します。保存が終わると、自動で完了の画面に移ります。</p>
        <p class="bk-err" id="bk-dlerr" role="alert" hidden></p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import "@/scripts/budget-checker/flow";
</script>
