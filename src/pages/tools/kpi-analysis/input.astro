---
// src/pages/tools/kpi-analysis/input.astro
//
// 施策効果診断Kitの入力の画面（/tools/kpi-analysis/input）2026-10-30。予算案診断Kit・KPI妥当性診断Kitの入力の画面と同じ作り
// 入口（/tools/kpi-analysis）の3つの入口は、どれもこのページに移る（localStorage で受け渡す）。?sample=1 で記入例を入れて開く
// 画面の動きは src/scripts/kpi-analysis/app.ts（#bk の data-mode="input"）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import EffectGrid from "@/components/kpi-analysis/EffectGrid.astro";
import "@/styles/budget-checker.css";
import "@/styles/kpi-analysis.css";

const TOOL_TITLE = "施策効果診断Kit";
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/kpi-analysis" },
  { name: "入力", href: "/tools/kpi-analysis/input" },
];
---

<BaseLayout
  title={`${TOOL_TITLE} 入力｜MeerKitLab`}
  description="施策効果診断Kitの入力の画面です。計画・毎月の実績・施策ログを入れると、計画を下回っている課題と打ち手の効果をその場で判定し、KPI管理表（Excel）をダウンロードできます。"
  ogImage="/open-graph/default.png"
  noindex
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">毎月の振り返りを、勘ではなく数字で。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">毎月の実績と施策ログから、計画を下回っている課題と、打ち手が効いたかを確率で判定します。画面で直すと、そのまま翌月も使えるKPI管理表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk" data-kit="effect" data-mode="input">
    <p class="bk-back"><a href="/tools/kpi-analysis">← 施策効果診断Kitに戻る</a></p>

    <section class="bk-howto" aria-labelledby="bk-howto-h">
      <h2 class="bk-howto-h" id="bk-howto-h">使い方</h2>
      <div class="bk-howto-b">
        <ol class="bk-howto-l">
          <li>
            <span class="bk-tno">1</span>
            <div><b>まず「計画」を入力</b><p>前提とチャネル別の年間の計画を入れ、月別は季節で増減する月だけ直します。</p></div>
          </li>
          <li>
            <span class="bk-tno">2</span>
            <div><b>毎月「実績」と「施策ログ」を入力</b><p>終わった月の実績と、課題に打った手を入れます。</p></div>
          </li>
        </ol>
        <ul class="bk-howto-n">
          <li>水色のセルに入力してください。</li>
          <li>灰色のセルは自動計算されるセルです。</li>
          <li>右の判定で「直す」「確認」が出たら、その欄を直してください（残っていてもKPI管理表をダウンロードできます）。</li>
        </ul>
      </div>
    </section>

    <section id="bk-work">
      <div class="bk-notes" id="bk-notes" hidden></div>

      <EffectGrid />

      <div class="bk-mbar" id="bk-mbar">
        <span class="fix"><b id="bk-m-fix">0</b>直す</span>
        <span class="check"><b id="bk-m-check">0</b>確認</span>
        <button type="button" class="bk-btn" id="bk-mopen">判定を見る</button>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/kpi-analysis" />
</BaseLayout>

<script>
  import "@/scripts/kpi-analysis/app";
</script>
