---
// src/pages/tools/kpi-sheet-maker/input.astro
// 入力の画面（noindex）。中身は共通の部品 src/components/kit-flow/KitFlow.astro（2026-11-01）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import KitFlow from "@/components/kit-flow/KitFlow.astro";
import { kitPage } from "@/data/kitPages";
import { KITS } from "@/lib/planKits";
import "@/styles/budget-checker.css";

const KIT_ID = "kpimake";
const p = kitPage(KIT_ID);
const base = KITS[KIT_ID].path;
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: p.title, href: base },
  { name: "入力", href: `${base}/input` },
];
---

<BaseLayout title={`${p.title} 入力｜MeerKitLab`} description={`${p.title}の入力の画面です。数字を入れて「診断する」を押すと、次の画面で判定します。`} ogImage="/open-graph/default.png" noindex>
  <Breadcrumb items={breadcrumbItems} />
  <KitFlow kitId={KIT_ID} mode="input" />
  <ToolFooter path={base} />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
