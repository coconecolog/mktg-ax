---
// src/pages/tools/kpi-sheet-maker/input.astro
//
// KPI管理表作成Kitの入力の画面（/tools/kpi-sheet-maker/input）2026-10-30。形と計算は予算作成Kitの入力の画面と同じ（/tools/budget-simulator/input）
// 入口（/tools/kpi-sheet-maker）の3つの入口からこのページに移る。AI・.xlsxから来たときは読み込んだ数字、画面で入力するときは前回の入力（なければ空）から始める
// - KPI妥当性診断Kitとの違い：「2. 今期の実績と、来期に必要な数」があり、チャネルの有効リード数・商談数・受注数は自動配分（上書き可）
// - 上に「← KPI管理表作成Kitに戻る」と使い方。入力の上のバー（読み込み元・入口に戻る）はなし
// - 記入例・すべて消すは、入力のタブの右に置く（BudgetGrid）
// - ダウンロードは判定の枠の外に独立。Chrome・Edgeは保存先を選ぶ画面が開く（それ以外は通常のダウンロード）
// - ?sample=1 で記入例（基本モデルの安定期）を入れて開く
// 画面の動きは src/scripts/budget-checker/app.ts（#bk の data-mode="input"）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import BudgetGrid from "@/components/budget-checker/BudgetGrid.astro";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "KPI管理表作成Kit";
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/kpi-sheet-maker" },
  { name: "入力", href: "/tools/kpi-sheet-maker/input" },
];
---

<BaseLayout
  title={`${TOOL_TITLE} 入力｜MeerKitLab`}
  description="KPI管理表作成Kitの入力の画面です。売上目標と今期の実績から必要な数を逆算し、リード数と費用をチャネルに分割すると、目標に届くか・コストが上限以内かをその場で判定し、KPI管理表（Excel）をダウンロードできます。"
  ogImage="/open-graph/default.png"
  noindex
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">売上目標から逆算して、KPI管理表を作る。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">売上目標と今期の実績から、必要なリード数を逆算します。リード数と費用をチャネルに分割するだけで、CPL・CACまで判定し、そのまま期初から使えるKPI管理表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk" data-kit="kpimake" data-mode="input">
    <p class="bk-back"><a href="/tools/kpi-sheet-maker">← KPI管理表作成Kitに戻る</a></p>

    <section class="bk-howto" aria-labelledby="bk-howto-h">
      <h2 class="bk-howto-h" id="bk-howto-h">使い方</h2>
      <div class="bk-howto-b">
        <ol class="bk-howto-l">
          <li>
            <span class="bk-tno">1</span>
            <div><b>まず「年間」を入力</b><p>前提と今期の実績を入れ、リード数と費用をチャネルに分割します。</p></div>
          </li>
          <li>
            <span class="bk-tno">2</span>
            <div><b>次に「月別」で調整</b><p>年間÷12が入っています。季節で増減する月だけ直します。</p></div>
          </li>
        </ol>
        <ul class="bk-howto-n">
          <li>水色のセルに入力してください。</li>
          <li>灰色のセルは自動計算されるセルです（有効リード数・商談数・受注数は上書きもできます）。</li>
          <li>右の判定で「直す」「確認」が出たら、その欄を直してください（残っていてもKPI管理表をダウンロードできます）。</li>
        </ul>
      </div>
    </section>

    <section id="bk-work">
      <div class="bk-notes" id="bk-notes" hidden></div>

      <BudgetGrid kit="kpimake" />

      <div class="bk-mbar" id="bk-mbar">
        <span class="fix"><b id="bk-m-fix">0</b>直す</span>
        <span class="check"><b id="bk-m-check">0</b>確認</span>
        <button type="button" class="bk-btn" id="bk-mopen">判定を見る</button>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/kpi-sheet-maker" />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
