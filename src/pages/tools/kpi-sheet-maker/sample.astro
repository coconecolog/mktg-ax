---
// src/pages/tools/kpi-sheet-maker/sample.astro
// サンプル画面（検索に出す）。診断・修正の画面と完成イメージをタブで切り替える。中身は共通の部品 src/components/kit-flow/KitFlow.astro（2026-11-01）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import KitFlow from "@/components/kit-flow/KitFlow.astro";
import { kitPage } from "@/data/kitPages";
import { KITS } from "@/lib/planKits";
import "@/styles/budget-checker.css";

const KIT_ID = "kpimake";
const p = kitPage(KIT_ID);
const base = KITS[KIT_ID].path;
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: p.title, href: base },
  { name: "サンプル画面", href: `${base}/sample` },
];
---

<BaseLayout title={`${p.title} サンプル画面｜診断・修正の画面と${KITS[KIT_ID].doc}の完成イメージ｜MeerKitLab`} description={`${p.title}のサンプル画面です。架空の会社（基本モデルの安定期）の数字で、診断・修正の画面と完成イメージを見られます。`} ogImage="/open-graph/default.png">
  <Breadcrumb items={breadcrumbItems} />
  <KitFlow kitId={KIT_ID} mode="sample" />

</BaseLayout>

<script>
  import "@/scripts/budget-checker/flow";
</script>
