---
// src/pages/tools/kpi-check/sample.astro
//
// KPI妥当性診断キットのサンプル画面（/tools/kpi-check/sample）2026-10-30。予算案診断キットのサンプル画面と同じ作り
// 記入例（基本モデルの安定期）で、「診断画面」と「KPI管理表（完成イメージ：はじめに入力・診断結果）」をタブで切り替えて見せる
// - KPI管理表のタブは ?tab=sheet で開く。数字は変えられるが保存しない。ダウンロードはなし（キットへのリンク）
// 画面の動きは src/scripts/budget-checker/app.ts（#bk の data-kit="kpi" data-mode="sample"）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import BudgetGrid from "@/components/budget-checker/BudgetGrid.astro";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "KPI妥当性診断キット";
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/kpi-check" },
  { name: "サンプル画面", href: "/tools/kpi-check/sample" },
];
---

<BaseLayout
  title={`${TOOL_TITLE} サンプル画面｜診断画面とKPI管理表の完成イメージ｜MeerKitLab`}
  description="KPI妥当性診断キットのサンプル画面です。架空の会社（基本モデル）の安定期の数字で、診断画面と、ダウンロードできるKPI管理表（Excel）の完成イメージを確かめられます。"
  ogImage="/open-graph/default.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}<span class="bk-h1-sub">サンプル画面</span></h1>
    <p class="mt-4 text-lg font-bold text-ink-950">作ったKPIを、診断して直し、KPI管理表に仕上げる。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">自分やAIで作ったKPIを取りこみ、売上目標とつながっているか・率やコストに無理がないかを判定します。画面でNGを直すと、そのまま期初から使えるKPI管理表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk" data-kit="kpi" data-mode="sample">
    <p class="bk-back"><a href="/tools/kpi-check">← KPI妥当性診断キットに戻る</a></p>

    <section id="bk-work">
      <div class="bk-views" role="tablist" aria-label="表示">
        <button type="button" role="tab" class="bk-view" id="bk-v-diag" aria-selected="true">診断画面</button>
        <button type="button" role="tab" class="bk-view" id="bk-v-sheet" aria-selected="false">KPI管理表（完成イメージ）</button>
        <span class="bk-tab-n" id="bk-v-note">水色の欄を直すと、右の判定がすぐ変わります</span>
      </div>
      <p class="bk-hint bk-sample-n">記入例：架空の会社（基本モデル）の安定期の数字です。数字を変えると判定とKPI管理表が変わります（保存はされません）</p>

      <div class="bk-sheetview" id="bk-sheetview" hidden>
        <div class="bk-sheettabs">
          <button type="button" class="bk-stab" id="bk-s-main" aria-selected="true">はじめに入力</button>
          <button type="button" class="bk-stab" id="bk-s-diag" aria-selected="false">診断結果</button>
          <a class="bk-btn bk-sheet-dl" href="/tools/kpi-check">自分のKPIで診断する<span aria-hidden="true">→</span></a>
        </div>
        <div class="bk-sheet" id="bk-sheet"></div>
      </div>

      <BudgetGrid sample kit="kpi" />

      <div class="bk-mbar" id="bk-mbar">
        <span class="fix"><b id="bk-m-fix">0</b>直す</span>
        <span class="check"><b id="bk-m-check">0</b>確認</span>
        <button type="button" class="bk-btn" id="bk-mopen">判定を見る</button>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
