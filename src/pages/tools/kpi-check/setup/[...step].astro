---
// /tools/kpi-check/setup/1〜6（3は施策ごと：/setup/3/<施策>、/setup/3/common）
import KpiCheckStep from "@/components/kpi-check/KpiCheckStep.astro";
import { MEASURE_IDS } from "@/lib/kpiCheck";

export function getStaticPaths() {
  const titles: Record<string, string> = { "1": "KPIツリー", "2": "施策と期間", "3": "施策のKPI", "4": "費用と撤退", "5": "判定", "6": "PDF" };
  const paths = ["1", "2", "3", ...MEASURE_IDS.map((id) => `3/${id}`), "3/common", "4", "5", "6"];
  return paths.map((p) => ({ params: { step: p }, props: { title: titles[p.split("/")[0]] } }));
}
const { step } = Astro.params;
const [n, sub] = String(step).split("/");
const { title } = Astro.props;
---

<KpiCheckStep flow="setup" step={Number(n)} sub={sub} title={title} />
