---
// src/pages/tools/kpi-check/done.astro
// 完了の画面（noindex）。中身は共通の部品 src/components/kit-flow/KitFlow.astro（2026-11-01）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import KitFlow from "@/components/kit-flow/KitFlow.astro";
import { kitPage } from "@/data/kitPages";
import { KITS } from "@/lib/planKits";
import "@/styles/budget-checker.css";

const KIT_ID = "kpi";
const p = kitPage(KIT_ID);
const base = KITS[KIT_ID].path;
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: p.title, href: base },
  { name: "完了", href: `${base}/done` },
];
---

<BaseLayout title={`${p.title} 完了｜MeerKitLab`} description={`${p.title}の完了の画面です。ダウンロードと、次に使うKitへの案内です。`} ogImage="/open-graph/default.png" noindex>
  <Breadcrumb items={breadcrumbItems} />
  <KitFlow kitId={KIT_ID} mode="done" />

</BaseLayout>

<script>
  import "@/scripts/budget-checker/flow";
</script>
