---
// /tools/kpi-check/monthly/1〜5（2は施策ごと：/monthly/2/<施策>）
import KpiCheckStep from "@/components/kpi-check/KpiCheckStep.astro";
import { MEASURE_IDS } from "@/lib/kpiCheck";

export function getStaticPaths() {
  const titles: Record<string, string> = { "1": "準備", "2": "施策ごとの実績", "3": "全体の数字", "4": "判定", "5": "PDF" };
  const paths = ["1", "2", ...MEASURE_IDS.map((id) => `2/${id}`), "3", "4", "5"];
  return paths.map((p) => ({ params: { step: p }, props: { title: titles[p.split("/")[0]] } }));
}
const { step } = Astro.params;
const [n, sub] = String(step).split("/");
const { title } = Astro.props;
---

<KpiCheckStep flow="monthly" step={Number(n)} sub={sub} title={title} />
