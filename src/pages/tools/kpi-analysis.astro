---
// src/pages/tools/kpi-analysis.astro
//
// 施策効果診断Kit（旧KPI分析ツール、/tools/kpi-analysis）2026-10-30 作り直し（予算案診断Kit・KPI妥当性診断Kitと同じ型）
// 毎月の実績と施策ログから、計画を下回っている課題と、打ち手が効いたかを診断し、KPI管理表（M-B-04、Excel）に仕上げる。
// - 3ステップ：入力する → 診断する（左＝入力、右＝判定、下＝グラフ。直すと判定がすぐ変わる）→ KPI管理表 完成（Excelをダウンロード）
// - 入口は3つ：AIで整えて貼りつける／KPI管理表（.xlsx）を読み込む／画面で入力する。どれも /tools/kpi-analysis/input に移る
// - 入力の項目はKPI管理表の「はじめに入力」「毎月の実績入力」「施策ログ」と同じ。ダウンロードはKPI管理表の全シート＋「診断結果」（PDFはなし）
// - NGが残っていてもダウンロードできる
// 画面の動きは src/scripts/kpi-analysis/app.ts、判定は src/lib/effectCheck.ts、Excelは src/lib/effect-sheet.ts
// サンプル画面：/tools/kpi-analysis/sample（架空の会社のKPI管理表、10月まで入力。診断画面とKPI管理表の完成イメージをタブで切り替え）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import { effectPrompt } from "@/lib/effectCheck";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "施策効果診断Kit";
const TOOL_DESCRIPTION =
  "KPI管理表の毎月の実績と施策ログから、計画を下回っている課題と、打ち手が効いたかを確率で診断する無料のKitです。画面で直すと、そのまま翌月も使えるKPI管理表（Excel）になります。";
const SHEET_URL = "/lab/whitepapers/kpi-management-template";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/kpi-analysis" },
];

const PLAN_TAGS = ["期首", "売上目標", "平均受注単価", "粗利率", "回収期間", "リードタイム", "チャネル別の年間の計画"];
const ACT_TAGS = ["リード数", "有効リード数", "商談数", "受注数", "外部費用・人件費（計画と違う月だけ）"];
const LOG_TAGS = ["狙う指標", "チャネル", "課題", "打ち手", "実施月", "状態", "振り返り"];
---

<BaseLayout title={`${TOOL_TITLE}｜続いている課題と打ち手の効果を診断し、KPI管理表に仕上げる｜MeerKitLab`} description={TOOL_DESCRIPTION} ogImage="/open-graph/tools/kpi-analysis.png">
  <Breadcrumb items={breadcrumbItems} />

  <!-- H1まわりは /lab・/tools と同じ形。.bk の外に置く -->
  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">毎月の振り返りを、勘ではなく数字で。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">毎月の実績と施策ログから、計画を下回っている課題と、打ち手が効いたかを確率で判定します。画面で直すと、そのまま翌月も使えるKPI管理表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk" data-kit="effect" data-mode="intro">
    <section id="bk-intro">
      <p class="bk-for">KPI管理表で毎月の実績を記録している方向けのKitです。KPI管理表がまだない方は <a href="/tools/kpi-sheet-maker">KPI管理表作成Kit →</a></p>

      <div class="bk-band bk-can">
        <h2 class="bk-h2">このKitでわかること</h2>
        <div class="bk-can-g">
          <div class="bk-can-i"><b><i>A</i>月別進捗状況</b><p>指標ごとに、計画を下回っている確率を月別に色分け</p></div>
          <div class="bk-can-i"><b><i>B</i>推移と打ち手</b><p>実績・計画の推移に、打ち手を入れた月を重ねて表示</p></div>
          <div class="bk-can-i"><b><i>C</i>打ち手の効果</b><p>打ち手ごとに、実施後に良くなった確率を表示</p></div>
        </div>
      </div>

      <div class="bk-band">
        <h2 class="bk-h2">3ステップで、施策の効果を診断し、KPI管理表が完成します。</h2>
        <div class="bk-flow">
          <ol class="bk-fsteps">
            <li class="bk-fstep"><span class="bk-no">1</span><div><b>入力する</b><p>AIの案・KPI管理表・画面入力から1つ選ぶ</p></div></li>
            <li class="bk-fstep"><span class="bk-no">2</span><div><b>診断する</b><p>実績や施策ログを直すと、判定がすぐ変わる</p></div></li>
            <li class="bk-fstep"><span class="bk-no">3</span><div><b>KPI管理表 完成</b><p>入れた数字と診断結果をExcelでダウンロード</p></div><span class="bk-xl-tag bk-fstep-xl">XLSX</span></li>
          </ol>
          <a class="bk-shot" href="/tools/kpi-analysis/sample"><img src="/images/tools/kpi-analysis-screen.png" alt="" width="640" height="420" loading="lazy" /><span>診断画面の見本を見る →</span></a>
          <a class="bk-shot" href="/tools/kpi-analysis/sample?tab=sheet"><img src="/images/tools/kpi-analysis-sheet.png" alt="" width="640" height="420" loading="lazy" /><span>KPI管理表の見本を見る →</span></a>
        </div>
      </div>

      <h2 class="bk-h2 bk-h2c">診断をはじめる</h2>
      <p class="bk-sub bk-subc">手元の状態に合うものを1つ選んでください。どれを選んでも、診断の中身は同じです。</p>
      <div class="bk-ents">
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z" /><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" /></svg>実績や打ち手を別の表で記録している</small>
          <b>AIで整えて貼りつける</b>
          <p>プロンプトをAIに渡し、返ってきた結果を貼る</p>
          <button type="button" class="bk-btn" id="bk-ai-open" aria-expanded="false" aria-controls="bk-ai">はじめる<span aria-hidden="true">→</span></button>
        </div>
        <label class="bk-ent bk-drop" id="bk-drop" for="bk-file">
          <svg class="bk-drop-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h8M12 11v8" /></svg>
          <b>KPI管理表（.xlsx）をここに置く</b>
          <span class="bk-drop-hint">Googleスプレッドシート：ファイル → ダウンロード → Microsoft Excel（.xlsx）</span>
          <span class="bk-btn">ファイルを選ぶ</span>
          <span class="bk-drop-hint">ファイルは送信されず、ブラウザの中だけで読みます</span>
        </label>
        <input type="file" id="bk-file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden />
        <div class="bk-ent">
          <small><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="6" width="20" height="12" /><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10" /></svg>数字が手元にある</small>
          <b>画面で入力する</b>
          <p>計画・毎月の実績・施策ログを画面の表に入れる</p>
          <button type="button" class="bk-btn" id="bk-start">入力する<span aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="bk-ai" id="bk-ai" hidden>
        <p class="bk-ai-st">① このプロンプトをコピーして、AIのチャットに貼る（計画・実績・打ち手の記録を一緒に貼る）</p>
        <pre class="bk-prompt" id="bk-prompt" set:text={effectPrompt()}></pre>
        <button type="button" class="bk-btn2" id="bk-copy">プロンプトをコピー</button>
        <p class="bk-ai-st">② AIが返した結果を、ここに貼る</p>
        <textarea class="bk-paste" id="bk-paste" rows="6" placeholder="AIが返したJSON（```json から ``` まで）をそのまま貼りつけます" aria-label="AIが返した結果"></textarea>
        <p class="bk-ai-st">③ 読み込む</p>
        <button type="button" class="bk-btn" id="bk-import">読み込む<span aria-hidden="true">→</span></button>
      </div>

      <p class="bk-busy" id="bk-busy" role="status" hidden>読み込んでいます…</p>
      <p class="bk-err" id="bk-err" role="alert" hidden></p>
      <p class="bk-hint"><a href="/tools/kpi-analysis/sample">サンプル画面を見る（架空の会社、10月まで入力）→</a></p>

      <div class="bk-need">
        <div>
          <p class="bk-need-top"><b>必要な数字</b><span>率は入れません（件数から出します）。使わないチャネルは空欄でかまいません。判定は1か月目の実績から出ます</span></p>
          <dl>
            <dt>計画</dt>
            <dd>{PLAN_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
            <dt>毎月の実績（チャネル別）</dt>
            <dd>{ACT_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
            <dt>施策ログ</dt>
            <dd>{LOG_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
          </dl>
        </div>
        <div class="bk-need-dl">
          <div class="bk-doc" aria-hidden="true"><i></i><b>KPI管理表</b><em></em><em></em></div>
          <div class="bk-need-dl-t">
            <span class="bk-tag-o">スプレッドシートで入力したい方へ</span>
            <b>KPI管理表（無料）</b>
            <p>計画・毎月の実績・施策ログを1つのファイルで管理できる資料です。入力して.xlsxで保存し、上の枠に置くと同じ診断ができます。</p>
          </div>
          <a class="bk-btn2" href={SHEET_URL}>無料でダウンロード<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <ToolFooter path="/tools/kpi-analysis" />
</BaseLayout>

<script>
  import "@/scripts/kpi-analysis/app";
</script>
