---
// src/pages/tools/kpi-analysis.astro
//
// 施策効果診断Kit（/tools/kpi-analysis）。毎月の実績と施策ログから、計画を下回っている課題と打ち手の効果を診断し、KPI管理表（M-B-04、Excel）に仕上げる。
// 2026-11-01：入口・最終チェック・完了をほかのKitと同じ形にした（入力と診断は1画面のまま：/input、src/components/kpi-analysis/EffectGrid.astro）
// 画面の流れ：入口（このページ）→ 入力（/input）→ ② 診断・修正（/check）→ ③ 最終チェック・ダウンロード（/final）→ 完了（/done）
// 2026-11-01：入口の中身を共通の部品（src/components/kit-flow/KitIntro.astro）にした。文言は src/data/kitPages.ts
// 判定：src/lib/effectCheck.ts　Excel：src/lib/effect-sheet.ts　画面：src/scripts/kpi-analysis/app.ts
// ひな形：public/files/tools/kpi-check-template.xlsx（KPI妥当性診断Kitと同じ）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import KitIntro from "@/components/kit-flow/KitIntro.astro";
import { kitPage } from "@/data/kitPages";
import "@/styles/budget-checker.css";
import "@/styles/kpi-analysis.css";

const KIT_ID = "effect";
const p = kitPage(KIT_ID);
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: p.title, href: p.path! },
];
---

<BaseLayout title={p.metaTitle} description={p.description} ogImage={p.ogImage}>
  <Breadcrumb items={breadcrumbItems} />
  <KitIntro kitId={KIT_ID} />
  <ToolFooter path={p.path!} />
</BaseLayout>

<script>
  import "@/scripts/kpi-analysis/app";
</script>
