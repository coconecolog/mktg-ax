---
// キット一覧（/tools）。2026-10-28 やりたいこと別のキット構成にリニューアル。
// 見出しまわりは /library に合わせる。キット・その他の文言は src/data/tools.ts を編集する。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContactCta from "@/components/ContactCta.astro";
import { buildCollectionPageSchema } from "@/lib/schema";
import { ICONS, KIT_GROUPS, OTHER_TOOLS } from "@/data/tools";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "キット一覧", href: "/tools" },
];

const pageDescription =
  "作成キットは、画面で入力しながら判定まで行います。ほかの方法で作った計画は、診断キットで確かめられます。";

const schemaItems = [
  ...KIT_GROUPS.flatMap((g) => g.kits.map((k) => ({ href: k.href, title: k.name }))),
  ...OTHER_TOOLS.map((t) => ({ href: t.href, title: t.title })),
];
const toolsSchema = buildCollectionPageSchema({
  name: "キット一覧",
  description: pageDescription,
  path: "/tools",
  items: schemaItems,
});
---

<BaseLayout
  title="キット一覧"
  description={pageDescription}
  ogImage="/open-graph/tools.png"
  jsonLd={toolsSchema}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10 pb-16 text-ink-950">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">キット一覧</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">やりたいことから、キットを選ぶ。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">{pageDescription}</p>

    <!-- キット（予算・KPI） -->
    <div class="mt-12 grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-2">
      {
        KIT_GROUPS.map((group) => (
          <section>
            <div class="flex flex-wrap items-end justify-between gap-2 border-b-2 border-ink-950 pb-2">
              <h2 class="text-xl font-bold text-ink-950">{group.title}</h2>
              <p class="text-xs text-neutral-500">{group.note}</p>
            </div>
            <ul class="mt-4 space-y-3">
              {group.kits.map((kit) => (
                <li class="border border-neutral-300 bg-white p-5">
                  <div class="flex items-center gap-3">
                    <div class="flex size-11 shrink-0 items-center justify-center bg-[#f8f7f9]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[kit.icon]} />
                    </div>
                    <h3 class="text-lg font-bold leading-snug md:text-xl">{kit.situation}</h3>
                  </div>
                  <p class="mt-3 text-[13px] leading-[1.8] text-neutral-600">{kit.description}</p>
                  <div class="mt-3 flex items-center justify-between gap-3">
                    <p class="text-sm font-bold">{kit.name}</p>
                    <a href={kit.href} class="flex shrink-0 items-center gap-2 bg-ink-950 px-4 py-2 text-[13px] font-bold text-white hover:opacity-85">
                      {kit.button}
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS["arrow-right"]} />
                    </a>
                  </div>
                  {kit.resource && (
                    <p class="mt-4 flex items-start gap-2 border-t border-dashed border-neutral-300 pt-3 text-xs leading-relaxed text-neutral-500">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0" set:html={ICONS["file-text"]} />
                      <span>
                        {kit.resource.before}
                        {kit.resource.before && " "}
                        {kit.resource.href ? (
                          <a href={kit.resource.href} class="font-bold text-ink-950 underline underline-offset-2">{kit.resource.label}</a>
                        ) : (
                          <span class="font-bold text-ink-950">{kit.resource.label}</span>
                        )}
                        {kit.resource.after && ` ${kit.resource.after}`}
                        {!kit.resource.href && <span class="ml-1 border border-neutral-300 px-1 text-[10px] text-neutral-400">準備中</span>}
                      </span>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- その他 -->
    <section class="mt-16">
      <div class="flex flex-wrap items-end justify-between gap-2 border-b-2 border-ink-950 pb-2">
        <h2 class="text-xl font-bold text-ink-950">その他</h2>
        <p class="text-xs text-neutral-500">個別の判断に</p>
      </div>
      <ul class="grid grid-cols-1 gap-x-6 md:grid-cols-2">
        {
          OTHER_TOOLS.map((tool) => (
            <li class="flex gap-4 border-b border-[#dedee2] py-6">
              <div class="flex size-11 shrink-0 items-center justify-center bg-[#f8f7f9]">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[tool.icon]} />
              </div>
              <div class="min-w-0">
                <p class="text-[11px] font-medium text-[#7b7c83]">{tool.category}</p>
                <a href={tool.href} class="mt-1 block text-base font-bold leading-snug hover:underline md:text-[17px]">{tool.title}</a>
                <p class="mt-2 text-[13px] leading-[1.7] text-[#4f5057]">{tool.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-8 text-xs leading-[1.9] text-[#7b7c83]">
      計算・診断結果は、入力した前提に基づく参考情報です。社内の実績や条件に照らし合わせてご判断ください。
    </p>
  </div>

  <ContactCta />
</BaseLayout>
