---
// Kit一覧（/tools）。
// 2026-11-02：カテゴリページ（/lab/category/…）と同じ型に変更。
// H1まわり＋ミーアキャット → 01・02の矢羽根（ページ内リンク）→「01 これから作る」「02 作ったものを確かめる」→「その他のツール」。
// 各セクションは左＝Kit（行全体がリンク）、右＝グレーの枠で資料。Kit数が少ないので検索・絞り込みは置かない。
// 文言は src/data/tools.ts（KIT_GROUPS・KIT_SECTIONS・OTHER_TOOLS）を編集する。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContactCta from "@/components/ContactCta.astro";
import { buildCollectionPageSchema } from "@/lib/schema";
import { getResourceBySlug } from "@/lib/resources";
import { DEFAULT_OG_IMAGE } from "@/consts";
import { KIT_GROUPS, KIT_SECTIONS, OTHER_TOOLS } from "@/data/tools";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
];

const pageDescription =
  "予算とKPI管理表を、画面で入力するだけで作れます。AIや自社で作った計画、毎月の実績は、読み込むだけで診断できます。";

const allKits = KIT_GROUPS.flatMap((g) => g.kits);
const sections = KIT_SECTIONS.map((section) => ({
  ...section,
  kits: allKits.filter((k) => k.kind === section.kind),
  resources: section.resources.map((r) => ({ ...r, thumbnail: getResourceBySlug(r.slug)?.thumbnail || DEFAULT_OG_IMAGE })),
}));

const toolsSchema = buildCollectionPageSchema({
  name: "Kit一覧",
  description: pageDescription,
  path: "/tools",
  items: [...allKits.map((k) => ({ href: k.href, title: k.name })), ...OTHER_TOOLS.map((t) => ({ href: t.href, title: t.title }))],
});

const tagClass = "inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950";
---

<BaseLayout
  title="Kit一覧"
  description={pageDescription}
  ogImage="/open-graph/tools.png"
  jsonLd={toolsSchema}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10 pb-6 text-ink-950">
    {/* ページ見出し（カテゴリページと同じ形） */}
    <div class="flex items-end justify-between gap-6">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">Kit一覧</h1>
        <p class="mt-4 text-lg font-bold text-ink-950">やりたいことから、Kitを選ぶ。</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-500">{pageDescription}</p>
      </div>
      <img src="/images/meerkat/flask-hold.svg" alt="" aria-hidden="true" class="h-24 w-24 shrink-0 sm:mr-8 sm:h-36 sm:w-36" />
    </div>

    {/* 01・02の矢羽根（ページ内リンク） */}
    <div class="mt-10 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-5">
      <ul class="flex min-w-0 flex-1 flex-col gap-2 lg:flex-row lg:gap-0">
        {
          sections.map((s, i) => (
            <li class={`min-w-0 lg:flex-1 ${i > 0 ? "lg:-ml-2" : ""}`}>
              <a href={`#${s.anchor}`} class={`chev group block h-full bg-neutral-300 p-px transition-colors hover:bg-ink-950 ${i === 0 ? "chev-first" : ""}`}>
                <span class={`chev flex h-full items-center gap-4 bg-white py-4 pr-8 pl-4 ${i === 0 ? "chev-first" : "lg:pl-8"}`}>
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink-950 text-sm font-bold tabular-nums text-white">{s.number}</span>
                  <span class="min-w-0">
                    <span class="block text-[15px] font-bold text-ink-950">{s.title}</span>
                    <span class="mt-1 block text-xs text-neutral-500">
                      {s.countLabel} <span class="font-bold text-ink-950 tabular-nums">{s.kits.length}</span>
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="shrink-0 text-xs leading-relaxed text-neutral-500 lg:w-24">どちらからでも使えます</p>
    </div>

    {/* 01 これから作る / 02 作ったものを確かめる */}
    <div class="mt-12">
      {
        sections.map((s) => (
          <section id={s.anchor} class="scroll-mt-24 border-t-2 border-ink-950 pt-8 pb-14">
            <h2 class="flex items-baseline gap-4 text-2xl font-bold tracking-tight text-ink-950">
              <span class="text-3xl font-bold tabular-nums">{s.number}</span>
              <span>{s.title}</span>
            </h2>
            <p class="mt-4 text-sm text-neutral-500">{s.description}</p>

            <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_336px]">
              {/* 左：Kit */}
              <div class="min-w-0">
                <p class="text-sm font-bold text-ink-950">{s.mainLabel}</p>
                <ul class="mt-4 border-t border-neutral-300">
                  {s.kits.map((kit) => (
                    <li class="border-b border-neutral-300">
                      <a href={kit.href} class="group flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:gap-6">
                        <span class="min-w-0 flex-1">
                          <span class="flex flex-wrap items-center gap-2">
                            <span class={tagClass}>{s.countLabel}</span>
                            <span class="text-xs text-neutral-500">{kit.situation}</span>
                          </span>
                          <span class="mt-3 block text-lg font-bold leading-snug text-ink-950 group-hover:underline sm:text-xl">{kit.name}</span>
                          <span class="mt-2 block text-sm leading-relaxed text-neutral-500">{kit.description}</span>
                        </span>
                        <span class="flex w-fit shrink-0 items-center gap-2 bg-ink-950 px-4 py-2.5 text-[13px] font-bold text-white group-hover:opacity-85">
                          {kit.button}
                          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              {/* 右：資料（グレーの枠） */}
              <div class="min-w-0">
                <p class="text-sm font-bold text-ink-950">{s.sideLabel}</p>
                <div class="mt-4 bg-neutral-100 p-5">
                  {s.kind === "create" ? (
                    <ul class="space-y-6">
                      {s.resources.map((r) => (
                        <li>
                          <a href={r.href} class="group block">
                            <span class="block aspect-video overflow-hidden bg-white">
                              <img src={r.thumbnail} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
                            </span>
                            <span class={`mt-3 ${tagClass}`}>無料資料</span>
                            <span class="mt-2 flex items-center justify-between gap-3 text-base font-bold text-ink-950">
                              <span class="group-hover:underline">{r.label}</span>
                              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <>
                      {s.sideNote && <p class="text-xs leading-relaxed text-neutral-500">{s.sideNote}</p>}
                      <ul class="mt-3 border-t border-neutral-300">
                        {s.resources.map((r) => (
                          <li class="border-b border-neutral-300">
                            <a href={r.href} class="group flex items-center gap-3 py-3">
                              <span class={tagClass}>無料資料</span>
                              <span class="min-w-0 flex-1 text-sm font-bold text-ink-950 group-hover:underline">{r.label}</span>
                              <span aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-1">→</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </div>
            </div>
          </section>
        ))
      }

      {/* その他のツール */}
      <section class="border-t-2 border-ink-950 pt-8 pb-10">
        <h2 class="text-2xl font-bold tracking-tight text-ink-950">その他のツール</h2>
        <p class="mt-4 text-sm text-neutral-500">個別の判断に使える、簡易的な計算ツールです。</p>
        <ul class="mt-6 border-t border-neutral-300">
          {
            OTHER_TOOLS.map((tool) => (
              <li class="border-b border-neutral-300">
                <a href={tool.href} class="group flex items-center gap-4 py-4">
                  <span class={tagClass}>ツール</span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium leading-relaxed text-ink-950 group-hover:underline sm:text-[15px]">{tool.title}</span>
                    <span class="mt-0.5 block text-xs leading-relaxed text-neutral-500">{tool.description}</span>
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-ink-950 transition-transform group-hover:translate-x-1">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="text-xs leading-[1.9] text-[#7b7c83]">
        計算・診断結果は、入力した前提に基づく参考情報です。社内の実績や条件に照らし合わせてご判断ください。
      </p>
    </div>
  </div>

  <ContactCta showTags={false} />
</BaseLayout>

<style>
  /* 01・02の矢羽根（カテゴリページと同じ。PCだけ。スマホは四角のまま縦に並べる） */
  @media (min-width: 1024px) {
    .chev {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%, 16px 50%);
    }
    .chev-first {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
    }
  }
</style>
