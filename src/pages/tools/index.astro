---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import MoreExplore from "@/components/MoreExplore.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllCategories, getPopularPosts } from "@/lib/posts";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "便利ツール", href: "/tools" },
];

const categories = getAllCategories();
const popularPosts = getPopularPosts(3).map((p) => ({ slug: p.slug, title: p.title }));

// フィルタータブ。key が下の TOOLS の category と対応する。
const FILTERS = [
  { key: "all", label: "すべて" },
  { key: "revenue-cost", label: "収益・費用シミュレーション" },
  { key: "seo-aeo", label: "SEO / AEO 診断" },
  { key: "org-outsource", label: "体制・外注検討" },
];

const TOOLS = [
  {
    href: "/tools/roas-cac-simulator",
    category: "revenue-cost",
    tag: "広告運用・収益化",
    tagClass: "bg-brand-50 text-brand-700",
    duration: "所要1分",
    title: "広告費用対効果（ROAS/CAC）シミュレーター",
    description:
      "月額単価・粗利率・解約率・獲得単価（CAC）を入力するだけで、LTV/CAC比率と投資回収期間（Payback）を診断します。",
    cta: "シミュレーションを開始 →",
  },
  {
    href: "/tools/seo-aeo-aio-check",
    category: "seo-aeo",
    tag: "SEO・生成AI",
    tagClass: "bg-emerald-50 text-emerald-700",
    duration: "所要2分",
    title: "簡易SEO・AEO・AIO診断チェックリスト",
    description:
      "全15項目のチェックだけで、従来のSEOに加えてAEO（AI検索最適化）・AIO/GEO（生成AI最適化）への対応状況を簡易診断します。",
    cta: "診断をチェックする →",
  },
  {
    href: "/tools/inhouse-vs-outsource",
    category: "org-outsource",
    tag: "組織・コスト",
    tagClass: "bg-violet-50 text-violet-700",
    duration: "所要2分",
    title: "内製 vs 外注 コスト比較シミュレーター",
    description: "マーケティング担当者を採用するか、外注に任せるか。月次・年間コストを試算して比較します。",
    cta: "コスト比較を開始 →",
  },
];
---

<BaseLayout
  title="便利ツール"
  description="日々の意思決定にそのまま使える無料のマーケティング診断・シミュレーションツールを公開しています。"
  ogImage="/open-graph/tools.png"
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-5xl px-5 py-12">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-block rounded-full border border-neutral-200 bg-white px-4 py-1 text-xs font-medium text-neutral-500">
        完全無料・会員登録不要
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-950">実務の意思決定をスピードアップする計算・診断ツール</h1>
      <p class="mt-3 text-neutral-500">入力データはサーバーに保存されません。安心してお手元の数値で試算できます。</p>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-2" id="tool-filters">
      {
        FILTERS.map((filter, i) => (
          <button
            type="button"
            data-filter={filter.key}
            class={`tool-filter-btn rounded-full px-4 py-2 text-sm font-medium transition-colors ${
              i === 0 ? "bg-brand-600 text-white" : "border border-neutral-200 text-neutral-600 hover:border-brand-300"
            }`}
          >
            {filter.label}
            {filter.key === "all" && ` (${TOOLS.length})`}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3" id="tool-cards">
      {
        TOOLS.map((tool) => (
          <div data-category={tool.category} class="tool-card flex flex-col rounded-2xl border border-neutral-100 bg-white p-6">
            <div class="flex items-center justify-between gap-2">
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${tool.tagClass}`}>{tool.tag}</span>
              <span class="shrink-0 text-xs text-neutral-400">🕐 {tool.duration}</span>
            </div>
            <h2 class="mt-4 font-bold text-ink-950">{tool.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-500">{tool.description}</p>
            <a href={tool.href} class="mt-5 block rounded-xl bg-ink-950 px-4 py-2.5 text-center text-sm font-bold text-white hover:bg-neutral-800">
              {tool.cta}
            </a>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-neutral-400">
      追加してほしいツールのご要望は
      <a href="/contact" class="text-brand-700 underline">お問い合わせ</a>よりお気軽にお寄せください。
    </p>

    <MoreExplore
      categories={categories}
      popularPosts={popularPosts}
      categoryHeading="カテゴリから探す"
      popularHeading="💡 あわせて読みたい実践ノウハウ"
    />
  </section>

  <ContactCta />
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll(".tool-filter-btn")) as HTMLButtonElement[];
  const cards = Array.from(document.querySelectorAll(".tool-card")) as HTMLElement[];

  const activeClasses = ["bg-brand-600", "text-white"];
  const inactiveClasses = ["border", "border-neutral-200", "text-neutral-600"];

  function setActive(button: HTMLButtonElement) {
    filterButtons.forEach((btn) => {
      btn.classList.remove(...activeClasses, ...inactiveClasses);
      btn.classList.add(...(btn === button ? activeClasses : inactiveClasses));
    });
  }

  function applyFilter(key: string) {
    cards.forEach((card) => {
      const show = key === "all" || card.dataset.category === key;
      card.classList.toggle("hidden", !show);
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.filter || "all";
      setActive(btn);
      applyFilter(key);
    });
  });
</script>
