---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "便利ツール", href: "/tools" },
];
---

<BaseLayout
  title="便利ツール"
  description="日々の意思決定にそのまま使える無料のマーケティング診断・シミュレーションツールを公開しています。"
  ogImage="/open-graph/tools.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">便利ツール</h1>
    <p class="mt-3 text-neutral-500">
      日々の意思決定にそのまま使える無料ツールを公開しています。数値はブラウザ内だけで計算され、送信・保存はされません。
    </p>

    <div class="mt-10 grid grid-cols-1 gap-5">
      <a
        href="/tools/seo-aeo-aio-check"
        class="block rounded-2xl border border-neutral-100 bg-white p-6 transition-shadow hover:shadow-lg md:p-8"
      >
        <h2 class="text-xl font-bold text-ink-950">簡易SEO・AEO・AIO診断チェックリスト</h2>
        <p class="mt-2 text-sm text-neutral-500">
          全15項目のチェックだけで、従来のSEOに加えてAEO（AI検索最適化）・AIO/GEO（生成AI最適化）への対応状況を簡易診断します。
        </p>
        <span class="mt-4 inline-block text-sm font-medium text-brand-700">ツールを使う →</span>
      </a>

      <div class="rounded-2xl border border-neutral-100 bg-neutral-50 p-6 opacity-70 md:p-8">
        <span class="inline-block rounded-full bg-neutral-200 px-2.5 py-0.5 text-xs font-medium text-neutral-600">
          準備中
        </span>
        <h2 class="mt-2 text-xl font-bold text-ink-950">内製 vs 外注 コスト比較シミュレーター</h2>
        <p class="mt-2 text-sm text-neutral-500">
          マーケティング担当者を採用するか、外注に任せるか。月次・年間コストを試算して比較します。
        </p>
      </div>
    </div>

    <p class="mt-10 text-sm text-neutral-400">
      追加してほしいツールのご要望は
      <a href="/contact" class="text-brand-700 underline">お問い合わせ</a>よりお気軽にお寄せください。
    </p>
  </section>
</BaseLayout>
