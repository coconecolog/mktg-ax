---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import MoreExplore from "@/components/MoreExplore.astro";
import ContactCta from "@/components/ContactCta.astro";
import ToolCard from "@/components/ToolCard.astro";
import { getAllCategories, getPopularPosts } from "@/lib/posts";
import { getAllTools, getToolCategories } from "@/lib/tools";
import { buildCollectionPageSchema } from "@/lib/schema";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "便利ツール", href: "/tools" },
];

const categories = getAllCategories();
const popularPosts = getPopularPosts(3).map((p) => ({ slug: p.slug, title: p.title }));

// ツールはNotionのツールDB（src/lib/tools.ts）から取得する。フィルタータブは、ツールが1件以上あるカテゴリから自動で作る。
const tools = getAllTools();
const filterCategories = getToolCategories();

const pageDescription = "日々の意思決定にそのまま使える無料のマーケティング診断・シミュレーションツールを公開しています。";
const toolsSchema = buildCollectionPageSchema({
  name: "便利ツール",
  description: pageDescription,
  path: "/tools",
  items: tools.map((t) => ({ href: t.href, title: t.title })),
});
---

<BaseLayout
  title="便利ツール"
  description={pageDescription}
  ogImage="/open-graph/tools.png"
  jsonLd={toolsSchema}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-5xl px-5 py-12">
    <div class="mx-auto text-center">
      <span class="inline-block rounded-full border border-neutral-200 bg-white px-4 py-1 text-xs font-medium text-neutral-500">
        完全無料・会員登録不要
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink-950">実務の意思決定をスピードアップする計算・診断ツール</h1>
      <p class="mt-3 text-neutral-500">入力データはサーバーに保存されません。安心してお手元の数値で試算できます。</p>
    </div>

    {
      filterCategories.length > 0 && (
        <div class="mt-8 flex flex-wrap justify-center gap-2" id="tool-filters">
          <button
            type="button"
            data-filter="all"
            class="tool-filter-btn rounded-full bg-brand-600 px-4 py-2 text-sm font-medium text-white transition-colors"
          >
            すべて ({tools.length})
          </button>
          {filterCategories.map((name) => (
            <button
              type="button"
              data-filter={name}
              class="tool-filter-btn rounded-full border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:border-brand-300"
            >
              {name}
            </button>
          ))}
        </div>
      )
    }

    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3" id="tool-cards">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>

    <p class="mt-10 text-sm text-neutral-400">
      追加してほしいツールのご要望は
      <a href="/contact" class="text-brand-700 underline">お問い合わせ</a>よりお気軽にお寄せください。
    </p>

    <MoreExplore
      categories={categories}
      popularPosts={popularPosts}
      categoryHeading="カテゴリから探す"
      popularHeading="💡 あわせて読みたい実践ノウハウ"
    />
  </section>

  <ContactCta />
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll(".tool-filter-btn")) as HTMLButtonElement[];
  const cards = Array.from(document.querySelectorAll(".tool-card")) as HTMLElement[];

  const activeClasses = ["bg-brand-600", "text-white"];
  const inactiveClasses = ["border", "border-neutral-200", "text-neutral-600"];

  function setActive(button: HTMLButtonElement) {
    filterButtons.forEach((btn) => {
      btn.classList.remove(...activeClasses, ...inactiveClasses);
      btn.classList.add(...(btn === button ? activeClasses : inactiveClasses));
    });
  }

  function applyFilter(key: string) {
    cards.forEach((card) => {
      const show = key === "all" || (card.dataset.categories || "").split("|").includes(key);
      card.classList.toggle("hidden", !show);
    });
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.filter || "all";
      setActive(btn);
      applyFilter(key);
    });
  });
</script>
