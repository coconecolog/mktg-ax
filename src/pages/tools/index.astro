---
// Kit一覧（/tools）。
// 2026-11-15 作り直し：「01 分析する」（メインのKit 3つ。画面の画像つきの大きなカード）→「02 カテゴリから探す」（記事のカテゴリごとに、すべてのKit・ツール・資料）。
// 以前の「これから作る／作ったものを確かめる」と「その他のツール」の枠はなくした。
// 文言は src/data/tools.ts（KIT_GROUPS・MAIN_KITS・TOOL_CATEGORIES・OTHER_TOOLS）を編集する。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContactCta from "@/components/ContactCta.astro";
import { buildCollectionPageSchema } from "@/lib/schema";
import { getCategoryPath } from "@/lib/posts";
import { KIT_GROUPS, MAIN_KITS, OTHER_TOOLS, TOOL_CATEGORIES } from "@/data/tools";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
];

const pageDescription =
  "GA4・Search Console・KPI管理表の数字から、悪化したところと次に直すところを出します。予算とKPI管理表を作るKitもあります。";

const allKits = KIT_GROUPS.flatMap((g) => g.kits);
const mainHrefs = new Set<string>(MAIN_KITS.map((m) => m.href));
const mainCards = MAIN_KITS.map((m) => ({ ...m, kit: allKits.find((k) => k.href === m.href)! })).filter((m) => m.kit);

type Item = { type: "kit" | "tool"; title: string; description: string; href: string; main: boolean };
const findItem = (href: string): Item | null => {
  const kit = allKits.find((k) => k.href === href);
  if (kit) return { type: "kit", title: kit.name, description: kit.description, href, main: mainHrefs.has(href) };
  const tool = OTHER_TOOLS.find((t) => t.href === href);
  if (tool) return { type: "tool", title: tool.title, description: tool.description, href, main: false };
  return null;
};
const categories = TOOL_CATEGORIES.map((c) => ({
  ...c,
  path: getCategoryPath(c.name),
  items: c.hrefs.map(findItem).filter((x): x is Item => !!x),
}));

const toolsSchema = buildCollectionPageSchema({
  name: "Kit一覧",
  description: pageDescription,
  path: "/tools",
  items: [...allKits.map((k) => ({ href: k.href, title: k.name })), ...OTHER_TOOLS.map((t) => ({ href: t.href, title: t.title }))],
});

const tagClass = "inline-flex shrink-0 items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950";
---

<BaseLayout
  title="Kit一覧"
  description={pageDescription}
  ogImage="/open-graph/tools.png"
  jsonLd={toolsSchema}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10 pb-6 text-ink-950">
    {/* ページ見出し */}
    <div class="flex items-end justify-between gap-6">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">Kit一覧</h1>
        <p class="mt-4 text-lg font-bold text-ink-950">毎月の数字を、Kitで分析する。</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-500">{pageDescription}</p>
      </div>
      <img src="/images/meerkat/flask-hold.svg" alt="" aria-hidden="true" class="h-24 w-24 shrink-0 sm:mr-8 sm:h-36 sm:w-36" />
    </div>

    {/* 01 分析する（メインのKit） */}
    <section id="analyze" class="mt-10 scroll-mt-24 border-t-2 border-ink-950 pt-8 pb-14">
      <h2 class="flex items-baseline gap-4 text-2xl font-bold tracking-tight text-ink-950">
        <span class="text-3xl font-bold tabular-nums">01</span>
        <span>分析する</span>
      </h2>
      <p class="mt-4 text-sm text-neutral-500">毎月の数字をつなぐ・読み込むだけで、判定と対策が出ます。</p>
      <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          mainCards.map(({ kit, image, data }) => (
            <li>
              <a href={kit.href} class="group flex h-full flex-col border-[1.5px] border-ink-950 bg-white">
                <span class="block aspect-[16/10] overflow-hidden border-b border-neutral-200 bg-neutral-100">
                  <img src={image} alt="" loading="lazy" class="h-full w-full object-cover object-left-top transition-transform duration-300 group-hover:scale-[1.02]" />
                </span>
                <span class="flex flex-1 flex-col gap-2 p-5">
                  <span class={`${tagClass} w-fit`}>Kit</span>
                  <span class="text-xs text-neutral-500">{kit.situation}</span>
                  <span class="text-lg font-bold leading-snug text-ink-950 group-hover:underline sm:text-xl">{kit.name}</span>
                  <span class="text-sm leading-relaxed text-neutral-600">{kit.description}</span>
                  <span class="flex flex-wrap gap-1.5">
                    {data.map((d) => <span class="border border-neutral-200 bg-neutral-100 px-2 py-0.5 text-[11px] text-neutral-700">{d}</span>)}
                  </span>
                  <span class="mt-auto flex w-fit items-center gap-2 bg-ink-950 px-4 py-2.5 text-[13px] font-bold text-white group-hover:opacity-85">
                    {kit.button}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 02 カテゴリから探す（すべてのKit・ツール・資料） */}
    <section id="category" class="scroll-mt-24 border-t-2 border-ink-950 pt-8 pb-10">
      <h2 class="flex items-baseline gap-4 text-2xl font-bold tracking-tight text-ink-950">
        <span class="text-3xl font-bold tabular-nums">02</span>
        <span>カテゴリから探す</span>
      </h2>
      <p class="mt-4 text-sm text-neutral-500">記事のカテゴリと同じ分け方で、すべてのKit・ツール・資料を並べています。</p>
      <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-2">
        {
          categories.map((c) => (
            <section class="bg-neutral-100 p-5" aria-label={c.name}>
              <div class="flex items-baseline justify-between gap-3 border-b-[1.5px] border-ink-950 pb-2">
                <h3 class="text-base font-bold text-ink-950">{c.name}</h3>
                <a href={c.path} class="group shrink-0 text-xs font-bold text-ink-950 hover:underline">
                  カテゴリの記事<span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
                </a>
              </div>
              <ul>
                {c.items.map((it) => (
                  <li class="border-b border-neutral-300">
                    <a href={it.href} class="group flex items-start gap-3 py-3">
                      <span class={`${tagClass} mt-0.5`}>{it.type === "kit" ? "Kit" : "ツール"}</span>
                      <span class="min-w-0 flex-1">
                        <span class="text-sm font-bold text-ink-950 group-hover:underline">{it.title}</span>
                        {it.main && <span class="ml-2 bg-ink-950 px-1.5 py-0.5 text-[10px] font-bold text-white">メイン</span>}
                        {!it.main && <span class="mt-0.5 block text-xs leading-relaxed text-neutral-500">{it.description}</span>}
                      </span>
                      <span aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-1">→</span>
                    </a>
                  </li>
                ))}
                {c.resources.map((r) => (
                  <li class="border-b border-neutral-300">
                    <a href={r.href} class="group flex items-center gap-3 py-3">
                      <span class="inline-flex shrink-0 items-center bg-ink-950 px-1.5 py-0.5 text-[11px] font-bold leading-none text-white">無料資料</span>
                      <span class="min-w-0 flex-1 text-sm font-bold text-ink-950 group-hover:underline">{r.label}</span>
                      <span aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-1">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <p class="text-xs leading-[1.9] text-[#7b7c83]">
      計算・診断結果は、入力した前提に基づく参考情報です。社内の実績や条件に照らし合わせてご判断ください。
    </p>
  </div>

  <ContactCta />
</BaseLayout>
