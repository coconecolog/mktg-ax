  }

  .cost-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.3rem;
    font-size: 0.85rem;
  }
  .cost-table th, .cost-table td {
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid #eee;
    text-align: left;
  }
  .cost-table thead th { color: #666; font-weight: 600; font-size: 0.78rem; }
  .cost-table .col-num { text-align: right; white-space: nowrap; }
  .cost-table .col-desc { color: #888; font-size: 0.78rem; }
  .cost-table input {
    width: 90px;
    padding: 0.35rem 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    text-align: right;
  }
  .cost-table .reserve-row td { color: #888; font-size: 0.82rem; }
  .cost-table .total-row td { font-weight: 700; color: var(--color-accent, #2563eb); border-top: 2px solid #ddd; border-bottom: none; }

  #run-btn {
    display: block;
    margin: 0.5rem auto 0;
    padding: 0.9rem 2rem;
