  }
  .preset-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #222;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .preset-badge {
    font-size: 0.68rem;
    background: var(--color-accent, #2563eb);
    color: #fff;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-weight: 700;
  }
  .preset-desc { font-size: 0.78rem; color: #666; line-height: 1.5; }

  .field-group {
    border: 1px solid #e2e2e2;
