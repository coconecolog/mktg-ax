---
// src/pages/tools/budget-simulator.astro
//
// マーケティング予算シミュレーター（/tools/budget-simulator）
// 仕様: Googleドライブ「MKTG.AX／共有（正本）／04_ツール仕様／予算シミュレーターの仕様」6. 修正（2026-10-17／10-18）
// 数字の定義: 同「数字の定義（KPI・予算）」。計算は src/lib/budget-calc.ts（予算案チェッカーと共通）
// - 計算はすべてブラウザ内。入力した数字はサーバーに送らない
// - 金額は万円（時間単価だけ円）。費用＝外部費用＋人件費。人件費は総額を施策の時間の比で配る
// - 結論のカードは逆算の受注件数で出す。シナリオは ROUND(計画リード×率×率) の受注件数で出す
// - 記入例は架空の会社（基本モデル）の成長期
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import { metricUrl } from "@/lib/budget-calc";
import type { MetricKey } from "@/lib/budget-calc";

const def = (key: MetricKey) => metricUrl(key);
---

<BaseLayout
  title="マーケティング予算シミュレーター｜MKTG.AX"
  description="来期の売上目標から必要な受注・商談・リード数を逆算し、人件費込みの費用で回収期間・CAC・ROI（1年）と施策ごとのCPL判定まで出す無料ツールです。"
  ogImage="/open-graph/default.png"
>
  <main class="bs">
    <header class="bs-head no-print">
      <p class="bs-eyebrow"><a href="/tools">便利ツール</a></p>
      <h1>マーケティング予算シミュレーター</h1>
      <p class="bs-lead">来期の売上目標から必要な受注・商談・リード数を逆算し、人件費込みの費用で回収期間・CAC・ROI（1年）と施策ごとのCPLの判定まで出した計画書を作ります（金額は万円）。</p>
    </header>

    <div class="bs-grid">
      <!-- ===== 入力 ===== -->
      <div class="bs-in no-print">
        <div class="bs-tools">
          <button type="button" class="bs-link" id="bs-example">記入例を入れる</button>
          <button type="button" class="bs-link" id="bs-clear">入力をすべて消す</button>
        </div>
        <p class="bs-note bs-note-r">記入例は架空の会社（基本モデル）の成長期の数字です</p>

        <section class="bs-sec">
          <h2 class="bs-st">1. 前提</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">平均単価（1社あたりの年間の取引額）</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="price" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">粗利率</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.1" data-k="margin" /><span>%</span></span></label>
            <label class="bs-field"><span class="bs-lb">取り返す年数</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="0.1" data-k="years" /><span>年</span></span></label>
            <div class="bs-field">
              <span class="bs-lb">事業の段階</span>
              <div class="bs-chips" role="radiogroup" aria-label="事業の段階" id="bs-stage">
                <button type="button" class="bs-chip" role="radio" data-stage="intro">導入期</button>
                <button type="button" class="bs-chip" role="radio" data-stage="growth">成長期</button>
                <button type="button" class="bs-chip" role="radio" data-stage="stable">安定期</button>
              </div>
            </div>
          </div>
          <p class="bs-note">取り返す年数は、獲得の費用を何年で取り返すかを自社で決める値です（小数可）。事業の段階は、防衛：攻撃の目安（導入期5：5、成長期7：3、安定期6：4）に使います</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">2. 目標（来期）</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">全社の売上目標</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="target" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">マーケ経由の割合</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.1" data-k="mktRatio" /><span>%</span></span></label>
          </div>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">3. 今期の実績</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">売上<small>任意</small></span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="nowSales" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">マーケ経由の売上<small>任意</small></span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="nowMktSales" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">リード数</span><span class="bs-ip"><input type="number" inputmode="numeric" min="0" step="1" data-k="nowLeads" /><span>件</span></span></label>
            <label class="bs-field"><span class="bs-lb">商談数</span><span class="bs-ip"><input type="number" inputmode="numeric" min="0" step="1" data-k="nowDeals" /><span>件</span></span></label>
            <label class="bs-field"><span class="bs-lb">受注数</span><span class="bs-ip"><input type="number" inputmode="numeric" min="0" step="1" data-k="nowWins" /><span>件</span></span></label>
            <label class="bs-field"><span class="bs-lb">失注数</span><span class="bs-ip"><input type="number" inputmode="numeric" min="0" step="1" data-k="nowLosses" /><span>件</span></span></label>
          </div>
          <p class="bs-rates" id="bs-rates"></p>
          <p class="bs-note">商談化率＝商談数÷リード数、受注率＝受注数÷（受注数＋失注数）。受注率は決着した商談だけで出します</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">4. 施策<small>万円・時間／年・件</small></h2>
          <div id="bs-rows"></div>
          <button type="button" class="bs-add" id="bs-add">＋ 施策を追加</button>
          <p class="bs-note">時間は、マーケがこの施策にかける時間（年間）。集計・報告、営業との連携、予算づくりなど共通の作業は入れません。リードを生まない費用（ツール・サイト保守など）はリード数0で、判定は「―」になります。今期の欄は、わからなければ空欄で構いません</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">5. 人件費（来期）<small>1行＝1人またはグループ</small></h2>
          <div id="bs-labor"></div>
          <button type="button" class="bs-add" id="bs-labor-add">＋ 行を追加</button>
          <label class="bs-check"><input type="checkbox" id="bs-sales" />営業が施策に協力する時間（展示会の立ち会い、事例の取材、登壇など）を含めた</label>
          <p class="bs-note">人件費（万円）＝時間×時間単価÷10,000。時間がわからないときは人件費を直接入れます。時間には、施策の時間と共通の作業の時間をすべて含めます。施策ごとの人件費は、この総額を施策の時間の比で配ります</p>
          <label class="bs-field bs-mt8"><span class="bs-lb">今期の人件費（合計）<small>任意</small></span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="laborNow" /><span>万円</span></span></label>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">6. 予算の上限<small>任意</small></h2>
          <label class="bs-field"><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="cap" aria-label="予算の上限" /><span>万円</span></span></label>
        </section>

        <p class="bs-err" id="bs-err" role="alert" hidden>未入力の項目があります。赤枠の欄を入力してください。</p>
        <button type="button" class="bs-btn" id="bs-run">計画書を作る</button>
      </div>

      <!-- ===== 計画書 ===== -->
      <div class="bs-out">
        <div class="bs-bar no-print">
          <div class="bs-sw">
            <span>シナリオ：</span>
            <div class="bs-chips" role="radiogroup" aria-label="シナリオ" id="bs-scenario">
              <button type="button" class="bs-chip" role="radio" data-sc="pess">悲観（−2割）</button>
              <button type="button" class="bs-chip" role="radio" data-sc="base">標準</button>
              <button type="button" class="bs-chip" role="radio" data-sc="opt">楽観（＋2割）</button>
            </div>
          </div>
          <button type="button" class="bs-obtn" id="bs-print">印刷／PDF</button>
        </div>

        <div class="bs-rp" id="bs-report">
          <div class="bs-rh">
            <div>
              <h2 class="bs-rt">来期 マーケティング予算計画書（案）</h2>
              <p class="bs-rs" id="r-sub">今期の実績の率から逆算・金額は万円・費用は外部費用＋人件費</p>
            </div>
            <p class="bs-rs" id="r-date"></p>
          </div>

          <p class="bs-empty" id="r-empty" hidden></p>

          <div id="r-body">
            <div class="bs-top">
              <div class="bs-dark">
                <div class="bs-k">
                  <div><p class="bs-kl">回収期間<a class="bs-def no-print" href={def("payback")}>定義</a></p><p class="bs-kv bs-big"><span id="r-payback"></span><small>か月</small></p><p class="bs-ks" id="r-payback-s"></p></div>
                  <div><p class="bs-kl">CAC<a class="bs-def no-print" href={def("cac")}>定義</a></p><p class="bs-kv bs-big"><span id="r-cac"></span><small>万円</small></p><p class="bs-ks" id="r-cac-s"></p></div>
                  <div><p class="bs-kl">ROI（1年）<a class="bs-def no-print" href={def("roi")}>定義</a></p><p class="bs-kv bs-big"><span id="r-roi"></span></p><p class="bs-ks">（受注金額×粗利率−費用）÷費用</p></div>
                </div>
                <p class="bs-base" id="r-base"></p>
                <hr />
                <div class="bs-k">
                  <div><p class="bs-kl">来期の費用（合計）</p><p class="bs-kv"><span id="r-total"></span><small>万円</small></p><p class="bs-ks" id="r-total-s"></p></div>
                  <div><p class="bs-kl">予算の上限との差</p><p class="bs-kv" id="r-cap"></p><p class="bs-ks" id="r-cap-s"></p></div>
                  <div><p class="bs-kl">許容CPL<a class="bs-def no-print" href={def("allowableCpl")}>定義</a></p><p class="bs-kv"><span id="r-acpl"></span><small>万円</small></p><p class="bs-ks" id="r-acpl-s"></p></div>
                </div>
              </div>

              <div class="bs-box">
                <p class="bs-h"><span>逆算<a class="bs-def no-print" href={def("backcast")}>定義</a></span><small id="r-flow-sc"></small></p>
                <div class="bs-flow"><div class="bs-fc"><p class="l">マーケ経由の売上目標</p><p class="v" id="r-mktsales"></p><p class="s" id="r-mktsales-s"></p></div></div>
                <p class="bs-growth" id="r-growth"></p>
                <div class="bs-flow bs-flow3">
                  <div class="bs-fc"><p class="l">受注件数</p><p class="v" id="r-won"></p><p class="s" id="r-won-s"></p></div>
                  <span class="bs-arr">→</span>
                  <div class="bs-fc"><p class="l">商談数</p><p class="v" id="r-opp"></p><p class="s" id="r-opp-s"></p></div>
                  <span class="bs-arr">→</span>
                  <div class="bs-fc"><p class="l">リード数</p><p class="v" id="r-lead"></p><p class="s" id="r-lead-s"></p></div>
                </div>
                <div class="bs-cap"><span id="r-leadcheck"></span><span id="r-leadtag"></span></div>
              </div>
            </div>

            <div class="bs-row2">
              <div class="bs-box">
                <p class="bs-h"><span>費用<a class="bs-def no-print" href={def("laborCost")}>定義</a></span><small>万円</small></p>
                <table class="bs-t">
                  <thead><tr><th></th><th>今期</th><th>来期</th><th>差</th></tr></thead>
                  <tbody id="r-cost"></tbody>
                </table>
              </div>
              <div class="bs-box">
                <p class="bs-h"><span>防衛：攻撃</span><small>費用（外部費用＋人件費）の比率</small></p>
                <div class="bs-ratio" id="r-ratio"></div>
                <div class="bs-ratio bs-ratio-t" id="r-ratio-t"></div>
                <p class="bs-lg" id="r-ratio-s"></p>
              </div>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h"><span>施策ごとのCPL<a class="bs-def no-print" href={def("cpl")}>定義</a><a class="bs-def no-print" href={def("judgment")}>判定</a></span><small id="r-cpl-s"></small></p>
              <div class="bs-tw">
                <table class="bs-t">
                  <thead><tr><th>施策</th><th class="c">区分</th><th>外部費用</th><th>人件費</th><th>費用合計</th><th>リード数</th><th>CPL</th><th class="c">判定</th></tr></thead>
                  <tbody id="r-ins"></tbody>
                </table>
              </div>
              <p class="bs-fx">人件費は、人件費の総額を施策の時間の比で配った値（万円の整数）<a class="bs-def no-print" href={def("laborAllocation")}>定義</a>。CPL＝費用合計÷リード数。CPLが許容CPL以下なら「上限内」、超えたら「上限超え」</p>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h"><span>シナリオ<a class="bs-def no-print" href={def("scenario")}>定義</a></span><small>商談化率と受注率を −2割／そのまま／＋2割。受注件数＝計画リード数×商談化率×受注率（四捨五入）</small></p>
              <div class="bs-sc" id="r-sc"></div>
            </div>

            <div class="bs-box bs-mt bs-warn" id="r-warn-box" hidden>
              <p class="bs-h"><span>要確認</span></p>
              <ul id="r-warn"></ul>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h"><span>経営層のための指標の読み方<a class="bs-def no-print" href={def("explain")}>定義</a></span></p>
              <div class="bs-gg">
                <div class="bs-gb"><b>回収期間（説明の主役）</b>1社を獲得する費用（CAC）を、受注した会社の粗利で何か月で取り返すか。<code>回収期間＝CAC÷（平均単価×粗利率÷12）<br />CAC＝費用合計÷受注件数</code></div>
                <div class="bs-gb"><b>CACの上限と許容CPL</b>決めた年数のうちに取り返せる獲得の費用の上限と、それをリード1件あたりに直した値。施策のCPLが許容CPL以下なら上限内です。<code>CACの上限＝平均単価×粗利率×取り返す年数<br />許容CPL＝CACの上限×商談化率×受注率</code></div>
                <div class="bs-gb"><b>ROI（1年）</b>1年の粗利から費用を引いた利益の、費用に対する割合。初年度はマイナスになることもあるため、回収期間と並べて示します。<code>ROI＝（受注金額×粗利率−費用合計）÷費用合計<br />受注金額＝受注件数×平均単価</code></div>
              </div>
              <p class="bs-fx">受注件数は、マーケ経由の売上目標から逆算した件数。費用＝外部費用＋人件費。人件費は、共通の作業の時間も含めた総額を施策の時間の比で配ります。予備費は持たず、期中に足りなくなったら追加予算の稟議で扱います。</p>
            </div>

            <div class="bs-ft">
              <div><b>重点施策の方針</b><span id="r-policy"></span></div>
              <div><b>リスク</b><span id="r-risk"></span></div>
              <div><b>お願い</b><span id="r-ask"></span></div>
            </div>
            <p class="bs-src">指標の定義は「数字の定義（KPI・予算）」による：mktg.ax/standards/metrics　金額は万円</p>
          </div>
        </div>

        <a class="bs-checker no-print" href="/tools/budget-checker">
          <span><b>AIで作った予算案を確かめる</b>生成AIで作った予算案を、人件費込みのCPL・CAC・回収期間で判定します</span>
          <span aria-hidden="true">予算案チェッカー →</span>
        </a>
      </div>
    </div>
  </main>

  <ToolFooter path="/tools/budget-simulator" />
</BaseLayout>

<style is:global>
  .bs { max-width: 1240px; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: #0b0b12; font-variant-numeric: tabular-nums; }
  .bs p { margin: 0; }
  .bs-eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; color: #737373; }
  .bs-eyebrow a { color: inherit; text-decoration: none; }
  .bs-eyebrow a:hover { text-decoration: underline; }
  .bs-head h1 { margin: 0.25rem 0 0.4rem; font-size: 1.7rem; font-weight: 800; line-height: 1.35; }
  .bs-lead { color: #525252; line-height: 1.7; margin-bottom: 1.25rem !important; }

  .bs-grid { display: grid; grid-template-columns: 370px minmax(0, 1fr); gap: 24px; align-items: start; }

  /* ===== 入力 ===== */
  .bs-in { border: 1px solid #e5e5e5; border-radius: 12px; padding: 14px 16px 16px; background: #fff; min-width: 0; }
  .bs-tools { display: flex; justify-content: flex-end; gap: 12px; }
  .bs-link { background: none; border: 0; padding: 0; font-size: 0.75rem; color: #525252; text-decoration: underline; cursor: pointer; }
  .bs-link[data-armed="1"] { color: #b91c1c; font-weight: 700; }
  .bs-note-r { text-align: right; margin-top: 2px !important; }
  .bs-sec { border-bottom: 1px solid #ececec; padding: 12px 0 14px; }
  .bs-st { font-size: 0.8rem; font-weight: 800; margin: 0 0 8px; }
  .bs-st small { font-weight: 400; color: #8a8a8a; margin-left: 6px; font-size: 0.7rem; }
  .bs-f { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .bs-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .bs-lb { font-size: 0.72rem; font-weight: 600; color: #404040; line-height: 1.4; }
  .bs-lb small { font-weight: 400; color: #8a8a8a; margin-left: 4px; }
  .bs-ip { display: flex; align-items: center; gap: 6px; min-width: 0; border: 1px solid #d4d4d4; border-radius: 8px; background: #fff; padding: 0 8px; }
  .bs-ip:focus-within { border-color: #0b0b12; outline: 1px solid #0b0b12; }
  .bs-ip input { flex: 1 1 0; width: 0; min-width: 0; border: 0; outline: 0; background: transparent; padding: 6px 0; font-size: 0.9rem; color: #0b0b12; }
  .bs-ip input[readonly] { color: #525252; }
  .bs-ip > span { font-size: 0.72rem; color: #737373; flex-shrink: 0; }
  .bs-note { font-size: 0.68rem; color: #8a8a8a; line-height: 1.55; margin-top: 6px !important; }
  .bs-rates { font-size: 0.75rem; color: #0b0b12; background: #f6f6f6; border-radius: 6px; padding: 5px 8px; margin-top: 8px !important; line-height: 1.6; }
  .bs-rates:empty { display: none; }
  .bs-chips { display: flex; gap: 4px; flex-wrap: wrap; }
  .bs-chip { white-space: nowrap; border: 1px solid #d4d4d4; border-radius: 999px; background: #fff; padding: 4px 10px; font-size: 0.72rem; color: #404040; cursor: pointer; }
  .bs-chip[aria-checked="true"] { background: #0b0b12; border-color: #0b0b12; color: #fff; }
  .bs-ini { border: 1px solid #e5e5e5; border-radius: 8px; padding: 8px; margin-bottom: 6px; }
  .bs-ini-h { display: flex; gap: 6px; align-items: center; margin-bottom: 5px; }
  .bs-ini-name { flex: 1; min-width: 0; border: 1px solid transparent; border-radius: 6px; padding: 2px 4px; font-size: 0.78rem; font-weight: 800; color: #0b0b12; background: transparent; }
  .bs-ini-name:hover { border-color: #e5e5e5; }
  .bs-ini-name:focus { border-color: #0b0b12; outline: 0; }
  .bs-seg { display: inline-flex; border: 1px solid #d4d4d4; border-radius: 6px; overflow: hidden; flex-shrink: 0; }
  .bs-seg button { border: 0; background: #fff; padding: 2px 8px; font-size: 0.66rem; color: #404040; cursor: pointer; }
  .bs-seg button[aria-checked="true"] { background: #0b0b12; color: #fff; }
  .bs-del { border: 0; background: none; color: #8a8a8a; font-size: 0.95rem; line-height: 1; cursor: pointer; padding: 2px 4px; flex-shrink: 0; }
  .bs-del:hover { color: #b91c1c; }
  .bs-it { width: 100%; border-collapse: collapse; font-size: 0.7rem; table-layout: fixed; }
  .bs-it th { font-weight: 600; color: #737373; text-align: right; padding: 1px 4px; }
  .bs-it th:first-child, .bs-it td:first-child { text-align: left; white-space: nowrap; color: #404040; width: 40%; }
  .bs-it td { padding: 1px 4px; text-align: right; }
  .bs-it td.na { color: #bdbdbd; padding-right: 10px; }
  .bs-it input { width: 100%; box-sizing: border-box; border: 1px solid #d4d4d4; border-radius: 5px; padding: 2px 6px; text-align: right; font-size: 0.75rem; color: #0b0b12; background: #fff; }
  .bs-it input:focus { outline: 1px solid #0b0b12; border-color: #0b0b12; }
  .bs-it input::placeholder { color: #bdbdbd; }
  .bs-lab { border: 1px solid #e5e5e5; border-radius: 8px; padding: 8px; margin-bottom: 6px; }
