---
// src/pages/tools/budget-simulator.astro
//
// 予算作成Kit（旧マーケティング予算シミュレーター、/tools/budget-simulator）2026-10-30 作り直し
// 予算がまだない人向け。売上目標と今期の実績から必要なリード数を逆算し、チャネルにリード数と費用を配って、年間予算表（M-B-03、Excel）を作る。
// - 入口は「画面で作成をはじめる」だけ（AI・ファイルの読み込みはなし）。画面で作らない人は、同じ表のスプレッドシート（年間予算表）をDLする
// - 3ステップ：目標と実績を入れる → チャネルに配る（左＝入力、右＝判定）→ 年間予算表 完成（Excelをダウンロード）
// - 予算案がもうある人は予算案診断Kit（/tools/budget-checker）へ
// 入力の画面：/tools/budget-simulator/input　サンプル画面：/tools/budget-simulator/sample
// 計算：src/lib/budgetMake.ts（判定は予算案診断キットと同じ src/lib/budgetCheck.ts）　画面：src/scripts/budget-checker/app.ts（data-kit="make"）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import "@/styles/budget-checker.css";

const TOOL_TITLE = "予算作成Kit";
const TOOL_DESCRIPTION =
  "売上目標と今期の実績から、必要なリード数を逆算する無料のツール（Kit）です。チャネルごとにリード数と費用を配るだけで、CPL・CACまで判定し、そのまま稟議に使える年間予算表（Excel）になります。";
const SHEET_URL = "/lab/whitepapers/kgi-kpi-backcast-sheet";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: TOOL_TITLE, href: "/tools/budget-simulator" },
];

const PRE_TAGS = ["売上目標", "平均受注単価", "粗利率", "回収期間", "リードタイム", "共通費"];
const ACT_TAGS = ["リード数", "有効リード数", "商談数", "受注数"];
const CH_TAGS = ["リード数", "外部費用", "人件費"];
const NEED = [
  ["受注数", "23"],
  ["商談数", "78"],
  ["有効リード数", "195"],
  ["リード数", "514"],
];
---

<BaseLayout title={`${TOOL_TITLE}｜売上目標から逆算して、年間予算表を作る｜MeerKitLab`} description={TOOL_DESCRIPTION} ogImage="/open-graph/default.png">
  <Breadcrumb items={breadcrumbItems} />

  <!-- H1まわりは /lab・/tools と同じ形。.bk の外に置く -->
  <div class="mx-auto max-w-6xl px-5 pt-10">
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{TOOL_TITLE}</h1>
    <p class="mt-4 text-lg font-bold text-ink-950">売上目標から逆算して、年間予算表を作る。</p>
    <p class="mt-3 text-sm leading-relaxed text-neutral-500">売上目標と今期の実績から、必要なリード数を逆算します。チャネルごとにリード数と費用を配るだけで、CPL・CACまで判定し、そのまま稟議に使える年間予算表（Excel）になります。</p>
  </div>

  <main class="bk" id="bk" data-kit="make" data-mode="intro">
    <p class="bk-for">予算がまだない方向けのKitです。作った予算案がある方は <a href="/tools/budget-checker">予算案診断Kit →</a></p>

    <section id="bk-intro">
      <h2 class="bk-h2">3ステップで、売上目標から年間予算表が完成します。</h2>
      <ol class="bk-steps">
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">1</span>目標と実績を入れる</p>
          <p class="bk-step-p">売上目標と今期の実績から、必要なリード数が出る</p>
          <div class="bk-th bk-th-need" aria-hidden="true">
            <em>必要な数</em>
            {NEED.map(([l, v]) => <div><span>{l}</span><b>{v}</b></div>)}
          </div>
        </li>
        <li class="bk-arrow" aria-hidden="true">→</li>
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">2</span>チャネルに配る</p>
          <p class="bk-step-p">リード数と費用を配ると、足りるか・上限以内かがすぐ出る</p>
          <a class="bk-th bk-th-2" href="/tools/budget-simulator/sample" aria-label="入力画面の見本を見る">
            <div class="bk-th-grid bk-th-g5">
              {Array.from({ length: 5 }).map(() => <i class="k" />)}
              {Array.from({ length: 35 }).map((_, i) => <i class={i % 5 === 0 ? "" : i === 33 ? "r" : "b"} />)}
            </div>
            <div class="bk-th-alert"><span>1 直す</span><span class="o">0 確認</span><i /><i class="s" /><i /><i class="s" /><em>必要まであと12件</em></div>
          </a>
          <a class="bk-sample" href="/tools/budget-simulator/sample">入力画面の見本を見る →</a>
        </li>
        <li class="bk-arrow" aria-hidden="true">→</li>
        <li class="bk-step">
          <p class="bk-step-h"><span class="bk-no">3</span>年間予算表 完成</p>
          <p class="bk-step-p">作った数字と判定が入った年間予算表（Excel）をダウンロード</p>
          <a class="bk-th bk-th-3" href="/tools/budget-simulator/sample?tab=sheet" aria-label="年間予算表の見本を見る">
            <span class="bk-xl">
              <span class="bk-xl-file">
                <span class="bk-xl-fold" />
                <span class="bk-xl-grid">
                  {Array.from({ length: 5 }).map(() => <i class="k" />)}
                  {Array.from({ length: 20 }).map((_, i) => <i class={i % 5 === 1 || i % 5 === 2 ? "b" : ""} />)}
                </span>
              </span>
              <span class="bk-xl-tag">XLSX</span>
              <span class="bk-xl-dl"><svg viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg></span>
            </span>
            <span class="bk-xl-name">年間予算表.xlsx</span>
          </a>
          <a class="bk-sample" href="/tools/budget-simulator/sample?tab=sheet">年間予算表の見本を見る →</a>
        </li>
      </ol>

      <div class="bk-need">
        <div>
          <p class="bk-need-top"><b>必要な数字</b><span>率は入れません（件数から出します）。今期の実績がなければ空欄で、基本モデルの率で逆算します</span></p>
          <dl>
            <dt>前提</dt>
            <dd>{PRE_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
            <dt>今期の実績</dt>
            <dd>{ACT_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
            <dt>チャネル別（年間）</dt>
            <dd>{CH_TAGS.map((t) => <span class="bk-tag">{t}</span>)}</dd>
          </dl>
        </div>
        <div class="bk-need-dl">
          <div class="bk-doc" aria-hidden="true"><i></i><b>年間予算表</b><em></em><em></em></div>
          <div class="bk-need-dl-t">
            <span class="bk-tag-o">スプレッドシートで作りたい方へ</span>
            <b>年間予算表（無料）</b>
            <p>画面ではなくスプレッドシートで予算を作りたい方向けの資料です。このKitで作るものと同じ年間予算表に、直接入力できます。</p>
          </div>
          <a class="bk-btn2" href={SHEET_URL}>無料でダウンロード<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <h2 class="bk-h2">作成をはじめる</h2>
      <button type="button" class="bk-btn bk-start-btn" id="bk-start">画面で作成をはじめる<span aria-hidden="true">→</span></button>
      <p class="bk-hint">無料・登録なし・入れた数字はサーバーに送りません（すべてブラウザの中）・<a href="/tools/budget-simulator/sample">サンプル画面を見る（基本モデルの安定期）→</a></p>
    </section>
  </main>

  <ToolFooter path="/tools/budget-simulator" />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
