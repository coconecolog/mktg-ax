    font-size: 0.95rem;
    color: #222;
    padding: 0 0.4rem;
  }
  .field-note { font-size: 0.78rem; color: #888; margin: 0.2rem 0 1rem; }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .form-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #333;
  }
  .form-grid input,
  .form-grid select {
    padding: 0.6rem 0.7rem;
