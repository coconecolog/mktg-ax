---
// src/pages/tools/budget-simulator.astro
//
// 予算作成Kit（/tools/budget-simulator）。売上目標と今期の実績から逆算して、年間予算表（M-B-03、Excel）を作る。
// 2026-11-01：予算案診断Kitと同じ画面の流れにした（入力に「今期の実績」と自動配分の欄が加わる）
// 画面の流れ：入口（このページ）→ 入力（/input）→ ② 診断・修正（/check）→ ③ 最終チェック・ダウンロード（/final）→ 完了（/done）
// 2026-11-01：入口の中身を共通の部品（src/components/kit-flow/KitIntro.astro）にした。文言は src/data/kitPages.ts
// 判定と状態：src/lib/budgetCheck.ts　Excel：src/lib/budget-sheet.ts　画面：src/scripts/budget-checker/app.ts・flow.ts
// ひな形：public/files/tools/budget-sheet-template.xlsx（scripts/build-budget-sheet-template.py で作る）
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import KitIntro from "@/components/kit-flow/KitIntro.astro";
import { kitPage } from "@/data/kitPages";
import { KITS } from "@/lib/planKits";
import "@/styles/budget-checker.css";

const KIT_ID = "make";
const p = kitPage(KIT_ID);
const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Kit一覧", href: "/tools" },
  { name: p.title, href: KITS[KIT_ID].path },
];
---

<BaseLayout title={p.metaTitle} description={p.description} ogImage={p.ogImage}>
  <Breadcrumb items={breadcrumbItems} />
  <KitIntro kitId={KIT_ID} />
  <ToolFooter path={KITS[KIT_ID].path} />
</BaseLayout>

<script>
  import "@/scripts/budget-checker/app";
</script>
