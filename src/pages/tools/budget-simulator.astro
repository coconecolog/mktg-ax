    color: var(--color-accent, #2563eb);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }
.tool-header .eyebrow a {
  color: inherit;
  text-decoration: none;
}
.tool-header .eyebrow a:hover {
  text-decoration: underline;
}
  .tool-header h1 {
    margin: 0.25rem 0 0.6rem;
    font-size: 1.7rem;
  }
  .tool-header .lead {
    color: #444;
    line-height: 1.6;
    max-width: 760px;
  }

  /* ===== STEP1 ===== */
