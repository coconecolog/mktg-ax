---
// src/pages/tools/budget-simulator.astro
//
// 来期マーケティング予算シミュレーター & 計画書ツール
//
// 仕様書（Google Docs）に基づいて実装。デザインは仕様書のスクリーンショット（ダークネイビー×インディゴ）ではなく、
// サイト全体のトンマナ（ライトブルー系 #2563eb）に合わせて配色のみ調整している。
// Tailwind CDNは導入せず、他ツール（kpi-benchmark.astro）と同じくプレーンCSSで実装（BaseLayoutの
// グローバルスタイルとの衝突を避けるため）。
//
// 業界ベンチマーク（中小企業実態基本調査の実データ）は、仕様書には無いがこのツールにも
// 「参考」セクションとして追加している（既存の src/data/benchmark-data.json を再利用）。
//
// 既存の /tools/kpi-benchmark（来期予算プランナー）はそのまま残し、本ツールは別ページとして追加。
//
import BaseLayout from "@/layouts/BaseLayout.astro";
import benchmarkData from "@/data/benchmark-data.json";

const industries = benchmarkData.industries;
---

<BaseLayout
  title="マーケティング予算シミュレーター｜MKTG.AX"
  description="今期実績と来期施策（人件費・ツール費・広告費等）を入力し、根拠ある予算計画書を作成します。"
  ogImage="/open-graph/default.png"
>
  <main class="budget-tool" data-industries={JSON.stringify(industries)}>
    <header class="tool-header">
      <p class="eyebrow"><a href="/tools">便利ツール</a></p>
      <h1>マーケティング予算詳細シミュレーター</h1>
      <p class="lead">
        今期実績と来期施策（人件費・ツール費・広告費等）を入力し、逆算パイプライン・費用内訳・ROI試算まで含めた計画書を作成します。
      </p>
    </header>

    <!-- ============ 入力エリア（左）＋ 結果レポート（右） 固定2カラム ============ -->
    <div class="tool-layout">
      <div class="input-panel">
        <div class="setup-toolbar">
          <button id="setup-reset-btn" type="button" class="setup-reset-btn">すべてリセット</button>
        </div>

        <p class="required-legend"><span class="req-mark">※</span>は必須入力項目です（それ以外は任意項目です）</p>

        <fieldset class="field-group">
          <legend>1. 収益単価 ＆ 許容上限CPL（自動計算）</legend>
          <div class="form-grid">
            <label><span class="field-label-text">商品粗利率（％）<span class="req-mark">※</span></span><input type="number" id="in-grossMargin" min="0" max="100" step="1" /></label>
            <label><span class="field-label-text">1件LTV（千円）<span class="req-mark">※</span></span><input type="number" id="in-ltv" min="0" step="100" /></label>
          </div>
          <div class="auto-readout">
            <span class="auto-readout-label">許容上限CPL</span>
            <span class="auto-readout-value" id="maxcpl-display">-</span>
            <span class="auto-readout-tag">自動</span>
          </div>
          <p class="field-note">※許容上限CPL＝1件LTV×粗利率×リード→商談化率×商談→成約率（下記「3. 施策チャネル・コスト詳細内訳」内の今期実績値、シナリオ調整後）から自動算出されます。</p>
        </fieldset>

        <fieldset class="field-group">
          <legend>2. 全社目標・売上パイプライン前提（来期）</legend>
          <div class="form-grid">
            <label><span class="field-label-text">来期 全社売上目標（千円）<span class="req-mark">※</span></span><input type="number" id="in-targetSales" min="0" step="1000" /></label>
            <label><span class="field-label-text">マーケ貢献売上割合（％）<span class="req-mark">※</span></span><input type="number" id="in-mktRatio" min="0" max="100" step="1" /></label>
            <label><span class="field-label-text">平均客単価（千円／件）<span class="req-mark">※</span></span><input type="number" id="in-unitPrice" min="0" step="100" /></label>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend>3. 施策チャネル・コスト詳細内訳（今期実績 vs 来期計画）</legend>
          <div class="form-grid">
            <label>今期 売上着地実績（千円）<input type="number" id="in-currentSales" min="0" step="1000" /></label>
            <label>今期 マーケ貢献売上着地（千円）<input type="number" id="in-currentMktSales" min="0" step="1000" /></label>
            <label><span class="field-label-text">今期 商談 → 成約率（％）<span class="req-mark">※</span></span><input type="number" id="in-winRate" min="0" max="100" step="1" /></label>
            <label><span class="field-label-text">今期 リード → 商談化率（％）<span class="req-mark">※</span></span><input type="number" id="in-oppRate" min="0" max="100" step="1" /></label>
          </div>

          <div class="cost-cards">
            <div class="cost-cards-dynamic" id="cost-cards-body"></div>
            <div class="cost-card cost-card--buffer">
              <p class="cost-card-name">7. 予備費・バッファ</p>
              <div class="cost-card-inputs">
                <label>今期実績（％）
                  <span class="percent-input">
                    <input type="number" id="in-reserveRateCurrent" min="0" max="100" step="1" placeholder="5" />
                    <span class="percent-sign">%</span>
                  </span>
                </label>
                <label>来期計画（％）
                  <span class="percent-input">
                    <input type="number" id="in-reserveRateNext" min="0" max="100" step="1" placeholder="5" />
                    <span class="percent-sign">%</span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="cost-summary">
            <div class="cost-summary-row">
              <span class="cost-summary-label">獲得リード数（合計）</span>
              <span class="cost-summary-vals">
                <span class="cost-summary-item"><span class="cost-summary-tag">今期</span><span id="setup-leads-current"></span></span>
                <span class="cost-summary-arrow">→</span>
                <span class="cost-summary-item"><span class="cost-summary-tag">来期計画</span><span id="setup-leads-next"></span></span>
              </span>
            </div>
            <div class="cost-summary-row cost-summary-row--total">
              <span class="cost-summary-label">合計マーケティング予算（総投資額）</span>
              <span class="cost-summary-vals">
                <span class="cost-summary-item"><span class="cost-summary-tag">今期</span><span id="setup-total-current"></span></span>
                <span class="cost-summary-arrow">→</span>
                <span class="cost-summary-item"><span class="cost-summary-tag">来期</span><span id="setup-total-next"></span></span>
              </span>
            </div>
            <p class="field-note" id="leads-plan-check"></p>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend>4. 参考：業界データとの比較（任意）</legend>
          <div class="form-grid">
            <label>
              業種
              <select id="in-industry">
                {industries.map((item) => (
                  <option value={item.industry} data-ratio={item.adToSalesRatioPercent}>
                    {item.industry}
                  </option>
                ))}
              </select>
            </label>
          </div>
        </fieldset>

        <p id="setup-error" class="setup-error" hidden></p>
        <button id="run-btn" type="button">シミュレーター実行</button>
      </div>

      <div class="result-panel">
        <div class="result-toolbar no-print">
          <div class="scenario-switcher">
            <span class="scenario-label">成約・商談化率シナリオ：</span>
            <button type="button" class="scenario-btn" data-scenario="pessimistic">悲観（-20%）</button>
            <button type="button" class="scenario-btn scenario-btn--active" data-scenario="base">標準</button>
            <button type="button" class="scenario-btn" data-scenario="optimistic">楽観（+20%）</button>
          </div>
          <button id="print-btn" type="button">1ページ印刷／PDF出力</button>
        </div>
        <div class="print-container" id="print-container">
          <div class="report-tags">
          <span class="tag">役員会提出資料</span>
          <span class="tag-sep">・</span>
          <span class="tag-plain">マーケティング部マネージャー作成</span>
          <span class="report-date" id="report-date"></span>
        </div>
        <h2 class="report-title">来期 マーケティング予算策定・投資計画書（案）</h2>
        <p class="report-subnote" id="report-subnote">※今期実績比較・歩留まり逆算モデル適用</p>

        <div class="exec-summary" id="exec-summary">
          <p class="exec-summary-text" id="exec-summary-text">計算中...</p>
        </div>

        <div class="decision-dashboard">
          <div class="decision-dashboard-title">
            <h3><span class="card-icon">▼</span>経営判断ダッシュボード</h3>
          </div>
          <div class="kpi-cards kpi-cards--decision">
            <div class="kpi-card">
              <div class="kpi-card-head">
                <p class="kpi-label">来期 総投資コスト（予算）</p>
                <span class="kpi-icon kpi-icon--accent">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                </span>
              </div>
              <p class="kpi-value"><span id="kpi-budget"></span><span class="kpi-unit">千円</span></p>
              <p class="kpi-sub" id="kpi-budgetSub"></p>
            </div>
            <div class="kpi-card kpi-card--dark">
              <div class="kpi-card-head">
                <p class="kpi-label">来期 創出限界利益</p>
                <span class="kpi-icon kpi-icon--dark">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>
                </span>
              </div>
              <p class="kpi-value"><span id="kpi-marginalProfit"></span><span class="kpi-unit">千円</span></p>
              <p class="kpi-sub" id="kpi-marginalProfitSub">粗利 − マーケ総費用</p>
            </div>
            <div class="kpi-card kpi-card--accent">
              <div class="kpi-card-head">
                <p class="kpi-label">限界利益ROI（粗利／費用）</p>
                <span class="kpi-icon kpi-icon--accent">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6 6"/></svg>
                </span>
              </div>
              <p class="kpi-value"><span id="kpi-marginalRoi"></span><span class="kpi-unit">%</span></p>
              <p class="kpi-sub" id="kpi-marginalRoiSub"></p>
            </div>
            <div class="kpi-card" id="kpi-leadRateCard">
              <div class="kpi-card-head">
                <p class="kpi-label">全社目標達成率（リード）</p>
                <span class="kpi-icon kpi-icon--warn" id="kpi-leadRateIcon">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </span>
              </div>
              <p class="kpi-value"><span id="kpi-leadRate"></span><span class="kpi-unit">%</span></p>
              <p class="kpi-sub" id="kpi-leadRateSub"></p>
            </div>
          </div>
          <div class="alert-box" id="health-alert-box">
            <span class="alert-icon" id="health-alert-icon">✓</span>
            <span id="health-alert-message">計算中...</span>
          </div>
        </div>

        <div class="chart-guide-grid">
          <div class="card chart-guide-card">
            <div class="chart-cards-head">
              <p class="chart-cards-title"><span class="card-icon">◐</span>リード目標 vs 獲得計画</p>
              <span class="chart-tag" id="chartTag1">計算中</span>
            </div>
            <p class="chart-cards-desc">マーケ貢献売上目標に必要なリード数と、来期計画リード数の比較</p>
            <div class="chart-box"><canvas id="leadGapChart"></canvas></div>
            <div class="chart-stat-strip" id="chartStat1"></div>
          </div>
          <div class="card chart-guide-card">
            <div class="chart-cards-head">
              <p class="chart-cards-title"><span class="card-icon">▤</span>今期実績 vs 来期計画</p>
              <span class="chart-tag" id="chartTag2">計算中</span>
            </div>
            <p class="chart-cards-desc">マーケ投資コストと創出粗利の推移（千円）</p>
            <div class="chart-box"><canvas id="costProfitChart"></canvas></div>
            <div class="chart-stat-strip" id="chartStat2"></div>
          </div>
          <div class="card chart-guide-card">
            <div class="chart-cards-head">
              <p class="chart-cards-title"><span class="card-icon">♦</span>CPL効率分析（獲得単価比較）</p>
              <span class="chart-tag" id="chartTag3">計算中</span>
            </div>
            <p class="chart-cards-desc">計画CPLと許容上限CPL・限界CPLの比較（千円）</p>
            <div class="chart-box"><canvas id="cplComparisonChart"></canvas></div>
            <div class="chart-stat-strip" id="chartStat3"></div>
          </div>
          <div class="card chart-guide-card chart-guide-card--reco">
            <div class="chart-cards-head">
              <p class="chart-cards-title"><span class="card-icon">✎</span>CPL超過・目標未達への対応策</p>
            </div>
            <ol class="reco-list" id="reco-list"></ol>
          </div>
        </div>

        <div class="card">
          <div class="card-title-row">
            <h3><span class="card-icon">▼</span>経営層のための指標解釈ガイド（許容上限CPL vs 限界CPL）</h3>
          </div>
          <div class="guide-grid guide-grid--3col">
            <div class="guide-box">
              <p class="guide-box-title"><span class="guide-dot guide-dot--good"></span>許容上限CPL（損益分岐CPL）とは</p>
              <p class="guide-box-text">獲得した1リードが創出する平均利益に基づく、「赤字にならない限界の平均リード獲得コスト」です。この数値を基準に、各施策の計画CPLが健全かどうかを判定します。</p>
              <div class="guide-box-formula">許容上限CPL＝1件LTV × 粗利率 × リード→商談化率 × 商談→成約率</div>
            </div>
            <div class="guide-box guide-box--accent">
              <p class="guide-box-title"><span class="guide-dot guide-dot--accent"></span>限界CPL（追加獲得時の許容上限）とは</p>
              <p class="guide-box-text">未達ギャップを追加リードで埋める際、来期計画の利益クッション（創出限界利益）を使い切らない範囲で「投じて良い上限単価」です。全社のリード積み増し判断に利用します。</p>
              <div class="guide-box-formula">限界CPL＝創出限界利益 ÷ 未達リード数</div>
            </div>
            <div class="guide-box">
              <p class="guide-box-title"><span class="guide-dot guide-dot--bad"></span>経営判断ルール（判定基準）</p>
              <ul class="guide-rule-list">
                <li><span class="guide-dot guide-dot--good"></span><strong>計画CPL ≤ 許容上限CPL：</strong>健全。現行施策を維持・拡大して問題ありません。</li>
                <li><span class="guide-dot guide-dot--warn"></span><strong>許容CPL＜計画CPL≤限界CPL：</strong>平均では赤字リスクがあるが、投資回収シナリオ次第で許容。</li>
                <li><span class="guide-dot guide-dot--bad"></span><strong>計画CPL＞限界CPL：</strong>即座に施策停止またはCVR改善が必要。</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-title-row">
            <h3><span class="card-icon">▼</span>施策別 Unit Economics（単位当たり収益性）＆ 投資判定</h3>
            <span class="badge-legend">
              <span class="badge-legend-item"><span class="guide-dot guide-dot--good"></span>健全</span>
              <span class="badge-legend-item"><span class="guide-dot guide-dot--warn"></span>要調整</span>
              <span class="badge-legend-item"><span class="guide-dot guide-dot--bad"></span>超過</span>
            </span>
          </div>
          <div class="unit-econ-table-wrap">
            <table class="unit-econ-table">
              <thead>
                <tr>
                  <th>施策・コスト科目</th>
                  <th>来期予算</th>
                  <th>目標リード</th>
                  <th>施策CPL</th>
                  <th>1件限界利益</th>
                  <th>創出限界利益</th>
                  <th>投資判定</th>
                </tr>
              </thead>
              <tbody id="unit-econ-body"></tbody>
            </table>
          </div>
          <p class="field-note">※ 1件あたり限界利益＝（1件LTV × 粗利率 × リード→商談化率 × 商談→成約率）－施策CPL。許容上限CPLを超過している施策は「要改善」または「撤退」判定となります。</p>
          <p class="field-note field-note--warn">※「-」と表示される施策は、左側「3. 施策チャネル・コスト詳細内訳」で「来期計画（千円）」または「来期 目標リード（件）」が未入力、もしくは「実施しない（0）」として入力されています。ツール・SaaS利用料／人件費／外注費はリードを直接生まない固定費のため、投資判定は常に「-」表示となります。</p>
        </div>

        <div class="card">
          <div class="card-title-row">
            <h3><span class="card-icon">▼</span>今期実績 vs 来期計画　全コスト・全指標 対比サマリー</h3>
            <span class="chip">全入力値完全連動</span>
          </div>
          <div class="full-compare-table-wrap">
            <table class="full-compare-table">
              <thead>
                <tr>
                  <th>管理・コスト項目</th>
                  <th>今期実績</th>
                  <th>来期計画</th>
                  <th>差分</th>
                  <th>変化率</th>
                </tr>
              </thead>
              <tbody id="full-compare-body"></tbody>
            </table>
          </div>
        </div>

        <div class="card report-footer-card">
          <div class="report-footer">
            <div class="footer-col">
              <h4>◎ 重点施策方針</h4>
              <p id="footer-policy"></p>
            </div>
            <div class="footer-col">
              <h4>◇ リスク管理＆機動的バッファ</h4>
              <p id="footer-risk"></p>
            </div>
            <div class="footer-col">
              <h4>✓ 経営層へのご決裁依頼</h4>
              <p id="footer-request"></p>
            </div>
          </div>
        </div>

        <div class="card checklist-card">
          <h4 class="checklist-title">本日の経営会議での確認ポイント</h4>
          <ul class="checklist-list checklist-list--check">
            <li><span class="check-icon">✓</span><strong>許容上限CPLの厳守：</strong>1件LTV・粗利率・歩留まりから数学的に算出された許容上限CPL（撤退ライン）を基準に、各施策の収益性を判定しています。</li>
            <li><span class="check-icon">✓</span><strong>シナリオ別の成約感度：</strong>悲観（-20%）／標準／楽観（+20%）の3パターンで成約率・商談化率を調整し、許容上限CPLと必要リード数への影響を確認できます。</li>
            <li><span class="check-icon">✓</span><strong>固定費投資の回収要件：</strong>ツール費や人件費の増額は、商談化率の向上やリード数の底上げで投資回収できる見込みがあるかを判定してください。</li>
          </ul>
        </div>

        <div class="card reference-card">
          <h3><span class="card-icon">▼</span>参考：業界の広告宣伝費水準と比較する</h3>
          <p class="field-note">
            以下は「来期のWeb広告費が、業界の広告宣伝費水準から見て
            極端でないか」を確認するための参考情報です（出典：{benchmarkData.sourceTitle}）。
          </p>
          <div class="result-row">
            <span>来期Web広告費 ／ 来期全社売上目標</span>
            <span id="ref-own-ratio"></span>
          </div>
          <div class="result-row">
            <span>業界平均の比率</span>
            <span id="ref-industry-ratio"></span>
          </div>
          <div class="result-row result-row--highlight">
            <span>位置づけ</span>
            <span id="ref-position"></span>
          </div>
          <div id="ranking-chart" class="ranking-chart"></div>
          <div class="legend-line">
            <span class="legend-dot rank-avg"></span>業界平均比率
            <span class="legend-dot rank-own" style="margin-left:0.6rem;"></span>選択した業種
            <span class="legend-refline" style="margin-left:0.6rem;">┊ 来期Web広告費の実績値</span>
          </div>
        </div>
        </div>
        <!-- ↑ print-container 閉じ -->
      </div>
    </div>

    <div class="setup-help no-print" id="setup-help">
      <p class="setup-help-title">用語・計算式の説明</p>
      <dl>
        <dt>商品粗利率（％）</dt>
        <dd>提供する商品・サービスの粗利率。許容上限CPLの算出に使用します。</dd>
        <dt>1件LTV（千円）</dt>
        <dd>契約1件あたりの生涯価値（Life Time Value）。許容上限CPLの算出に使用します。</dd>
        <dt>許容上限CPL（自動計算）</dt>
        <dd>1件LTV × 粗利率 × リード→商談化率 × 商談→成約率 から自動算出される、赤字にならないリード獲得コストの上限値。申請予算・必要リード数から逆算した実質CPLと比較し、予算配分が妥当かを判定する基準です。</dd>
        <dt>マーケ貢献売上割合（％）</dt>
        <dd>「マーケの売上額」＝自社のマーケ施策（広告・SEO・展示会等）経由で獲得したリードが契約に至り、売上として計上された金額の合計（最初の接点＝ファーストタッチ基準）。この金額が、来期の全社売上目標に対してどのくらいの割合を占めるかの目標値です。</dd>
        <dt>平均客単価（千円／件）</dt>
        <dd>契約1件あたりの平均売上額。目標成約件数 ＝ マーケ貢献目標売上 ÷ 平均客単価。</dd>
        <dt>今期 商談 → 成約率（％）</dt>
        <dd>今期実績ベースの成約率（成約件数 ÷ 商談件数 × 100）。必要商談数 ＝ 目標成約件数 ÷ 商談→成約率として来期の逆算に使用するほか、許容上限CPLの算出にも使用します。悲観／楽観シナリオでは±20%で調整されます。</dd>
        <dt>今期 リード → 商談化率（％）</dt>
        <dd>今期実績ベースの商談化率（商談件数 ÷ リード件数 × 100）。必要リード数 ＝ 必要商談数 ÷ リード→商談化率として来期の逆算に使用するほか、許容上限CPLの算出にも使用します。悲観／楽観シナリオでは±20%で調整されます。</dd>
      </dl>

      <p class="setup-help-title setup-help-title--sub">施策チャネル費用の内容例</p>
      <dl class="setup-help-costs" id="setup-help-costs"></dl>
    </div>
  </main>
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // このスクリプトはブラウザ側でのみ動きます（サーバー処理は一切なし）。

  const COST_KEYS = [
    { key: 'ad', name: 'Web広告費', desc: 'リスティング、SNS広告、記事広告等', hasLeads: true },
    { key: 'event', name: '展示会・イベント費', desc: '展示会ブース出展料、施工費、ノベルティ（実施しない場合は0円）', hasLeads: true },
    { key: 'seo', name: 'SEO・コンテンツ制作', desc: 'オウンドメディア記事、事例取材、動画制作', hasLeads: true },
    { key: 'tools', name: 'ツール・SaaS利用料', desc: 'MA（HubSpot等）、SEO分析、SFA、フォームツール', hasLeads: false },
    { key: 'labor', name: '人件費（マーケ部）', desc: '社内マーケ担当給与、採用費、教育費', hasLeads: false },
    { key: 'outsourcing', name: '外注費・コンサル費', desc: '広告代理店手数料、マーケティング顧問・業務委託', hasLeads: false },
  ];

  // 入力欄のプレースホルダー（記入例）としてのみ使う見本データ。実際の計算には使われない。
  // 金額の単位はすべて「千円」に統一（例：targetSales 1,000,000＝10億円）。
  const DEMO_DATA = {
    targetSales: 1000000, mktRatio: 40, unitPrice: 5000, winRate: 20, oppRate: 10,
    grossMargin: 70, ltv: 5000, scenario: 'base',
    currentSales: 800000, currentMktSales: 310000, reserveRateCurrent: 5, reserveRateNext: 5,
    costs: {
      ad: { current: 20000, currentLeads: 1800, next: 24000, nextLeads: 2150 },
      event: { current: 0, currentLeads: 0, next: 0, nextLeads: 0 },
      seo: { current: 8000, currentLeads: 1450, next: 10000, nextLeads: 1800 },
      tools: { current: 6000, currentLeads: 0, next: 9000, nextLeads: 0 },
      labor: { current: 12000, currentLeads: 0, next: 12000, nextLeads: 0 },
      outsourcing: { current: 4000, currentLeads: 0, next: 5000, nextLeads: 0 },
    },
  };

  // 2-1：必須入力項目（この7つが空欄のままシミュレーター実行を押すとエラーにする）
  const REQUIRED_FIELDS = [
    { id: 'in-targetSales', label: '来期 全社売上目標' },
    { id: 'in-mktRatio', label: 'マーケ貢献売上割合' },
    { id: 'in-unitPrice', label: '平均客単価' },
    { id: 'in-winRate', label: '今期 商談→成約率' },
    { id: 'in-oppRate', label: '今期 リード→商談化率' },
    { id: 'in-grossMargin', label: '商品粗利率' },
    { id: 'in-ltv', label: '1件LTV' },
  ];


  let state = JSON.parse(JSON.stringify(DEMO_DATA));

  const toolRoot = document.querySelector('.budget-tool');
  const allIndustries = JSON.parse(toolRoot?.dataset.industries || '[]');
  let selectedIndustryName = allIndustries[0]?.industry || '';

  // ---------- フォーマッタ（金額の単位はすべて「千円」に統一） ----------
  function fmtThousand(n) { return `${Math.round(n).toLocaleString('ja-JP')}千円`; }
  function fmtThousandNoUnit(n) { return Math.round(n).toLocaleString('ja-JP'); }
  function fmtPercent(n, digits = 1) { return `${n.toFixed(digits)}%`; }
  function fmtCount(n) { return `${Math.round(n).toLocaleString('ja-JP')}件`; }
  function clampPositive(n, fallback = 0.0001) { return isFinite(n) && n > 0 ? n : fallback; }
  // 今期実績→来期計画の増減率（％）。今期実績が0の場合は率が定義できないため「新規」表示にする。
  function fmtChangeRate(current, next) {
    if (current > 0) {
      const pct = ((next - current) / current) * 100;
      if (pct === 0) return '今期比 ±0%';
      return `今期比 ${pct > 0 ? '+' : ''}${pct.toFixed(0)}%`;
    }
    return next > 0 ? '今期比 新規' : '';
  }

  // ---------- 計算ロジック（仕様書 4章） ----------
  // 成約感度シナリオ：悲観(-20%)／標準／楽観(+20%)。今期実績の商談→成約率・リード→商談化率に乗じる。
  function getScenarioMultiplier(scenario) {
    if (scenario === 'pessimistic') return 0.8;
    if (scenario === 'optimistic') return 1.2;
    return 1.0;
  }

  function computePipeline(s) {
    const mult = getScenarioMultiplier(s.scenario);
    const effWinRate = (s.winRate || 0) * mult;
    const effOppRate = (s.oppRate || 0) * mult;
    // targetSales・unitPrice はすべて千円単位のため、変換係数なしでそのまま計算できる
    const mktTarget = s.targetSales * (s.mktRatio / 100);
    const unitPrice = clampPositive(s.unitPrice);
    const winRate = clampPositive(effWinRate) / 100;
    const oppRate = clampPositive(effOppRate) / 100;
    const targetDeals = Math.max(0, Math.ceil(mktTarget / unitPrice));
    const requiredOpps = Math.max(0, Math.ceil(targetDeals / winRate));
    const requiredLeads = Math.max(0, Math.ceil(requiredOpps / oppRate));
    return { mktTarget, targetDeals, requiredOpps, requiredLeads, effWinRate, effOppRate };
  }

  // 許容上限CPL＝1件LTV × 粗利率 × リード→商談化率 × 商談→成約率（シナリオ調整後）
  function computeMaxCPL(s, pipeline) {
    const ltv = clampPositive(s.ltv, 0);
    const margin = (s.grossMargin || 0) / 100;
    if (ltv <= 0 || margin <= 0) return 0;
    const oppRateFrac = clampPositive(pipeline.effOppRate) / 100;
    const winRateFrac = clampPositive(pipeline.effWinRate) / 100;
    return ltv * margin * oppRateFrac * winRateFrac;
  }

  function sumCosts(costs, field) {
    return COST_KEYS.reduce((sum, c) => sum + (costs[c.key]?.[field] || 0), 0);
  }

  // 施策別リード数の合計（ハコにリード入力欄があるチャネルのみ集計対象）
  function sumLeads(costs, field) {
    return COST_KEYS.reduce((sum, c) => sum + (c.hasLeads ? (costs[c.key]?.[field] || 0) : 0), 0);
  }

  // 総合平均CPL（実施中の施策のみで算出）＝ 予算・リードともに入力されている（＝実施している）
  // リード獲得施策の来期予算合計 ÷ 来期目標リード合計。「実施しない（0）」の施策は母数から除外する。
  // 固定費（ツール・人件費・外注費）はリードを生まないため、もとより対象外。
  function computeBlendedActiveCpl(costs, budgetField, leadsField) {
    let budgetSum = 0;
    let leadsSum = 0;
    COST_KEYS.forEach((c) => {
      if (!c.hasLeads) return;
      const budget = costs[c.key]?.[budgetField] || 0;
      const leads = costs[c.key]?.[leadsField] || 0;
      if (budget > 0 && leads > 0) {
        budgetSum += budget;
        leadsSum += leads;
      }
    });
    return leadsSum > 0 ? budgetSum / leadsSum : 0;
  }

  function computeCostTotals(s) {
    // 仕様書 4.2：Buffer = Math.round(Subtotal * rate) を先に丸めてから TotalBudget に加算する
    // 予備費率は今期実績・来期計画で別々に持つ（実態が異なるため）。既定5%。0%も許容する。
    const rateNext = (isFinite(s.reserveRateNext) && s.reserveRateNext >= 0 ? s.reserveRateNext : 5) / 100;
    const rateCurrent = (isFinite(s.reserveRateCurrent) && s.reserveRateCurrent >= 0 ? s.reserveRateCurrent : 5) / 100;
    const subtotal = sumCosts(s.costs, 'next');
    const reserve = Math.round(subtotal * rateNext);
    const budget = subtotal + reserve;
    const subtotalCurrent = sumCosts(s.costs, 'current');
    const reserveCurrent = Math.round(subtotalCurrent * rateCurrent);
    const budgetCurrent = subtotalCurrent + reserveCurrent;
    return { subtotal, reserve, budget, subtotalCurrent, reserveCurrent, budgetCurrent };
  }

  function computeKpis(s, pipeline, totals) {
    const roi = totals.budget > 0 ? (pipeline.mktTarget / totals.budget) * 100 : 0;
    const cac = pipeline.targetDeals > 0 ? totals.budget / pipeline.targetDeals : 0;
    const budgetRatioToSales = s.targetSales > 0 ? (totals.budget / s.targetSales) * 100 : 0;
    const growthRate = s.currentSales > 0 ? ((s.targetSales - s.currentSales) / s.currentSales) * 100 : 0;
    return { roi, cac, budgetRatioToSales, growthRate };
  }

  // 経営判断ダッシュボード：創出限界利益（粗利－マーケ総費用）と限界利益ROI（今期実績・来期計画の両方を算出）
  // すべて千円単位で算出（億・万への変換は行わない）
  function computeMarginalProfit(s, pipeline, totals) {
    const grossProfit = pipeline.mktTarget * ((s.grossMargin || 0) / 100);
    const marginalProfit = grossProfit - totals.budget;
    const marginalROI = totals.budget > 0 ? (grossProfit / totals.budget) * 100 : 0;

    const currentBudget = totals.subtotalCurrent + totals.reserveCurrent;
    const grossProfitCurrent = s.currentMktSales * ((s.grossMargin || 0) / 100);
    const marginalProfitCurrent = grossProfitCurrent - currentBudget;

    return { grossProfit, marginalProfit, marginalROI, marginalProfitCurrent, grossProfitCurrent, currentBudget };
  }

  // CPL超過・目標未達への対応策（経営層向け提案リスト。すべて既存の入力・計算値のみから動的生成）
  function renderRecoList(pipeline, maxCPL, worstChannel, worstCpl, leadGap, marginalCpl, s) {
    const el = document.getElementById('reco-list');
    if (!el) return;
    const items = [];

    if (worstChannel && maxCPL > 0) {
      const bumpPt = 3;
      const ltv = clampPositive(s.ltv, 0);
      const margin = (s.grossMargin || 0) / 100;
      const winRateFrac = clampPositive(pipeline.effWinRate) / 100;
      const improvedOppRatePct = (pipeline.effOppRate || 0) + bumpPt;
      const improvedMaxCPL = ltv > 0 && margin > 0 ? ltv * margin * (improvedOppRatePct / 100) * winRateFrac : 0;
      items.push(`<strong>CVR改善：</strong>${worstChannel.name}のリード→商談化率を現状${(pipeline.effOppRate || 0).toFixed(1)}%から+${bumpPt}pt改善できれば、許容上限CPLは${maxCPL.toFixed(1)}千円から${improvedMaxCPL.toFixed(1)}千円へ拡大し、現行計画CPL（${worstCpl.toFixed(1)}千円）でも健全化が見込めます。`);

      let bestChannel = null;
      let bestCpl = Infinity;
      COST_KEYS.forEach((c) => {
        if (!c.hasLeads || c.key === worstChannel.key) return;
        const budget = s.costs[c.key].next || 0;
        const leads = s.costs[c.key].nextLeads || 0;
        if (budget > 0 && leads > 0) {
          const cpl = budget / leads;
          if (cpl < bestCpl) { bestCpl = cpl; bestChannel = c; }
        }
      });
      if (bestChannel && bestCpl < worstCpl) {
        items.push(`<strong>予算再配分：</strong>${worstChannel.name}への依存度を下げ、相対的に低CPLで獲得できている${bestChannel.name}（計画CPL ${bestCpl.toFixed(1)}千円）へ予算の一部を振り替えることで、全体の獲得効率を改善できます。`);
      }
    }

    if (leadGap > 0) {
      if (marginalCpl !== null && marginalCpl > 0) {
        items.push(`<strong>追加予算の承認：</strong>未達ギャップ${fmtCount(leadGap)}を追加リードで埋める場合、限界CPL（${marginalCpl.toFixed(1)}千円）の範囲内であれば、来期の利益水準を維持したまま追加予算を承認できます。`);
      } else {
        items.push(`<strong>追加予算の承認：</strong>未達ギャップ${fmtCount(leadGap)}がありますが、現状の利益クッションでは追加リード獲得の原資が確保できていません。既存施策のCPL改善が先決です。`);
      }
    }

    if (items.length === 0) {
      el.innerHTML = `<li class="reco-item--ok"><span class="reco-num">✓</span><span class="reco-text"><strong>現状維持で問題なし：</strong>許容上限CPL・全社リード目標ともに充足しています。追加のアクションは不要です。</span></li>`;
      return;
    }
    el.innerHTML = items.slice(0, 3).map((text, i) => `<li><span class="reco-num">案${i + 1}</span><span class="reco-text">${text}</span></li>`).join('');
  }

  // 施策別 Unit Economics（単位当たり収益性）テーブルの描画
  function renderUnitEconTable(s, maxCPL) {
    const tbody = document.getElementById('unit-econ-body');
    if (!tbody) return;

    // 合計行用の集計値
    let sumBudgetAll = 0;
    let sumLeadsAll = 0;
    let sumTotalProfit = 0;
    let anyComputed = false;
    let worstTier = -1; // -1:該当なし 0:健全 1:要調整 2:超過
    let worstChannelName = '';

    const warnIconSvg = '<span class="row-warn-icon" title="許容上限CPLを超過しています"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><line x1="12" y1="10" x2="12" y2="14"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>';

    const rowsHtml = COST_KEYS.map((c) => {
      const budget = s.costs[c.key].next || 0;
      sumBudgetAll += budget;

      if (!c.hasLeads) {
        return `
        <tr>
          <td>${c.name}</td>
          <td class="num">${fmtThousandNoUnit(budget)} 千円</td>
          <td class="num">-</td>
          <td class="num text-muted">固定費</td>
          <td class="num text-muted">-</td>
          <td class="num">-</td>
          <td class="center">-</td>
        </tr>`;
      }
      const leads = s.costs[c.key].nextLeads || 0;
      // 予算・リードともに0（＝当該施策は実施しない）、またはどちらか未入力の場合は「-」表示のみとする
      if (leads <= 0 || budget <= 0) {
        return `
        <tr>
          <td>${c.name}</td>
          <td class="num">${budget > 0 ? `${fmtThousandNoUnit(budget)} 千円` : '-'}</td>
          <td class="num">${leads > 0 ? fmtCount(leads) : '-'}</td>
          <td class="num text-muted">-</td>
          <td class="num text-muted">-</td>
          <td class="num text-muted">-</td>
          <td class="center">-</td>
        </tr>`;
      }
      sumLeadsAll += leads;
      const cpl = budget / leads;
      const unitProfit = maxCPL - cpl;
      const totalProfit = unitProfit * leads;
      sumTotalProfit += totalProfit;
      anyComputed = true;
      // 投資判定は3段階に簡略化（健全／要調整／超過）
      let badgeClass = 'decision-badge--fixed';
      let badgeText = '判定不可';
      let tier = -1;
      if (maxCPL > 0) {
        if (cpl <= maxCPL) { badgeClass = 'decision-badge--expand'; badgeText = '健全'; tier = 0; }
        else if (cpl <= maxCPL * 1.3) { badgeClass = 'decision-badge--review'; badgeText = '要調整'; tier = 1; }
        else { badgeClass = 'decision-badge--withdraw'; badgeText = '超過'; tier = 2; }
      }
      if (tier > worstTier) { worstTier = tier; worstChannelName = c.name; }
      const rowClass = tier >= 1 ? ' class="unit-econ-row--warn"' : '';
      const nameCell = tier >= 1 ? `${warnIconSvg}${c.name}` : c.name;
      return `
      <tr${rowClass}>
        <td>${nameCell}</td>
        <td class="num">${fmtThousandNoUnit(budget)} 千円</td>
        <td class="num">${fmtCount(leads)}</td>
        <td class="num ${maxCPL > 0 && cpl > maxCPL ? 'text-warn' : ''}">${cpl.toFixed(2)} 千円</td>
        <td class="num ${unitProfit < 0 ? 'text-warn' : 'text-good'}">${unitProfit >= 0 ? '+' : ''}${unitProfit.toFixed(2)} 千円</td>
        <td class="num ${totalProfit < 0 ? 'text-warn' : ''}">${totalProfit >= 0 ? '+' : ''}${fmtThousandNoUnit(totalProfit)} 千円</td>
        <td class="center"><span class="decision-badge ${badgeClass}">${badgeText}</span></td>
      </tr>`;
    }).join('');

    // 合計行（全施策の来期予算・目標リード・創出限界利益を集計。CPLは実施中のリード獲得施策のみの実額ベース）
    const blendedCplValue = computeBlendedActiveCpl(s.costs, 'next', 'nextLeads');
    const blendedCpl = sumLeadsAll > 0 ? blendedCplValue : null;

    // 合計行の投資判定：施策別判定の中で最も悪い判定を集約バッジとして表示
    let summaryBadgeHtml = '-';
    if (worstTier === 0) {
      summaryBadgeHtml = '<span class="decision-badge decision-badge--expand">全施策健全</span>';
    } else if (worstTier === 1) {
      summaryBadgeHtml = `<span class="decision-badge decision-badge--review">要施策調整</span>`;
    } else if (worstTier === 2) {
      summaryBadgeHtml = `<span class="decision-badge decision-badge--withdraw">要施策調整</span>`;
    }

    const summaryRowHtml = `
      <tr class="unit-econ-row--summary">
        <td>合計</td>
        <td class="num">${fmtThousandNoUnit(sumBudgetAll)} 千円</td>
        <td class="num">${sumLeadsAll > 0 ? fmtCount(sumLeadsAll) : '-'}</td>
        <td class="num">${blendedCpl !== null ? `${blendedCpl.toFixed(2)} 千円` : '-'}</td>
        <td class="num text-muted">-</td>
        <td class="num ${anyComputed && sumTotalProfit < 0 ? 'text-warn' : anyComputed ? 'text-good' : ''}">${anyComputed ? `${sumTotalProfit >= 0 ? '+' : ''}${fmtThousandNoUnit(sumTotalProfit)} 千円` : '-'}</td>
        <td class="center">${summaryBadgeHtml}</td>
      </tr>`;

    tbody.innerHTML = rowsHtml + summaryRowHtml;
  }

  function computePosition(ratio, industryRatio) {
    if (!isFinite(ratio) || industryRatio <= 0) {
      return { multiple: NaN, text: '判定不可（入力値をご確認ください）' };
    }
    const multiple = ratio / industryRatio;
    if (multiple >= 1.2) return { multiple, text: `積極水準（業界平均の${multiple.toFixed(2)}倍）` };
    if (multiple <= 0.8) return { multiple, text: `消極水準（業界平均の${multiple.toFixed(2)}倍）` };
    return { multiple, text: `標準水準（業界平均の${multiple.toFixed(2)}倍）` };
  }

  // ---------- STEP1：コストテーブル描画 ----------
  // asPlaceholder=true の場合、実際の値（value）は入れず、demoCosts の数字を
  // プレースホルダー（薄いグレーの見本表示）としてのみ表示する＝計算には使われない。
  function renderCostTable(asPlaceholder, demoCosts) {
    const body = document.getElementById('cost-cards-body');
    if (!body) return;
    body.innerHTML = COST_KEYS.map((c, i) => {
      const demo = demoCosts ? demoCosts[c.key] : { current: 0, next: 0, currentLeads: 0, nextLeads: 0 };
      const currentAttr = asPlaceholder
        ? `placeholder="${demo.current}" value=""`
        : `value="${state.costs[c.key].current}"`;
      const nextAttr = asPlaceholder
        ? `placeholder="${demo.next}" value=""`
        : `value="${state.costs[c.key].next}"`;
      const currentLeadsAttr = asPlaceholder
        ? `placeholder="${demo.currentLeads || 0}" value=""`
        : `value="${state.costs[c.key].currentLeads || 0}"`;
      const nextLeadsAttr = asPlaceholder
        ? `placeholder="${demo.nextLeads || 0}" value=""`
        : `value="${state.costs[c.key].nextLeads || 0}"`;
      const leadsRow = c.hasLeads ? `
        <p class="cost-card-leads-heading">◆ 獲得リード数（施策別CPL算出に必須）</p>
        <div class="cost-card-inputs cost-card-inputs--leads">
          <label>今期 獲得リード（件）<input type="number" min="0" step="10" data-cost-key="${c.key}" data-cost-field="currentLeads" ${currentLeadsAttr} /></label>
          <label>来期 目標リード（件）<input type="number" min="0" step="10" data-cost-key="${c.key}" data-cost-field="nextLeads" ${nextLeadsAttr} /></label>
        </div>` : '';
      return `
      <div class="cost-card">
        <p class="cost-card-name">${i + 1}. ${c.name}</p>
        <div class="cost-card-inputs">
          <label>今期実績（千円）<input type="number" min="0" step="100" data-cost-key="${c.key}" data-cost-field="current" ${currentAttr} /></label>
          <label>来期計画（千円）<input type="number" min="0" step="100" data-cost-key="${c.key}" data-cost-field="next" ${nextAttr} /></label>
        </div>
        ${leadsRow}
      </div>
    `;
    }).join('');

    body.querySelectorAll('input[data-cost-key]').forEach((input) => {
      input.addEventListener('input', (e) => {
        const target = e.target;
        const key = target.dataset.costKey;
        const field = target.dataset.costField;
        state.costs[key][field] = parseFloat(target.value) || 0;
        renderSetupTotals();
      });
    });

    renderSetupTotals();
  }

  // 「施策チャネル費用の内容例」（用語・計算式の説明の下部）を COST_KEYS から生成
  function renderCostHelp() {
    const el = document.getElementById('setup-help-costs');
    if (!el) return;
    el.innerHTML = COST_KEYS.map((c, i) => `<dt>${i + 1}. ${c.name}</dt><dd>${c.desc}</dd>`).join('');
  }

  function renderSetupTotals() {
    const totals = computeCostTotals(state);
    document.getElementById('setup-total-current').textContent = fmtThousand(totals.subtotalCurrent + totals.reserveCurrent);
    document.getElementById('setup-total-next').textContent = fmtThousand(totals.budget);
    const leadsCurrentEl = document.getElementById('setup-leads-current');
    const leadsNextEl = document.getElementById('setup-leads-next');
    if (leadsCurrentEl) leadsCurrentEl.textContent = fmtCount(sumLeads(state.costs, 'currentLeads'));
    if (leadsNextEl) leadsNextEl.textContent = fmtCount(sumLeads(state.costs, 'nextLeads'));
  }

  // asPlaceholder=true：初期表示専用。見本の数字はプレースホルダーとしてのみ表示し、
  // 実際の入力値（value）は空にする＝この状態でシミュレーターを実行しても計算には使われない。
  // asPlaceholder=false：プリセット選択時・条件再設定時。実際の値として入力欄に反映する。
  function fillSetupForm(asPlaceholder = false) {
    const fields = [
      ['in-targetSales', state.targetSales],
      ['in-mktRatio', state.mktRatio],
      ['in-unitPrice', state.unitPrice],
      ['in-winRate', state.winRate],
      ['in-oppRate', state.oppRate],
      ['in-grossMargin', state.grossMargin],
      ['in-ltv', state.ltv],
      ['in-currentSales', state.currentSales],
      ['in-currentMktSales', state.currentMktSales],
    ];
    const demoCosts = asPlaceholder ? JSON.parse(JSON.stringify(state.costs)) : null;

    fields.forEach(([id, val]) => {
      const el = document.getElementById(id);
      if (!el) return;
      if (asPlaceholder) {
        el.placeholder = String(val);
        el.value = '';
      } else {
        el.value = String(val);
      }
    });
    const reserveRateCurrentEl = document.getElementById('in-reserveRateCurrent');
    const reserveRateNextEl = document.getElementById('in-reserveRateNext');
    [
      [reserveRateCurrentEl, state.reserveRateCurrent],
      [reserveRateNextEl, state.reserveRateNext],
    ].forEach(([el, val]) => {
      if (!el) return;
      const shown = String(isFinite(val) ? val : 5);
      if (asPlaceholder) {
        el.placeholder = shown;
        el.value = '';
      } else {
        el.value = shown;
      }
    });

    if (asPlaceholder) {
      // 見本表示のみ＝計算対象外にする（実行時に0扱いになる。必須項目はエラー扱いになる）
      state.targetSales = 0; state.mktRatio = 0; state.unitPrice = 0;
      state.winRate = 0; state.oppRate = 0;
      state.grossMargin = 0; state.ltv = 0;
      state.currentSales = 0; state.currentMktSales = 0;
      COST_KEYS.forEach((c) => {
        state.costs[c.key].current = 0; state.costs[c.key].next = 0;
        state.costs[c.key].currentLeads = 0; state.costs[c.key].nextLeads = 0;
      });
    }

    clearSetupError();
    renderCostTable(asPlaceholder, demoCosts);
    updateMaxCplPreview();
  }

  function validateRequiredFields() {
    const missing = [];
    REQUIRED_FIELDS.forEach(({ id, label }) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('input-error');
      if (el.value.trim() === '') {
        missing.push(label);
        el.classList.add('input-error');
      }
    });
    return missing;
  }

  function showSetupError(missing) {
    const el = document.getElementById('setup-error');
    if (!el) return;
    el.textContent = `必須項目（※）が未入力です：${missing.join('、')}`;
    el.hidden = false;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function clearSetupError() {
    const el = document.getElementById('setup-error');
    if (el) el.hidden = true;
  }

  function readSetupForm() {
    state.targetSales = parseFloat(document.getElementById('in-targetSales').value) || 0;
    state.mktRatio = parseFloat(document.getElementById('in-mktRatio').value) || 0;
    state.unitPrice = parseFloat(document.getElementById('in-unitPrice').value) || 0;
    state.winRate = parseFloat(document.getElementById('in-winRate').value) || 0;
    state.oppRate = parseFloat(document.getElementById('in-oppRate').value) || 0;
    state.grossMargin = parseFloat(document.getElementById('in-grossMargin').value) || 0;
    state.ltv = parseFloat(document.getElementById('in-ltv').value) || 0;
    state.currentSales = parseFloat(document.getElementById('in-currentSales').value) || 0;
    state.currentMktSales = parseFloat(document.getElementById('in-currentMktSales').value) || 0;
    const reserveRateCurrentInput = parseFloat(document.getElementById('in-reserveRateCurrent').value);
    state.reserveRateCurrent = isFinite(reserveRateCurrentInput) && reserveRateCurrentInput >= 0 ? reserveRateCurrentInput : 5;
    const reserveRateNextInput = parseFloat(document.getElementById('in-reserveRateNext').value);
    state.reserveRateNext = isFinite(reserveRateNextInput) && reserveRateNextInput >= 0 ? reserveRateNextInput : 5;
    selectedIndustryName = document.getElementById('in-industry').value;
    // costs はテーブルの入力欄がすでに state.costs を直接更新している
  }

  // ---------- 入力エリア上部の「すべてリセット」 ----------
  document.getElementById('setup-reset-btn')?.addEventListener('click', () => {
    state = JSON.parse(JSON.stringify(DEMO_DATA));
    document.getElementById('in-industry').selectedIndex = 0;
    document.querySelectorAll('.scenario-btn').forEach((b) => {
      b.classList.toggle('scenario-btn--active', b.getAttribute('data-scenario') === state.scenario);
    });
    fillSetupForm(true);
  });

  // 予備費率（%）は今期実績・来期計画で別々に、STEP1の合計プレビューにもリアルタイムで反映する
  document.getElementById('in-reserveRateCurrent')?.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    state.reserveRateCurrent = isFinite(val) && val >= 0 ? val : 0;
    renderSetupTotals();
  });
  document.getElementById('in-reserveRateNext')?.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    state.reserveRateNext = isFinite(val) && val >= 0 ? val : 0;
    renderSetupTotals();
  });

  // 許容上限CPL（自動計算）のライブプレビュー：入力のたびに即座に再計算して表示する
  function updateMaxCplPreview() {
    const grossMargin = parseFloat(document.getElementById('in-grossMargin')?.value) || 0;
    const ltv = parseFloat(document.getElementById('in-ltv')?.value) || 0;
    const winRate = parseFloat(document.getElementById('in-winRate')?.value) || 0;
    const oppRate = parseFloat(document.getElementById('in-oppRate')?.value) || 0;
    const mult = getScenarioMultiplier(state.scenario);
    const effWin = clampPositive(winRate * mult) / 100;
    const effOpp = clampPositive(oppRate * mult) / 100;
    const maxCPL = ltv > 0 && grossMargin > 0 ? ltv * (grossMargin / 100) * effOpp * effWin : 0;
    const el = document.getElementById('maxcpl-display');
    if (el) el.textContent = maxCPL > 0 ? `${maxCPL.toFixed(2)}千円` : '-';
  }
  ['in-grossMargin', 'in-ltv', 'in-winRate', 'in-oppRate'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', updateMaxCplPreview);
  });

  // ---------- 成約・商談化率シナリオ切り替え（悲観-20% ／ 標準 ／ 楽観+20%） ----------
  document.querySelectorAll('.scenario-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.scenario = btn.getAttribute('data-scenario') || 'base';
      document.querySelectorAll('.scenario-btn').forEach((b) => b.classList.toggle('scenario-btn--active', b === btn));
      updateMaxCplPreview();
      render();
    });
  });

  // ---------- 参考：業界比較 ----------
  function renderRankingChart(container, ownIndustryName, ownActualRatio) {
    const rows = [...allIndustries].sort((a, b) => b.adToSalesRatioPercent - a.adToSalesRatioPercent);
    const max = Math.max(...rows.map((d) => d.adToSalesRatioPercent), ownActualRatio) * 1.08;
    container.innerHTML = '';
    rows.forEach((d) => {
      const isOwn = d.industry === ownIndustryName;
      const row = document.createElement('div');
      row.className = 'rank-row' + (isOwn ? ' own' : '');
      const widthPct = (d.adToSalesRatioPercent / max) * 100;
      const refPct = isOwn ? (ownActualRatio / max) * 100 : null;
      row.innerHTML = `
        <div class="name">${d.industry}</div>
        <div class="rank-track">
          <div class="rank-fill" style="width:${widthPct}%;"></div>
          ${refPct !== null ? `<div class="rank-refline" style="left:${refPct}%;"></div>` : ''}
        </div>
        <div class="val">${fmtPercent(d.adToSalesRatioPercent, 2)}</div>
      `;
      container.appendChild(row);
    });
  }

  function renderReference(totals) {
    const industryEntry = allIndustries.find((i) => i.industry === selectedIndustryName) || allIndustries[0];
    const industryRatio = industryEntry ? industryEntry.adToSalesRatioPercent : 0;
    const ownRatio = state.targetSales > 0 ? (state.costs.ad.next / state.targetSales) * 100 : 0;
    const position = computePosition(ownRatio, industryRatio);

    document.getElementById('ref-own-ratio').textContent = fmtPercent(ownRatio, 2);
    document.getElementById('ref-industry-ratio').textContent = fmtPercent(industryRatio, 2);
    document.getElementById('ref-position').textContent = position.text;

    const rankingContainer = document.getElementById('ranking-chart');
    if (rankingContainer && industryEntry) {
      renderRankingChart(rankingContainer, industryEntry.industry, ownRatio);
    }
  }

  // ---------- チャート（来期 収益構造・CPL可視化） ----------
  // サイトのアクセントカラー（--color-accent）をJSから参照するためのヘルパー。
  // Chart.jsの色設定はCSS変数を直接使えないため、実際に適用されている値を都度読み取る。
  function getAccentColor() {
    try {
      const v = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim();
      return v || '#2563eb';
    } catch (e) {
      return '#2563eb';
    }
  }

  let leadGapChartInstance = null;
  let cplComparisonChartInstance = null;
  let costProfitChartInstance = null;

  function initCharts() {
    if (typeof Chart === 'undefined') return;
    const accent = getAccentColor();
    const leadGapCtx = document.getElementById('leadGapChart');
    if (leadGapCtx) {
      leadGapChartInstance = new Chart(leadGapCtx, {
        type: 'doughnut',
        data: {
          labels: ['来期計画リード（合計）', '目標未達ギャップ'],
          datasets: [{
            data: [0, 0],
            backgroundColor: [accent, '#f59e0b'],
            borderWidth: 0,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } },
            tooltip: {
              callbacks: {
                label: (ctx) => `${ctx.label}：${Math.round(ctx.parsed).toLocaleString('ja-JP')}件`,
              },
            },
          },
        },
      });
    }
    const cplCtx = document.getElementById('cplComparisonChart');
    if (cplCtx) {
      cplComparisonChartInstance = new Chart(cplCtx, {
        type: 'bar',
        data: {
          labels: ['許容上限CPL', '計画CPL', '限界CPL'],
          datasets: [
            {
              label: '千円',
              data: [0, 0, 0],
              backgroundColor: ['#10b981', '#94a3b8', accent],
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: { beginAtZero: true, ticks: { font: { size: 10 } } },
            x: { ticks: { font: { size: 10 } } },
          },
          plugins: {
            legend: { display: false },
          },
        },
      });
    }
    const costProfitCtx = document.getElementById('costProfitChart');
    if (costProfitCtx) {
      costProfitChartInstance = new Chart(costProfitCtx, {
        type: 'bar',
        data: {
          labels: ['今期実績', '来期計画'],
          datasets: [
            { label: 'マーケ投資コスト（千円）', data: [0, 0], backgroundColor: '#94a3b8', borderRadius: 6 },
            { label: 'マーケ創出粗利（千円）', data: [0, 0], backgroundColor: accent, borderRadius: 6 },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } },
          },
          scales: {
            y: { beginAtZero: true, ticks: { font: { size: 10 } } },
            x: { ticks: { font: { size: 10 } } },
          },
        },
      });
    }
  }

  function updateCharts(s, pipeline, totals, marginal, maxCPL, impliedCpl, leadsNextSum, leadGap, worstChannel, worstCpl, marginalCpl) {
    if (leadGapChartInstance) {
      const achieved = Math.max(0, Math.min(leadsNextSum, pipeline.requiredLeads));
      const gap = Math.max(0, leadGap);
      leadGapChartInstance.data.datasets[0].data = [achieved, gap];
      leadGapChartInstance.update();
    }
    if (cplComparisonChartInstance) {
      const planCpl = worstChannel ? worstCpl : impliedCpl;
      const planLabel = worstChannel ? `計画CPL（${worstChannel.name}）` : '計画CPL（総合平均）';
      const planColor = maxCPL > 0 && planCpl > maxCPL ? '#dc2626' : '#10b981';
      cplComparisonChartInstance.data.labels = ['許容上限CPL', planLabel, '限界CPL'];
      cplComparisonChartInstance.data.datasets[0].data = [maxCPL, planCpl, marginalCpl || 0];
      cplComparisonChartInstance.data.datasets[0].backgroundColor = ['#10b981', planColor, getAccentColor()];
      cplComparisonChartInstance.update();
    }
    if (costProfitChartInstance) {
      costProfitChartInstance.data.datasets[0].data = [marginal.currentBudget, totals.budget];
      costProfitChartInstance.data.datasets[1].data = [marginal.grossProfitCurrent, marginal.grossProfit];
      costProfitChartInstance.update();
    }
  }

  // ---------- STEP2：ダッシュボード描画 ----------
  function render() {
    const pipeline = computePipeline(state);
    const totals = computeCostTotals(state);
    const maxCPL = computeMaxCPL(state, pipeline);
    // 算定総合CPL（実施中の施策のみの実額ベース。「実施しない（0）」の施策は母数から除外）
    const impliedCpl = computeBlendedActiveCpl(state.costs, 'next', 'nextLeads');
    const kpis = computeKpis(state, pipeline, totals);

    const maxcplEl = document.getElementById('maxcpl-display');
    if (maxcplEl) maxcplEl.textContent = maxCPL > 0 ? `${maxCPL.toFixed(2)}千円` : '-';

    const subnoteEl = document.getElementById('report-subnote');
    if (subnoteEl) {
      const scenarioText = state.scenario === 'pessimistic' ? '悲観シナリオ（-20%）' : state.scenario === 'optimistic' ? '楽観シナリオ（+20%）' : '標準シナリオ';
      subnoteEl.textContent = `※今期実績比較・歩留まり逆算モデル適用／成約・商談化率シナリオ：${scenarioText}`;
    }

    // 施策別（Web広告・展示会・SEO）の来期目標リード合計 vs 全社目標からの必要リード数（KPIカード・アラート双方で使用）
    const leadsNextSum = sumLeads(state.costs, 'nextLeads');
    const leadGap = pipeline.requiredLeads - leadsNextSum;

    // 経営判断ダッシュボード（来期予算／創出限界利益／限界利益ROI／全社目標達成率）
    const marginal = computeMarginalProfit(state, pipeline, totals);
    document.getElementById('kpi-budget').textContent = fmtThousandNoUnit(totals.budget);
    document.getElementById('kpi-budgetSub').textContent =
      fmtChangeRate(marginal.currentBudget, totals.budget) || '今期実績データなし';
    document.getElementById('kpi-marginalProfit').textContent = fmtThousandNoUnit(marginal.marginalProfit);
    document.getElementById('kpi-marginalProfitSub').textContent =
      `粗利 ${fmtThousand(marginal.grossProfit)} − 費 ${fmtThousand(totals.budget)}`;
    const marginalRoiEl = document.getElementById('kpi-marginalRoi');
    marginalRoiEl.textContent = marginal.marginalROI.toFixed(0);
    marginalRoiEl.classList.toggle('kpi-value-good', marginal.marginalROI >= 100);
    marginalRoiEl.classList.toggle('kpi-value-bad', marginal.marginalROI < 100);
    document.getElementById('kpi-marginalRoiSub').textContent = marginal.marginalROI >= 100
      ? `✓ 100%超＝投資価値あり（売上ベースROI ${kpis.roi.toFixed(0)}%）`
      : `⚠ 100%未満＝要再検討（売上ベースROI ${kpis.roi.toFixed(0)}%）`;
    const leadRatePct = pipeline.requiredLeads > 0 ? (leadsNextSum / pipeline.requiredLeads) * 100 : 0;
    document.getElementById('kpi-leadRate').textContent = leadRatePct.toFixed(1);
    document.getElementById('kpi-leadRateSub').textContent = leadGap > 0
      ? `必要${fmtCount(pipeline.requiredLeads)}に対し${fmtCount(leadGap)}不足`
      : `必要${fmtCount(pipeline.requiredLeads)}を充足`;
    document.getElementById('kpi-leadRateCard')?.classList.toggle('kpi-card--warn', leadGap > 0);

    // 算定総合CPL・CPL安全率（KPIカードとしては非表示だが、判定ロジックには引き続き使用）
    const safetyMarginPct = maxCPL > 0 ? ((maxCPL - impliedCpl) / maxCPL) * 100 : 0;

    // エグゼクティブサマリー（結論ファースト：絶対額と投資判定を1行目で提示）
    const execEl = document.getElementById('exec-summary');
    const execTextEl = document.getElementById('exec-summary-text');
    if (execEl && execTextEl) {
      let tier = 'good';
      if (maxCPL <= 0) tier = 'neutral';
      else if (safetyMarginPct < 0) tier = 'danger';
      else if (safetyMarginPct < 15) tier = 'warn';
      const judgeLabel = tier === 'danger' ? 'NG（赤字構造）' : tier === 'warn' ? '要再検討（余地わずか）' : tier === 'neutral' ? '判定不可（入力不足）' : 'GO（投資妥当）';
      execEl.className = `exec-summary exec-summary--${tier}`;
      execTextEl.innerHTML = `来期マーケ予算 <strong>${fmtThousand(totals.budget)}</strong> に対し、創出限界利益は <strong>${marginal.marginalProfit >= 0 ? '+' : ''}${fmtThousandNoUnit(marginal.marginalProfit)}千円</strong>（限界利益ROI ${marginal.marginalROI.toFixed(0)}%）。判定：<strong>${judgeLabel}</strong>`;
    }

    // 課題の特定：許容上限CPLを超過している施策のうち、最もCPLが高いものを名指しする
    let worstChannel = null;
    let worstCpl = 0;
    if (maxCPL > 0) {
      COST_KEYS.forEach((c) => {
        if (!c.hasLeads) return;
        const budget = state.costs[c.key].next || 0;
        const leads = state.costs[c.key].nextLeads || 0;
        if (budget > 0 && leads > 0) {
          const cpl = budget / leads;
          if (cpl > maxCPL && cpl > worstCpl) { worstCpl = cpl; worstChannel = c; }
        }
      });
    }
    const leadGapText = leadGap > 0
      ? `全社目標達成に必要な${fmtCount(pipeline.requiredLeads)}に対し、来期計画のリード獲得見込みは${fmtCount(leadsNextSum)}（不足 ${fmtCount(leadGap)}）です。`
      : '';
    const worstChannelText = worstChannel
      ? `${worstChannel.name}の計画CPL（${worstCpl.toFixed(1)}千円）が許容上限CPL（${maxCPL.toFixed(1)}千円）を超過しています。`
      : '';

    const alertBox = document.getElementById('health-alert-box');
    const alertMsg = document.getElementById('health-alert-message');
    const alertIcon = document.getElementById('health-alert-icon');
    if (alertBox && alertMsg && alertIcon) {
      if (maxCPL <= 0) {
        alertBox.className = 'alert-box';
        alertIcon.textContent = 'ℹ';
        alertMsg.textContent = '商品粗利率・1件LTVを入力すると、健全性判定が表示されます。';
      } else if (safetyMarginPct < 0) {
        alertBox.className = 'alert-box alert-box--danger';
        alertIcon.textContent = '⚠';
        alertMsg.innerHTML = `<strong>危険判定（撤退リスク）</strong>：${leadGapText}${worstChannelText}算定総合CPL（${impliedCpl.toFixed(2)}千円）が許容上限CPL（${maxCPL.toFixed(2)}千円）を超過しており赤字構造です。高CPL施策の縮小が必要です。`;
      } else if (safetyMarginPct < 15) {
        alertBox.className = 'alert-box alert-box--warn';
        alertIcon.textContent = '⚠';
        alertMsg.innerHTML = `<strong>注意判定（余地わずか）</strong>：${leadGapText}${worstChannelText}CPL安全率が${safetyMarginPct.toFixed(1)}%と低めです。CPLの悪化や成約率ダウンで赤字転落するリスクがあります。`;
      } else {
        alertBox.className = 'alert-box';
        alertIcon.textContent = '✓';
        alertMsg.innerHTML = `<strong>健全性確認（利益構造クリア）</strong>：${leadGapText}${worstChannelText}算定CPL（${impliedCpl.toFixed(2)}千円）は許容上限CPL（${maxCPL.toFixed(2)}千円）を下回っており、${safetyMarginPct.toFixed(1)}%の確実な利益クッションが確保されています。`;
      }
    }
    // 限界CPL＝不足リードを追加獲得する際、既存の利益クッション（創出限界利益）を使い切らない範囲で許容できるCPLの上限
    // （新規の入力項目は追加せず、既存の計算値のみから算出）
    const marginalCpl = leadGap > 0 ? Math.max(0, marginal.marginalProfit) / leadGap : null;

    // チャートカードのタグ・フッター統計ストリップ（現状値から動的生成）
    const chartTag1 = document.getElementById('chartTag1');
    const chartStat1 = document.getElementById('chartStat1');
    if (chartTag1 && chartStat1) {
      if (leadGap > 0) {
        chartTag1.textContent = '目標未達ギャップ';
        chartTag1.className = 'chart-tag chart-tag--warn';
      } else if (pipeline.requiredLeads > 0) {
        chartTag1.textContent = '目標達成';
        chartTag1.className = 'chart-tag chart-tag--good';
      } else {
        chartTag1.textContent = '計算中';
        chartTag1.className = 'chart-tag';
      }
      chartStat1.innerHTML = `<span>全社必要リード：<strong>${fmtCount(pipeline.requiredLeads)}</strong></span><span>${leadGap > 0 ? `未達：<strong>▲${fmtCount(leadGap)}</strong>` : `充足：<strong>+${fmtCount(-leadGap)}</strong>`}</span>`;
    }
    const chartTag2 = document.getElementById('chartTag2');
    const chartStat2 = document.getElementById('chartStat2');
    if (chartTag2 && chartStat2) {
      const budgetDelta = totals.budget - marginal.currentBudget;
      const profitDelta = marginal.grossProfit - marginal.grossProfitCurrent;
      if (profitDelta >= 0 && budgetDelta <= 0) {
        chartTag2.textContent = 'コスト効率改善';
        chartTag2.className = 'chart-tag chart-tag--good';
      } else if (profitDelta < 0) {
        chartTag2.textContent = '粗利減少見込み';
        chartTag2.className = 'chart-tag chart-tag--warn';
      } else {
        chartTag2.textContent = '投資拡大フェーズ';
        chartTag2.className = 'chart-tag';
      }
      chartStat2.innerHTML = `<span>投資額 増減：<strong>${budgetDelta >= 0 ? '+' : ''}${fmtThousandNoUnit(budgetDelta)}千円</strong></span><span>創出粗利 増減：<strong>${profitDelta >= 0 ? '+' : ''}${fmtThousandNoUnit(profitDelta)}千円</strong></span>`;
    }
    const chartTag3 = document.getElementById('chartTag3');
    const chartStat3 = document.getElementById('chartStat3');
    if (chartTag3 && chartStat3) {
      if (worstChannel) {
        chartTag3.textContent = `${worstChannel.name}が許容超過`;
        chartTag3.className = 'chart-tag chart-tag--danger';
      } else if (maxCPL > 0 && safetyMarginPct < 15) {
        chartTag3.textContent = '安全率わずか';
        chartTag3.className = 'chart-tag chart-tag--warn';
      } else {
        chartTag3.textContent = 'CPL基準内';
        chartTag3.className = 'chart-tag chart-tag--good';
      }
      chartStat3.innerHTML = `<span>許容上限CPL：<strong>${maxCPL > 0 ? maxCPL.toFixed(2) : '-'}千円</strong></span><span>限界CPL：<strong>${marginalCpl !== null ? marginalCpl.toFixed(2) : '-'}千円</strong></span>`;
    }

    renderRecoList(pipeline, maxCPL, worstChannel, worstCpl, leadGap, marginalCpl, state);
    renderUnitEconTable(state, maxCPL);
    updateCharts(state, pipeline, totals, marginal, maxCPL, impliedCpl, leadsNextSum, leadGap, worstChannel, worstCpl, marginalCpl);

    const leadsCheckEl = document.getElementById('leads-plan-check');
    if (leadsCheckEl) {
      if (leadsNextSum > 0) {
        const sufficient = leadsNextSum >= pipeline.requiredLeads;
        const badge = `<span class="cpl-badge ${sufficient ? 'cpl-badge--ok' : 'cpl-badge--warn'}">${sufficient ? '目標充足' : '目標未達'}</span>`;
        leadsCheckEl.innerHTML = sufficient
          ? `${badge} 施策別（Web広告・展示会・SEO）の来期目標リード合計は${fmtCount(leadsNextSum)}。全社目標から逆算した必要リード数${fmtCount(pipeline.requiredLeads)}に対し充足しています。`
          : `${badge} 施策別（Web広告・展示会・SEO）の来期目標リード合計は${fmtCount(leadsNextSum)}。全社目標から逆算した必要リード数${fmtCount(pipeline.requiredLeads)}に対し${fmtCount(pipeline.requiredLeads - leadsNextSum)}不足しています。施策別の目標リードを見直してください。`;
      } else {
        leadsCheckEl.innerHTML = '';
      }
    }

    // 今期実績 vs 来期計画　全コスト・全指標 対比サマリー
    renderFullCompareTable(state, pipeline, totals, marginal);

    // フッター文言
    document.getElementById('footer-policy').textContent =
      `${COST_KEYS[0].name}と${COST_KEYS[3].name}の強化により、${fmtCount(pipeline.requiredLeads)}のリード獲得と商談化率の維持・改善を図る。予算配分は今期実績をベースに、施策ごとの費用対効果を見ながら四半期ごとに見直す想定。`;
    document.getElementById('footer-risk').textContent =
      `申請予算の${isFinite(state.reserveRateNext) ? state.reserveRateNext : 5}%（${fmtThousand(totals.reserve)}）を予備費として確保。市況変化や新チャネルの検証、CPA高騰時の緊急補填策へ機動的に充当する。`;
    document.getElementById('footer-request').textContent =
      `本申請枠（${fmtThousand(totals.budget)}）のご承認を依頼する。期中は月次でROI・CACをモニタリングし、四半期終了時点で予実差が大きい場合はチャネル間の再配分を行う。`;

    renderReference(totals);
  }

  // 今期実績 vs 来期計画　全コスト・全指標 対比サマリー（1テーブルに集約）
  function renderFullCompareTable(s, pipeline, totals, marginal) {
    const tbody = document.getElementById('full-compare-body');
    if (!tbody) return;
    const leadsCurrentSum = sumLeads(s.costs, 'currentLeads');
    const currentBudget = totals.subtotalCurrent + totals.reserveCurrent;
    const rows = [
      { name: '全社売上高（千円）', cur: s.currentSales, next: s.targetSales, unit: '千円', isCost: false },
      { name: 'マーケ創出売上（千円）', cur: s.currentMktSales, next: pipeline.mktTarget, unit: '千円', isCost: false },
      { name: '獲得リード総数（件）', cur: leadsCurrentSum, next: pipeline.requiredLeads, unit: '件', isCost: false },
      { name: '― Web広告費（千円）', cur: s.costs.ad.current, next: s.costs.ad.next, unit: '千円', isCost: true },
      { name: '― 展示会・イベント費（千円）', cur: s.costs.event.current, next: s.costs.event.next, unit: '千円', isCost: true },
      { name: '― SEO・制作費（千円）', cur: s.costs.seo.current, next: s.costs.seo.next, unit: '千円', isCost: true },
      { name: '― ツール・SaaS費（千円）', cur: s.costs.tools.current, next: s.costs.tools.next, unit: '千円', isCost: true },
      { name: '― 人件費（千円）', cur: s.costs.labor.current, next: s.costs.labor.next, unit: '千円', isCost: true },
      { name: '― 外注費（千円）', cur: s.costs.outsourcing.current, next: s.costs.outsourcing.next, unit: '千円', isCost: true },
      { name: 'マーケ総費用（千円）', cur: currentBudget, next: totals.budget, unit: '千円', isCost: true, isBold: true },
      { name: '創出限界利益（千円）', cur: marginal.marginalProfitCurrent, next: marginal.marginalProfit, unit: '千円', isCost: false, isBold: true },
    ];

    tbody.innerHTML = rows.map((r) => {
      const diff = r.next - r.cur;
      const pct = r.cur !== 0 ? (diff / r.cur) * 100 : null;
      const diffStr = `${diff >= 0 ? '+' : ''}${Math.round(diff).toLocaleString('ja-JP')} ${r.unit}`;
      const pctStr = pct === null ? '―' : `${pct >= 0 ? '+' : ''}${pct.toFixed(1)}%`;
      const isGood = r.isCost ? diff < 0 : diff > 0;
      const isBad = r.isCost ? diff > 0 : diff < 0;
      const diffClass = diff === 0 ? '' : isGood ? 'diff-up' : isBad ? 'diff-down' : '';
      const curDisplay = Math.round(r.cur).toLocaleString('ja-JP');
      const nextDisplay = Math.round(r.next).toLocaleString('ja-JP');
      return `
      <tr class="${r.isBold ? 'fct-row--bold' : ''}">
        <td>${r.name}</td>
        <td class="fct-current">${curDisplay} ${r.unit}</td>
        <td class="fct-next">${nextDisplay} ${r.unit}</td>
        <td class="${diffClass}">${diffStr}</td>
        <td class="fct-pct">${pctStr}</td>
      </tr>`;
    }).join('');
  }

  // ---------- イベント：実行／印刷 ----------
  document.getElementById('run-btn')?.addEventListener('click', () => {
    const missing = validateRequiredFields();
    if (missing.length > 0) {
      showSetupError(missing);
      return;
    }
    clearSetupError();
    readSetupForm();

    const reportDate = document.getElementById('report-date');
    if (reportDate) {
      const now = new Date();
      reportDate.textContent = `作成日：${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日`;
    }

    render();

    const resultPanel = document.querySelector('.result-panel');
    if (resultPanel && window.innerWidth < 960) {
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  document.getElementById('print-btn')?.addEventListener('click', () => {
    window.print();
  });

  // ---------- 初期表示 ----------
  // 見本の数字はプレースホルダーとしてのみ表示（計算には使わない）。
  // 右側の結果パネルは、実行前は0・グラフは枠のみの状態で表示しておく。
  fillSetupForm(true);
  renderCostHelp();
  updateMaxCplPreview();
  initCharts();
  render();
</script>

