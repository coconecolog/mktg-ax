---
// src/pages/tools/budget-simulator.astro
//
// マーケティング予算シミュレーター（/tools/budget-simulator）
// 仕様: Googleドライブ「MKTG.AX／共有（正本）／04_ツール仕様／予算シミュレーターの仕様」6. 修正（2026-10-17）
// 数字の定義: 同「数字の定義（KPI・予算）」。金額は万円、費用は外部費用＋人件費。
// - 計算はすべてブラウザ内。入力した数字はサーバーに送らない。
// - CAC・ROI・回収期間は、計画の受注件数（計画のリード数×商談化率×受注率）と、その受注金額（×平均単価）で出す。
// - 配色はサイト（白黒）と月次報告メーカーに合わせる。緑＝上限内／足りる、赤＝上限超え／不足。
// - 記入例は基本モデルの成長期（3期目）。施策の「今期」は前の期の数字がないため空欄。
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFooter from "@/components/ToolFooter.astro";
---

<BaseLayout
  title="マーケティング予算シミュレーター｜MKTG.AX"
  description="今期の実績から来期に必要なリード数と予算を逆算し、回収期間・ROI・施策ごとのCPL判定まで含めた予算計画書を作る無料ツールです。"
  ogImage="/open-graph/default.png"
>
  <main class="bs">
    <header class="bs-head no-print">
      <p class="bs-eyebrow"><a href="/tools">便利ツール</a></p>
      <h1>マーケティング予算シミュレーター</h1>
      <p class="bs-lead">今期の実績から来期に必要なリード数と予算を逆算し、回収期間・ROI・施策ごとのCPL判定まで含めた計画書を作ります（金額は万円）。</p>
    </header>

    <div class="bs-grid">
      <!-- ===== 入力 ===== -->
      <div class="bs-in no-print">
        <div class="bs-tools">
          <button type="button" class="bs-link" id="bs-example">記入例に戻す</button>
          <button type="button" class="bs-link" id="bs-clear">入力をすべて消す</button>
        </div>

        <section class="bs-sec">
          <h2 class="bs-st">1. 前提</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">平均単価（年間の取引額）</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="price" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">粗利率</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.01" data-k="margin" /><span>%</span></span></label>
            <label class="bs-field"><span class="bs-lb">取り返す年数</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="0.1" data-k="years" /><span>年</span></span></label>
            <div class="bs-field">
              <span class="bs-lb">事業の段階</span>
              <div class="bs-chips" role="radiogroup" aria-label="事業の段階" id="bs-stage">
                <button type="button" class="bs-chip" role="radio" data-stage="intro">導入期</button>
                <button type="button" class="bs-chip" role="radio" data-stage="growth">成長期</button>
                <button type="button" class="bs-chip" role="radio" data-stage="stable">安定期</button>
              </div>
            </div>
          </div>
          <p class="bs-note">事業の段階は、防衛：攻撃の目安（導入期5：5、成長期7：3、安定期6：4）に使います</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">2. 目標（来期）</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">全社の売上目標</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="target" /><span>万円</span></span></label>
            <label class="bs-field"><span class="bs-lb">マーケ経由の割合</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.01" data-k="mktRatio" /><span>%</span></span></label>
          </div>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">3. 今期の実績</h2>
          <div class="bs-f">
            <label class="bs-field"><span class="bs-lb">商談化率</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.01" data-k="oppRate" /><span>%</span></span></label>
            <label class="bs-field"><span class="bs-lb">受注率</span><span class="bs-ip"><input type="number" inputmode="decimal" min="0" max="100" step="0.01" data-k="winRate" /><span>%</span></span></label>
          </div>
          <p class="bs-note">率は小数第2位まで入れられます。受注率は決着した商談（受注＋失注）だけで出します</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">4. 施策ごとの費用とリード数<small>万円・件</small></h2>
          <div id="bs-rows"></div>
          <button type="button" class="bs-add" id="bs-add">＋ 施策を追加</button>
          <p class="bs-note">人件費は、その施策にかける時間の割合×マーケの人件費（年額）。リードを生まない費用（ツール・サイト保守など）はリード数0で、判定は「―」になります。今期の欄は、わからなければ空欄で構いません</p>
        </section>

        <section class="bs-sec">
          <h2 class="bs-st">5. 予算の上限<small>任意</small></h2>
          <label class="bs-field"><span class="bs-ip"><input type="number" inputmode="decimal" min="0" step="1" data-k="cap" /><span>万円</span></span></label>
        </section>

        <p class="bs-err" id="bs-err" role="alert" hidden>未入力の項目があります。赤枠の欄を入力してください。</p>
        <button type="button" class="bs-btn" id="bs-run">計画書を作る</button>
      </div>

      <!-- ===== 計画書 ===== -->
      <div class="bs-out">
        <div class="bs-bar no-print">
          <div class="bs-sw">
            <span>シナリオ：</span>
            <div class="bs-chips" role="radiogroup" aria-label="シナリオ" id="bs-scenario">
              <button type="button" class="bs-chip" role="radio" data-sc="pess">悲観（−2割）</button>
              <button type="button" class="bs-chip" role="radio" data-sc="base">標準</button>
              <button type="button" class="bs-chip" role="radio" data-sc="opt">楽観（＋2割）</button>
            </div>
          </div>
          <button type="button" class="bs-obtn" id="bs-print">印刷／PDF</button>
        </div>

        <div class="bs-rp" id="bs-report">
          <div class="bs-rh">
            <div>
              <h2 class="bs-rt">来期 マーケティング予算計画書（案）</h2>
              <p class="bs-rs">今期の実績の率から逆算・金額は万円・費用は外部費用＋人件費</p>
            </div>
            <p class="bs-rs" id="r-date"></p>
          </div>

          <p class="bs-empty" id="r-empty" hidden></p>

          <div id="r-body">
            <div class="bs-top">
              <div class="bs-dark">
                <div class="bs-k">
                  <div><p class="bs-kl">回収期間</p><p class="bs-kv bs-big"><span id="r-payback"></span><small>か月</small></p><p class="bs-ks" id="r-payback-s"></p></div>
                  <div><p class="bs-kl">ROI（1年）</p><p class="bs-kv bs-big"><span id="r-roi"></span><small>%</small></p><p class="bs-ks">（受注金額×粗利率−費用）÷費用</p></div>
                  <div><p class="bs-kl">CAC</p><p class="bs-kv bs-big"><span id="r-cac"></span><small>万円</small></p><p class="bs-ks"><span id="r-cac-s"></span></p></div>
                </div>
                <p class="bs-base" id="r-base"></p>
                <hr />
                <div class="bs-k">
                  <div><p class="bs-kl">来期の費用（合計）</p><p class="bs-kv"><span id="r-total"></span><small>万円</small></p><p class="bs-ks" id="r-total-s"></p></div>
                  <div><p class="bs-kl">予算の上限との差</p><p class="bs-kv" id="r-cap"></p><p class="bs-ks" id="r-cap-s"></p></div>
                  <div><p class="bs-kl">許容CPL</p><p class="bs-kv"><span id="r-acpl"></span><small>万円</small></p><p class="bs-ks">CACの上限×商談化率×受注率</p></div>
                </div>
              </div>

              <div class="bs-box">
                <p class="bs-h">逆算<small id="r-flow-sc"></small></p>
                <div class="bs-flow"><div class="bs-fc"><p class="l">マーケ経由の売上目標</p><p class="v" id="r-mktsales"></p><p class="s" id="r-mktsales-s"></p></div></div>
                <div class="bs-flow bs-flow3">
                  <div class="bs-fc"><p class="l">受注件数</p><p class="v" id="r-won"></p><p class="s" id="r-won-s"></p></div>
                  <span class="bs-arr">→</span>
                  <div class="bs-fc"><p class="l">商談数</p><p class="v" id="r-opp"></p><p class="s" id="r-opp-s"></p></div>
                  <span class="bs-arr">→</span>
                  <div class="bs-fc"><p class="l">リード数</p><p class="v" id="r-lead"></p><p class="s" id="r-lead-s"></p></div>
                </div>
                <div class="bs-cap"><span id="r-leadcheck"></span><span id="r-leadtag"></span></div>
              </div>
            </div>

            <div class="bs-row2">
              <div class="bs-box">
                <p class="bs-h">費用<small>万円</small></p>
                <table class="bs-t">
                  <thead><tr><th></th><th>今期</th><th>来期</th><th>差</th></tr></thead>
                  <tbody id="r-cost"></tbody>
                </table>
              </div>
              <div class="bs-box">
                <p class="bs-h">防衛：攻撃<small>費用（外部費用＋人件費）の比率</small></p>
                <div class="bs-ratio" id="r-ratio"></div>
                <div class="bs-ratio bs-ratio-t" id="r-ratio-t"></div>
                <p class="bs-lg" id="r-ratio-s"></p>
              </div>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h">施策ごとのCPL<small id="r-cpl-s"></small></p>
              <div class="bs-tw">
                <table class="bs-t">
                  <thead><tr><th>施策</th><th class="c">区分</th><th>来期の費用</th><th>リード数</th><th>CPL</th><th>今期のCPL</th><th class="c">判定</th></tr></thead>
                  <tbody id="r-ins"></tbody>
                </table>
              </div>
              <p class="bs-fx">CPL＝費用÷リード数。判定は、CPLが許容CPL以下なら「上限内」、超えたら「上限超え」</p>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h">シナリオ<small>商談化率と受注率を −2割／そのまま／＋2割</small></p>
              <div class="bs-sc" id="r-sc"></div>
            </div>

            <div class="bs-box bs-mt">
              <p class="bs-h">経営層のための指標の読み方</p>
              <div class="bs-gg">
                <div class="bs-gb"><b>回収期間（説明の主役）</b>1社を獲得した費用（CAC）を、その会社の粗利で何か月で取り返すか。<code>回収期間＝CAC÷（平均単価×粗利率÷12）<br />CAC＝費用÷計画の受注件数</code></div>
                <div class="bs-gb"><b>CACの上限と許容CPL</b>取り返す年数のうちに回収できる獲得費用の上限と、それをリード1件あたりに直した値。<code>CACの上限＝平均単価×粗利率×取り返す年数<br />許容CPL＝CACの上限×商談化率×受注率</code></div>
                <div class="bs-gb"><b>ROI（1年）</b>1年の粗利から費用を引いた利益の、費用に対する割合。初年度はマイナスになることもあります。回収期間と並べて示します。<code>ROI＝（計画の受注金額×粗利率−費用）÷費用</code></div>
              </div>
              <p class="bs-fx">計画の受注件数＝計画のリード数×商談化率×受注率。受注金額＝計画の受注件数×平均単価。予備費は持たず、期中に足りなくなったら追加予算の稟議で扱います。</p>
            </div>

            <div class="bs-ft">
              <div><b>重点施策の方針</b><span id="r-policy"></span></div>
              <div><b>リスク</b><span id="r-risk"></span></div>
              <div><b>お願い</b><span id="r-ask"></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <ToolFooter path="/tools/budget-simulator" />
</BaseLayout>

<style is:global>
  .bs { max-width: 1240px; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: #0b0b12; font-variant-numeric: tabular-nums; }
  .bs p { margin: 0; }
  .bs-eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; color: #737373; }
  .bs-eyebrow a { color: inherit; text-decoration: none; }
  .bs-eyebrow a:hover { text-decoration: underline; }
  .bs-head h1 { margin: 0.25rem 0 0.4rem; font-size: 1.7rem; font-weight: 800; line-height: 1.35; }
  .bs-lead { color: #525252; line-height: 1.7; margin-bottom: 1.25rem !important; }

  .bs-grid { display: grid; grid-template-columns: 370px minmax(0, 1fr); gap: 24px; align-items: start; }

  /* ===== 入力 ===== */
  .bs-in { border: 1px solid #e5e5e5; border-radius: 12px; padding: 14px 16px 16px; background: #fff; }
  .bs-tools { display: flex; justify-content: flex-end; gap: 12px; }
  .bs-link { background: none; border: 0; padding: 0; font-size: 0.75rem; color: #525252; text-decoration: underline; cursor: pointer; }
  .bs-link[data-armed="1"] { color: #b91c1c; font-weight: 700; }
  .bs-sec { border-bottom: 1px solid #ececec; padding: 12px 0 14px; }
  .bs-st { font-size: 0.8rem; font-weight: 800; margin: 0 0 8px; }
  .bs-st small { font-weight: 400; color: #8a8a8a; margin-left: 6px; font-size: 0.7rem; }
  .bs-f { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .bs-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .bs-lb { font-size: 0.72rem; font-weight: 600; color: #404040; white-space: nowrap; }
  .bs-ip { display: flex; align-items: center; gap: 6px; border: 1px solid #d4d4d4; border-radius: 8px; background: #fff; padding: 0 8px; }
  .bs-ip:focus-within { border-color: #0b0b12; outline: 1px solid #0b0b12; }
  .bs-ip input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; padding: 6px 0; font-size: 0.9rem; color: #0b0b12; }
  .bs-ip > span { font-size: 0.72rem; color: #737373; flex-shrink: 0; }
  .bs-note { font-size: 0.68rem; color: #8a8a8a; line-height: 1.55; margin-top: 6px !important; }
  .bs-chips { display: flex; gap: 4px; flex-wrap: wrap; }
  .bs-chip { white-space: nowrap; border: 1px solid #d4d4d4; border-radius: 999px; background: #fff; padding: 4px 10px; font-size: 0.72rem; color: #404040; cursor: pointer; }
  .bs-chip[aria-checked="true"] { background: #0b0b12; border-color: #0b0b12; color: #fff; }
  .bs-ini { border: 1px solid #e5e5e5; border-radius: 8px; padding: 8px; margin-bottom: 6px; }
  .bs-ini-h { display: flex; gap: 6px; align-items: center; margin-bottom: 5px; }
  .bs-ini-name { flex: 1; min-width: 0; border: 1px solid transparent; border-radius: 6px; padding: 2px 4px; font-size: 0.78rem; font-weight: 800; color: #0b0b12; background: transparent; }
  .bs-ini-name:hover { border-color: #e5e5e5; }
  .bs-ini-name:focus { border-color: #0b0b12; outline: 0; }
  .bs-seg { display: inline-flex; border: 1px solid #d4d4d4; border-radius: 6px; overflow: hidden; flex-shrink: 0; }
  .bs-seg button { border: 0; background: #fff; padding: 2px 8px; font-size: 0.66rem; color: #404040; cursor: pointer; }
  .bs-seg button[aria-checked="true"] { background: #0b0b12; color: #fff; }
  .bs-del { border: 0; background: none; color: #8a8a8a; font-size: 0.95rem; line-height: 1; cursor: pointer; padding: 2px 4px; }
  .bs-del:hover { color: #b91c1c; }
  .bs-it { width: 100%; border-collapse: collapse; font-size: 0.7rem; }
  .bs-it th { font-weight: 600; color: #737373; text-align: right; padding: 1px 4px; }
  .bs-it th:first-child, .bs-it td:first-child { text-align: left; white-space: nowrap; color: #404040; }
  .bs-it td { padding: 1px 4px; text-align: right; }
  .bs-it input { width: 82px; border: 1px solid #d4d4d4; border-radius: 5px; padding: 2px 6px; text-align: right; font-size: 0.75rem; color: #0b0b12; background: #fff; }
  .bs-it input:focus { outline: 1px solid #0b0b12; border-color: #0b0b12; }
  .bs-it input::placeholder { color: #bdbdbd; }
  .bs-add { width: 100%; border: 1px dashed #bfbfbf; border-radius: 8px; background: #fff; text-align: center; padding: 6px; color: #525252; font-size: 0.72rem; cursor: pointer; }
  .bs-add:hover { border-color: #0b0b12; color: #0b0b12; }
  .bs-ip.bs-invalid { border-color: #b91c1c; background: #fef2f2; outline: 1px solid #b91c1c; }
  .bs-it input.bs-invalid { border-color: #b91c1c; background: #fef2f2; outline: 1px solid #b91c1c; }
  .bs-err { margin-top: 14px !important; font-size: 0.78rem; font-weight: 700; color: #b91c1c; }
  .bs-err + .bs-btn { margin-top: 6px; }
  .bs-btn { display: block; width: 100%; margin-top: 14px; border: 0; border-radius: 12px; background: #0b0b12; color: #fff; padding: 0.8rem; font-size: 0.92rem; font-weight: 700; cursor: pointer; }
  .bs-btn:hover { opacity: 0.9; }

  /* ===== 計画書 ===== */
  .bs-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
  .bs-sw { display: flex; align-items: center; gap: 6px; font-size: 0.78rem; color: #525252; flex-wrap: wrap; }
  .bs-obtn { border: 1px solid #0b0b12; border-radius: 10px; background: #fff; padding: 6px 14px; font-weight: 700; font-size: 0.78rem; color: #0b0b12; cursor: pointer; }
  .bs-obtn:hover { background: #0b0b12; color: #fff; }
  .bs-rp { border: 1px solid #e5e5e5; border-radius: 12px; padding: 22px 24px; background: #fff; font-size: 13px; line-height: 1.5; }
  .bs-rh { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; border-bottom: 3px solid #0b0b12; padding-bottom: 7px; }
  .bs-rt { font-size: 20px; font-weight: 800; margin: 0; line-height: 1.35; }
  .bs-rs { font-size: 11px; color: #525252; }
  .bs-empty { padding: 48px 0; text-align: center; color: #8a8a8a; font-size: 14px; line-height: 1.8; }
  .bs-top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 12px; margin-top: 12px; }
  .bs-dark { background: #0b0b12; color: #fff; border-radius: 8px; padding: 12px 16px; }
  .bs-dark hr { border: 0; border-top: 1px solid #333; margin: 10px 0; }
  .bs-k { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .bs-kl { font-size: 10.5px; color: #bdbdbd; font-weight: 700; }
  .bs-kv { font-size: 22px; font-weight: 800; line-height: 1.2; white-space: nowrap; }
  .bs-kv small { font-size: 12px; margin-left: 2px; }
  .bs-big { font-size: 30px; }
  .bs-ks { font-size: 10px; color: #d4d4d4; }
  .bs-base { font-size: 10.5px; color: #d4d4d4; background: #1f1f27; border-radius: 5px; padding: 4px 8px; margin-top: 8px !important; }
  .bs-tag { white-space: nowrap; display: inline-block; border-radius: 4px; padding: 1px 7px; font-size: 10.5px; font-weight: 800; color: #fff; margin-left: 6px; vertical-align: 2px; line-height: 1.5; }
  .bs-tag.ok { background: #15803d; }
  .bs-tag.ng { background: #b91c1c; }
  .bs-tag.mid { background: #6b7280; }
  .bs-box { border: 1px solid #e5e5e5; border-radius: 8px; padding: 10px 12px; min-width: 0; }
  .bs-mt { margin-top: 12px; }
  .bs-h { font-size: 12px; font-weight: 800; margin-bottom: 6px !important; display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .bs-h small { font-weight: 400; color: #737373; font-size: 10px; }
  .bs-flow { display: flex; align-items: center; gap: 6px; }
  .bs-flow3 { margin-top: 6px; }
  .bs-fc { flex: 1; min-width: 0; background: #f6f6f6; border-radius: 6px; padding: 6px 8px; text-align: center; }
  .bs-fc .l { font-size: 10px; color: #525252; font-weight: 700; }
  .bs-fc .v { font-size: 18px; font-weight: 800; }
  .bs-fc .s { font-size: 9.5px; color: #737373; }
  .bs-arr { font-weight: 800; color: #8a8a8a; }
  .bs-cap { display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #f6f6f6; border-radius: 6px; padding: 7px 10px; margin-top: 6px; }
  .bs-fx { font-size: 10px; color: #737373; margin-top: 6px !important; }
  .bs-tw { overflow-x: auto; }
  .bs-t { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-top: 2px; }
  .bs-t th { font-size: 10px; color: #404040; font-weight: 700; text-align: right; padding: 3px 8px; border-bottom: 1px solid #0b0b12; white-space: nowrap; }
  .bs-t td { text-align: right; padding: 3px 8px; border-bottom: 1px solid #ececec; white-space: nowrap; }
  .bs-t th:first-child, .bs-t td:first-child { text-align: left; }
  .bs-t td.n { font-weight: 800; white-space: normal; }
  .bs-t .c { text-align: center; }
  .bs-t tr.tot td { font-weight: 800; border-top: 1px solid #0b0b12; }
  .bs-t tr.weak td { background: #fef2f2; }
  .bs-t tr.weak td:first-child { box-shadow: inset 3px 0 0 #b91c1c; color: #b91c1c; }
  .bs-t .na { color: #8a8a8a; }
  .bs-t .bs-tag { margin-left: 0; }
  .bs-row2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: 12px; }
  .bs-ratio { display: flex; height: 20px; gap: 2px; margin: 6px 0 4px; }
  .bs-ratio div { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10.5px; font-weight: 800; border-radius: 2px; overflow: hidden; white-space: nowrap; }
  .bs-ratio-t { height: 6px; margin-top: 0; }
  .bs-lg { font-size: 10px; color: #525252; }
  .bs-sc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .bs-scc { background: #f6f6f6; border-radius: 6px; padding: 6px 9px; border: 1.5px solid transparent; }
  .bs-scc.on { background: #fff; border-color: #0b0b12; }
  .bs-scc .l { font-size: 10.5px; font-weight: 800; }
  .bs-scc .v { font-size: 11px; color: #404040; line-height: 1.6; }
  .bs-scc .v b { color: #0b0b12; }
  .bs-gg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .bs-gb { background: #f6f6f6; border-radius: 6px; padding: 8px 10px; font-size: 11px; line-height: 1.6; }
  .bs-gb b { display: block; font-size: 11.5px; margin-bottom: 2px; }
  .bs-gb code { display: block; font-family: inherit; font-size: 10.5px; color: #404040; border-top: 1px solid #e0e0e0; margin-top: 4px; padding-top: 4px; background: none; }
  .bs-ft { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 12px; border-top: 1px solid #e5e5e5; padding-top: 10px; font-size: 11px; line-height: 1.6; }
  .bs-ft b { display: block; font-size: 11.5px; }

  @media (max-width: 1000px) {
    .bs-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .bs-rp { padding: 16px 14px; }
    .bs-top, .bs-row2, .bs-sc, .bs-gg, .bs-ft { grid-template-columns: minmax(0, 1fr); }
    .bs-big { font-size: 24px; }
    .bs-kv { font-size: 18px; }
    .bs-k { gap: 8px; }
    .bs-rh { flex-direction: column; align-items: flex-start; }
  }

  @media print {
    @page { size: A4 portrait; margin: 8mm; }
    header, footer, nav, .no-print { display: none !important; }
    .bs { max-width: none; padding: 0; }
    .bs-grid { display: block; }
    .bs-rp { border: 0; padding: 0; zoom: 0.68; }
    .bs-top, .bs-row2 { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .bs-sc, .bs-gg, .bs-ft { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bs-box, .bs-dark { break-inside: avoid; }
    .bs-dark, .bs-tag, .bs-ratio div, .bs-t tr.weak td, .bs-fc, .bs-cap, .bs-gb, .bs-scc, .bs-base { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  // ===== 記入例（基本モデルの成長期・3期目）。施策の「今期」は前の期の数字がないため空欄 =====
  const EXAMPLE = {
    price: 250, margin: 40, years: 1.5, stage: "growth",
    target: 150000, mktRatio: 2,
    oppRate: 14.74, winRate: 28.6,
    cap: 1280,
    rows: [
      { name: "業界展示会（1回・10月）", kind: "def", extNow: null, labNow: null, leadNow: null, ext: 280, lab: 60, lead: 120 },
      { name: "リスティング広告", kind: "def", extNow: null, labNow: null, leadNow: null, ext: 240, lab: 24, lead: 50 },
      { name: "自社サイトの保守・サーバー（更新を含む）", kind: "def", extNow: null, labNow: null, leadNow: null, ext: 36, lab: 36, lead: 0 },
      { name: "MAツール（運用・メルマガを含む）", kind: "def", extNow: null, labNow: null, leadNow: null, ext: 84, lab: 119, lead: 0 },
      { name: "記事・事例・ホワイトペーパー制作（外注）", kind: "att", extNow: null, labNow: null, leadNow: null, ext: 120, lab: 56, lead: 60 },
      { name: "ウェビナー（年4回）", kind: "att", extNow: null, labNow: null, leadNow: null, ext: 60, lab: 60, lead: 40 },
      { name: "新しい業種向けのLP＋リスティング広告（試行）", kind: "att", extNow: null, labNow: null, leadNow: null, ext: 90, lab: 15, lead: 15 },
    ],
  };
  const STAGES = { intro: { label: "導入期", def: 5, att: 5 }, growth: { label: "成長期", def: 7, att: 3 }, stable: { label: "安定期", def: 6, att: 4 } };
  const SCENARIOS = { pess: { label: "悲観", m: 0.8 }, base: { label: "標準", m: 1 }, opt: { label: "楽観", m: 1.2 } };
  const KIND_LABEL = { def: "防衛", att: "攻撃" };
  const NA = "―";
  const EPS = 1e-9;

  const $ = (id) => document.getElementById(id);
  const scalarInputs = Array.from(document.querySelectorAll(".bs-in input[data-k]"));
  const rowsEl = $("bs-rows");

  let state = { stage: "growth", scenario: "base", rows: [] };

  // ===== 書式 =====
  const num = (v) => (v === "" || v === null || v === undefined || !isFinite(Number(v)) ? null : Number(v));
  const fmtInt = (n) => Math.round(n).toLocaleString("ja-JP");
  const fmt1 = (n) => (Math.round(n * 10) / 10).toLocaleString("ja-JP", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const fmtRate = (r) => `${parseFloat((r * 100).toFixed(2))}%`;
  const signed = (n) => (n > 0 ? "+" : n < 0 ? "−" : "±") + fmtInt(Math.abs(n));
  const ceil = (x) => Math.ceil(x - EPS);
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const tag = (cls, text) => `<span class="bs-tag ${cls}">${text}</span>`;

  // ===== 入力の行（施策） =====
  function rowHtml(r, i) {
    const v = (x) => (x === null || x === undefined ? "" : x);
    const cell = (f) => `<input type="number" inputmode="decimal" min="0" step="1" data-i="${i}" data-f="${f}" value="${v(r[f])}" placeholder="${f.endsWith("Now") ? "空欄可" : ""}" aria-label="${esc(r.name)} ${f}" />`;
    return `<div class="bs-ini">
      <div class="bs-ini-h">
        <input class="bs-ini-name" type="text" data-i="${i}" data-f="name" value="${esc(r.name)}" aria-label="施策名" />
        <span class="bs-seg" role="radiogroup" aria-label="区分">
          <button type="button" role="radio" data-i="${i}" data-kind="def" aria-checked="${r.kind === "def"}">防衛</button><button type="button" role="radio" data-i="${i}" data-kind="att" aria-checked="${r.kind === "att"}">攻撃</button>
        </span>
        <button type="button" class="bs-del" data-del="${i}" aria-label="この施策を削除">×</button>
      </div>
      <table class="bs-it">
        <thead><tr><th></th><th>今期</th><th>来期</th></tr></thead>
        <tbody>
          <tr><td>外部費用</td><td>${cell("extNow")}</td><td>${cell("ext")}</td></tr>
          <tr><td>人件費</td><td>${cell("labNow")}</td><td>${cell("lab")}</td></tr>
          <tr><td>リード数</td><td>${cell("leadNow")}</td><td>${cell("lead")}</td></tr>
        </tbody>
      </table>
    </div>`;
  }
  function renderRows() {
    rowsEl.innerHTML = state.rows.map(rowHtml).join("");
  }

  rowsEl.addEventListener("input", (e) => {
    const t = e.target;
    if (!(t instanceof HTMLInputElement) || t.dataset.i === undefined) return;
    const r = state.rows[Number(t.dataset.i)];
    if (!r) return;
    r[t.dataset.f] = t.dataset.f === "name" ? t.value : num(t.value);
    update();
  });
  rowsEl.addEventListener("click", (e) => {
    const t = e.target instanceof Element ? e.target.closest("button") : null;
    if (!t) return;
    if (t.dataset.kind) {
      state.rows[Number(t.dataset.i)].kind = t.dataset.kind;
      renderRows();
      update();
    } else if (t.dataset.del !== undefined) {
      state.rows.splice(Number(t.dataset.del), 1);
      renderRows();
      update();
    }
  });
  $("bs-add").addEventListener("click", () => {
    state.rows.push({ name: `施策${state.rows.length + 1}`, kind: "att", extNow: null, labNow: null, leadNow: null, ext: null, lab: null, lead: null });
    renderRows();
    update();
    const names = rowsEl.querySelectorAll(".bs-ini-name");
    const last = names[names.length - 1];
    if (last instanceof HTMLInputElement) { last.focus(); last.select(); }
  });

  // ===== 1列の入力・チップ =====
  scalarInputs.forEach((el) => el.addEventListener("input", update));
  function setChips(groupId, attr, value) {
    $(groupId).querySelectorAll(".bs-chip").forEach((b) => b.setAttribute("aria-checked", String(b.getAttribute(attr) === value)));
  }
  $("bs-stage").addEventListener("click", (e) => {
    const b = e.target instanceof Element ? e.target.closest("[data-stage]") : null;
    if (!b) return;
    state.stage = b.getAttribute("data-stage");
    setChips("bs-stage", "data-stage", state.stage);
    update();
  });
  $("bs-scenario").addEventListener("click", (e) => {
    const b = e.target instanceof Element ? e.target.closest("[data-sc]") : null;
    if (!b) return;
    state.scenario = b.getAttribute("data-sc");
    setChips("bs-scenario", "data-sc", state.scenario);
    update();
  });

  function readScalars() {
    const o = {};
    scalarInputs.forEach((el) => { o[el.dataset.k] = num(el.value); });
    return o;
  }
  function load(data) {
    scalarInputs.forEach((el) => { const v = data[el.dataset.k]; el.value = v === null || v === undefined ? "" : String(v); });
    state.stage = data.stage || "growth";
    state.rows = (data.rows || []).map((r) => ({ ...r }));
    setChips("bs-stage", "data-stage", state.stage);
    renderRows();
    checked = false;
    document.querySelectorAll(".bs-invalid").forEach((el) => el.classList.remove("bs-invalid"));
    $("bs-err").hidden = true;
    update();
  }

  $("bs-example").addEventListener("click", () => load(EXAMPLE));
  const clearBtn = $("bs-clear");
  let clearTimer = 0;
  clearBtn.addEventListener("click", () => {
    if (clearBtn.dataset.armed !== "1") {
      clearBtn.dataset.armed = "1";
      clearBtn.textContent = "もう一度押すと消えます";
      clearTimeout(clearTimer);
      clearTimer = window.setTimeout(() => { clearBtn.dataset.armed = ""; clearBtn.textContent = "入力をすべて消す"; }, 4000);
      return;
    }
    clearTimeout(clearTimer);
    clearBtn.dataset.armed = "";
    clearBtn.textContent = "入力をすべて消す";
    load({ stage: "growth", rows: [{ name: "施策1", kind: "def", extNow: null, labNow: null, leadNow: null, ext: null, lab: null, lead: null }] });
  });
  // ===== 必須チェック（ボタンを押したあと、入力のたびに赤枠を付け直す） =====
  let checked = false;
  const blank = (el) => el.value.trim() === "" || !isFinite(Number(el.value));
  function markInvalid() {
    let bad = [];
    scalarInputs.forEach((el) => {
      if (!REQUIRED.some(([k]) => k === el.dataset.k)) return;
      const ng = blank(el) || !(Number(el.value) > 0);
      el.closest(".bs-ip").classList.toggle("bs-invalid", ng);
      if (ng) bad.push(el);
    });
    rowsEl.querySelectorAll('input[data-f="ext"], input[data-f="lab"], input[data-f="lead"]').forEach((el) => {
      const ng = blank(el);
      el.classList.toggle("bs-invalid", ng);
      if (ng) bad.push(el);
    });
    $("bs-err").hidden = bad.length === 0;
    return bad;
  }
  $("bs-run").addEventListener("click", () => {
    checked = true;
    update();
    const bad = markInvalid();
    if (bad.length) {
      bad[0].focus({ preventScroll: true });
      bad[0].scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }
    $("bs-report").scrollIntoView({ behavior: "smooth", block: "start" });
  });
  $("bs-print").addEventListener("click", () => window.print());

  // ===== 計算 =====
  function compute(s, rows, m) {
    const o = Math.min(s.oppRate / 100 * m, 1);
    const w = Math.min(s.winRate / 100 * m, 1);
    const mktSales = s.target * s.mktRatio / 100;
    const won = ceil(mktSales / s.price);
    const opp = ceil(won / w);
    const lead = ceil(opp / o);
    const planLeads = rows.reduce((a, r) => a + (r.lead || 0), 0);
    const ext = rows.reduce((a, r) => a + (r.ext || 0), 0);
    const lab = rows.reduce((a, r) => a + (r.lab || 0), 0);
    const total = ext + lab;
    const planWon = planLeads * o * w;
    const planAmount = planWon * s.price;
    const monthlyGross = s.price * s.margin / 100 / 12;
    const cac = planWon > 0 ? total / planWon : null;
    const payback = cac !== null && monthlyGross > 0 ? cac / monthlyGross : null;
    const roi = total > 0 ? (planAmount * s.margin / 100 - total) / total : null;
    const cacLimit = s.price * s.margin / 100 * s.years;
    const acpl = cacLimit * o * w;
    return { o, w, mktSales, won, opp, lead, planLeads, ext, lab, total, planWon, planAmount, monthlyGross, cac, payback, roi, cacLimit, acpl };
  }

  // 今期：入力のある欄だけ合計。1つも入力がなければ null
  function sumNow(rows, f) {
    const vals = rows.map((r) => r[f]).filter((v) => v !== null && v !== undefined);
    return vals.length ? vals.reduce((a, v) => a + v, 0) : null;
  }
  function rowNowCpl(r) {
    if (r.leadNow === null || r.leadNow === undefined || r.leadNow <= 0) return null;
    if ((r.extNow === null || r.extNow === undefined) && (r.labNow === null || r.labNow === undefined)) return null;
    return ((r.extNow || 0) + (r.labNow || 0)) / r.leadNow;
  }

  const REQUIRED = [
    ["price", "平均単価"], ["margin", "粗利率"], ["years", "取り返す年数"],
    ["target", "全社の売上目標"], ["mktRatio", "マーケ経由の割合"],
    ["oppRate", "商談化率"], ["winRate", "受注率"],
  ];

  function update() {
    if (checked) markInvalid();
    const s = readScalars();
    const rows = state.rows;
    $("r-date").textContent = new Date().toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });

    const missing = REQUIRED.filter(([k]) => !(s[k] > 0)).map(([, l]) => l);
    if (!rows.some((r) => (r.ext || 0) + (r.lab || 0) > 0)) missing.push("施策の来期の費用");
    if (!rows.some((r) => (r.lead || 0) > 0)) missing.push("施策の来期のリード数");
    const empty = $("r-empty");
    const body = $("r-body");
    if (missing.length) {
      empty.hidden = false;
      empty.innerHTML = `次の項目を入れると、計画書ができあがります<br>${missing.map(esc).join("・")}`;
      body.hidden = true;
      return;
    }
    empty.hidden = true;
    body.hidden = false;

    const sc = SCENARIOS[state.scenario];
    const c = compute(s, rows, sc.m);

    // --- 黒い枠 ---
    $("r-payback").textContent = c.payback === null ? NA : fmt1(c.payback);
    $("r-payback-s").textContent = `CAC÷1社あたりの月の粗利（${fmt1(c.monthlyGross)}）`;
    $("r-roi").textContent = c.roi === null ? NA : (c.roi < 0 ? "−" : "") + fmtInt(Math.abs(c.roi * 100));
    $("r-cac").textContent = c.cac === null ? NA : fmtInt(c.cac);
    $("r-cac-s").innerHTML = `上限 ${fmtInt(c.cacLimit)}万円` + (c.cac === null ? "" : c.cac <= c.cacLimit + EPS ? tag("ok", "上限内") : tag("ng", "上限超え"));
    $("r-base").textContent = `計画の受注 ${fmt1(c.planWon)}件・${fmtInt(c.planAmount)}万円 ＝ 計画リード${fmtInt(c.planLeads)}件 × 商談化率${fmtRate(c.o)} × 受注率${fmtRate(c.w)}（× 平均単価${fmtInt(s.price)}）`;
    $("r-total").textContent = fmtInt(c.total);
    $("r-total-s").textContent = `外部 ${fmtInt(c.ext)} ／ 人件費 ${fmtInt(c.lab)}`;
    if (s.cap !== null && s.cap > 0) {
      const diff = s.cap - c.total;
      $("r-cap").innerHTML = `${fmtInt(Math.abs(diff))}<small>万円</small>` + (diff >= -EPS ? tag("ok", "上限内") : tag("ng", "上限超え"));
      $("r-cap-s").textContent = `上限 ${fmtInt(s.cap)}万円` + (diff >= -EPS ? "" : `（${fmtInt(-diff)}万円 超えている）`);
    } else {
      $("r-cap").textContent = NA;
      $("r-cap-s").textContent = "上限は未入力";
    }
    $("r-acpl").textContent = fmt1(c.acpl);

    // --- 逆算 ---
    $("r-flow-sc").textContent = `${sc.label}シナリオ`;
    $("r-mktsales").textContent = fmtInt(c.mktSales);
    $("r-mktsales-s").textContent = `万円（${fmtInt(s.target)}×${parseFloat(s.mktRatio.toFixed(2))}%）`;
    $("r-won").textContent = fmtInt(c.won);
    $("r-won-s").textContent = `÷平均単価${fmtInt(s.price)}`;
    $("r-opp").textContent = fmtInt(c.opp);
    $("r-opp-s").textContent = `÷受注率${fmtRate(c.w)}`;
    $("r-lead").textContent = fmtInt(c.lead);
    $("r-lead-s").textContent = `÷商談化率${fmtRate(c.o)}`;
    const leadGap = c.planLeads - c.lead;
    $("r-leadcheck").innerHTML = `来期の計画リード数 <b>${fmtInt(c.planLeads)}件</b>（必要数 ${fmtInt(c.lead)}件）`;
    $("r-leadtag").innerHTML = leadGap >= 0 ? tag("ok", "足りる") : tag("ng", `${fmtInt(-leadGap)}件不足`);

    // --- 費用 ---
    const extNow = sumNow(rows, "extNow");
    const labNow = sumNow(rows, "labNow");
    const totNow = extNow === null && labNow === null ? null : (extNow || 0) + (labNow || 0);
    const costRow = (label, now, next, cls) =>
      `<tr${cls ? ` class="${cls}"` : ""}><td${cls ? "" : ' class="n"'}>${label}</td><td${now === null ? ' class="na"' : ""}>${now === null ? NA : fmtInt(now)}</td><td>${fmtInt(next)}</td><td${now === null ? ' class="na"' : ""}>${now === null ? NA : signed(next - now)}</td></tr>`;
    $("r-cost").innerHTML = costRow("外部費用", extNow, c.ext) + costRow("人件費", labNow, c.lab) + costRow("合計", totNow, c.total, "tot");

    // --- 防衛：攻撃 ---
    const defCost = rows.filter((r) => r.kind === "def").reduce((a, r) => a + (r.ext || 0) + (r.lab || 0), 0);
    const attCost = c.total - defCost;
    const defPct = c.total > 0 ? Math.round(defCost / c.total * 100) : 0;
    const attPct = 100 - defPct;
    const st = STAGES[state.stage];
    $("r-ratio").innerHTML =
      (defPct > 0 ? `<div style="flex:${defPct};background:#0b0b12">防衛 ${defPct}%（${fmtInt(defCost)}）</div>` : "") +
      (attPct > 0 ? `<div style="flex:${attPct};background:#737373">攻撃 ${attPct}%（${fmtInt(attCost)}）</div>` : "");
    $("r-ratio-t").innerHTML = `<div style="flex:${st.def};background:#bfbfbf"></div><div style="flex:${st.att};background:#d9d9d9"></div>`;
    const pt = defPct - st.def * 10;
    const ratioMsg = Math.abs(pt) <= 5 ? "ほぼ目安どおり" : `防衛が目安より${Math.abs(pt)}ポイント${pt > 0 ? "多い" : "少ない"}`;
    $("r-ratio-s").textContent = `上：来期の計画　下：目安（${st.label} ${st.def}：${st.att}）　→ ${ratioMsg}`;

    // --- 施策ごとのCPL ---
    $("r-cpl-s").textContent = `費用＝外部費用＋人件費・判定は許容CPL ${fmt1(c.acpl)}万円と比べる`;
    const over = [];
    let html = "";
    rows.forEach((r) => {
      const cost = (r.ext || 0) + (r.lab || 0);
      const hasLead = (r.lead || 0) > 0;
      const cpl = hasLead ? cost / r.lead : null;
      const ng = cpl !== null && cpl > c.acpl + EPS;
      if (ng) over.push(r.name);
      const nowCpl = rowNowCpl(r);
      html += `<tr${ng ? ' class="weak"' : ""}><td class="n">${esc(r.name || "（名前なし）")}</td><td class="c">${KIND_LABEL[r.kind]}</td><td>${fmtInt(cost)}</td><td${hasLead ? "" : ' class="na"'}>${hasLead ? fmtInt(r.lead) : NA}</td><td${cpl === null ? ' class="na"' : ""}>${cpl === null ? NA : fmt1(cpl)}</td><td${nowCpl === null ? ' class="na"' : ""}>${nowCpl === null ? NA : fmt1(nowCpl)}</td><td class="c">${cpl === null ? `<span class="na">${NA}</span>` : ng ? tag("ng", "上限超え") : tag("ok", "上限内")}</td></tr>`;
    });
    const leadNowTotal = sumNow(rows, "leadNow");
    const totNowCpl = totNow !== null && leadNowTotal ? totNow / leadNowTotal : null;
    html += `<tr class="tot"><td>全体</td><td></td><td>${fmtInt(c.total)}</td><td>${fmtInt(c.planLeads)}</td><td>${c.planLeads > 0 ? fmt1(c.total / c.planLeads) : NA}</td><td${totNowCpl === null ? ' class="na"' : ""}>${totNowCpl === null ? NA : fmt1(totNowCpl)}</td><td></td></tr>`;
    $("r-ins").innerHTML = html;

    // --- シナリオ ---
    const all = Object.entries(SCENARIOS).map(([key, v]) => ({ key, ...v, c: compute(s, rows, v.m) }));
    $("r-sc").innerHTML = all.map((x) => {
      const gap = x.c.planLeads - x.c.lead;
      const roi = x.c.roi === null ? NA : `${x.c.roi < 0 ? "−" : ""}${fmtInt(Math.abs(x.c.roi * 100))}%`;
      return `<div class="bs-scc${x.key === state.scenario ? " on" : ""}">
        <p class="l">${x.label}（商談化率${fmtRate(x.c.o)}・受注率${fmtRate(x.c.w)}）</p>
        <p class="v">必要リード ${fmtInt(x.c.lead)}件${gap >= 0 ? tag("ok", "足りる") : tag("ng", `${fmtInt(-gap)}件不足`)}<br>
        計画の受注 ${fmt1(x.c.planWon)}件<br>
        回収期間 <b>${x.c.payback === null ? NA : fmt1(x.c.payback) + "か月"}</b>・ROI <b>${roi}</b><br>
        CAC ${x.c.cac === null ? NA : fmtInt(x.c.cac) + "万円"}・許容CPL ${fmt1(x.c.acpl)}万円</p>
      </div>`;
    }).join("");

    // --- 結び ---
    const byCost = (k) => rows.filter((r) => r.kind === k && (r.lead || 0) > 0).sort((a, b) => ((b.ext || 0) + (b.lab || 0)) - ((a.ext || 0) + (a.lab || 0))).map((r) => r.name);
    const defNames = byCost("def").slice(0, 2);
    const attNames = byCost("att");
    $("r-policy").textContent =
      (defNames.length ? `防衛（${defNames.join("・")}）でリードの土台を守る。` : "") +
      (attNames.length ? `攻撃（${attNames.length}施策・${fmtInt(attCost)}万円）は止める基準を決めて試す。` : "");
    const pess = all.find((x) => x.key === "pess").c;
    const risks = [];
    if (over.length) risks.push(`${over.join("・")}は許容CPLを超えている（${sc.label}）。費用を下げるかリードを増やす`);
    const pessGap = pess.planLeads - pess.lead;
    risks.push(pessGap < 0 ? `悲観ではリードが${fmtInt(-pessGap)}件不足` : "悲観でもリードは足りる");
    risks.push("期中に足りなければ追加予算の稟議で扱う");
    $("r-risk").textContent = risks.join("。") + "。";
    $("r-ask").textContent = `来期の費用 ${fmtInt(c.total)}万円（外部 ${fmtInt(c.ext)}／人件費 ${fmtInt(c.lab)}）の承認。回収期間 ${c.payback === null ? NA : fmt1(c.payback) + "か月"}、1年のROI ${c.roi === null ? NA : (c.roi < 0 ? "−" : "") + fmtInt(Math.abs(c.roi * 100)) + "%"}。`;
  }

  setChips("bs-scenario", "data-sc", state.scenario);
  load(EXAMPLE);
</script>
