---
// src/pages/tools/kpi-check.astro
//
// （仮）KPI妥当性チェッカー（/tools/kpi-check）の入口。2026-10-23：KPI運用チェッカーを2つに分けた。こちらは初回の妥当性の判定だけ
// （毎月の判定は（仮）KPI運用管理ツールとして別のURLにする予定。/tools/kpi-check/monthly/* は入口からリンクしていない）
// 仕様: Googleドライブ「MKTG.AX／共有（正本）／04_ツール仕様／KPI運用チェッカー 仕様」（2026-10-18）
// 2026-10-23 改修：1ページの作りをやめ、ステップごとのページに分けた。
// - /tools/kpi-check/setup/1〜6（KPIツリー → 施策と期間 → 施策のKPI → 費用と撤退（任意）→ 判定 → PDF）
// - 画面は src/scripts/kpi-check/app.ts、PDFは src/scripts/kpi-check/pdf.ts、計算と判定は src/lib/kpiCheck.ts
// - 見本の画像：public/images/tools/kpi-check-preview.png（判定の画面）
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFooter from "@/components/ToolFooter.astro";
import "@/styles/kpi-check.css";

const TOOL_TITLE = "KPI妥当性チェッカー";
const TOOL_DESCRIPTION =
  "売上目標と施策ごとのKPIを入れると、KPIツリーの妥当性（リードの過不足、受注とつながらないKPI、CPLの上限など）を判定する無料ツールです。空欄は一般的な値で計算し、結果はA4横のPDFで出せます。";
---

<BaseLayout title={`${TOOL_TITLE}｜KPIツリーと施策のKPIの妥当性を判定｜MKTG.AX`} description={TOOL_DESCRIPTION} ogImage="/open-graph/tools/kpi-check.png">
  <div id="kc-hub" class="kc kc-wide">
    <p class="kc-hint" style="margin:0 0 6px !important;letter-spacing:0.08em"><a href="/tools" style="color:inherit;text-decoration:none">便利ツール</a></p>
    <div class="kc-hero">
      <div>
        <h1 class="kc-h" style="font-size:1.8rem">{TOOL_TITLE}</h1>
        <p class="kc-lead" style="font-size:1rem">売上目標と施策ごとのKPIを入れると、KPIツリーが妥当かを判定します。リードの過不足、受注とつながらないKPI、CPLの上限などを、結論とツリーの図で示します。</p>
        <p class="kc-hint">無料・入力した数字はサーバーに送りません（計算はすべてブラウザの中）・空欄は一般的な値で計算・結果はA4横のPDFで出せます</p>
        <p class="kc-hint">全6ステップ：KPIツリー → 施策と期間 → 施策のKPI → 費用と撤退（任意）→ 判定 → PDF</p>
        <div class="kc-row" style="margin-top:20px">
          <a class="kc-btn" href="/tools/kpi-check/setup/1"><span>はじめる</span><span aria-hidden="true">→</span></a>
          <a class="kc-btn2" href="/tools/kpi-check/setup/5?sample=1">サンプルで結果を見る →</a>
        </div>
      </div>
      <figure class="kc-shot"><img src="/images/tools/kpi-check-preview.png" width="1339" height="1165" alt="判定の画面の例：結論、全体のツリー、確認が必要な指摘" loading="eager" /><figcaption>判定の画面（サンプル）</figcaption></figure>
    </div>
    <div class="kc-resume" id="kc-resume" hidden></div>
  </div>

  <ToolFooter path="/tools/kpi-check" />
</BaseLayout>

<script>
  import "@/scripts/kpi-check/app";
</script>
