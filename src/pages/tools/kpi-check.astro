---
// src/pages/tools/kpi-check.astro
//
// KPI運用チェッカー（/tools/kpi-check）
// 仕様: Googleドライブ「MKTG.AX／共有（正本）／04_ツール仕様／KPI運用チェッカー 仕様」（2026-10-18）
// 計算: src/lib/kpiCheck.ts（CACの上限・許容CPLは src/lib/budget-calc.ts と共通）
// - 初回：KPIツリーと施策を入れると、妥当性を9項目で判定する。PDFはA4横3ページ（判定／ツリーと目標／経営との合意）
// - 毎月：実績と実施したことを入れると、達成・未達、次の打ち手（出典つき）、撤退の判断を出す。PDFはA4横1ページ
// - 計算はすべてブラウザ内。入力データはPDFの添付ファイル（mktgax-kpi-check.json）に埋め込み、次回はPDFを読み込む
// - PDFのダウンロード時にメール登録（POST /api/kpi-check-register）。サーバーに置くのはメールアドレスと管理日だけ
// - PDFは html2canvas-pro で各ページを画像にし、pdf-lib でPDFにする（月次報告メーカーと同じ。CDNから、使うときだけ読み込む）
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolFooter from "@/components/ToolFooter.astro";

const TOOL_TITLE = "KPI運用チェッカー";
const TOOL_DESCRIPTION =
  "KPIツリーと施策を入れると目標の妥当性を判定し、毎月は実績を入れると達成・未達、次の打ち手（出典つき）、撤退の判断を出す無料ツールです。結果はA4横のPDFで出せます。";
---

<BaseLayout title={`${TOOL_TITLE}｜KPIの妥当性と月次の打ち手・撤退を判定｜MKTG.AX`} description={TOOL_DESCRIPTION} ogImage="/open-graph/tools/kpi-check.png">
  <main class="kc">
    <header class="kc-head">
      <p class="kc-eyebrow"><a href="/tools">便利ツール</a></p>
      <h1>{TOOL_TITLE}</h1>
      <p class="kc-lead">KPIツリーと施策を入れると、目標の妥当性を判定します。毎月は実績と実施したことを入れると、達成・未達、次の打ち手、撤退の判断を出します（金額は万円）。計算はすべてブラウザの中で行い、入力した数字はサーバーに送りません。</p>
    </header>

    <div class="kc-bar">
      <div class="kc-mode" role="tablist" aria-label="使い方">
        <button type="button" role="tab" id="kc-tab-first" data-mode="first">初回<small>KPIツリーを判定する</small></button>
        <button type="button" role="tab" id="kc-tab-monthly" data-mode="monthly">毎月<small>実績を判定する</small></button>
      </div>
      <div class="kc-load">
        <label class="kc-obtn">前回のPDFを読み込む<input id="kc-pdf-input" type="file" accept="application/pdf,.pdf" class="kc-sr" /></label>
        <p class="kc-note" id="kc-load-note">このツールで作ったPDFを選ぶと、目標と前月までの実績が入ります</p>
        <p class="kc-msg" id="kc-load-msg" role="status" hidden></p>
      </div>
    </div>

    <div class="kc-grid">
      <!-- ===== 入力 ===== -->
      <div class="kc-in">
        <div class="kc-tools">
          <button type="button" class="kc-link" id="kc-example">記入例を入れる</button>
          <button type="button" class="kc-link" id="kc-clear">入力をすべて消す</button>
        </div>
        <p class="kc-note kc-note-r">記入例は架空の会社の数字です（11月まで入っています）</p>

        <!-- 初回 -->
        <div id="kc-in-first">
          <div class="kc-sec">
            <p class="kc-step"><span>STEP1</span>期間とKPIツリーの目標</p>
            <div class="kc-f3">
              <div class="kc-field"><label class="kc-lb" for="p-period">期間</label><div class="kc-ip"><select id="p-period" data-p="plan.period" data-t="sel"></select></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-start">期首</label><div class="kc-ip"><select id="p-start" data-t="start"></select></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-day">管理日</label><div class="kc-ip"><select id="p-day" data-p="plan.manageDay" data-t="day"></select></div></div>
            </div>
            <p class="kc-note">期間は、KPIツリーの目標の期間です。管理日は毎月の数字を入れる日で、登録すると3営業日前と当日にお知らせメールが届きます</p>
            <div class="kc-f2 kc-mt8">
              <div class="kc-field"><label class="kc-lb" for="p-sales">売上目標（マーケ経由）</label><div class="kc-ip"><input id="p-sales" data-p="plan.sales" inputmode="decimal" /><span>万円</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-price">平均単価</label><div class="kc-ip"><input id="p-price" data-p="plan.price" inputmode="decimal" /><span>万円</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-wins">受注数</label><div class="kc-ip"><input id="p-wins" data-p="plan.wins" inputmode="decimal" /><span>件</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-winRate">受注率</label><div class="kc-ip"><input id="p-winRate" data-p="plan.winRate" inputmode="decimal" /><span>%</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-deals">商談数</label><div class="kc-ip"><input id="p-deals" data-p="plan.deals" inputmode="decimal" /><span>件</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-dealRate">商談化率</label><div class="kc-ip"><input id="p-dealRate" data-p="plan.dealRate" inputmode="decimal" /><span>%</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-leads">リード数</label><div class="kc-ip"><input id="p-leads" data-p="plan.leads" inputmode="decimal" /><span>件</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-cycle">商談から受注までの平均期間</label><div class="kc-ip"><input id="p-cycle" data-p="plan.cycle" inputmode="decimal" /><span>か月</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-margin">粗利率<small>任意</small></label><div class="kc-ip"><input id="p-margin" data-p="plan.margin" inputmode="decimal" /><span>%</span></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-years">取り返す年数<small>任意</small></label><div class="kc-ip"><input id="p-years" data-p="plan.years" inputmode="decimal" /><span>年</span></div></div>
            </div>
            <p class="kc-note">粗利率と取り返す年数を入れると、CACの上限と許容CPLを計算し、CPLの上限の初期値に入れます</p>
          </div>

          <div class="kc-sec">
            <p class="kc-step"><span>STEP2</span>実施する施策とKPIの目標</p>
            <div class="kc-chips" id="kc-mchips-on"></div>
            <div id="kc-cards"></div>
          </div>

          <div class="kc-sec">
            <p class="kc-step"><span>STEP3</span>経営との合意<small>PDFの合意用の1枚に入ります</small></p>
            <div class="kc-f2">
              <div class="kc-field"><label class="kc-lb" for="p-decider">判断する人</label><div class="kc-ip"><input id="p-decider" data-p="plan.decider" data-t="text" maxlength="40" placeholder="例：営業本部長" /></div></div>
              <div class="kc-field"><label class="kc-lb" for="p-review">振り返りの日</label><div class="kc-ip"><input id="p-review" data-p="plan.review" data-t="text" maxlength="40" placeholder="例：毎月10日の経営会議" /></div></div>
            </div>
          </div>
        </div>

        <!-- 毎月 -->
        <div id="kc-in-monthly" hidden>
          <div class="kc-sec">
            <p class="kc-step"><span>STEP1</span>報告する月</p>
            <div class="kc-chips" id="kc-month-chips"></div>
            <p class="kc-note">枠の月は入力済みです。押すとその月の数字を見直せます</p>
          </div>
          <div class="kc-sec">
            <p class="kc-step"><span>STEP2</span>施策ごとの実績<small id="kc-month-sub"></small></p>
            <p class="kc-note kc-mb8">件数で入れてください。率とCPLはツールが計算します</p>
            <div id="kc-mcards"></div>
          </div>
          <div class="kc-sec">
            <p class="kc-step"><span>STEP3</span>全体<small id="kc-common-sub"></small></p>
            <div class="kc-f2" id="kc-common"></div>
            <p class="kc-note">受注率は決着した商談（受注＋失注）だけで出し、決着が10件たまってから判定します。営業に渡した数が空のときは「営業に渡せる割合」を判定しません</p>
          </div>
        </div>

        <!-- 登録・ダウンロード -->
        <div class="kc-sec kc-dl">
          <p class="kc-step"><span id="kc-dl-step">STEP4</span>PDFをダウンロード</p>
          <form id="kc-reg-form" novalidate>
            <p class="kc-note kc-mb8">メールアドレスを登録すると、その場でPDFをダウンロードできます（PDFはメールでは送りません）。管理日を決めた場合は、3営業日前と当日にお知らせメールが届きます。</p>
            <div class="kc-field"><label class="kc-lb" for="reg-email">メールアドレス</label><div class="kc-ip"><input id="reg-email" type="email" autocomplete="email" data-skip="1" placeholder="you@example.com" /></div></div>
            <p class="kc-note">管理日：<b id="reg-day"></b>（STEP1で変えられます）</p>
            <div class="kc-hp" aria-hidden="true"><label>ウェブサイト<input type="text" id="reg-website" tabindex="-1" autocomplete="off" data-skip="1" /></label></div>
            <label class="kc-check"><input id="reg-consent" type="checkbox" data-skip="1" /><span><a href="/privacy" target="_blank" rel="noopener">プライバシーポリシー</a>に同意して、お知らせメールを受け取る</span></label>
            <button type="submit" class="kc-btn" id="reg-submit">登録してPDFをダウンロード</button>
            <p class="kc-msg" id="reg-msg" role="status" hidden></p>
          </form>
          <div id="kc-registered" hidden>
            <p class="kc-note">登録済み：<b id="kc-reg-email"></b></p>
            <button type="button" class="kc-btn" id="kc-download">PDFをダウンロード</button>
            <p class="kc-msg" id="kc-dl-msg" role="status" hidden></p>
            <button type="button" class="kc-link kc-mt8" id="kc-reregister">別のメールアドレス・管理日で登録しなおす</button>
          </div>
          <p class="kc-note kc-mt8" id="kc-dl-what"></p>
          <p class="kc-note">※PDFを別のソフトで保存し直すと、埋め込んだデータが消えることがあります（その場合は手で入力してください）。メンバーとの共有はPDFを渡して行えます。</p>
        </div>
      </div>

      <!-- ===== 結果 ===== -->
      <div class="kc-out">
        <div id="kc-out-first">
          <div class="kc-panel">
            <p class="kc-ph">妥当性の判定<small>9項目</small></p>
            <div id="kc-first"></div>
          </div>
          <div class="kc-panel">
            <p class="kc-ph">KPIツリーと施策の目標<small id="kc-tree-sub"></small></p>
            <div id="kc-tree"></div>
          </div>
        </div>
        <div id="kc-out-monthly" hidden>
          <div class="kc-panel">
            <p class="kc-ph"><span id="kc-m-title">今月の判定</span><small>件数が少ないKPI（◇）は直近3か月の合計</small></p>
            <div id="kc-m-table"></div>
          </div>
          <div class="kc-panel">
            <p class="kc-ph">次の打ち手と、前月に実施したことの効果</p>
            <div id="kc-m-actions"></div>
          </div>
          <div class="kc-panel">
            <p class="kc-ph">撤退の判断<small>判定する月以降、開始月からの累計</small></p>
            <div id="kc-m-exit"></div>
          </div>
          <div class="kc-panel">
            <p class="kc-ph">月次報告メーカーに写す数字<small>同じ順番・同じ名前</small></p>
            <div id="kc-m-copy"></div>
            <a class="kc-next" href="/tools/monthly-report"><span><b>経営への報告は、マーケ月次報告メーカーで</b>この数字を写すと、期末の着地見込みまでそろった報告1枚を作れます</span><span aria-hidden="true">月次報告メーカー →</span></a>
          </div>
          <div class="kc-panel">
            <p class="kc-ph"><span>AIに相談するプロンプト</span><button type="button" class="kc-obtn kc-obtn-s" id="kc-copy-prompt">コピー</button></p>
            <pre class="kc-prompt" id="kc-prompt"></pre>
            <p class="kc-note">数字と判定だけが入ります。会社名・顧客名は入りません。お使いのAIのチャットに貼ってください（このサイトではAIを使いません）</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <ToolFooter path="/tools/kpi-check" />
</BaseLayout>

<style is:global>
  .kc { max-width: 1240px; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: #0b0b12; font-variant-numeric: tabular-nums; }
  .kc p { margin: 0; }
  .kc-eyebrow { font-size: 0.75rem; letter-spacing: 0.08em; color: #737373; }
  .kc-eyebrow a { color: inherit; text-decoration: none; }
  .kc-eyebrow a:hover { text-decoration: underline; }
  .kc-head h1 { margin: 0.25rem 0 0.4rem; font-size: 1.7rem; font-weight: 800; line-height: 1.35; }
  .kc-lead { color: #525252; line-height: 1.7; }
  .kc-sr { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .kc-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .kc-bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin: 16px 0 18px; }
  .kc-mode { display: flex; border: 1px solid #0b0b12; border-radius: 10px; overflow: hidden; }
  .kc-mode button { border: 0; background: #fff; padding: 8px 18px; font-size: 0.9rem; font-weight: 700; color: #0b0b12; cursor: pointer; line-height: 1.35; text-align: center; }
  .kc-mode button small { display: block; font-weight: 400; font-size: 0.68rem; opacity: 0.75; }
  .kc-mode button[aria-selected="true"] { background: #0b0b12; color: #fff; }
  .kc-load { text-align: right; max-width: 440px; }
  .kc-load .kc-note { margin-top: 4px !important; }

  .kc-grid { display: grid; grid-template-columns: 400px minmax(0, 1fr); gap: 24px; align-items: start; }
  .kc-step { font-size: 0.8rem; font-weight: 800; display: flex; align-items: center; gap: 8px; margin-bottom: 8px !important; flex-wrap: wrap; }
  .kc-step span { background: #0b0b12; color: #fff; border-radius: 4px; padding: 1px 7px; font-size: 0.68rem; letter-spacing: 0.04em; }
  .kc-step small { font-weight: 400; color: #8a8a8a; font-size: 0.7rem; }

  /* 入力 */
  .kc-in { border: 1px solid #e5e5e5; border-radius: 12px; padding: 14px 16px 16px; background: #fff; min-width: 0; }
  .kc-tools { display: flex; justify-content: flex-end; gap: 12px; }
  .kc-link { background: none; border: 0; padding: 0; font-size: 0.75rem; color: #525252; text-decoration: underline; cursor: pointer; text-align: left; }
  .kc-link[data-armed="1"] { color: #b91c1c; font-weight: 700; }
  .kc-note-r { text-align: right; margin-top: 2px !important; }
  .kc-sec { border-bottom: 1px solid #ececec; padding: 12px 0 14px; }
  .kc-sec:last-child { border-bottom: 0; padding-bottom: 0; }
  .kc-f2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .kc-f3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .kc-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .kc-lb { font-size: 0.72rem; font-weight: 600; color: #404040; line-height: 1.4; }
  .kc-lb small { font-weight: 400; color: #8a8a8a; margin-left: 4px; }
  .kc-ip { display: flex; align-items: center; gap: 6px; min-width: 0; border: 1px solid #d4d4d4; border-radius: 8px; background: #fff; padding: 0 8px; }
  .kc-ip:focus-within { border-color: #0b0b12; outline: 1px solid #0b0b12; }
  .kc-ip input, .kc-ip select, .kc-ip textarea { flex: 1 1 0; width: 0; min-width: 0; border: 0; outline: 0; background: transparent; padding: 6px 0; font-size: 0.9rem; color: #0b0b12; font-family: inherit; }
  .kc-ip textarea { resize: vertical; min-height: 3.2em; font-size: 0.8rem; line-height: 1.55; }
  .kc-ip input[readonly] { color: #525252; }
  .kc-ip > span { font-size: 0.72rem; color: #737373; flex-shrink: 0; }
  .kc-ip.kc-bad { border-color: #b91c1c; background: #fef2f2; }
  .kc-note { font-size: 0.68rem; color: #8a8a8a; line-height: 1.55; margin-top: 6px !important; }
  .kc-note b { color: #0b0b12; }
  .kc-mt8 { margin-top: 8px !important; }
  .kc-mb8 { margin-bottom: 8px !important; margin-top: 0 !important; }
  .kc-chips { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
  .kc-chip { border: 1px solid #d4d4d4; border-radius: 999px; background: #fff; padding: 3px 11px; font-size: 0.75rem; color: #525252; cursor: pointer; }
  .kc-chip:hover { border-color: #0b0b12; color: #0b0b12; }
  .kc-chip[aria-pressed="true"] { background: #0b0b12; border-color: #0b0b12; color: #fff; }
  .kc-chip.done { border-color: #0b0b12; color: #0b0b12; font-weight: 700; }
  .kc-chip.cur { background: #0b0b12; border-color: #0b0b12; color: #fff; }
  .kc-card { border: 1px solid #e5e5e5; border-radius: 8px; margin-bottom: 8px; background: #fff; }
  .kc-card > summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; cursor: pointer; font-size: 0.82rem; font-weight: 800; }
  .kc-card > summary::-webkit-details-marker { display: none; }
  .kc-card > summary small { font-weight: 400; color: #8a8a8a; font-size: 0.68rem; text-align: right; }
  .kc-card[open] > summary small .kc-sum { display: none; }
  .kc-card-b { padding: 0 10px 10px; }
  .kc-kh, .kc-kr { display: grid; grid-template-columns: minmax(0, 1fr) 104px 58px; gap: 6px; align-items: center; }
  .kc-kh { font-size: 0.62rem; color: #8a8a8a; padding-bottom: 2px; }
  .kc-kr { font-size: 0.75rem; padding: 3px 0; border-top: 1px dashed #ececec; }
  .kc-kr .kc-ip input { padding: 3px 0; font-size: 0.8rem; }
  .kc-kr .kc-ip > span { font-size: 0.64rem; }
  .kc-kr small { color: #8a8a8a; font-size: 0.62rem; display: block; }
  .kc-kr.kc-other { grid-template-columns: minmax(0, 1fr) 104px 58px; }
  .kc-yn { display: flex; align-items: center; gap: 4px; font-size: 0.68rem; color: #525252; cursor: pointer; }
  .kc-oname { display: flex; gap: 4px; align-items: center; }
  .kc-del { border: 0; background: none; color: #8a8a8a; font-size: 0.9rem; line-height: 1; cursor: pointer; padding: 2px; flex-shrink: 0; }
  .kc-del:hover { color: #b91c1c; }
  .kc-add { width: 100%; border: 1px dashed #bfbfbf; border-radius: 8px; background: #fff; text-align: center; padding: 5px; color: #525252; font-size: 0.72rem; cursor: pointer; margin-top: 6px; }
  .kc-add:hover { border-color: #0b0b12; color: #0b0b12; }
  .kc-sub { border: 1px solid #ececec; border-radius: 8px; padding: 6px 10px; margin-top: 8px; font-size: 0.72rem; }
  .kc-sub > summary { cursor: pointer; font-weight: 700; color: #404040; }
  .kc-sub > summary small { font-weight: 400; color: #8a8a8a; margin-left: 4px; }
  .kc-mg { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; margin-top: 4px; }
  .kc-mg label { display: flex; flex-direction: column; font-size: 0.6rem; color: #737373; text-align: center; gap: 1px; }
  .kc-mg input { width: 100%; box-sizing: border-box; border: 1px solid #d4d4d4; border-radius: 6px; padding: 2px 4px; font-size: 0.75rem; text-align: right; }
  .kc-mg input:focus { outline: 1px solid #0b0b12; border-color: #0b0b12; }
  .kc-mgl { font-size: 0.68rem; color: #404040; margin-top: 8px !important; font-weight: 600; }
  .kc-sumok { color: #15803d; }
  .kc-sumng { color: #b91c1c; font-weight: 700; }
  .kc-check { display: flex; gap: 6px; align-items: flex-start; font-size: 0.72rem; color: #404040; line-height: 1.5; margin-top: 8px; cursor: pointer; }
  .kc-check input { margin-top: 3px; flex-shrink: 0; }
  .kc-check a { color: inherit; }
  .kc-btn { display: block; width: 100%; margin-top: 10px; border: 0; border-radius: 10px; background: #0b0b12; color: #fff; padding: 0.65rem; font-size: 0.85rem; font-weight: 700; cursor: pointer; }
  .kc-btn:hover:not(:disabled) { opacity: 0.9; }
  .kc-btn:disabled { opacity: 0.4; cursor: default; }
  .kc-obtn { position: relative; display: inline-block; border: 1px solid #0b0b12; border-radius: 10px; background: #fff; padding: 7px 14px; font-weight: 700; font-size: 0.8rem; color: #0b0b12; cursor: pointer; }
