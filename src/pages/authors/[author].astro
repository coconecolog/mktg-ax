---
// 執筆者ページ（2026-10-29リニューアル）。記事・資料の一覧は出さず、プロフィールだけのページにした。
// 中身はすべてNotionの執筆者リストDBから取得する（scripts/fetch-notion.mjs の fetchAuthors）。
//   名前の右上の英字   → 肩書
//   名前の下の一文     → キャッチコピー（未入力なら主な経験分野）
//   タグ               → 専門タグ（Notionで並べた順）
//   経歴と専門分野     → 経歴（未入力なら執筆者紹介文）＋主な実績（1行1件）
//   方針               → 方針の見出し・方針1/2の見出し・本文
//   読者のみなさまへ   → メッセージ
// 未入力の項目は、その枠ごと出さない。
// 旧URL（/authors/{著者}/blog・/whitepapers・ページ番号）は public/_redirects でこのページへ転送している。
import type { GetStaticPaths } from "astro";
import type { Author } from "@/lib/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllAuthors } from "@/lib/posts";
import { toRouteSlug } from "@/lib/routeSlug";
import { buildAuthorSchema } from "@/lib/schema";

export const getStaticPaths = (() =>
  getAllAuthors().map((author) => ({
    params: { author: toRouteSlug(author.name) },
    props: { author },
  }))) satisfies GetStaticPaths;

const { author } = Astro.props as { author: Author };

const authorPath = (name: string) => `/authors/${encodeURIComponent(toRouteSlug(name))}`;
const authorBasePath = authorPath(author.name);

const lead = author.catchcopy || author.expertise;
// 経歴は空行で段落に分ける（1行の改行は段落内の改行として残す）
const careerParagraphs = (author.career || author.bio)
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// 「EDITORIAL POLICY（執筆・検証スタンス）」→ 見出し「執筆・検証スタンス」＋英字ラベル「EDITORIAL POLICY」
const policyMatch = author.policyHeading.match(/^(.*?)[（(](.+)[）)]\s*$/);
const policyLabel = policyMatch ? policyMatch[1].trim() : "POLICY";
const policyTitle = policyMatch ? policyMatch[2].trim() : author.policyHeading || "執筆・検証の方針";

const otherAuthors = getAllAuthors().filter((a) => a.name !== author.name);

const authorSchema = buildAuthorSchema({
  name: author.name,
  path: authorBasePath,
  title: author.title,
  // 構造化データの knowsAbout は専門タグを優先（無ければ主な経験分野の各行）
  expertise: author.tags.length > 0 ? author.tags.join("\n") : author.expertise,
  bio: author.bio,
  image: author.image,
});

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "サービスについて", href: "/service" },
  { name: author.name, href: authorBasePath },
];
---

<BaseLayout
  title={`${author.name}｜執筆者`}
  description={lead || author.bio || `${author.name}のプロフィールです。`}
  ogImage="/open-graph/default.png"
  jsonLd={authorSchema}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  {/* 導入 */}
  <section class="mx-auto max-w-6xl px-5 pt-10 pb-16">
    <div class="grid grid-cols-1 items-center gap-7 md:grid-cols-[minmax(0,1fr)_auto] md:gap-14">
      {author.image && (
        <img
          src={author.image}
          alt={author.name}
          width="220"
          height="220"
          class="order-first aspect-square h-28 w-28 rounded-full object-cover md:order-last md:h-[220px] md:w-[220px]"
        />
      )}
      <div class="min-w-0">
        <p class="flex items-center gap-3.5 text-xs font-bold text-[#74757c]">
          <span>執筆者</span>
          {author.title && (
            <span class="border-l border-[#dedee2] pl-3.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7b7c83]">
              {author.title}
            </span>
          )}
        </p>
        <h1 class="mt-4 text-[40px] font-extrabold leading-[1.1] tracking-tight text-ink-950 md:text-[64px]">{author.name}</h1>
        {lead && <p class="mt-6 max-w-[30em] whitespace-pre-line text-xl font-bold leading-[1.6] text-ink-950 md:text-[28px]">{lead}</p>}
        {author.tags.length > 0 && (
          <ul class="mt-7 flex flex-wrap gap-2">
            {author.tags.map((t) => (
              <li class="border border-ink-950 bg-white px-3.5 py-1.5 text-sm font-semibold text-ink-950">{t}</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  {/* 経歴と専門分野 */}
  {(careerParagraphs.length > 0 || author.achievements.length > 0) && (
    <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-20">
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">経歴と専門分野</h2>
        <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">BACKGROUND</p>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-14">
        <div class="min-w-0 space-y-5">
          {careerParagraphs.map((p) => (
            <p class="whitespace-pre-line text-[17px] leading-[2] text-ink-950">{p}</p>
          ))}
        </div>
        {author.achievements.length > 0 && (
          <div class="min-w-0">
            <h3 class="text-sm font-bold tracking-wide text-[#74757c]">主な実績</h3>
            <ul class="mt-3.5 border-t border-ink-950">
              {author.achievements.map((a) => (
                <li class="border-b border-[#dedee2] py-[18px] text-base font-bold leading-[1.75] text-ink-950">{a}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {/* 方針・役割 */}
  {author.policies.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-20">
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">{policyTitle}</h2>
        <p class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-[#7b7c83]">{policyLabel}</p>
      </div>
      <div class={`mt-8 grid grid-cols-1 gap-6 ${author.policies.length > 1 ? "md:grid-cols-2" : ""}`}>
        {author.policies.map((p) => (
          <div class="border border-[#dedee2] bg-white p-6 md:p-8">
            {p.title && <h3 class="text-[22px] font-bold leading-[1.5] text-ink-950">{p.title}</h3>}
            {p.body && <p class="mt-3.5 whitespace-pre-line text-base leading-[1.95] text-[#4f5057]">{p.body}</p>}
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 読者のみなさまへ */}
  {author.message && (
    <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-20">
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">読者のみなさまへ</h2>
        <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">MESSAGE</p>
      </div>
      <div class="mt-8 border-l-2 border-ink-950 py-1 pl-6 md:pl-7">
        <p class="max-w-[42em] whitespace-pre-line text-lg font-medium leading-[2] text-ink-950 md:text-[22px]">{author.message}</p>
        <p class="mt-5 text-sm font-bold text-[#74757c]">{author.name}</p>
      </div>
    </section>
  )}

  {/* 運営メンバー */}
  <section class="mx-auto max-w-6xl px-5 pb-16 md:pb-20">
    <div class="h-[2px] bg-ink-950"></div>
    <div class="mt-6 flex items-center justify-between gap-4">
      <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">MeerKitLabの運営メンバー</h2>
      <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">ABOUT US</p>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-[minmax(0,1fr)_auto]">
      <div class="grid gap-4">
        {otherAuthors.map((o) => (
          <a href={authorPath(o.name)} class="flex flex-wrap items-center gap-6 border border-[#dedee2] bg-white px-7 py-6 transition-colors hover:border-ink-950">
            {o.image && <img src={o.image} alt="" class="aspect-square h-[72px] w-[72px] shrink-0 rounded-full object-cover" />}
            <div class="min-w-0 flex-1">
              <p>
                <span class="text-[22px] font-bold text-ink-950">{o.name}</span>
                {o.title && <span class="ml-2.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-[#7b7c83]">{o.title}</span>}
              </p>
              {(o.catchcopy || o.expertise) && (
                <p class="mt-1.5 text-[15px] font-bold leading-[1.7] text-[#4f5057]">{o.catchcopy || o.expertise}</p>
              )}
            </div>
            <span class="whitespace-nowrap text-sm font-bold text-ink-950">プロフィールを見る <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <a href="/service" class="flex flex-col justify-center gap-1.5 border border-ink-950 bg-ink-950 px-7 py-6 text-white transition-colors hover:bg-neutral-800 md:min-w-[240px]">
        <span class="text-xs text-neutral-300">MeerKitLabについて</span>
        <span class="text-[15px] font-bold">サービスについて <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
