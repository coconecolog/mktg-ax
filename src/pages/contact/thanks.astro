---
// お問い合わせフォーム送信後のサンクスページ（/contact/thanks）。
// 遷移元は src/pages/contact.astro（送信成功時に自動遷移）。
// 2026-10-29: お問い合わせページと同じ型（角丸なし・白黒、黒の2px線＋見出し＋英字ラベル）にそろえた。
// 構成: お礼 → 今後の流れ → サイト内の案内リンク。資料DLのサンクスと違い、コンテンツ紹介は出さない。
// GA4: ページ自体が /contact/thanks という固有URLなので page_view で到達数を計測できる。
//      お問い合わせの「イベント」（contact_form_submit）はフォーム側で送信済みのため、このページでは送らない。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "お問い合わせ", href: "/contact" },
  { name: "送信完了", href: "/contact/thanks" },
];

const steps = [
  { no: "1", title: "受付完了", text: "お問い合わせを受け付けました。" },
  { no: "2", title: "内容の確認", text: "担当者が内容を確認します。" },
  { no: "3", title: "メールでご連絡", text: "通常2〜3営業日以内にご返信します。" },
];

const links = [
  { title: "トップページ", text: "サイトの全体像を見る", href: "/" },
  { title: "記事・資料", text: "実務ノウハウと資料を探す", href: "/lab" },
  { title: "Kit一覧", text: "予算・KPIのKitを使う", href: "/tools" },
  { title: "サイト内検索", text: "キーワードから探す", href: "/search" },
];
---

<BaseLayout
  title="お問い合わせありがとうございました"
  description="お問い合わせを受け付けました。担当者よりメールでご連絡いたします。"
  noindex
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10 pb-16 md:pb-20">
    <!-- お礼（/lab と同じH1まわりの形） -->
    <div class="flex items-center justify-between gap-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">お問い合わせありがとうございます</h1>
        <p class="mt-4 text-lg font-bold text-ink-950">お問い合わせを受け付けました。</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-500">
          内容を確認のうえ、担当よりメールでご連絡いたします。数日たっても返信が届かない場合は、迷惑メールフォルダをご確認ください。
        </p>
      </div>
      <img src="/images/logo/meerkat-symbol.svg" alt="" width="160" height="160" class="hidden h-32 w-32 shrink-0 sm:block lg:h-40 lg:w-40" />
    </div>

    <!-- 今後の流れ -->
    <section class="mt-12">
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">今後の流れ</h2>
        <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">NEXT STEPS</p>
      </div>
      <ol class="mt-8 flex flex-col gap-2 sm:flex-row sm:items-stretch">
        {
          steps.map((step, i) => (
            <>
              <li class="flex-1 border border-[#dedee2] bg-white p-6">
                <span class="text-2xl font-medium text-ink-950 tabular-nums">{step.no.padStart(2, "0")}</span>
                <p class="mt-4 text-base font-bold text-ink-950">{step.title}</p>
                <p class="mt-2 text-sm leading-[1.9] text-[#4f5057]">{step.text}</p>
              </li>
              {i < steps.length - 1 && (
                <span class="hidden shrink-0 self-center text-lg text-[#7b7c83] sm:block" aria-hidden="true">→</span>
              )}
            </>
          ))
        }
      </ol>
    </section>

    <!-- サイト内の案内 -->
    <section class="mt-16 md:mt-20">
      <div class="h-[2px] bg-ink-950"></div>
      <div class="mt-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold leading-[1.5] text-ink-950 md:text-[30px]">引き続きサイトをご覧ください</h2>
        <p class="shrink-0 text-[11px] font-semibold tracking-wider text-[#7b7c83]">EXPLORE</p>
      </div>
      <ul class="mt-8 border-t border-[#dedee2]">
        {
          links.map((link) => (
            <li class="border-b border-[#dedee2] bg-white">
              <a href={link.href} class="group flex items-center gap-4 px-4 py-4 sm:gap-6 sm:px-6">
                <span class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:gap-6">
                  <span class="text-base font-bold text-ink-950 sm:w-56 sm:shrink-0">{link.title}</span>
                  <span class="text-sm leading-[1.8] text-[#4f5057]">{link.text}</span>
                </span>
                <span class="shrink-0 text-xl text-ink-950 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
