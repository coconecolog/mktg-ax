---
import type { GetStaticPaths, Page } from "astro";
import type { Category, Post } from "@/lib/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import MoreExplore from "@/components/MoreExplore.astro";
import {
  getAllCategories,
  getAllTags,
  getCategoryTags,
  getPopularPosts,
  getPostBySlug,
  getPostsByCategory,
} from "@/lib/posts";
import { getResourcesByCategory } from "@/lib/resources";
import { CATEGORY_TAG_PAGE_SIZE, DEFAULT_OG_IMAGE } from "@/consts";

export const getStaticPaths = (async ({ paginate }) => {
  const categories = getAllCategories();
  return categories.flatMap((category) =>
    paginate(getPostsByCategory(category.name), {
      params: { category: category.name },
      pageSize: CATEGORY_TAG_PAGE_SIZE,
      props: { category },
    }),
  );
}) satisfies GetStaticPaths;

const { category, page } = Astro.props as { category: Category; page: Page<Post> };

const allCategories = getAllCategories();
const categoryTags = getCategoryTags(category.name);
const representativePost = category.representativeSlug ? getPostBySlug(category.representativeSlug) : undefined;
const categoryResources = getResourcesByCategory(category.name);

const sidebarPopularPosts = getPopularPosts(5).map((p) => ({ slug: p.slug, title: p.title }));
const sidebarTags = getAllTags();
const sitePopularPosts = getPopularPosts(3).map((p) => ({ slug: p.slug, title: p.title }));

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ブログ", href: "/blog" },
  { name: "カテゴリ", href: "/blog" },
  { name: category.name, href: `/blog/category/${encodeURIComponent(category.name)}` },
];
---

<BaseLayout
  title={`${category.name}｜カテゴリ一覧`}
  description={category.description || `${category.name}に関する記事の一覧です。`}
  ogImage="/open-graph/default.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <p class="text-xs font-bold text-brand-600">カテゴリ　全{page.total}件の記事</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-950">{category.name}</h1>

        {
          category.description && (
            <p class="mt-4 rounded-2xl border border-neutral-100 bg-neutral-50 p-5 text-sm leading-relaxed text-neutral-600">
              {category.description}
            </p>
          )
        }

        {
          categoryTags.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-neutral-400">関連するテーマ・キーワードから探す:</span>
              {categoryTags.map((tag) => (
                <a href={`/blog/tag/${encodeURIComponent(tag.name)}`} class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600 hover:bg-brand-50 hover:text-brand-700">
                  #{tag.name}
                </a>
              ))}
            </div>
          )
        }

        {
          representativePost && (
            <div class="mt-8 w-full rounded-2xl bg-ink-950 p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-amber-300">
                  ★ まず読むべき代表記事
                </span>
                <span class="text-xs font-medium text-white/40">{category.name}のロードマップ</span>
              </div>
              <a href={`/blog/${representativePost.slug}`}
                class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center"
              >
                <div class="min-w-0 flex-1">
                  <p class="text-lg font-bold leading-snug text-white sm:text-xl">{representativePost.title}</p>
                  {representativePost.description && (
                    <p class="mt-2 line-clamp-2 text-sm text-white/60">{representativePost.description}</p>
                  )}
                  <span class="mt-5 inline-flex w-fit items-center gap-1 rounded-full bg-brand-600 px-5 py-2 text-sm font-bold text-white">
                    この記事を読む →
                  </span>
                </div>
                {representativePost.thumbnail && (
                  <div class="aspect-video w-full overflow-hidden rounded-xl sm:w-72 sm:shrink-0">
                    <img src={representativePost.thumbnail} alt="" class="h-full w-full object-cover" />
                  </div>
                )}
              </a>
            </div>
          )
        }

        {
          page.data.length > 0 ? (
            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {page.data.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-neutral-400">このカテゴリにはまだ記事がありません。</p>
          )
        }

        {
          categoryResources.length > 0 && (
            <div class="mt-12">
              <h2 class="text-lg font-bold text-ink-950">このカテゴリの資料</h2>
              <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {categoryResources.map((resource) => (
                  <a href={`/resources/${resource.slug}`}
                    class="group block overflow-hidden rounded-2xl border border-neutral-100 bg-white transition-shadow hover:shadow-lg"
                  >
                    <div class="aspect-video w-full overflow-hidden bg-neutral-50">
                      <img src={resource.thumbnail || DEFAULT_OG_IMAGE} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                    </div>
                    <div class="p-5">
                      {resource.category && <span class="text-xs font-medium text-brand-600">{resource.category}</span>}
                      <h3 class="mt-1 line-clamp-2 font-bold text-ink-950 group-hover:text-brand-700">{resource.title}</h3>
                      <p class="mt-2 line-clamp-2 text-sm text-neutral-500">{resource.description}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <Pagination page={page} basePath={`/blog/category/${encodeURIComponent(category.name)}`} />

        <MoreExplore categories={allCategories} excludeCategory={category.name} popularPosts={sitePopularPosts} />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <BlogSidebar categories={allCategories} popularPosts={sidebarPopularPosts} tags={sidebarTags} />
      </aside>
    </div>
  </div>
</BaseLayout>
