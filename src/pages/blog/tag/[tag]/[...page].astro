---
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import LibraryFilterTabs from "@/components/LibraryFilterTabs.astro";
import LibraryCard from "@/components/LibraryCard.astro";
import Pagination from "@/components/Pagination.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllCategories, getAllPosts, getAllTags, getPopularPosts, getTagByName } from "@/lib/posts";
import { getAllResources } from "@/lib/resources";
import { buildFaqSchema, buildTagPageSchema } from "@/lib/schema";
import {
  getAllLibraryTagNames,
  getLibraryItemsByTag,
  getLibraryCountsByTag,
  type LibraryItem,
} from "@/lib/library";
import { SITE_NAME, TAG_PAGE_SIZE } from "@/consts";
import { toRouteSlug } from "@/lib/routeSlug";

// タグページ。カテゴリページ（/blog/category/[category]/[...page].astro）とは意図的にデザインを分けている
// （2026-09-10、ユーザー指示により方針転換。以前は「カテゴリページとデザイン・構成を揃える」方針で、
// 説明文・代表記事カード・マスタータグDB本文まで表示していたが、タグページとカテゴリページの見た目が
// 見分けられなくなってしまうとの指摘を受け、タグページ側からはそれらを削除した）。
// 2026-09-12追記: 上記の削除後、マスタータグDBに登録した本文（Notionページ本文のブロック）が
// タグページのどこにも表示されなくなっていることが「デグレ」として報告された。ユーザー確認の結果、
// 説明文・代表記事カードは引き続き非表示のままでよいが、本文ブロックのみページネーション直下・
// フッター手前（旧MoreExplore・カテゴリページと同じ位置）に復活させる方針に確定。
// 2026-09-13追記: 続けて、マスタータグDBの「説明文」もタグ名見出しの直下（カテゴリページと同じ位置・
// 同じスタイル）に表示してほしいとの依頼があり復活。代表記事カードのみ非表示のまま維持。
// タグページの構成: パンくず→タグ名→説明文→すべて/ブログ記事/無料資料タブ→記事・資料混合カード→
// ページネーション→マスタータグDB本文ブロック。代表記事カードは表示しない（マスタータグDBに登録しても、
// タグページの見た目には反映されない）。カテゴリページ側は代表記事カードも従来通り表示するので、
// 混同しないこと。
// 2026-09-21追記（SEO対応）: タグページを「ピラーページ」として位置づけ直した。
//   カテゴリ（大分類）⊃ タグ＝ピラー（〇〇とは）⊃ クラスター（ブログ記事）。1つのタグは複数カテゴリにまたがる。
//   (1) titleを「〇〇とは？…」形式に変更（H1は短い「タグ名」のまま、UX優先）
//   (2) 定義ボックスの見出しを<p>から<h2>「〇〇とは」に変更（H1が短くてもSEO上「〇〇とは」の見出しを持たせる）
//   (3) 構造化データ（CollectionPage＋DefinedTerm＋ItemList、本文にFAQトグルがあればFAQPage）を出力
//   (4) 「関連カテゴリ」リンクを追加（ピラー↔カテゴリの内部リンク）
// 以前あった「すべて／B2B／KPI…」のようなタグ切り替え（TagFilter）は、種類別タブに置き換える形で廃止済み。

export const getStaticPaths = (async ({ paginate }) => {
  const tagNames = getAllLibraryTagNames();
  // カテゴリページ側と同じ理由・同じ対策。パラメータ値はtoRouteSlug()したものを使い、
  // 「/」を含むタグ名でもビルドが落ちず、常にリンクが機能するようにする（詳細はrouteSlug.ts参照）。
  return tagNames.flatMap((name) =>
    paginate(getLibraryItemsByTag(name, "all"), {
      params: { tag: toRouteSlug(name) },
     pageSize: TAG_PAGE_SIZE,
      props: { tagName: name },
    }),
  );
}) satisfies GetStaticPaths;

const { tagName, page } = Astro.props as { tagName: string; page: Page<LibraryItem> };

const allCategories = getAllCategories();
// マスタータグDBの説明文はタグ名見出しの直下に表示する（2026-09-13復活）。BaseLayoutのdescription props
// （SEO用meta description）にも引き続き使う。代表記事カードはタグページの見た目には表示しない
// （上部コメント参照）。本文ブロック（tagInfo.blocks）はページ下部に表示する（2026-09-12復活）。
const tagInfo = getTagByName(tagName);
const counts = getLibraryCountsByTag(tagName);
const tagBasePath = `/blog/tag/${encodeURIComponent(toRouteSlug(tagName))}`;
const tabHrefs = { all: tagBasePath, post: `${tagBasePath}/blog`, resource: `${tagBasePath}/resources` };

const sidebarPopularPosts = getPopularPosts(5).map((p) => ({ slug: p.slug, title: p.title }));
const sidebarTags = getAllTags();

// このタグが付いた記事・資料が属するカテゴリ（カテゴリ側→タグ側の相互リンク用）。並びはマスターカテゴリDBの「並び順」に従う。
const usedCategoryNames = new Set<string>([
  ...getAllPosts().filter((p) => p.tags.includes(tagName)).flatMap((p) => p.categories),
  ...getAllResources().filter((r) => r.tags.includes(tagName)).flatMap((r) => (r.category ? [r.category] : [])),
]);
const relatedCategories = allCategories.filter((c) => usedCategoryNames.has(c.name));

// titleタグ。検索結果で「〇〇の用語ページ」と伝わるよう「〇〇とは？」を先頭に置く。
// 末尾の「 | MKTG.AX」はSEO.astroが自動で付ける。
const pageTitle = `${tagName}とは？意味・解説と関連記事・資料一覧`;
const metaDescription = tagInfo?.description || `「${tagName}」タグが付いた記事・資料の一覧です。`;

const tagSchema = buildTagPageSchema({
  tagName,
  pageTitle: `${pageTitle} | ${SITE_NAME}`,
  description: metaDescription,
  path: tagBasePath,
  items: page.data.map((item) => ({ href: item.href, title: item.title })),
  itemsStartIndex: page.start,
  totalItems: page.total,
});
const faqSchema = tagInfo?.blocks ? buildFaqSchema(tagInfo.blocks) : null;
const jsonLd = faqSchema ? [tagSchema, faqSchema] : tagSchema;

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ライブラリ（記事・資料）", href: "/library" },
  { name: tagName, href: tagBasePath },
];
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  ogImage="/open-graph/default.png"
  jsonLd={jsonLd}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <p class="text-xs font-bold text-brand-600">タグ　全{counts.all}件</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink-950">{tagName}</h1>

        {
          tagInfo?.description && (
            <div class="mt-6 rounded-2xl border border-neutral-300 bg-white p-6 sm:p-8">
              <h2 class="text-sm font-bold text-ink-950">{tagName}とは</h2>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600 whitespace-pre-line">
                {tagInfo.description}
              </p>
            </div>
          )
        }

        {
          relatedCategories.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm">
              <span class="font-bold text-ink-950">関連カテゴリ</span>
              {relatedCategories.map((c) => (
                <a href={`/blog/category/${encodeURIComponent(toRouteSlug(c.name))}`} class="rounded border border-brand-300 px-2 py-0.5 text-brand-700 hover:bg-brand-50">
                  {c.name}
                </a>
              ))}
            </div>
          )
        }

        <h2 class="mt-8 text-xl font-extrabold tracking-tight text-ink-950">「{tagName}」に関する関連記事</h2>

        <div class="mt-10">
          <LibraryFilterTabs active="all" counts={counts} hrefs={tabHrefs} />
        </div>

        {
          page.data.length > 0 ? (
            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
              {page.data.map((item) => (
                <LibraryCard item={item} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-neutral-400">このタグにはまだコンテンツがありません。</p>
          )
        }

        <Pagination page={page} basePath={tagBasePath} />

        {
          tagInfo?.blocks && tagInfo.blocks.length > 0 && (
            <div class="prose-notion mt-12 w-full">
              <NotionBlocks blocks={tagInfo.blocks} />
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <BlogSidebar categories={allCategories} popularPosts={sidebarPopularPosts} tags={sidebarTags} />
      </aside>
    </div>
  </div>

  <ContactCta />
</BaseLayout>
