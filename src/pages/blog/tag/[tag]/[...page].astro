---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TagFilter from "@/components/TagFilter.astro";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllCategories, getAllTags, getPopularPosts, getPostsByTag, getTagByName } from "@/lib/posts";
import { CATEGORY_TAG_PAGE_SIZE } from "@/consts";
import { toRouteSlug, fromRouteSlug } from "@/lib/routeSlug";

export const getStaticPaths = (async ({ paginate }) => {
  const tags = getAllTags();
  // カテゴリページ側と同じ理由・同じ対策。パラメータ値はtoRouteSlug()したものを使い、
  // 「/」を含むタグ名でもビルドが落ちず、常にリンクが機能するようにする（詳細はrouteSlug.ts参照）。
  return tags.flatMap(({ name }) =>
    paginate(getPostsByTag(name), {
      params: { tag: toRouteSlug(name) },
      pageSize: CATEGORY_TAG_PAGE_SIZE,
    }),
  );
}) satisfies GetStaticPaths;

// params.tag はtoRouteSlug()されたスラッグなので、表示・検索用に元のタグ名へ戻す。
const tagParam = Astro.params.tag;
const tag = tagParam ? fromRouteSlug(tagParam) : undefined;
const tagUrlSlug = tag ? encodeURIComponent(toRouteSlug(tag)) : "";
const { page } = Astro.props;
const tags = getAllTags();
const categories = getAllCategories();
// 「マスタータグ」DBに登録されていれば、カテゴリページと同じく説明文・本文（Notion側の解説文）を表示する。
const tagInfo = tag ? getTagByName(tag) : undefined;
const sidebarPopularPosts = getPopularPosts(5).map((p) => ({ slug: p.slug, title: p.title }));

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ライブラリ（記事・資料）", href: "/library" },
  { name: tag ?? "", href: `/blog/tag/${tagUrlSlug}` },
];
---

<BaseLayout
  title={`タグ「${tag}」の記事一覧`}
  description={`「${tag}」タグが付いた記事の一覧です。`}
  ogImage="/open-graph/default.png"
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">
          タグ: <span class="text-brand-600">{tag}</span>
        </h1>

        <div class="mt-6"><TagFilter tags={tags} activeTag={tag} /></div>

        {
          tagInfo?.description && (
            <p class="mt-4 text-sm leading-relaxed text-neutral-600 whitespace-pre-line">{tagInfo.description}</p>
          )
        }

        {
          page.data.length > 0 ? (
            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {page.data.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="mt-10 text-neutral-400">このタグの記事はまだありません。</p>
          )
        }

        <Pagination page={page} basePath={`/blog/tag/${tagUrlSlug}`} />

        {
          tagInfo?.blocks && tagInfo.blocks.length > 0 && (
            <div class="prose-notion mt-12 w-full">
              <NotionBlocks blocks={tagInfo.blocks} />
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <BlogSidebar categories={categories} popularPosts={sidebarPopularPosts} tags={tags} />
      </aside>
    </div>
  </div>

  <ContactCta />
</BaseLayout>
