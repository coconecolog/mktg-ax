---
// タグページ（2026-10-15リニューアル）。タグ＝ピラーページ（〇〇とは）。
// 設計の2軸:
//   SEO/AIO … H1「〇〇とは？」直下に定義文（マスタータグDB「説明文」200〜500字）、解説エリア（ページ本文）、
//             構造化データ（CollectionPage＋DefinedTerm＋ItemList、本文にFAQがあればFAQPage）
//   UX       … 記事ページのタグから来た人が、そのタグの記事をすぐ探せるよう、記事一覧を上に置く
// 構成: パンくず → H1「〇〇とは？」＋定義文 → ページ内リンク列 →
//       左: 「〇〇に関する記事・資料」（記事を新しい順、TAG_PAGE_SIZE件ずつページ内JSでページ送り）→ 解説エリア（TagBody）
//       右: このページの内容（本文の見出し2）→ 資料で実践する（このタグの資料）
// URLは /blog/tag/{slug} の1つだけ（ライブラリページと同じ扱い）。旧URL（/blog・/resources タブ、/2 などのページ送り）は
// public/_redirects でこのページへ301転送している。
// 記事のラベルは自動: 記事の「サブカテゴリ」名（無ければ先頭のカテゴリ名）。
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TagBody from "@/components/TagBody.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllSubcategories, getTagByName, getTagPath, getTagSlug } from "@/lib/posts";
import { getAllResources } from "@/lib/resources";
import { buildFaqSchema, buildTagPageSchema } from "@/lib/schema";
import { autoLinkRelatedTerms } from "@/lib/relatedTermLinks";
import { getAllLibraryTagNames, getLibraryItemsByTag } from "@/lib/library";
import { SITE_NAME, TAG_PAGE_SIZE } from "@/consts";
import type { BlockNode, RichTextItem } from "@/lib/types";

export const getStaticPaths = (() => {
  return getAllLibraryTagNames().map((name) => ({
    params: { tag: getTagSlug(name) },
    props: { tagName: name },
  }));
}) satisfies GetStaticPaths;

const { tagName } = Astro.props as { tagName: string };

const tagInfo = getTagByName(tagName);
const tagPath = getTagPath(tagName);

// ---- 記事・資料 ----
const items = getLibraryItemsByTag(tagName, "all");
const posts = items.filter((item) => item.kind === "post");
const resourceItems = items.filter((item) => item.kind === "resource");
const resourceBySlug = new Map(getAllResources().map((r) => [r.slug, r]));
const resources = resourceItems.map((item) => resourceBySlug.get(item.slug)).filter((r) => !!r);

const subcategoryName = new Map(getAllSubcategories().map((s) => [s.id, s.name]));
const labelOf = (item: (typeof posts)[number]) =>
  item.subcategoryIds.map((id) => subcategoryName.get(id)).find(Boolean) || item.categories[0] || "";

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Tokyo" }).replaceAll("/", ".");

// 「内容物」（例: 5つのステップ＋記入例付きワークシート）を箇条書き用に分ける
const splitContents = (text: string | undefined) =>
  (text || "")
    .split(/\r?\n|[＋+／]/)
    .map((s) => s.replace(/^[・\-\s]+/, "").trim())
    .filter(Boolean);

// ---- 解説エリア（マスタータグDBのページ本文） ----
// 「似た用語との違い」「関連用語」の用語名は、同名のタグページがあれば自動でリンクする
const bodyBlocks: BlockNode[] = autoLinkRelatedTerms(tagInfo?.blocks, tagName) || [];
const plain = (items: RichTextItem[] | undefined) => (items || []).map((r) => r.text).join("").trim();
const headings = bodyBlocks
  .filter((b) => b.type === "heading_2" && b.anchor && plain(b.richText))
  .map((b) => ({ anchor: b.anchor as string, text: plain(b.richText) }));

// 右カラム「このページの内容」用の短い見出し（先頭のタグ名と「の・と・を・について」等を省く）
const shortLabel = (text: string) => {
  if (!text.startsWith(tagName)) return text;
  const rest = text.slice(tagName.length).replace(/^(について|に関する|における|との|の|と|を|が|は|で)/, "").trim();
  return rest || text;
};

const ARTICLES_ANCHOR = "articles";
const articlesHeading = `${tagName}に関する記事・資料`;

// ---- SEO ----
// titleタグ。マスタータグDBの「SEOタイトル」を使う（末尾の「 | MKTG.AX」はSEO.astroが自動で付ける）。
const pageTitle = tagInfo?.seoTitle || `${tagName}とは？意味・解説と関連記事・資料一覧`;
// meta description。マスタータグDBの「ディスクリプション」→ 無ければ説明文の先頭120字 → 無ければ定型文
const definition = (tagInfo?.description || "").trim();
const truncate = (text: string, max: number) => {
  const flat = text.replace(/\s+/g, " ").trim();
  return flat.length > max ? `${flat.slice(0, max - 1)}…` : flat;
};
const metaDescription =
  tagInfo?.metaDescription?.trim() || (definition ? truncate(definition, 120) : `「${tagName}」に関する記事・資料の一覧です。`);

const tagSchema = buildTagPageSchema({
  tagName,
  pageTitle: `${pageTitle} | ${SITE_NAME}`,
  description: definition ? truncate(definition, 300) : metaDescription,
  path: tagPath,
  items: items.map((item) => ({ href: item.href, title: item.title })),
  itemsStartIndex: 0,
  totalItems: items.length,
});
const faqSchema = tagInfo?.blocks ? buildFaqSchema(tagInfo.blocks) : null;
const jsonLd = faqSchema ? [tagSchema, faqSchema] : tagSchema;

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ライブラリ（記事・資料）", href: "/library" },
  { name: tagName, href: tagPath },
];
---

<BaseLayout title={pageTitle} description={metaDescription} ogImage="/open-graph/default.png" jsonLd={jsonLd} pagefindIgnore>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-8 pb-16">
    {/* H1＋定義文 */}
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{tagName}とは？</h1>
    {
      definition ? (
        <div class="mt-8 border-y border-ink-950 py-6">
          <p class="max-w-4xl text-[15px] leading-[2] whitespace-pre-line text-ink-950">{definition}</p>
        </div>
      ) : (
        <div class="mt-8 border-t border-ink-950" />
      )
    }

    {/* ページ内リンク */}
    <nav aria-label="ページ内リンク" class="mt-6">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-ink-950">
        <li><a href={`#${ARTICLES_ANCHOR}`} class="hover:underline">{articlesHeading}<span aria-hidden="true">↓</span></a></li>
        {headings.map((h) => (
          <li><a href={`#${h.anchor}`} class="hover:underline">{h.text}<span aria-hidden="true">↓</span></a></li>
        ))}
      </ul>
    </nav>

    <div class="mt-12 grid grid-cols-1 gap-x-16 lg:grid-cols-[minmax(0,1fr)_300px]">
      {/* 記事・資料 */}
      <section class="lg:col-start-1 lg:row-start-1" data-tag-articles data-page-size={TAG_PAGE_SIZE}>
        <h2 id={ARTICLES_ANCHOR} class="scroll-mt-24 text-[1.6rem] font-bold leading-snug tracking-tight text-ink-950">{articlesHeading}</h2>
        <p class="mt-3 text-[13px] text-neutral-500">
          {tagName}に関連する{[posts.length > 0 && `記事${posts.length}件`, resources.length > 0 && `資料${resources.length}件`].filter(Boolean).join("・") || "記事・資料はまだありません"}。
        </p>

        {
          posts.length > 0 ? (
            <>
              <p class="mt-8 border-b border-neutral-300 pb-4 text-sm font-bold text-ink-950">記事で理解する｜記事{posts.length}件</p>
              <ul data-list>
                {posts.map((item, i) => (
                  <li data-row hidden={i >= TAG_PAGE_SIZE} class="border-b border-neutral-300">
                    <a href={item.href} class="group grid grid-cols-1 gap-3 py-7 sm:grid-cols-[100px_minmax(0,1fr)] sm:gap-6">
                      <span class="flex gap-3 text-xs leading-relaxed text-neutral-500 sm:block">
                        <span class="block tabular-nums">{formatDate(item.publishedAt)}</span>
                        <span class="block">読了{item.readMinutes}分</span>
                      </span>
                      <span class="min-w-0">
                        {labelOf(item) && <span class="block text-xs text-neutral-500">{labelOf(item)}</span>}
                        <span class="mt-2 block text-base font-bold leading-relaxed text-ink-950 group-hover:underline sm:text-[17px]">{item.title}</span>
                        {item.description && <span class="mt-2 line-clamp-2 block text-[13px] leading-relaxed text-neutral-500">{item.description}</span>}
                        <span class="mt-3 flex items-center gap-1 text-xs font-bold text-ink-950">
                          記事を読む<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <nav data-pager aria-label="記事のページ送り" class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm" />
            </>
          ) : (
            <p class="mt-8 border-t border-neutral-300 py-8 text-sm text-neutral-500">このタグの記事はまだありません。</p>
          )
        }
      </section>

      {/* 右カラム */}
      <aside class="mt-14 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0">
        {
          headings.length > 0 && (
            <nav aria-label="このページの内容" class="hidden lg:block">
              <p class="text-sm font-bold text-ink-950">このページの内容</p>
              <ol class="mt-4 space-y-4 text-[13px]">
                {[...headings.map((h) => ({ anchor: h.anchor, text: shortLabel(h.text) })), { anchor: ARTICLES_ANCHOR, text: "詳しく学ぶ記事・資料" }].map((h, i) => (
                  <li>
                    <a href={`#${h.anchor}`} class="flex gap-4 text-ink-950 hover:underline">
                      <span class="shrink-0 tabular-nums text-neutral-400">{String(i + 1).padStart(2, "0")}</span>
                      <span>{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {
          resources.length > 0 && (
            <div class={headings.length > 0 ? "lg:mt-24" : ""}>
              <p class="text-sm font-bold text-ink-950">資料で実践する｜{resources.length}件</p>
              <div class="mt-3 bg-neutral-100 p-5">
                {resources.map((r, i) => (
                  <div class={i > 0 ? "mt-8 border-t border-neutral-300 pt-8" : ""}>
                    {/* 表紙（資料名から白黒で生成。PDFのキャプチャは使わない） */}
                    <a href={`/resources/${r.slug}`} class="flex aspect-square flex-col bg-ink-950 p-5 text-white" aria-hidden="true" tabindex="-1">
                      <span class="flex items-start justify-between gap-3 text-[10px] font-bold">
                        <span class="text-neutral-300">{r.category || "無料資料"}</span>
                        <span class="tracking-wide">MKTG.AX</span>
                      </span>
                      <span class="mt-5 line-clamp-3 text-xl font-bold leading-snug">{r.title}</span>
                      <svg viewBox="0 0 240 70" class="mt-auto w-full" fill="none" aria-hidden="true">
                        <line x1="0" y1="35" x2="240" y2="35" stroke="#525252" stroke-width="1" />
                        <line x1="120" y1="0" x2="120" y2="70" stroke="#525252" stroke-width="1" />
                        <rect x="79" y="22" width="6" height="6" stroke="white" stroke-width="1" />
                        <rect x="183" y="8" width="10" height="10" fill="white" />
                        <rect x="46" y="50" width="6" height="6" stroke="white" stroke-width="1" />
                      </svg>
                      <span class="mt-4 block min-h-[1em] text-[10px] text-neutral-300">{r.homeCatch || ""}</span>
                    </a>
                    <p class="mt-4 text-xs text-neutral-500">無料資料　/　{formatDate(r.publishedAt)}</p>
                    <p class="mt-2 text-lg font-bold leading-snug text-ink-950">
                      <a href={`/resources/${r.slug}`} class="hover:underline">{r.title}</a>
                    </p>
                    {r.description && <p class="mt-3 line-clamp-4 text-[13px] leading-relaxed whitespace-pre-line text-neutral-600">{r.description}</p>}
                    {splitContents(r.contents).length > 0 && (
                      <ul class="mt-4 space-y-1 text-xs text-neutral-500">
                        {splitContents(r.contents).map((c) => (
                          <li>・{c}</li>
                        ))}
                      </ul>
                    )}
                    <a href={`/resources/${r.slug}`} class="mt-5 flex items-center justify-between bg-ink-950 px-4 py-3.5 text-sm font-bold text-white transition-colors hover:bg-neutral-800">
                      資料を見る<span aria-hidden="true">→</span>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </aside>

      {/* 解説エリア */}
      {
        bodyBlocks.length > 0 && (
          <div class="mt-16 lg:col-start-1 lg:row-start-2">
            <TagBody blocks={bodyBlocks} />
          </div>
        )
      }
    </div>
  </div>

  <ContactCta />
</BaseLayout>

<script>
  // 「〇〇に関する記事・資料」のページ送り（全記事のリンクはHTMLに入っていて、表示だけを切り替える）
  const root = document.querySelector<HTMLElement>("[data-tag-articles]");
  const pager = root?.querySelector<HTMLElement>("[data-pager]");
  if (root && pager) {
    const pageSize = Number(root.dataset.pageSize) || 3;
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-row]"));
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    const heading = root.querySelector<HTMLElement>("h2");
    let current = 1;

    const button = (label: string, page: number, opts: { current?: boolean; aria?: string; wide?: boolean } = {}) => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = label;
      if (opts.aria) b.setAttribute("aria-label", opts.aria);
      if (opts.current) b.setAttribute("aria-current", "page");
      b.className = opts.wide
        ? "h-10 border border-neutral-200 bg-white px-4 text-ink-950 hover:border-ink-950"
        : `h-10 min-w-10 border px-2 tabular-nums ${opts.current ? "border-ink-950 bg-ink-950 text-white" : "border-neutral-300 bg-white text-ink-950 hover:border-ink-950"}`;
      b.addEventListener("click", () => {
        current = page;
        render();
        heading?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      return b;
    };

    function render() {
      const start = (current - 1) * pageSize;
      rows.forEach((row, i) => (row.hidden = i < start || i >= start + pageSize));
      pager!.replaceChildren();
      if (totalPages <= 1) return;
      if (current > 1) pager!.append(button("← 前へ", current - 1, { wide: true }));
      // 7ページ以内なら全部、それ以上は「1 … 前後 … 最終」
      const pages: (number | null)[] = [];
      if (totalPages <= 7) {
        for (let p = 1; p <= totalPages; p++) pages.push(p);
      } else {
        const s = Math.max(2, current - 1);
        const e = Math.min(totalPages - 1, current + 1);
        pages.push(1);
        if (s > 2) pages.push(null);
        for (let p = s; p <= e; p++) pages.push(p);
        if (e < totalPages - 1) pages.push(null);
        pages.push(totalPages);
      }
      for (const p of pages) {
        if (p === null) {
          const span = document.createElement("span");
          span.textContent = "…";
          span.className = "px-1 text-neutral-400";
          pager!.append(span);
        } else {
          pager!.append(button(String(p), p, { current: p === current, aria: `${p}ページ目` }));
        }
      }
      if (current < totalPages) pager!.append(button("次へ →", current + 1, { wide: true }));
    }

    render();
  }
</script>
