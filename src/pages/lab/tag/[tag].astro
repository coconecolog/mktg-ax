---
// タグページ。タグ＝ピラーページ（〇〇とは）。
// 2026-11-06 組み替え：検索から来た人向けに「定義 → テンプレート → 解説 → 記事・資料 → 関連用語」の順にした。
//   ・H1「〇〇とは？」＋定義文（マスタータグDB「説明文」200〜500字）。空行で段落、改行はそのまま改行。
//     本文の先頭（最初の見出し2より前）に画像があれば、定義文の右に「冒頭の図」として出す（本文からは外す）。
//   ・代表資料（マスタータグDB「代表資料」。資料DBとのリレーション）があれば、定義文の下にテンプレートの枠を出す。
//     スマホでは画面下にも同じ資料への帯を固定で出す。空欄なら枠も帯も出さない。
//   ・解説エリア（TagBody）→「〇〇の記事・資料」（記事一覧。形式の絞り込みとページ送りはページ内JS）→ 関連用語。
//     「関連用語」を含む見出し2のセクションだけ、記事一覧の後ろに回す。
//   ・右カラム：目次だけ（追従。今読んでいる見出しを太字にする）。資料・タグ一覧は出さない
//     （資料は最初の画面の枠と読み終えた位置のCTAで出す。タグ一覧はページ下の共通の帯にある）。
//   ・関連用語の下（共通フッターの上）に、代表資料のCTAを出す（2026-11-06）。
// 構造化データ：CollectionPage＋DefinedTerm＋ItemList、本文にFAQ（トグル）があればFAQPage。
// URLは /lab/tag/{slug} の1つだけ。旧URL（/blog/tag/{slug}、ページ送りなど）は public/_redirects で301転送している。
// 記事のラベルは自動: 記事の「サブカテゴリ」名（無ければ先頭のカテゴリ名）。
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import TagBody from "@/components/TagBody.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllSubcategories, getTagByName, getTagPath, getTagSlug } from "@/lib/posts";
import { getAllResources } from "@/lib/resources";
import { buildFaqSchema, buildTagPageSchema } from "@/lib/schema";
import { autoLinkRelatedTerms } from "@/lib/relatedTermLinks";
import { getAllLibraryTagNames, getLibraryItemsByTag } from "@/lib/library";
import { SITE_NAME, TAG_PAGE_SIZE } from "@/consts";
import type { BlockNode, RichTextItem } from "@/lib/types";

export const getStaticPaths = (() => {
  return getAllLibraryTagNames().map((name) => ({
    params: { tag: getTagSlug(name) },
    props: { tagName: name },
  }));
}) satisfies GetStaticPaths;

const { tagName } = Astro.props as { tagName: string };

const tagInfo = getTagByName(tagName);
const tagPath = getTagPath(tagName);

// ---- 記事・資料 ----
const items = getLibraryItemsByTag(tagName, "all");
const posts = items.filter((item) => item.kind === "post");
const resourceItems = items.filter((item) => item.kind === "resource");
const resourceBySlug = new Map(getAllResources().map((r) => [r.slug, r]));
const resources = resourceItems.map((item) => resourceBySlug.get(item.slug)).filter((r) => !!r);
// 代表資料（テンプレートの枠に出す）。マスタータグDB「代表資料」で指定した1件。未設定ならnull
const representativeResource = tagInfo?.representativeResourceId
  ? getAllResources().find((r) => r.id === tagInfo.representativeResourceId) || null
  : null;
const repCover = representativeResource
  ? representativeResource.thumbnail || representativeResource.coverImage || representativeResource.excerptImages?.[0] || null
  : null;
const repFormat = representativeResource?.fileFormat || "";
const filters = [
  { key: "all", label: "すべて", count: items.length },
  { key: "post", label: "記事", count: posts.length },
  { key: "resource", label: "無料資料", count: resourceItems.length },
];

const subcategoryName = new Map(getAllSubcategories().map((s) => [s.id, s.name]));
const labelOf = (item: (typeof items)[number]) =>
  item.subcategoryIds.map((id) => subcategoryName.get(id)).find(Boolean) || item.categories[0] || "";

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Tokyo" }).replaceAll("/", ".");


// ---- 解説エリア（マスタータグDBのページ本文） ----
// 「似た用語との違い」「関連用語」の用語名は、同名のタグページがあれば自動でリンクする
const allBlocks: BlockNode[] = autoLinkRelatedTerms(tagInfo?.blocks, tagName) || [];
const plain = (items: RichTextItem[] | undefined) => (items || []).map((r) => r.text).join("").trim();

// 冒頭の図：最初の見出し2より前にある、最初の画像
const firstH2Index = allBlocks.findIndex((b) => b.type === "heading_2");
const leadEnd = firstH2Index === -1 ? allBlocks.length : firstH2Index;
const heroIndex = allBlocks.slice(0, leadEnd).findIndex((b) => b.type === "image" && b.src);
const heroImage = heroIndex >= 0 ? allBlocks[heroIndex] : null;
const withoutHero = heroIndex >= 0 ? allBlocks.filter((_, i) => i !== heroIndex) : allBlocks;

// 「関連用語」のセクション（見出し2から次の見出し2の手前まで）は、記事一覧の後ろに回す
const relStart = withoutHero.findIndex((b) => b.type === "heading_2" && plain(b.richText).includes("関連用語"));
let relEnd = withoutHero.length;
if (relStart >= 0) {
  const next = withoutHero.findIndex((b, i) => i > relStart && b.type === "heading_2");
  if (next !== -1) relEnd = next;
}
const relatedBlocks = relStart >= 0 ? withoutHero.slice(relStart, relEnd) : [];
const mainBlocks = relStart >= 0 ? [...withoutHero.slice(0, relStart), ...withoutHero.slice(relEnd)] : withoutHero;

const h2List = (blocks: BlockNode[]) =>
  blocks
    .filter((b) => b.type === "heading_2" && b.anchor && plain(b.richText))
    .map((b) => ({ anchor: b.anchor as string, text: plain(b.richText) }));

// 右カラム「目次」用の短い見出し（先頭のタグ名と「の・と・を・について」等を省く）
const shortLabel = (text: string) => {
  if (!text.startsWith(tagName)) return text;
  const rest = text.slice(tagName.length).replace(/^(について|に関する|における|との|の|と|を|が|は|で)/, "").trim();
  return rest || text;
};

const ARTICLES_ANCHOR = "articles";
const articlesHeading = `${tagName}の記事・資料`;
// 右カラムの目次。ページの並びどおり：解説の見出し2 →「記事・資料」→ 関連用語
const sideToc = [
  ...h2List(mainBlocks),
  { anchor: ARTICLES_ANCHOR, text: articlesHeading },
  ...h2List(relatedBlocks),
].map((h) => ({ anchor: h.anchor, text: shortLabel(h.text) }));

// 定義文：空行で段落に分ける（段落内の改行は whitespace-pre-line でそのまま改行）
// ---- SEO ----
// titleタグ。マスタータグDBの「SEOタイトル」を使う（末尾の「 | MeerKitLab」はSEO.astroが自動で付ける）。
const pageTitle = tagInfo?.seoTitle || `${tagName}とは？意味・解説と関連記事・資料一覧`;
// meta description。マスタータグDBの「ディスクリプション」→ 無ければ説明文の先頭120字 → 無ければ定型文
const definition = (tagInfo?.description || "").trim();
const definitionParagraphs = definition.split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
const truncate = (text: string, max: number) => {
  const flat = text.replace(/\s+/g, " ").trim();
  return flat.length > max ? `${flat.slice(0, max - 1)}…` : flat;
};
const metaDescription =
  tagInfo?.metaDescription?.trim() || (definition ? truncate(definition, 120) : `「${tagName}」に関する記事・資料の一覧です。`);

const tagSchema = buildTagPageSchema({
  tagName,
  pageTitle: `${pageTitle} | ${SITE_NAME}`,
  description: definition ? truncate(definition, 300) : metaDescription,
  path: tagPath,
  items: items.map((item) => ({ href: item.href, title: item.title })),
  itemsStartIndex: 0,
  totalItems: items.length,
});
const faqSchema = tagInfo?.blocks ? buildFaqSchema(tagInfo.blocks) : null;
const jsonLd = faqSchema ? [tagSchema, faqSchema] : tagSchema;

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "Lab（記事・資料）", href: "/lab" },
  { name: tagName, href: tagPath },
];
---

<BaseLayout title={pageTitle} description={metaDescription} ogImage="/open-graph/default.png" jsonLd={jsonLd} pagefindIgnore>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-8 pb-16">
    {/* H1＋定義文（＋冒頭の図） */}
    <h1 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{tagName}とは？</h1>
    <div class={`mt-8 border-y border-ink-950 py-7 ${heroImage ? "grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start" : ""}`}>
      <div class="max-w-3xl">
        {definitionParagraphs.map((para, i) => (
          <p class={`text-[15px] leading-[2] whitespace-pre-line text-ink-950 ${i > 0 ? "mt-4" : ""}`}>{para}</p>
        ))}
        {items.length > 0 && (
          <p class="mt-6 text-[13px]">
            <a href={`#${ARTICLES_ANCHOR}`} class="text-neutral-500 hover:text-ink-950 hover:underline">
              {articlesHeading}（{items.length}件）<span aria-hidden="true">↓</span>
            </a>
          </p>
        )}
      </div>
      {heroImage && (
        <figure class="m-0">
          <img src={heroImage.src} alt={heroImage.alt || heroImage.caption || ""} class="block h-auto w-full" loading="eager" decoding="async" />
        </figure>
      )}
    </div>

    {/* 定義文の下から2カラム。左：テンプレート → 解説 → 記事・資料 → 関連用語、右：目次など（テンプレートの枠と同じ高さから始める） */}
    <div class="mt-8 grid grid-cols-1 gap-x-16 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        {/* テンプレート（代表資料） */}
        {
          representativeResource && (
            <a
              href={`/lab/whitepapers/${representativeResource.slug}`}
              class="group mb-16 grid grid-cols-1 gap-5 border-2 border-ink-950 bg-white p-5 no-underline sm:grid-cols-[200px_minmax(0,1fr)] sm:items-center sm:p-6"
            >
              <span class="block aspect-[4/3] overflow-hidden border border-neutral-200 bg-neutral-100">
                {repCover ? (
                  <img src={repCover} alt="" class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
                ) : (
                  <span class="flex h-full w-full items-center justify-center text-xs font-bold text-neutral-500">{repFormat || "無料資料"}</span>
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-bold text-[#665334]">無料テンプレート</span>
                <span class="mt-1 block text-lg font-bold leading-snug text-ink-950 group-hover:underline">{representativeResource.title}</span>
                {(repFormat || representativeResource.contents) && (
                  <span class="mt-2 block text-[13px] leading-relaxed text-neutral-500">
                    {[repFormat, representativeResource.contents].filter(Boolean).join(" ／ ")}
                  </span>
                )}
                <span class="mt-4 inline-flex items-center gap-3 bg-ink-950 px-5 py-3 text-sm font-bold text-white">
                  無料でダウンロード<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </span>
            </a>
          )
        }
        {/* 解説エリア */}
        {mainBlocks.length > 0 && <TagBody blocks={mainBlocks} />}

        {/* 記事・資料 */}
        <section class="mt-16 first:mt-0" data-tag-articles data-page-size={TAG_PAGE_SIZE}>
          <h2 id={ARTICLES_ANCHOR} class="scroll-mt-24 text-[1.6rem] font-bold leading-snug tracking-tight text-ink-950">{articlesHeading}</h2>
          <p class="mt-3 text-[13px] text-neutral-500">
            {tagName}に関連する{[posts.length > 0 && `記事${posts.length}件`, resources.length > 0 && `資料${resources.length}件`].filter(Boolean).join("・") || "記事・資料はまだありません"}。
          </p>

          {
            items.length > 0 ? (
              <>
                <div class="mt-6 flex flex-wrap items-center gap-3 bg-neutral-100 px-4 py-4 sm:px-5" role="group" aria-label="形式で絞り込む">
                  <span class="text-xs font-bold text-ink-950">形式</span>
                  <div class="flex flex-wrap gap-1.5">
                    {filters.map((f) => (
                      <button type="button" data-type={f.key} aria-pressed={f.key === "all" ? "true" : "false"} class="border border-neutral-300 bg-white px-3.5 py-2 text-xs font-bold text-ink-950 transition-colors aria-pressed:border-ink-950 aria-pressed:bg-ink-950 aria-pressed:text-white">
                        {f.label} <span class="font-normal tabular-nums">{f.count}</span>
                      </button>
                    ))}
                  </div>
                </div>
                <ul data-list class="mt-6 border-t border-neutral-300">
                  {items.map((item, i) => (
                    <li data-row data-kind={item.kind} hidden={i >= TAG_PAGE_SIZE} class={`border-b border-neutral-300 ${item.kind === "resource" ? "bg-neutral-100" : ""}`}>
                      <a href={item.href} class="group grid grid-cols-1 gap-3 px-3 py-6 sm:grid-cols-[100px_minmax(0,1fr)] sm:gap-6">
                        <span class="flex gap-3 text-xs leading-relaxed text-neutral-500 sm:block">
                          <span class="block tabular-nums">{formatDate(item.publishedAt)}</span>
                          <span class="block">{item.kind === "post" ? `読了${item.readMinutes}分` : item.fileExt ? `${item.fileExt}資料` : "無料資料"}</span>
                        </span>
                        <span class="min-w-0">
                          <span class="flex flex-wrap items-center gap-2">
                            {item.kind === "post" ? (
                              <span class="inline-flex items-center border border-ink-950 bg-white px-1.5 py-0.5 text-[11px] font-bold leading-none text-ink-950">記事</span>
                            ) : (
                              <span class="inline-flex items-center bg-ink-950 px-1.5 py-0.5 text-[11px] font-bold leading-none text-white">無料資料</span>
                            )}
                            {labelOf(item) && <span class="text-xs text-neutral-500">{labelOf(item)}</span>}
                          </span>
                          <span class="mt-2 block text-base font-bold leading-relaxed text-ink-950 group-hover:underline">{item.title}</span>
                          {item.description && <span class="mt-2 line-clamp-2 block text-[13px] leading-relaxed text-neutral-500">{item.description}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                <nav data-pager aria-label="記事・資料のページ送り" class="mt-8 flex flex-wrap items-center justify-center gap-2 text-sm" />
              </>
            ) : (
              <p class="mt-8 border-t border-neutral-300 py-8 text-sm text-neutral-500">このタグの記事・資料はまだありません。</p>
            )
          }
        </section>

        {/* 関連用語 */}
        {
          relatedBlocks.length > 0 && (
            <div class="mt-16">
              <TagBody blocks={relatedBlocks} />
            </div>
          )
        }
      </div>

      {/* 右カラム：目次だけ */}
      <aside class="hidden lg:col-start-2 lg:row-start-1 lg:block">
        {sideToc.length > 0 && (
          <nav aria-label="目次" class="sticky top-24 border-t-2 border-ink-950 pt-5" data-tag-toc>
            <p class="text-sm font-bold text-ink-950">目次</p>
            <ol class="mt-4 space-y-3 text-sm">
              {sideToc.map((h, i) => (
                <li>
                  <a href={`#${h.anchor}`} data-toc-link={h.anchor} class="flex gap-3 text-neutral-500 no-underline hover:text-ink-950 data-[active=true]:font-bold data-[active=true]:text-ink-950">
                    <span class="shrink-0 tabular-nums text-neutral-400">{String(i + 1).padStart(2, "0")}</span>
                    <span>{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>
    </div>
  </div>

  {/* 読み終えた位置のCTA（関連用語の下、共通フッターの上） */}
  {
    representativeResource && (
      <section class="mx-auto max-w-6xl px-5 pb-20" aria-label="無料テンプレート" data-tag-bottom-cta>
        <a
          href={`/lab/whitepapers/${representativeResource.slug}`}
          class="group grid grid-cols-1 gap-6 bg-ink-950 p-6 text-white no-underline sm:grid-cols-[240px_minmax(0,1fr)] sm:items-center sm:p-10"
        >
          <span class="block aspect-[4/3] overflow-hidden bg-white">
            {repCover ? (
              <img src={repCover} alt="" class="h-full w-full object-cover object-top" loading="lazy" decoding="async" />
            ) : (
              <span class="flex h-full w-full items-center justify-center text-sm font-bold text-neutral-500">{repFormat || "無料資料"}</span>
            )}
          </span>
          <span class="min-w-0">
            <span class="block text-xs font-bold text-neutral-400">{tagName}を、テンプレートで実践する</span>
            <span class="mt-2 block text-xl font-bold leading-snug sm:text-2xl">{representativeResource.title}</span>
            {(repFormat || representativeResource.contents) && (
              <span class="mt-3 block text-[13px] leading-relaxed text-neutral-300">
                {[repFormat, representativeResource.contents].filter(Boolean).join(" ／ ")}
              </span>
            )}
            <span class="mt-6 inline-flex items-center gap-3 bg-white px-6 py-3.5 text-sm font-bold text-ink-950">
              無料でダウンロード<span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </span>
        </a>
      </section>
    )
  }

  <ContactCta />

  {/* スマホ：画面下にテンプレートへの帯を固定 */}
  {
    representativeResource && (
      <a
        href={`/lab/whitepapers/${representativeResource.slug}`}
        data-tag-sticky-bar
        class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-3 border-t border-ink-950 bg-white px-5 py-3 no-underline transition-transform duration-200 data-[hidden=true]:translate-y-full lg:hidden"
      >
        <span class="min-w-0">
          <span class="block text-[11px] font-bold text-[#665334]">無料テンプレート</span>
          <span class="block truncate text-[13px] font-bold text-ink-950">{representativeResource.title}</span>
        </span>
        <span class="shrink-0 bg-ink-950 px-4 py-2.5 text-xs font-bold text-white">ダウンロード</span>
      </a>
    )
  }
</BaseLayout>

<script>
  // 「〇〇に関する記事・資料」の形式の絞り込み（すべて／記事／無料資料）とページ送り。全件のリンクはHTMLに入っていて、表示だけを切り替える
  const root = document.querySelector<HTMLElement>("[data-tag-articles]");
  const pager = root?.querySelector<HTMLElement>("[data-pager]");
  if (root && pager) {
    const pageSize = Number(root.dataset.pageSize) || 3;
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-row]"));
    const typeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-type]"));
    const heading = root.querySelector<HTMLElement>("h2");
    let current = 1;
    let type = "all";
    let totalPages = 1;

    typeButtons.forEach((b) =>
      b.addEventListener("click", () => {
        type = b.dataset.type || "all";
        typeButtons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        current = 1;
        render();
      }),
    );

    const button = (label: string, page: number, opts: { current?: boolean; aria?: string; wide?: boolean } = {}) => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = label;
      if (opts.aria) b.setAttribute("aria-label", opts.aria);
      if (opts.current) b.setAttribute("aria-current", "page");
      b.className = opts.wide
        ? "h-10 border border-neutral-200 bg-white px-4 text-ink-950 hover:border-ink-950"
        : `h-10 min-w-10 border px-2 tabular-nums ${opts.current ? "border-ink-950 bg-ink-950 text-white" : "border-neutral-300 bg-white text-ink-950 hover:border-ink-950"}`;
      b.addEventListener("click", () => {
        current = page;
        render();
        heading?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      return b;
    };

    function render() {
      const matched = rows.filter((row) => type === "all" || row.dataset.kind === type);
      totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
      current = Math.min(current, totalPages);
      const start = (current - 1) * pageSize;
      const visible = new Set(matched.slice(start, start + pageSize));
      rows.forEach((row) => (row.hidden = !visible.has(row)));
      pager!.replaceChildren();
      if (totalPages <= 1) return;
      if (current > 1) pager!.append(button("← 前へ", current - 1, { wide: true }));
      // 7ページ以内なら全部、それ以上は「1 … 前後 … 最終」
      const pages: (number | null)[] = [];
      if (totalPages <= 7) {
        for (let p = 1; p <= totalPages; p++) pages.push(p);
      } else {
        const s = Math.max(2, current - 1);
        const e = Math.min(totalPages - 1, current + 1);
        pages.push(1);
        if (s > 2) pages.push(null);
        for (let p = s; p <= e; p++) pages.push(p);
        if (e < totalPages - 1) pages.push(null);
        pages.push(totalPages);
      }
      for (const p of pages) {
        if (p === null) {
          const span = document.createElement("span");
          span.textContent = "…";
          span.className = "px-1 text-neutral-400";
          pager!.append(span);
        } else {
          pager!.append(button(String(p), p, { current: p === current, aria: `${p}ページ目` }));
        }
      }
      if (current < totalPages) pager!.append(button("次へ →", current + 1, { wide: true }));
    }

    render();
  }
</script>

<script>
  // 右カラムの目次：今読んでいる見出しを太字にする（画面の上から3割の位置を通り過ぎた最後の見出し）
  const toc = document.querySelector<HTMLElement>("[data-tag-toc]");
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const targets = links
      .map((a) => document.getElementById(a.dataset.tocLink || ""))
      .filter((el): el is HTMLElement => !!el);
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.3;
      let current = "";
      for (const el of targets) {
        if (el.getBoundingClientRect().top <= line) current = el.id;
      }
      links.forEach((a) => a.setAttribute("data-active", String(a.dataset.tocLink === current)));
    };
    window.addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>

<script>
  // スマホの画面下の帯：帯の高さだけページ下に余白を足し（フッターが隠れないように）、読み終えた位置のCTAが見えている間は帯を隠す
  const bar = document.querySelector<HTMLElement>("[data-tag-sticky-bar]");
  if (bar) {
    const mq = window.matchMedia("(max-width: 1023px)");
    const pad = () => {
      document.body.style.paddingBottom = mq.matches ? `${bar.offsetHeight}px` : "";
    };
    pad();
    mq.addEventListener("change", pad);
    const cta = document.querySelector<HTMLElement>("[data-tag-bottom-cta]");
    if (cta && "IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        bar.setAttribute("data-hidden", String(entries.some((e) => e.isIntersecting)));
      }).observe(cta);
    }
  }
</script>
