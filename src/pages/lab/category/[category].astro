---
// カテゴリページ（2026-10-12リニューアル）。
// カテゴリ内の記事・資料を、サブカテゴリ（マスターサブカテゴリDB）ごとのブロックに分けて1ページで表示する。
// - サブカテゴリ専用のページは作らず、ページ内アンカー（#Slug）で各テーマへ移動する
// - ページ番号のページネーションは廃止。件数の多いテーマは「もっと見る」ボタンで開く
// - 「形式（すべて／記事／無料資料）」「テーマ」「このカテゴリ内を検索」は、ページ内のJSで絞り込む（2026-10-29：/lab と同じ検索レイアウトに変更）
// 旧URL（/blog/category/{slug}・/blog/category/{slug}/2・…/blog・…/resources）は public/_redirects でこのページへ301転送している。
import type { GetStaticPaths } from "astro";
import type { Category } from "@/lib/types";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CategorySectionBlock from "@/components/CategorySectionBlock.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllCategories, getCategoryPath, getCategorySlug } from "@/lib/posts";
import { getCategoryGuide } from "@/lib/library";
import { buildCollectionPageSchema, buildFaqSchema } from "@/lib/schema";

export const getStaticPaths = (() => {
  // URLは英字Slug（未設定ならカテゴリ名を toRouteSlug() したもの）。詳細は getCategorySlug() のコメント参照。
  return getAllCategories().map((category) => ({
    params: { category: getCategorySlug(category.name) },
    props: { category },
  }));
}) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };

const guide = getCategoryGuide(category.name);
const themeSections = guide.sections.filter((s) => s.subcategory !== null);
const categoryPath = getCategoryPath(category.name);

// 資料が無いテーマの右側に出す「関連テーマも活用する」のリンク（同じカテゴリ内で資料があるテーマ。最大3件）
const sectionsWithResources = themeSections.filter((s) => s.resources.length > 0);
function relatedFor(index: number) {
  const self = guide.sections[index];
  if (!self.subcategory || self.resources.length > 0) return [];
  return sectionsWithResources
    .filter((s) => s !== self)
    .slice(0, 3)
    .map((s) => ({
      number: s.number,
      name: s.name,
      anchor: s.anchor,
      direction: (guide.sections.indexOf(s) < index ? "up" : "down") as "up" | "down",
    }));
}

// カテゴリごとのミーアキャット（2026-10-29）。カテゴリ名の語で決める（「戦略・市場分析」に「分析」が含まれるため、戦略を先に判定する）
const MEERKATS: [string, string][] = [
  ["戦略", "/images/meerkat/standing.svg"],
  ["予算", "/images/meerkat/circle.svg"],
  ["KPI", "/images/meerkat/flask-hold.svg"],
  ["組織", "/images/meerkat/parent-child.svg"],
  ["分析", "/images/meerkat/in-flask.svg"],
];
const meerkat = MEERKATS.find(([word]) => category.name.includes(word))?.[1] ?? null;

// 検索の「形式」ボタン（/lab と同じ形。件数はカテゴリ内の重複なしの件数）
const kindFilters = [
  { key: "all", label: "すべて", count: guide.counts.all },
  { key: "post", label: "記事", count: guide.counts.post },
  { key: "resource", label: "無料資料", count: guide.counts.resource },
];

// 構造化データ（カテゴリ = 「そのテーマの総合ページ」。CollectionPage + ItemList、本文にFAQがあればFAQPageも）
const pageTitle = `${category.name}｜カテゴリ一覧`;
const pageDescription = category.description || `${category.name}に関する記事・資料の一覧です。`;
const collectionSchema = buildCollectionPageSchema({
  name: pageTitle,
  description: pageDescription,
  path: categoryPath,
  about: { name: category.name, description: category.description || undefined },
  items: guide.items.map((item) => ({ href: item.href, title: item.title })),
});
const faqSchema = category.blocks ? buildFaqSchema(category.blocks) : null;
const jsonLd = faqSchema ? [collectionSchema, faqSchema] : collectionSchema;

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ライブラリ（記事・資料）", href: "/lab" },
  { name: category.name, href: categoryPath },
];

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/open-graph/default.png"
  jsonLd={jsonLd}
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pt-10 pb-6" data-guide>
    {/* ページ見出し */}
    <div class="flex items-end justify-between gap-6">
      <div class="min-w-0">
        <p class="text-xs font-bold tracking-wider text-ink-950">CATEGORY GUIDE</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">{category.name}</h1>
        <p class="mt-4 text-lg font-bold text-ink-950">記事で理解し、資料で実践する。</p>
        {category.description && <p class="mt-3 text-sm leading-relaxed text-neutral-500 whitespace-pre-line">{category.description}</p>}
      </div>
      {meerkat && <img src={meerkat} alt="" aria-hidden="true" class="h-24 w-24 shrink-0 sm:mr-8 sm:h-36 sm:w-36" />}
    </div>

    {/* いま、取り組みたいテーマは？ */}
    {
      themeSections.length > 0 && (
        <div class="mt-10 flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-5">
          {/* 2026-10-29：テーマを矢羽根で横に並べる（スマホは縦に並べる） */}
          <ul class="flex min-w-0 flex-1 flex-col gap-2 lg:flex-row lg:gap-0">
            {themeSections.map((s, i) => (
              <li class={`min-w-0 lg:flex-1 ${i > 0 ? "lg:-ml-2" : ""}`}>
                <a href={`#${s.anchor}`} class={`chev group block h-full bg-neutral-300 p-px transition-colors hover:bg-ink-950 ${i === 0 ? "chev-first" : ""}`}>
                  <span class={`chev flex h-full items-center gap-4 bg-white py-4 pr-8 pl-4 ${i === 0 ? "chev-first" : "lg:pl-8"}`}>
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink-950 text-sm font-bold tabular-nums text-white">{s.number}</span>
                    <span class="min-w-0">
                      <span class="block text-[15px] font-bold text-ink-950">{s.name}</span>
                      <span class="mt-1 block text-xs text-neutral-500">
                        記事 <span class="font-bold text-ink-950 tabular-nums">{s.posts.length}</span>
                        {s.resources.length > 0 && (
                          <>
                            <span class="mx-1.5 text-neutral-300">/</span>無料資料 <span class="font-bold text-ink-950 tabular-nums">{s.resources.length}</span>
                          </>
                        )}
                      </span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="shrink-0 text-xs leading-relaxed text-neutral-500 lg:w-24">順番に読む必要はありません</p>
        </div>
      )
    }

    {/* 検索・絞り込み（/lab と同じレイアウト。カテゴリの代わりにテーマで絞り込む） */}
    <form data-search-form role="search" class="mt-8 bg-neutral-100 p-4 sm:p-5">
      <div class="flex flex-col gap-2 sm:flex-row">
        <label class="flex flex-1 items-center gap-3 border border-neutral-300 bg-white px-4 py-3">
          <svg class="h-4 w-4 shrink-0 text-neutral-500" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8" /><path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <span class="sr-only">このカテゴリ内を検索</span>
          <input type="search" data-search-input placeholder="このカテゴリ内を検索　例：予算案、ROI、稟議書" class="w-full bg-transparent text-sm text-ink-950 placeholder:text-neutral-400 focus:outline-none" />
        </label>
        <button type="submit" class="bg-ink-950 px-6 py-3 text-sm font-bold text-white hover:opacity-90">検索する</button>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-bold text-ink-950">形式</span>
          <div class="flex gap-1.5" role="group" aria-label="形式で絞り込む">
            {
              kindFilters.map((f) => (
                <button type="button" data-type={f.key} aria-pressed={f.key === "all" ? "true" : "false"} class="border border-neutral-300 bg-white px-3.5 py-2 text-xs font-bold text-ink-950 transition-colors aria-pressed:border-ink-950 aria-pressed:bg-ink-950 aria-pressed:text-white">
                  {f.label} <span class="font-normal tabular-nums">{f.count}</span>
                </button>
              ))
            }
          </div>
        </div>
        {
          guide.sections.length > 1 && (
            <label class="flex items-center gap-3">
              <span class="text-xs font-bold text-ink-950">テーマ</span>
              <select data-theme class="min-w-48 border border-neutral-300 bg-white px-3 py-2 text-xs text-ink-950">
                <option value="">すべてのテーマ</option>
                {guide.sections.map((s) => <option value={s.anchor}>{s.number ? `${s.number} ${s.name}` : s.name}</option>)}
              </select>
            </label>
          )
        }
        <button type="button" data-clear class="text-xs text-neutral-500 underline-offset-2 hover:text-ink-950 hover:underline">条件をクリア</button>
      </div>
    </form>

    <div class="mt-6 text-xs">
      <p class="font-bold text-ink-950" data-status aria-live="polite">{guide.counts.all}件すべてを表示</p>
    </div>

    {/* テーマ（サブカテゴリ）ごとのブロック */}
    <div class="mt-4">
      {
        guide.sections.length > 0 ? (
          guide.sections.map((section, index) => <CategorySectionBlock section={section} related={relatedFor(index)} />)
        ) : (
          <p class="border-t-2 border-ink-950 py-10 text-sm text-neutral-400">このカテゴリにはまだコンテンツがありません。</p>
        )
      }
      <p data-empty hidden class="border-t-2 border-ink-950 py-10 text-sm text-neutral-500">
        条件に合う記事・資料が見つかりませんでした。キーワードを変えるか、「すべて」に戻してください。
      </p>
    </div>

    {/* カテゴリ本文（Notionのマスターカテゴリページに書いた解説・FAQ） */}
    {
      category.blocks && category.blocks.length > 0 && (
        <div class="prose-notion mt-6 w-full border-t border-neutral-300 pt-10">
          <NotionBlocks blocks={category.blocks} />
        </div>
      )
    }
  </div>

  {/* フッター手前の共通ブロック（カテゴリ一覧・タグ一覧 → ご要望・ご質問）。2026-10-15に「ほかのテーマ」から差し替え */}
  <ContactCta />
</BaseLayout>

<script>
  // カテゴリ内検索・「もっと見る」の制御。
  // キーワードを入れている間は、「もっと見る」で隠れている分も含めて条件に合う全件を表示する。
  const root = document.querySelector<HTMLElement>("[data-guide]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const form = root.querySelector<HTMLFormElement>("[data-search-form]");
    const sections = Array.from(root.querySelectorAll<HTMLElement>("[data-section]"));
    const status = root.querySelector<HTMLElement>("[data-status]");
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const normalize = (text: string) => text.normalize("NFKC").toLowerCase().trim();
    // 1つの記事が複数のテーマに出ることがあるため、件数はURLで重複を除いて数える
    const hrefOf = (el: HTMLElement) => (el.matches("a") ? el.getAttribute("href") : el.querySelector("a")?.getAttribute("href")) || "";
    const allCount = new Set(Array.from(root.querySelectorAll<HTMLElement>("[data-item]")).map(hrefOf)).size;

    const typeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-type]"));
    const themeSelect = root.querySelector<HTMLSelectElement>("[data-theme]");
    let kind = "all";
    let theme = "";
    let query = "";

    function render() {
      const words = normalize(query).split(/\s+/).filter(Boolean);
      // active：形式かキーワードで絞り込み中（「もっと見る」で隠れている分も含めて、条件に合う全件を出す）
      const active = kind !== "all" || words.length > 0;
      const matched = new Set<string>();

      for (const section of sections) {
        // テーマを選んでいるときは、そのテーマのブロックだけを出す
        if (theme && section.id !== theme) {
          section.hidden = true;
          continue;
        }
        let sectionHits = 0;
        // 左（main）は記事と資料の混合リスト、右（resource）は代表資料1件
        for (const column of ["main", "resource"]) {
          const columnEl = section.querySelector<HTMLElement>(`[data-column="${column}"]`);
          if (!columnEl) continue;
          const items = Array.from(columnEl.querySelectorAll<HTMLElement>("[data-item]"));
          const list = section.querySelector<HTMLElement>(`[data-list="${column}"]`);
          const expanded = list?.dataset.expanded === "true";
          let columnHits = 0;
          for (const item of items) {
            const text = normalize(item.dataset.search || "");
            const hit = (kind === "all" || kind === item.dataset.kind) && words.every((w) => text.includes(w));
            if (hit) {
              columnHits++;
              matched.add(hrefOf(item));
            }
            item.hidden = active ? !hit : item.hasAttribute("data-extra") && !expanded;
          }
          sectionHits += columnHits;
          const more = section.querySelector<HTMLElement>(`[data-more="${column}"]`);
          if (more) more.hidden = active || expanded;
          columnEl.hidden = active && columnHits === 0;
        }
        section.querySelectorAll<HTMLElement>("[data-related], [data-tools]").forEach((el) => (el.hidden = active));
        section.hidden = active && sectionHits === 0;
      }

      const filtered = active || theme !== "";
      if (status) status.textContent = filtered ? `${matched.size}件を表示` : `${allCount}件すべてを表示`;
      if (empty) empty.hidden = !filtered || matched.size > 0;
    }

    typeButtons.forEach((button) =>
      button.addEventListener("click", () => {
        kind = button.dataset.type || "all";
        typeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        render();
      }),
    );
    themeSelect?.addEventListener("change", () => {
      theme = themeSelect.value;
      render();
    });
    root.querySelector<HTMLButtonElement>("[data-clear]")?.addEventListener("click", () => {
      kind = "all";
      theme = "";
      query = "";
      if (input) input.value = "";
      if (themeSelect) themeSelect.value = "";
      typeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.type === "all")));
      render();
    });

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      query = input?.value || "";
      render();
    });
    input?.addEventListener("input", () => {
      query = input.value;
      render();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((button) =>
      button.addEventListener("click", () => {
        const section = button.closest<HTMLElement>("[data-section]");
        const list = section?.querySelector<HTMLElement>(`[data-list="${button.dataset.more}"]`);
        if (list) list.dataset.expanded = "true";
        render();
      }),
    );
  }
</script>

<style>
  /* テーマの矢羽根（PCだけ。スマホは四角のまま縦に並べる） */
  @media (min-width: 1024px) {
    .chev {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%, 16px 50%);
    }
    .chev-first {
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
    }
  }
</style>
