---
// 「モデル企業の成長期の施策と数字」（/standards/model）。数字の基準の3ページの2ページ目。
// 見出しのアンカー（backcast・cost・judgment・channels・explain・history）は、記事・ツールからリンクするので変えない。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PageIntro from "@/components/standards/PageIntro.astro";
import InPageNav from "@/components/standards/InPageNav.astro";
import SectionHeading from "@/components/standards/SectionHeading.astro";
import DataTable from "@/components/standards/DataTable.astro";
import Note from "@/components/standards/Note.astro";
import StandardsNav from "@/components/standards/StandardsNav.astro";
import { getStandardPage, buildStandardArticleSchema } from "@/lib/standards";

const page = getStandardPage("model");
const overview = getStandardPage("overview");
const metrics = getStandardPage("metrics");

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: overview.title, href: overview.path },
  { name: page.title, href: page.path },
];

const navItems = [
  { num: "01", label: "成長期の目標", anchor: "backcast" },
  { num: "02", label: "成長期の費用", anchor: "cost" },
  { num: "03", label: "成長期の判定", anchor: "judgment" },
  { num: "04", label: "施策・チャネル", anchor: "channels" },
  { num: "05", label: "経営への説明", anchor: "explain" },
];

const linkClass = "text-ink-950 underline underline-offset-2 hover:text-std-sub";
---

<BaseLayout
  title={page.title}
  description={page.description}
  ogImage="/open-graph/default.png"
  jsonLd={buildStandardArticleSchema(page)}
>
  <Breadcrumb items={breadcrumbItems} />

  <article class="mt-6 bg-white">
    <div class="mx-auto max-w-6xl px-5 pb-[72px] pt-14">
      <div class="space-y-8">
        <PageIntro
          label="NUMBERS / GROWTH PHASE"
          title={page.title}
          lead="架空の製造業の成長期（3期目）の数字一式です。MKTG.AXの記事・資料・ツールの記入例は、すべてこのページの数字を使っています。"
          lastUpdated={page.lastUpdated}
        />
        <p class="text-sm leading-[1.85] text-std-sub">
          このページの会社と数字は、すべて架空のものです。業界の平均や目安ではありません。会社の前提は「<a href={overview.path} class={linkClass}
            >{overview.title}</a
          >」、式と判定の基準は「<a href={metrics.path} class={linkClass}>{metrics.title}</a>」にあります。金額の単位は万円です（時間単価を除く）。
        </p>
        <InPageNav items={navItems} />
      </div>

      <!-- 01 成長期の目標 -->
      <section id="backcast" class="mt-16 scroll-mt-24 space-y-6">
        <SectionHeading
          num="01"
          title="成長期の目標の逆算"
          lead="全社の売上目標152,500から、マーケ経由の売上目標3,000を出し、受注12件・商談42件・リード285件を逆算します。率は今期の実績です。"
        />
        <DataTable
          title="表3 成長期の目標の逆算（架空の会社の記入例）"
          head={["段階", "式", "結果"]}
          widths={["22%", "62%", "16%"]}
          minWidth="40rem"
          strongCols={[2]}
          rows={[
            ["新規の売上目標", "全社の売上目標152,500 − 既存顧客の売上138,000", "14,500"],
            ["マーケ経由の売上目標", "新規の売上目標14,500 − 紹介・営業の開拓の見込み11,500（46件 × 250）", "3,000"],
            ["受注件数", "マーケ経由の売上目標3,000 ÷ 平均単価250", "12件"],
            ["商談数", "受注12 ÷ 受注率28.6%（今期の実績：受注12 ÷ 商談42）", "42件"],
            ["リード数", "商談42 ÷ 商談化率14.7%（今期の実績：商談42 ÷ リード285）", "285件"],
          ]}
        />
        <p class="text-sm leading-[1.85] text-std-sub">
          式と率の取り方は、数字の定義の<a href={`${metrics.path}#backcast`} class={linkClass}>目標の逆算</a>にあります。
        </p>
        <!-- TODO（B-04公開後に入れる）：逆算の進め方はB-04で詳しく説明しています -->
        <!-- TODO（予算シミュレーターの修正後に入れる）：自社の目標から逆算するなら、予算シミュレーター -->
      </section>

      <!-- 02 成長期の費用 -->
      <section id="cost" class="mt-16 scroll-mt-24 space-y-6">
        <SectionHeading
          num="02"
          title="成長期の費用（人件費込み）"
          lead="成長期の費用は、外部費用910と人件費370の合計1,280です。人件費は、施策にかける時間の割合で施策に配ります。"
        />
        <div class="flex" role="img" aria-label="費用1,280万円の内訳：外部費用910万円、人件費370万円">
          <div class="flex min-w-0 flex-col gap-2 bg-ink-950 p-6" style="flex:910 1 0%">
            <p class="text-sm text-white">外部費用</p>
            <p class="text-[1.75rem] font-semibold leading-tight text-white sm:text-[2.125rem]">910</p>
          </div>
          <div class="flex min-w-0 flex-col gap-2 bg-std-bar p-6" style="flex:370 1 0%">
            <p class="text-sm text-ink-950">人件費</p>
            <p class="text-[1.75rem] font-semibold leading-tight text-ink-950 sm:text-[2.125rem]">370</p>
          </div>
        </div>
        <DataTable
          title="表4 成長期の費用（架空の会社の記入例）"
          head={["項目", "金額"]}
          minWidth="20rem"
          total
          rows={[
            ["外部費用", "910"],
            ["人件費", "370"],
            ["費用合計", "1,280"],
          ]}
        />
        <p class="leading-[1.85] text-std-sub">
          人件費370は、施策と共通の作業にかけた年950時間に、人ごとの時間単価をかけたものです。施策に協力する営業の時間も含めています。
        </p>
        <div class="bg-std-bg p-6 sm:p-8">
          <h3 class="text-[1.1875rem] font-bold text-ink-950">施策の人件費の配り方</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-[1.85] text-std-sub">
            <li>施策の人件費＝その施策にかける時間の割合 × 人件費370</li>
            <li>時間の割合は、施策の時間の合計742時間に対する、その施策の時間の割合です</li>
            <li>
              共通の作業（集計・報告96時間、営業との連携72時間、予算づくり40時間）は、施策の時間の比で配ります。742時間は、共通の作業を配る前の時間です
            </li>
          </ul>
          <hr class="my-5 border-std-line" />
          <p class="leading-[1.85] text-ink-950">例（架空の会社の例）：370 × 展示会の時間120 ÷ 742 ＝ 人件費60</p>
        </div>
        <p class="text-sm leading-[1.85] text-std-sub">
          配り方の定義は、数字の定義の<a href={`${metrics.path}#labor-allocation`} class={linkClass}>施策ごとの人件費の配り方</a>にあります。
        </p>
        <!-- TODO（予算案チェッカー公開後に入れる）：人件費の配り方は予算案チェッカーで自動で計算できます -->
      </section>

      <!-- 03 成長期の判定 -->
      <section id="judgment" class="mt-16 scroll-mt-24 space-y-6">
        <SectionHeading
          num="03"
          title="成長期の判定"
          lead="成長期の全体は、CAC 107、回収期間12.8か月、1年のROI −6%です。CACの上限150・許容CPL 6.3で判定すると、上限を超えるのは新しい業種向けの試行と、チャネルで見たメール・セミナーです。"
        />
        <DataTable
          title="表5 成長期の全体の判定（架空の会社の記入例）"
          head={["指標", "式", "結果"]}
          widths={["22%", "62%", "16%"]}
          minWidth="36rem"
          strongCols={[2]}
          rows={[
            ["CAC", "1,280 ÷ 12", "107"],
            ["回収期間", "107 ÷（100 ÷ 12）", "12.8か月"],
            ["ROI（1年）", "（3,000 × 40% − 1,280）÷ 1,280", "−6%"],
            ["CACの上限", "年間粗利100 × 取り返す年数1.5年", "150"],
            ["許容CPL", "150 × 商談化率14.7% × 受注率28.6%", "6.3"],
          ]}
        />
        <p class="text-sm leading-[1.85] text-std-sub">
          取り返す年数1.5年は、記入例として決めた値です。計算は丸める前の値で行い、結果だけを丸めて示しています。
        </p>
      </section>

      <!-- 04 施策・チャネル -->
      <section id="channels" class="mt-16 scroll-mt-24 space-y-6">
        <SectionHeading
          num="04"
          title="施策別・チャネル別の判定"
          lead="施策ごとに見ると上限を超えるのは、新しい業種向けLP＋広告（試行）だけです。共通の費用を含めてチャネルで見ると、メール・セミナーも上限を超えます。"
        />
        <DataTable
          title="表6 成長期の施策別（人件費込み・架空の会社の記入例）"
          head={[
            "施策",
            "チャネル",
            "時間",
            "時間の割合",
            "外部費用",
            "人件費",
            "費用合計",
            "リード",
            "受注",
            "受注金額",
            "CPL",
            "CAC",
            "回収期間（か月）",
            "ROI（1年）",
            "判定",
          ]}
          size="sm"
          minWidth="84rem"
          widths={["15rem", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]}
          stickyFirst
          strongCols={[14]}
          total
          rows={[
            ["業界展示会（年1回・10月）", "展示会", "120", "16.2%", "280", "60", "340", "120", "3", "900", "2.8", "113", "13.6", "6%", "上限内"],
            ["リスティング広告", "Web広告", "48", "6.5%", "240", "24", "264", "50", "3", "600", "5.3", "88", "10.6", "−9%", "上限内"],
            ["自社サイトの保守・更新", "自社サイト", "72", "9.7%", "36", "36", "72", "―", "―", "―", "―", "―", "―", "―", "―"],
            ["MAツール（運用・メルマガを含む）", "メール・セミナー", "240", "32.3%", "84", "119", "203", "―", "―", "―", "―", "―", "―", "―", "―"],
            ["記事・事例・ホワイトペーパー制作", "自社サイト", "112", "15.1%", "120", "56", "176", "60", "3", "750", "2.9", "59", "7.0", "70%", "上限内"],
            ["ウェビナー（年4回）", "メール・セミナー", "120", "16.2%", "60", "60", "120", "40", "3", "750", "3.0", "40", "4.8", "150%", "上限内"],
            ["新しい業種向けLP＋広告（試行）", "Web広告", "30", "4.0%", "90", "15", "105", "15", "0", "0", "7.0", "―", "―", "−100%", "上限超え"],
            ["合計", "", "742", "100%", "910", "370", "1,280", "285", "12", "3,000", "4.5", "107", "12.8", "−6%", "上限内"],
          ]}
        />
        <ul class="list-disc space-y-1.5 pl-5 text-sm leading-[1.85] text-std-sub">
          <li>時間は、共通の作業を配る前の施策の時間です</li>
          <li>人件費370は、営業の協力を含みます。施策ごとの人件費は、合計が370に合うように丸めています（MAツールは119.7を119としています）</li>
          <li>自社サイトの保守・更新とMAツールは、リード・受注を施策に割り当てていないため、施策としては判定しません</li>
          <li>回収期間は、チャネルを問わず全社の1社あたりの月の粗利8.3で計算しています</li>
        </ul>

        <div class="pt-4">
          <DataTable
            title="表7 成長期のチャネル別（人件費込み・架空の会社の記入例）"
            head={[
              "チャネル",
              "外部費用",
              "人件費",
              "費用合計",
              "リード",
              "商談",
              "受注",
              "受注金額",
              "CPL",
              "CAC",
              "回収期間（か月）",
              "ROI（1年）",
              "判定",
            ]}
            size="sm"
            minWidth="68rem"
            stickyFirst
            strongCols={[12]}
            total
            rows={[
              ["展示会", "280", "60", "340", "120", "12", "3", "900", "2.8", "113", "13.6", "6%", "上限内"],
              ["Web広告", "330", "39", "369", "65", "11", "3", "600", "5.7", "123", "14.8", "−35%", "上限内"],
              ["自社サイト", "156", "92", "248", "60", "9", "3", "750", "4.1", "83", "9.9", "21%", "上限内"],
              ["メール・セミナー", "144", "179", "323", "40", "10", "3", "750", "8.1", "108", "12.9", "−7%", "上限超え"],
              ["合計", "910", "370", "1,280", "285", "42", "12", "3,000", "4.5", "107", "12.8", "−6%", "上限内"],
            ]}
          />
        </div>
        <Note title="ウェビナー単体は上限内。MAツールを含めたチャネルでは上限超え。">
          メール・セミナーは、ウェビナー単体なら上限内です。ところが、MAツールの費用を含めたチャネルで見ると、CPLが許容CPLを超えてしまいます。CACは108で上限150の内ですが、受注3件で出した数字のため、1件の差で大きく変わります。そのため判定は、全体の率で出した許容CPLとの比較で行っています。
        </Note>
        <p class="text-sm leading-[1.85] text-std-sub">
          判定の基準は、数字の定義の<a href={`${metrics.path}#cac-limit`} class={linkClass}>CACの上限</a>・<a
            href={`${metrics.path}#allowable-cpl`}
            class={linkClass}>許容CPL</a
          >・<a href={`${metrics.path}#judgment`} class={linkClass}>施策の判定</a>にあります。
        </p>
        <!-- TODO（予算案チェッカー公開後に入れる）：自社の予算案を施策・チャネルごとに判定するなら、予算案チェッカー -->
      </section>

      <!-- 05 経営への説明 -->
      <section id="explain" class="mt-16 scroll-mt-24 space-y-6">
        <SectionHeading
          num="05"
          title="経営への説明の例"
          lead="成長期の数字を、回収期間を主役にして経営に説明する一文の例です。1年のROIは並べて示します。"
        />
        <figure class="flex flex-col gap-4 border-l-[3px] border-ink-950 bg-std-bg p-6 sm:p-8">
          <figcaption class="text-[0.8125rem] font-bold text-std-mute">経営への説明例 / 成長期</figcaption>
          <blockquote class="text-lg leading-[1.89] text-ink-950 sm:text-[1.3125rem]">
            来期は、マーケ経由の新規1社の獲得に人件費込みで107万円かかり、その1社の粗利で12.8か月で取り返せます。1年のROIは−6%ですが、1社あたりの費用は、1年半で取り返せる上限の150万円の内に収まっています。
          </blockquote>
        </figure>
        <p class="text-sm leading-[1.85] text-std-sub">
          説明の順番は、数字の定義の<a href={`${metrics.path}#explain`} class={linkClass}>経営への説明の順番</a>にあります。
        </p>
        <!-- TODO（D-01公開後に入れる）：経営への説明の組み立てはD-01で詳しく -->
        <!-- TODO（予算案チェッカー公開後に入れる）：自社の回収期間・ROIを出すなら、予算案チェッカー -->
        <!-- TODO（ツール・資料のリンクが入ったら、この下に「自社の数字で計算する」の節を戻す。予算案チェッカー／予算シミュレーター／M-B-03／M-B-04） -->
      </section>

      <!-- 06 更新履歴 -->
      <section id="history" class="mt-16 scroll-mt-24 space-y-5">
        <SectionHeading num="06" title="更新履歴" lead="このページの数字を変えたときに記録します。" />
        <DataTable
          caption="更新履歴"
          head={["日付", "内容"]}
          widths={["30%", "70%"]}
          minWidth="20rem"
          rows={[
            ["2026-10-21", "会社の前提と3つの時期を「モデル企業の全体像」に分けた"],
            ["2026-10-20", "公開"],
          ]}
        />
      </section>

      <StandardsNav current="model" />
    </div>
  </article>
</BaseLayout>
