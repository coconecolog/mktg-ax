---
// 「数字の基準」の入口（/standards）。2ページへの案内だけを置く（同じ中身は書かない）。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { buildCollectionPageSchema } from "@/lib/schema";
import { getStandardPages } from "@/lib/standards";

const pages = getStandardPages();

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "数字の基準", href: "/standards" },
];

const pageDescription = "MKTG.AXの記事・資料・ツールが使う、KPI・予算の数字の定義と、記入例に使う架空の会社の数字一式です。";

const jsonLd = buildCollectionPageSchema({
  name: "数字の基準",
  description: pageDescription,
  path: "/standards",
  items: pages.map((p) => ({ href: p.path, title: p.title })),
});
---

<BaseLayout title="数字の基準" description={pageDescription} ogImage="/open-graph/default.png" jsonLd={jsonLd}>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-3xl px-5 pb-20 pt-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink-950 sm:text-4xl">数字の基準</h1>
    <p class="mt-4 leading-relaxed text-neutral-600">{pageDescription}</p>

    <ul class="mt-10 space-y-4">
      {
        pages.map((p) => (
          <li>
            <a
              href={p.path}
              class="block rounded-2xl border border-neutral-200 bg-white p-6 transition-colors hover:border-neutral-400"
            >
              <span class="block text-lg font-bold text-ink-950">{p.title}</span>
              <span class="mt-2 block text-sm leading-relaxed text-neutral-600">{p.description}</span>
              <span class="mt-3 block text-xs text-neutral-400">最終更新日：{p.lastUpdated}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
