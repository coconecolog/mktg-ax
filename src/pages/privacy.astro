---
// 個人情報保護方針（プライバシーポリシー）ページ。
// 文面の正本は Googleドキュメント「個人情報保護方針」。文面を変えるときは、ドキュメントと合わせてこのファイルの各セクションと lastUpdated を書き換えてください。
// 注意: 法律の専門家によるチェックを受けてから正式公開することを推奨します。
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE_NAME } from "@/consts";

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "個人情報保護方針", href: "/privacy" },
];

const lastUpdated = "2026年10月12日";

const intro = `${SITE_NAME}（以下「当サイト」といいます）は、ご利用いただく皆様の個人情報の重要性を認識し、個人情報の保護に関する法律その他の関連法令等を遵守し、個人情報を適切に取得・利用・管理いたします。`;

const sectionsBeforeCookie = [
  {
    heading: "1. 個人情報を取得する場面",
    body: "当サイトは、以下の場面で個人情報を取得します。",
    list: [
      "お問い合わせフォームからお問い合わせいただく場合",
      "資料（ホワイトペーパー）のダウンロードをお申し込みいただく場合",
      "当サイトの閲覧時に、アクセス解析ツールを通じて自動的に取得する場合",
    ],
  },
  {
    heading: "2. 利用目的",
    body: "取得した個人情報は、以下の目的の範囲内で利用します。",
    list: [
      "お問い合わせへの回答、必要な連絡を行うため",
      "お申し込みいただいた資料（ホワイトペーパー）をお届けするため",
      "当サイトのコンテンツ・サービスの改善、利用状況の分析のため",
      "上記利用目的に付随する目的のため",
    ],
  },
  {
    heading: "3. 第三者提供について",
    body: "当サイトは、あらかじめご本人の同意を得ずに、取得した個人情報を第三者に提供することはありません。ただし、以下の場合はこの限りではありません。",
    list: [
      "法令に基づく場合",
      "人の生命、身体又は財産の保護のために必要がある場合であって、ご本人の同意を得ることが困難であるとき",
      "国の機関もしくは地方公共団体又はその委託を受けた者が法令の定める事務を遂行することに対して協力する必要がある場合",
    ],
  },
];

// 4. Cookie・アクセス解析ツール（電気通信事業法の外部送信規律に対応：送信先・送信される情報・利用目的を記載）
const analyticsTools = [
  {
    name: "Google アナリティクス（GA4）",
    company: "Google LLC",
    info: "閲覧したページのURL、参照元、閲覧日時、IPアドレス、端末・ブラウザの種類、Cookie ID",
    purpose: "当サイトのアクセス状況の分析",
    policyLabel: "Google のプライバシーポリシー",
    policyUrl: "https://policies.google.com/privacy",
    optOutLabel: "Google アナリティクス オプトアウト アドオン",
    optOutUrl: "https://tools.google.com/dlpage/gaoptout",
  },
  {
    name: "Microsoft Clarity",
    company: "Microsoft Corporation",
    info: "閲覧したページのURL、クリック・スクロール・マウスの動きなどの操作、端末・ブラウザの種類、Cookie ID",
    purpose: "ページの使いやすさの分析・改善",
    policyLabel: "Microsoft のプライバシーステートメント",
    policyUrl: "https://privacy.microsoft.com/ja-jp/privacystatement",
    optOutLabel: "",
    optOutUrl: "",
  },
];

// 5. 安全管理措置（個人情報保護法で公表が求められる、講じている措置の内容）
const securityMeasures = [
  {
    label: "基本方針の策定",
    text: "本方針を定め、関係法令の遵守、お問い合わせ窓口などを明らかにしています。",
  },
  {
    label: "組織的な措置",
    text: "個人情報の取り扱いの責任者を定め、漏えい等が起きた場合、または起きたおそれがある場合の報告・連絡の体制を整えています。",
  },
  {
    label: "人的な措置",
    text: "個人情報を取り扱う運営メンバーに、取り扱いの注意事項を周知し、守秘を徹底しています。",
  },
  {
    label: "物理的な措置",
    text: "個人情報を取り扱う端末の盗難・紛失を防ぎ、第三者から画面が見えないようにしています。",
  },
  {
    label: "技術的な措置",
    text: "個人情報にアクセスできる者を必要な範囲に限り、2段階認証を使い、OSやソフトウェアを最新の状態に保っています。",
  },
  {
    label: "外的環境の把握",
        text: "個人情報は、米国の事業者が提供するクラウドサービスを利用し、日本国内のサーバーに保存しています。また、メールの送信には米国の事業者が提供するサービスを利用しています。米国の個人情報の保護に関する制度を把握したうえで、安全管理のための措置を講じます。",
  },
];

const sectionsAfterSecurity = [
  {
    heading: "6. 個人情報の開示・訂正・利用停止等の請求について",
    body: "ご本人からの個人情報の開示、訂正、追加、削除、利用停止等のご請求については、下記「お問い合わせ窓口」より受け付けます。ご本人確認のうえ、法令に従い、合理的な期間内に対応いたします。",
  },
  {
    heading: "7. 本方針の変更について",
    body: "当サイトは、法令の変更や運用状況の変化等に応じて、本方針の内容を予告なく変更することがあります。変更後の内容は、本ページに掲載した時点から効力を生じるものとします。",
  },
];
---

<BaseLayout
  title="個人情報保護方針"
  description={`${SITE_NAME}の個人情報保護方針（プライバシーポリシー）のご案内です。`}
  ogImage="/open-graph/default.png"
  noindex
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-3xl px-5 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">個人情報保護方針</h1>
    <p class="mt-4 leading-relaxed text-neutral-600">{intro}</p>

    {
      sectionsBeforeCookie.map((section) => (
        <div class="mt-10">
          <h2 class="text-lg font-bold text-ink-950">{section.heading}</h2>
          <p class="mt-3 leading-relaxed text-neutral-600">{section.body}</p>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-neutral-600">
            {section.list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="mt-10">
      <h2 class="text-lg font-bold text-ink-950">4. Cookie・アクセス解析ツールについて</h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        当サイトでは、サービス向上のため、以下のアクセス解析ツールを利用しています。これらのツールは、Cookie等を利用して、ご利用者の端末から以下の事業者に情報を送信します。送信される情報は、それだけで特定の個人を識別するものではありません。取得されたデータは、各ツール提供事業者のプライバシーポリシーに基づいて管理されます。
      </p>
      <ul class="mt-3 list-disc space-y-4 pl-5 text-sm leading-relaxed text-neutral-600">
        {
          analyticsTools.map((tool) => (
            <li>
              <span class="font-bold text-neutral-700">{tool.name}</span>
              <dl class="mt-1.5 space-y-1">
                <div>
                  <dt class="inline font-bold text-neutral-700">送信先：</dt>
                  <dd class="inline">{tool.company}</dd>
                </div>
                <div>
                  <dt class="inline font-bold text-neutral-700">送信される情報：</dt>
                  <dd class="inline">{tool.info}</dd>
                </div>
                <div>
                  <dt class="inline font-bold text-neutral-700">利用目的：</dt>
                  <dd class="inline">{tool.purpose}</dd>
                </div>
                <div>
                  <dt class="inline font-bold text-neutral-700">詳細：</dt>
                  <dd class="inline">
                    <a href={tool.policyUrl} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{tool.policyLabel}</a>
                    をご確認ください。
                  </dd>
                </div>
                {tool.optOutUrl && (
                  <div>
                    <dt class="inline font-bold text-neutral-700">送信の停止：</dt>
                    <dd class="inline">
                      <a href={tool.optOutUrl} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{tool.optOutLabel}</a>
                      で停止できます。
                    </dd>
                  </div>
                )}
              </dl>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm leading-relaxed text-neutral-600">
        ブラウザの設定によりCookieを無効化することで、これらのツールによるデータ収集を拒否することができます。無効化した場合、当サイトの一部機能がご利用いただけなくなる場合があります。
      </p>
    </div>

    <div class="mt-10">
      <h2 class="text-lg font-bold text-ink-950">5. 安全管理措置</h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        当サイトは、取得した個人情報の漏えい、滅失又はき損の防止その他の個人情報の安全管理のために、以下の措置を講じます。
      </p>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-neutral-600">
        {
          securityMeasures.map((measure) => (
            <li>
              <span class="font-bold text-neutral-700">{measure.label}：</span>
              {measure.text}
            </li>
          ))
        }
      </ul>
    </div>

    {
      sectionsAfterSecurity.map((section) => (
        <div class="mt-10">
          <h2 class="text-lg font-bold text-ink-950">{section.heading}</h2>
          <p class="mt-3 leading-relaxed text-neutral-600">{section.body}</p>
        </div>
      ))
    }

    <div class="mt-10">
      <h2 class="text-lg font-bold text-ink-950">8. お問い合わせ窓口</h2>
      <p class="mt-3 leading-relaxed text-neutral-600">
        本方針及び個人情報の取り扱いに関するお問い合わせは、下記までご連絡ください。運営者の住所・代表者の氏名は、お問い合わせいただければ遅滞なく回答します。
      </p>
      <p class="mt-3 text-sm font-bold text-neutral-700">{SITE_NAME} 運営事務局</p>
      <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-neutral-600">
        <li>
          <a href="/contact" class="text-brand-700 hover:underline">お問い合わせフォームはこちら</a>
        </li>
      </ul>
    </div>

    <p class="mt-12 text-right text-xs text-neutral-400">最終更新日：{lastUpdated}</p>
  </section>
</BaseLayout>
