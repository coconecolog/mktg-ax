---
// トップページ。文言・リンクは src/data/home.ts にまとめています（文言の修正はそちらだけでOK）。
// 構成: ヒーロー → 共通基準（黒い帯） → 01 注力テーマ → 02 課題から探す → 計画から改善、報告まで → 03 新着記事 → 04 ご要望・ご質問
// ・01: HOME_FOCUS.category のサブカテゴリ（STEP）と代表記事、ツール、記事・資料の新着を表示。
// ・02: Notionのカテゴリ（並び順）と、カテゴリごとのサブカテゴリを自動で表示。
// ・03: 記事を新しい順に自動表示（件数は HOME_LATEST.count）。
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLibraryItems, getLibraryItemsByCategory } from "@/lib/library";
import {
  getAllCategories,
  getAllPosts,
  getCategoryPath,
  getSubcategoriesByCategory,
  getSubcategoryPath,
} from "@/lib/posts";
import { getResourceById, getResourceBySlug } from "@/lib/resources";
import { SITE_NAME, SITE_DESCRIPTION } from "@/consts";
import { buildOrganizationSchema } from "@/lib/schema";
import { HOME_HERO, HOME_STANDARDS, HOME_FOCUS, HOME_ISSUES, HOME_PDCA, HOME_LATEST, HOME_REQUEST } from "@/data/home";

const organizationSchema = buildOrganizationSchema();

function formatDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
}

function readTimeOf(metaLabel: string | null): string | null {
  return metaLabel ? metaLabel.replace(/^◷\s*/, "") : null;
}

// ===== 01 注力テーマ =====
const focusItems = getLibraryItemsByCategory(HOME_FOCUS.category);
const allPosts = getAllPosts();

// STEP: サブカテゴリ（並び順）＋ 代表記事 →（なければ）代表資料 →（なければ）そのサブカテゴリの新しい記事・資料
const focusSteps = getSubcategoriesByCategory(HOME_FOCUS.category)
  .slice(0, HOME_FOCUS.stepCount)
  .map((sub) => {
    let link: { kind: "post" | "resource"; title: string; href: string } | null = null;
    const repPost = sub.representativePostId ? allPosts.find((p) => p.id === sub.representativePostId) : undefined;
    if (repPost) {
      link = { kind: "post", title: repPost.title, href: `/blog/${repPost.slug}` };
    } else {
      const repResource = sub.representativeResourceId ? getResourceById(sub.representativeResourceId) : undefined;
      if (repResource) {
        link = { kind: "resource", title: repResource.title, href: `/resources/${repResource.slug}` };
      } else {
        const latest = focusItems.find((item) => item.subcategoryIds.includes(sub.id));
        if (latest) link = { kind: latest.kind, title: latest.title, href: latest.href };
      }
    }
    return { name: sub.name, href: getSubcategoryPath(sub), link };
  });

// ツール＋関連資料（resourceSlug の資料が見つからないときは資料の枠を出さない）
const focusTools = HOME_FOCUS.tools.map((tool) => ({
  ...tool,
  resource: tool.resourceSlug ? getResourceBySlug(tool.resourceSlug) : undefined,
}));

// このテーマの新着（記事・資料）
const focusLatest = focusItems.slice(0, HOME_FOCUS.latestCount).map((item) => ({
  ...item,
  readTime: readTimeOf(item.metaLabel),
}));
const focusCategoryPath = getCategoryPath(HOME_FOCUS.category);

// ===== 02 課題から探す =====
const issueCategories = [...getAllCategories()]
  .sort((a, b) => (a.order ?? Number.MAX_SAFE_INTEGER) - (b.order ?? Number.MAX_SAFE_INTEGER))
  .map((c) => ({
    name: c.name,
    href: getCategoryPath(c.name),
    subs: getSubcategoriesByCategory(c.name)
      .slice(0, HOME_ISSUES.subcategoryCount)
      .map((s) => ({ name: s.name, href: getSubcategoryPath(s) })),
  }));

// カテゴリのアイコン（並び順の1番目から順に使う。足りないときは最初に戻る）
const ISSUE_ICONS = [
  // 戦略・市場分析
  '<rect x="4" y="4" width="11" height="11"/><path d="M9.5 7v6M6.5 10h6"/><path d="M15 15l5 5"/>',
  // 予算配分・投資判断
  '<rect x="3" y="4" width="8" height="8"/><path d="M5.5 8h3"/><circle cx="17" cy="15" r="4"/><path d="M17 13v4M15 15h4"/>',
  // KPI・効果測定
  '<rect x="9" y="3" width="6" height="4"/><rect x="3" y="16" width="6" height="4"/><rect x="15" y="16" width="6" height="4"/><path d="M12 7v4M6 16v-5h12v5"/>',
  // データ分析・AI活用
  '<path d="M3 4h18l-7 8v6l-4 2v-8z"/><path d="M6 8h12"/>',
  // 組織・人材育成
  '<circle cx="7" cy="8" r="3"/><circle cx="17" cy="8" r="3"/><path d="M2 20c0-3 2-5 5-5s5 2 5 5M12 20c0-3 2-5 5-5s5 2 5 5"/>',
];

// ===== 03 新着記事 =====
const latestPosts = getLibraryItems("post")
  .slice(0, HOME_LATEST.count)
  .map((item) => ({ ...item, readTime: readTimeOf(item.metaLabel) }));
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION} ogImage="/open-graph/default.png" pagefindIgnore jsonLd={organizationSchema}>
  <div class="bg-white text-ink-950">
    {/* ===== ヒーロー ===== */}
    <section>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-14 md:pt-20 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-16">
        <div>
          <p class="flex items-center gap-3 text-sm font-bold">
            <span class="h-[3px] w-6 bg-ink-950" aria-hidden="true"></span>
            {HOME_HERO.eyebrow}
          </p>
          <h1 class="mt-6 text-[1.85rem] font-extrabold leading-[1.35] tracking-tight md:text-5xl md:leading-[1.3]">
            {HOME_HERO.titleLines.map((line) => (
              <span class="block">{line}</span>
            ))}
          </h1>
          <p class="mt-7 text-[0.95rem] leading-[1.95] text-neutral-700">
            {HOME_HERO.descriptionLines.map((line) => (
              <span class="md:block">{line}</span>
            ))}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={HOME_HERO.primaryCta.href} class="inline-flex items-center gap-4 border border-ink-950 bg-ink-950 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-neutral-800">
              {HOME_HERO.primaryCta.label}
              <span aria-hidden="true">→</span>
            </a>
            <a href={HOME_HERO.secondaryCta.href} class="inline-flex items-center gap-4 border border-neutral-300 bg-white px-6 py-3.5 text-sm font-bold text-ink-950 transition-colors hover:border-ink-950">
              {HOME_HERO.secondaryCta.label}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {/* 右の画像（画像と下のテキストリンクは、どちらも HOME_HERO.imageLink.href へ） */}
        <div class="mx-auto w-full max-w-[400px]">
          <a href={HOME_HERO.imageLink.href} class="block transition-opacity hover:opacity-80" aria-hidden="true" tabindex="-1">
            <img src={HOME_HERO.image.src} alt={HOME_HERO.image.alt} width="484" height="475" class="h-auto w-full" />
          </a>
          <a href={HOME_HERO.imageLink.href} class="group mt-4 flex items-center justify-between gap-4 border-t border-neutral-300 pt-4 text-sm font-bold">
            <span class="group-hover:underline">{HOME_HERO.imageLink.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* ===== 共通基準（黒い帯） ===== */}
    <section class="bg-ink-950 text-white">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:py-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,2.3fr)] lg:gap-12">
        <div>
          <p class="text-xs font-bold text-white/70">{HOME_STANDARDS.eyebrow}</p>
          <p class="mt-4 text-xl font-extrabold leading-[1.6] md:text-2xl lg:text-[1.4rem]">
            {HOME_STANDARDS.headingLines.map((line) => (
              <span class="block">{line}</span>
            ))}
          </p>
        </div>
        <div class="grid divide-y divide-white/20 sm:grid-cols-3 sm:divide-y-0">
          {HOME_STANDARDS.items.map((item) => (
            <a href={item.link.href} class="group flex flex-col py-5 sm:border-l sm:border-white/20 sm:py-0 sm:pl-6 sm:pr-6 sm:last:pr-0">
              <p class="text-xs font-bold text-white/70">{item.label}</p>
              <p class="mt-3 text-[0.95rem] font-extrabold leading-relaxed text-white">{item.title}</p>
              <span class="mt-auto inline-flex items-center justify-between gap-4 border-b border-white/40 pb-2 pt-6 text-sm font-bold text-white group-hover:border-white">
                {item.link.label}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ===== 01 注力テーマ（HOME_FOCUS.visible が false のときは表示しない） ===== */}
    {HOME_FOCUS.visible && (
    <section id="focus" class="scroll-mt-20 border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        <p class="flex items-center gap-3 text-xs font-bold text-neutral-500">
          {HOME_FOCUS.eyebrow}
          <span class="bg-ink-950 px-2 py-0.5 text-white">{HOME_FOCUS.badge}</span>
        </p>
        <h2 class="mt-4 text-2xl font-extrabold tracking-tight md:text-[2rem]">{HOME_FOCUS.heading}</h2>

        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.3fr)]">
          {/* ツール */}
          {focusTools.map((tool) => (
            <div class="flex flex-col border border-neutral-300 bg-white p-6 md:p-7">
              <p class="text-xs font-bold text-neutral-500">{tool.label}</p>
              <h3 class="mt-2 text-xl font-extrabold leading-snug">
                <a href={tool.cta.href} class="hover:underline">{tool.name}</a>
              </h3>
              <p class="mt-4 text-sm leading-[1.9] text-neutral-700">{tool.description}</p>
              {tool.note && <p class="mt-4 bg-neutral-100 p-4 text-xs leading-relaxed text-neutral-700">{tool.note}</p>}
              {/* 関連資料（tools の resourceSlug。資料DBから題名・公開日・説明を表示） */}
              {tool.resource && (
                <div class="mt-6 grid grid-cols-[72px_minmax(0,1fr)] gap-4">
                  <a href={`/resources/${tool.resource.slug}`} class="block" aria-hidden="true" tabindex="-1">
                    <div class="aspect-[3/4] w-full border border-neutral-200 bg-white p-2">
                      <p class="text-[0.45rem] font-bold">MKTG.AX</p>
                      <div class="mt-1 h-[2px] bg-ink-950"></div>
                      <p class="mt-1.5 line-clamp-4 text-[0.55rem] font-extrabold leading-snug">{tool.resource.title}</p>
                      <div class="mt-1.5 space-y-1" aria-hidden="true">
                        <div class="h-1 bg-neutral-100"></div>
                        <div class="h-1 bg-neutral-100"></div>
                      </div>
                    </div>
                  </a>
                  <div class="min-w-0">
                    <p class="text-xs text-neutral-500">
                      {HOME_FOCUS.resourceTypeLabel}　/　{formatDate(tool.resource.publishedAt)}
                    </p>
                    <p class="mt-1.5 font-extrabold leading-snug">
                      <a href={`/resources/${tool.resource.slug}`} class="hover:underline">{tool.resource.title}</a>
                    </p>
                    {tool.resource.description && (
                      <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-neutral-600">{tool.resource.description}</p>
                    )}
                    <a href={`/resources/${tool.resource.slug}`} class="mt-2 inline-flex items-center gap-2 text-sm font-bold hover:underline">
                      {HOME_FOCUS.resourceCtaLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              )}
              <div class="mt-auto pt-6">
                <a href={tool.cta.href} class="flex items-center justify-between gap-4 bg-ink-950 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-neutral-800">
                  {tool.cta.label}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))}

          {/* STEP（サブカテゴリと代表記事） */}
          <div class="grid gap-4 md:col-span-2 lg:col-span-1">
            {focusSteps.map((step, i) => (
              <div class="border border-neutral-300 bg-white p-5 md:p-6">
                <p class="flex items-baseline gap-3">
                  <span class="shrink-0 text-xs font-bold text-neutral-500">{HOME_FOCUS.stepLabel} {String(i + 1).padStart(2, "0")}</span>
                  {step.href ? (
                    <a href={step.href} class="font-extrabold leading-snug hover:underline md:text-lg">{step.name}</a>
                  ) : (
                    <span class="font-extrabold leading-snug md:text-lg">{step.name}</span>
                  )}
                </p>
                {step.link && (
                  <a href={step.link.href} class="group mt-3 flex items-start gap-3 text-sm">
                    <span class="mt-[0.15em] shrink-0 border border-ink-950 px-1.5 text-[0.7rem] font-bold leading-snug">
                      {step.link.kind === "post" ? HOME_FOCUS.postTag : HOME_FOCUS.resourceTag}
                    </span>
                    <span class="line-clamp-2 leading-relaxed group-hover:underline">{step.link.title}</span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>

        {/* このテーマの新着（記事・資料） */}
        {
          focusLatest.length > 0 && (
            <div class="mt-12 grid gap-4 md:grid-cols-[160px_minmax(0,1fr)] md:gap-10">
              <p class="text-xs font-bold text-neutral-500 md:pt-6">{HOME_FOCUS.latestLabel}</p>
              <ul class="border-t border-neutral-200">
                {focusLatest.map((item) => (
                  <li class="border-b border-neutral-200">
                    <a href={item.href} class="group grid gap-3 py-5 md:grid-cols-[110px_minmax(0,1fr)_24px] md:gap-6">
                      <div class="flex gap-4 text-xs text-neutral-500 md:block md:space-y-2">
                        <p>{formatDate(item.publishedAt)}</p>
                        {item.readTime && <p>{item.readTime}</p>}
                      </div>
                      <div class="flex min-w-0 items-start gap-3">
                        <span class="mt-[0.2em] shrink-0 border border-ink-950 px-1.5 text-[0.7rem] font-bold leading-snug">
                          {item.kind === "post" ? HOME_FOCUS.postTag : HOME_FOCUS.resourceTag}
                        </span>
                        <h3 class="font-extrabold leading-snug group-hover:underline md:text-lg">{item.title}</h3>
                      </div>
                      <span class="hidden text-lg text-neutral-400 group-hover:text-ink-950 md:block" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="mt-8 flex justify-end">
          <a href={focusCategoryPath} class="inline-flex items-center justify-between gap-10 border border-neutral-300 px-6 py-3.5 text-sm font-bold transition-colors hover:border-ink-950">
            {HOME_FOCUS.categoryLinkLabel}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
    )}

    {/* ===== 02 課題から探す ===== */}
    {
      issueCategories.length > 0 && (
        <section id="issues" class="scroll-mt-20 bg-neutral-100">
          <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
            <p class="text-xs font-bold text-neutral-500">{HOME_ISSUES.eyebrow}</p>
            <h2 class="mt-4 text-2xl font-extrabold tracking-tight md:text-[2rem]">{HOME_ISSUES.heading}</h2>
            <div class="mt-10 grid gap-px bg-neutral-200 sm:grid-cols-2 lg:grid-cols-5">
              {issueCategories.map((cat, i) => (
                <div class="flex flex-col bg-white p-6">
                  <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true" set:html={ISSUE_ICONS[i % ISSUE_ICONS.length]} />
                  <h3 class="mt-5 font-extrabold leading-snug">
                    <a href={cat.href} class="hover:underline">{cat.name}</a>
                  </h3>
                  <ul class="mt-4 space-y-1.5 text-sm text-neutral-600">
                    {cat.subs.map((sub) => (
                      <li>
                        {sub.href ? <a href={sub.href} class="hover:text-ink-950 hover:underline">{sub.name}</a> : sub.name}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-auto pt-6">
                    <a href={cat.href} class="inline-flex items-center gap-2 text-sm font-bold hover:underline">
                      {HOME_ISSUES.linkLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* ===== 計画から改善、報告まで（文言は src/data/home.ts の HOME_PDCA） ===== */}
    <section id="tools" class="scroll-mt-20 border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-5 py-14 md:py-16">
        <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
          <h2 class="text-2xl font-extrabold tracking-tight md:text-[1.75rem]">{HOME_PDCA.heading}</h2>
          <p class="text-sm text-neutral-600">{HOME_PDCA.sub}</p>
        </div>
        <div class="mt-8 grid gap-4 lg:grid-cols-3">
          {HOME_PDCA.steps.map((step) => (
            <div class="flex flex-col border border-neutral-300 bg-white p-6">
              <div class="flex items-center gap-3">
                <span class="text-3xl font-light tracking-tight text-neutral-500">{step.step}</span>
                <div>
                  <p class="text-sm font-extrabold">{step.phase}</p>
                  <p class="text-xs text-neutral-500">{step.purpose}</p>
                </div>
              </div>
              <h3 class="mt-5 text-lg font-extrabold leading-snug">
                <a href={step.href} class="hover:underline">{step.name}</a>
              </h3>
              {/* PCで3枚の区切り線の高さをそろえるため、説明文は3行分の高さを確保 */}
              <p class="mt-2 text-sm leading-relaxed text-neutral-700 lg:min-h-[4.875em]">{step.description}</p>
              <div class="mt-4 border-t border-neutral-200 pt-4">
                <p class="text-xs font-bold text-neutral-500">{step.resource.label || HOME_PDCA.relatedLabel}</p>
                <div class="mt-3 grid grid-cols-[64px_minmax(0,1fr)] gap-4">
                  {/* 表紙（スプレッドシート：マス目＋下にシートのタブ） */}
                  {(() => {
                    const cover = (
                      <div class="flex aspect-[3/4] w-full flex-col overflow-hidden border border-neutral-300 bg-white px-1.5 pt-1.5">
                        <p class="text-[0.4rem] font-bold leading-none">MKTG.AX</p>
                        <div class="mt-1 h-[2px] bg-ink-950"></div>
                        <p class="mt-1 whitespace-pre-line text-[0.5rem] font-extrabold leading-tight">{step.resource.coverTitle}</p>
                        <div class="mt-1 grid flex-1 grid-cols-[1fr_2fr_2fr] auto-rows-[5px] content-start border-l border-t border-neutral-300">
                          {Array.from({ length: 12 }).map((_, i) => (
                            <span class={`border-b border-r border-neutral-300 ${i < 3 ? "bg-neutral-100" : ""}`}></span>
                          ))}
                        </div>
                        <div class="-mx-1.5 mt-auto flex h-[6px] gap-px border-t border-neutral-300">
                          <span class="w-3 bg-ink-950"></span>
                          <span class="w-3 border-r border-neutral-300"></span>
                          <span class="w-3 border-r border-neutral-300"></span>
                        </div>
                      </div>
                    );
                    return step.resource.href ? (
                      <a href={step.resource.href} class="block" aria-hidden="true" tabindex="-1">{cover}</a>
                    ) : (
                      <div aria-hidden="true">{cover}</div>
                    );
                  })()}
                  <div class="min-w-0">
                    <p class="text-sm font-bold leading-snug">
                      {step.resource.href ? (
                        <a href={step.resource.href} class="group flex items-center justify-between gap-3">
                          <span class="group-hover:underline">{step.resource.name}</span>
                          <span class="shrink-0 text-base" aria-hidden="true">→</span>
                        </a>
                      ) : (
                        <>
                          {step.resource.name}
                          <span class="ml-2 text-xs font-normal text-neutral-500">{HOME_PDCA.comingSoonLabel}</span>
                        </>
                      )}
                    </p>
                    {step.resource.guide ? (
                      <p class="mt-2 bg-neutral-50 px-2.5 py-2 text-xs leading-relaxed text-neutral-700">{step.resource.guide}</p>
                    ) : (
                      <p class="mt-1 text-xs text-neutral-500">{step.resource.typeLabel}</p>
                    )}
                  </div>
                </div>
              </div>
              <div class="mt-auto pt-5">
                <a href={step.href} class="flex items-center justify-between gap-4 bg-ink-950 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-neutral-800">
                  {step.name}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <p class="text-xs text-neutral-500">{HOME_PDCA.note}</p>
          <a href={HOME_PDCA.listLink.href} class="inline-flex items-center justify-between gap-10 self-start border border-neutral-300 px-6 py-3.5 text-sm font-bold transition-colors hover:border-ink-950 md:self-auto">
            {HOME_PDCA.listLink.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* ===== 03 新着記事 ===== */}
    {
      latestPosts.length > 0 && (
        <section class="border-t border-neutral-200">
          <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
            <p class="text-xs font-bold text-neutral-500">{HOME_LATEST.eyebrow}</p>
            <h2 class="mt-4 text-2xl font-extrabold tracking-tight md:text-[2rem]">{HOME_LATEST.heading}</h2>
            <ul class="mt-10 border-t border-neutral-200">
              {latestPosts.map((post) => (
                <li class="border-b border-neutral-200">
                  <a href={post.href} class="group grid gap-3 py-6 md:grid-cols-[110px_minmax(0,1fr)_24px] md:gap-6">
                    <div class="flex gap-4 text-xs text-neutral-500 md:block md:space-y-2">
                      <p>{formatDate(post.publishedAt)}</p>
                      {post.readTime && <p>{post.readTime}</p>}
                    </div>
                    <div class="min-w-0">
                      {post.category && <p class="text-xs font-bold">{post.category}</p>}
                      <h3 class="mt-2 font-extrabold leading-snug group-hover:underline md:text-lg">{post.title}</h3>
                      {post.description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-600">{post.description}</p>}
                    </div>
                    <span class="hidden text-lg text-neutral-400 group-hover:text-ink-950 md:block" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-8 flex justify-end">
              <a href={HOME_LATEST.allLink.href} class="inline-flex items-center justify-between gap-10 border border-neutral-300 px-6 py-3.5 text-sm font-bold transition-colors hover:border-ink-950">
                {HOME_LATEST.allLink.label}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </section>
      )
    }

    {/* ===== 04 ご要望・ご質問（お問い合わせフォームへ誘導） ===== */}
    <section class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        <p class="text-xs font-bold text-neutral-500">{HOME_REQUEST.eyebrow}</p>
        <div class="mt-4 grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <div>
            <h2 class="text-2xl font-extrabold tracking-tight md:text-[2rem]">{HOME_REQUEST.heading}</h2>
            <p class="mt-5 max-w-2xl text-sm leading-[1.9] text-neutral-700">{HOME_REQUEST.description}</p>
            <ul class="mt-6 space-y-2 text-sm text-neutral-700">
              {HOME_REQUEST.examples.map((ex) => (
                <li class="flex items-start gap-3">
                  <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 bg-ink-950" aria-hidden="true"></span>
                  <span>{ex}</span>
                </li>
              ))}
            </ul>
          </div>
          <a href={HOME_REQUEST.link.href} class="inline-flex items-center gap-4 self-start border border-ink-950 bg-ink-950 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-neutral-800 md:self-auto">
            {HOME_REQUEST.link.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
