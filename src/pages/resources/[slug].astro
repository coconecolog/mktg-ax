---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getAllResources } from "@/lib/resources";
import { DEFAULT_OG_IMAGE } from "@/consts";

export const getStaticPaths = (async () => {
  return getAllResources().map((resource) => ({
    params: { slug: resource.slug },
    props: { resource },
  }));
}) satisfies GetStaticPaths;

const { resource } = Astro.props;

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "資料一覧", href: "/resources" },
  { name: resource.title, href: `/resources/${resource.slug}` },
];

const dateLabel = new Date(resource.updatedAt).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

// メインタグはタグと同じ「マスタータグ」DBを参照しているため重複しうる。表示用に1本のタグ列にまとめる。
const displayTags = [...new Set([resource.mainTag, ...resource.tags].filter((t): t is string => !!t))];
---

<BaseLayout title={resource.title} description={resource.metaDescription || resource.description}>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_360px] lg:items-start">
      <article>
        {resource.category && <span class="text-xs font-medium text-brand-600">{resource.category}</span>}
        <h1 class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-ink-950">{resource.title}</h1>

        {
          displayTags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {displayTags.map((tag) => (
                <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{tag}</span>
              ))}
            </div>
          )
        }

        <p class="mt-4 text-sm text-neutral-400">更新日: <time datetime={resource.updatedAt}>{dateLabel}</time></p>

        <div class="mt-8 aspect-video w-full overflow-hidden rounded-2xl bg-neutral-50">
          <img src={resource.thumbnail || DEFAULT_OG_IMAGE} alt="" class="h-full w-full object-cover" />
        </div>

        {resource.description && <p class="mt-8 whitespace-pre-line leading-relaxed text-neutral-700">{resource.description}</p>}

        {
          resource.targetToc.length > 0 && (
            <div class="mt-8 rounded-2xl border border-neutral-100 bg-neutral-50 p-6">
              <h2 class="text-sm font-bold text-ink-950">こんな方におすすめ・資料の内容</h2>
              <ul class="mt-3 space-y-2 text-sm text-neutral-600">
                {resource.targetToc.map((line) => (
                  <li class="flex gap-2">
                    <span class="text-brand-500">・</span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      <aside class="lg:sticky lg:top-24">
        <div class="rounded-2xl border border-neutral-100 bg-white p-6 shadow-sm">
          <p class="text-xs font-bold text-brand-600">無料ダウンロード</p>
          <h2 class="mt-1 text-lg font-bold leading-snug text-ink-950">資料を無料でダウンロード</h2>
          <p class="mt-2 text-xs leading-relaxed text-neutral-500">以下のフォームにご入力のうえ、送信してください。</p>

          {/* TODO: HubSpotフォーム連携後、この見た目だけのフォームを実際の埋め込みフォームに差し替える。
              ダウンロード自体は resource.fileUrl（Notionの「資料ファイル」プロパティ）を使う想定。 */}
          <form class="mt-5 space-y-3">
            <div>
              <label class="text-xs font-medium text-neutral-600">会社名</label>
              <input type="text" placeholder="株式会社Example" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
            </div>
            <div>
              <label class="text-xs font-medium text-neutral-600">お名前</label>
              <input type="text" placeholder="山田 太郎" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
            </div>
            <div>
              <label class="text-xs font-medium text-neutral-600">メールアドレス</label>
              <input type="email" placeholder="you@example.com" class="mt-1 w-full rounded-lg border border-neutral-200 px-3 py-2 text-sm" />
            </div>
            <button
              type="button"
              disabled
              class="mt-2 w-full cursor-not-allowed rounded-full bg-brand-600/50 px-6 py-3 text-sm font-bold text-white"
            >
              資料をダウンロードする
            </button>
          </form>

          <p class="mt-3 text-center text-[11px] text-neutral-400">※フォームは準備中です。近日公開予定です。</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
