---
// 資料ダウンロード完了後のサンクスページ（カテゴリごとに1ページを静的生成）。
//   /resources/thanks/[category]  … そのカテゴリの資料をDLした人向け
//   /resources/thanks/general     … カテゴリ未設定の資料をDLした人向け
// 遷移元は src/pages/resources/[slug].astro の資料DLフォーム（成功時に自動遷移）。
//
// 構成（上から）: お礼 → TOOLS（無料ツール。そのカテゴリのツール、無ければ全ツールの先頭）
//                → OTHER DOWNLOADS（そのカテゴリの記事・資料を混合で3件。今ダウンロードした資料は除外）→ お問い合わせCTA
// GA4: ページ自体が /resources/thanks/... という固有URLなので、GTM/GA4の page_view で計測できる。
//      DLの「イベント」（resource_download）はフォーム側で送信済みのため、このページでは二重に送らない。
// ?slug=<資料slug> が付いている場合のみ、クライアント側で「今ダウンロードした資料名」を表示し、
//      関連一覧から同じ資料を外す（静的ページのため、この情報だけはブラウザ側で出し分ける）。
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import LibraryCard from "@/components/LibraryCard.astro";
import ContactCta from "@/components/ContactCta.astro";
import { getAllCategories, getCategorySlug } from "@/lib/posts";
import { getAllResources } from "@/lib/resources";
import { getLibraryItems, getLibraryItemsByCategory } from "@/lib/library";
import { getAllTools, getToolsByCategory } from "@/lib/tools";

export const getStaticPaths = (async () => {
  // マスターカテゴリDBの全カテゴリ＋資料に実際に設定されているカテゴリ（マスターDB未設定の環境でも壊れないように）
  const names = new Set<string>();
  for (const c of getAllCategories()) names.add(c.name);
  for (const r of getAllResources()) if (r.category) names.add(r.category);

  const paths = [...names].map((name) => ({
    // 2026-09-25: カテゴリページと同じく、マスターカテゴリDBの英字Slugを使う（未設定ならカテゴリ名）。
    params: { category: getCategorySlug(name) },
    props: { categoryName: name as string | null },
  }));
  paths.push({ params: { category: "general" }, props: { categoryName: null } });
  return paths;
}) satisfies GetStaticPaths;

const { categoryName } = Astro.props as { categoryName: string | null };

// TOOLS: そのカテゴリのツール（最大3件）。該当が無いカテゴリ・カテゴリ未設定のときは、並び順の先頭3件。
const categoryTools = categoryName ? getToolsByCategory(categoryName) : [];
const tools = (categoryTools.length > 0 ? categoryTools : getAllTools()).slice(0, 3);

// OTHER DOWNLOADS: そのカテゴリの記事・資料の混合リスト。「今ダウンロードした資料」を後から除外できるよう
// 1件多め（4件）を出力しておき、ブラウザ側で3件に整える。
const related = (categoryName ? getLibraryItemsByCategory(categoryName, "all") : getLibraryItems("all")).slice(0, 4);

// 「今ダウンロードした資料名」を表示するための slug → 資料名 の対応表（全資料。ページに埋め込む）
const resourceTitleMap = Object.fromEntries(getAllResources().map((r) => [r.slug, r.title]));

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "ライブラリ（記事・資料）", href: "/library" },
  { name: "ダウンロードありがとうございました", href: Astro.url.pathname },
];
---

<BaseLayout
  title="ダウンロードありがとうございました"
  description="資料のダウンロードリンクをメールでお送りしました。あわせて無料ツールや関連する記事・資料もご覧ください。"
  noindex
  pagefindIgnore
>
  <Breadcrumb items={breadcrumbItems} />

  <div class="mx-auto max-w-6xl px-5 pb-12 pt-4">
    <!-- お礼（高さは min-h で確保。お問い合わせのサンクスページと揃えている） -->
    <section class="mx-auto flex min-h-[20rem] max-w-3xl flex-col items-center justify-center py-10 text-center md:min-h-[24rem]">
      <p class="text-xs font-bold tracking-widest text-neutral-500">THANK YOU</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-ink-950 md:text-4xl">
        資料ダウンロードありがとうございます
      </h1>
      <p id="thanks-resource-line" class="mt-8 hidden text-lg font-bold text-ink-950 md:text-xl">
        「<span id="thanks-resource-title"></span>」
      </p>
      <p class="mt-6 text-base leading-loose text-neutral-600 md:text-lg">
        ご入力いただいたメールアドレス宛に、資料のダウンロードリンクをお送りしました。<br />
        メールが届かない場合は、迷惑メールフォルダをご確認ください。
      </p>
    </section>

    <!-- TOOLS -->
    {
      tools.length > 0 && (
        <section class="mt-14 border-t border-neutral-200 pt-12">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold tracking-widest text-neutral-400">TOOLS</p>
              <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-ink-950">業務効率化に役立つ無料ツール</h2>
            </div>
            <a href="/tools" class="shrink-0 text-sm font-medium text-brand-700 hover:underline">
              ツール一覧へ →
            </a>
          </div>
          <div class="mt-6 space-y-4">
            {tools.map((tool) => (
              <a href={tool.href} class="group flex flex-col gap-3 rounded-2xl border border-neutral-300 bg-white p-6 no-underline transition-shadow hover:shadow-lg sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:px-8">
                <div class="min-w-0">
                  {(tool.tag || tool.category) && <p class="text-xs text-neutral-400">{tool.tag || tool.category}</p>}
                  <h3 class="mt-1 text-xl font-extrabold leading-snug tracking-tight text-ink-950 group-hover:text-brand-700">{tool.title}</h3>
                  {tool.description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-500">{tool.description}</p>}
                </div>
                <span class="shrink-0 text-sm font-bold text-ink-950 underline underline-offset-4 group-hover:text-brand-700">
                  {tool.ctaLabel}
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- OTHER DOWNLOADS -->
    {
      related.length > 0 && (
        <section id="thanks-related" class="mt-14 border-t border-neutral-200 pt-12">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold tracking-widest text-neutral-400">OTHER DOWNLOADS</p>
              <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-ink-950">関連するその他の記事・資料</h2>
            </div>
            <a href="/library" class="shrink-0 text-sm font-medium text-brand-700 hover:underline">
              記事・資料一覧へ →
            </a>
          </div>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <div class="thanks-related-card contents" data-kind={item.kind} data-slug={item.slug}>
                <LibraryCard item={item} />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <ContactCta />

  <script type="application/json" id="thanks-resource-map" set:html={JSON.stringify(resourceTitleMap)} />
</BaseLayout>

<script>
  // ?slug= が付いているときだけ、今ダウンロードした資料名を表示し、関連一覧から同じ資料を外す。
  // その上で、関連一覧は最大3件に整える。slug が無い・該当なしの場合も3件に整えるだけで、他は何もしない。
  const slug = new URLSearchParams(window.location.search).get("slug");

  if (slug) {
    try {
      const map = JSON.parse(document.getElementById("thanks-resource-map")?.textContent || "{}") as Record<string, string>;
      const title = map[slug];
      const titleEl = document.getElementById("thanks-resource-title");
      const lineEl = document.getElementById("thanks-resource-line");
      if (title && titleEl && lineEl) {
        titleEl.textContent = title;
        lineEl.classList.remove("hidden");
      }
    } catch {
      // 対応表が読めなくても、ページの表示自体には影響させない
    }
    document
      .querySelectorAll<HTMLElement>('.thanks-related-card[data-kind="resource"]')
      .forEach((el) => {
        if (el.dataset.slug === slug) el.remove();
      });
  }

  const cards = Array.from(document.querySelectorAll<HTMLElement>(".thanks-related-card"));
  cards.slice(3).forEach((el) => el.remove());
  if (cards.length === 0) document.getElementById("thanks-related")?.remove();
</script>
