---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getAllResources } from "@/lib/resources";
import { DEFAULT_OG_IMAGE } from "@/consts";

const resources = getAllResources();

const breadcrumbItems = [
  { name: "トップ", href: "/" },
  { name: "資料一覧", href: "/resources" },
];
---

<BaseLayout
  title="資料一覧"
  description="業務にそのまま使える無料テンプレート・ホワイトペーパーを無料でダウンロードいただけます。"
  ogImage="/open-graph/resources.png"
>
  <Breadcrumb items={breadcrumbItems} />

  <section class="mx-auto max-w-6xl px-5 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-ink-950">資料一覧</h1>
    <p class="mt-3 text-neutral-500">
      業務にそのまま使える無料テンプレート・ホワイトペーパーをご用意しています。
    </p>

    {
      resources.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {resources.map((resource) => (
            <a href={`/resources/${resource.slug}`}
              class="group block overflow-hidden rounded-2xl border border-neutral-100 bg-white transition-shadow hover:shadow-lg"
            >
              <div class="aspect-video w-full overflow-hidden bg-neutral-50">
                <img src={resource.thumbnail || DEFAULT_OG_IMAGE} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
              </div>
              <div class="p-5">
                {resource.category && <span class="text-xs font-medium text-brand-600">{resource.category}</span>}
                <h3 class="mt-1 line-clamp-2 font-bold text-ink-950 group-hover:text-brand-700">{resource.title}</h3>
                <p class="mt-2 line-clamp-2 text-sm text-neutral-500">{resource.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-10 text-neutral-400">まだ資料がありません。</p>
      )
    }
  </section>
</BaseLayout>
