---
// カテゴリページの見出し（カテゴリ名・説明文）の下に置く、カテゴリの切り替え（2026-10-12）。
// 表示中のカテゴリは黒地、ほかは枠線のみ。狭い画面では折り返す。
import { getAllCategories, getCategoryPath } from "@/lib/posts";

interface Props {
  /** 表示中のカテゴリ名 */
  current: string;
}

const { current } = Astro.props;
const categories = getAllCategories();
---

<nav aria-label="カテゴリを切り替える" class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <span class="text-xs text-neutral-500">カテゴリ</span>
  <ul class="flex flex-wrap gap-2">
    {
      categories.map((c) => (
        <li>
          <a href={getCategoryPath(c.name)} aria-current={c.name === current ? "page" : undefined} class={`block border px-3 py-1.5 text-xs font-bold transition-colors ${c.name === current ? "border-ink-950 bg-ink-950 text-white" : "border-neutral-300 bg-white text-ink-950 hover:border-ink-950"}`}>
            {c.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
